<style>
  /* ═══════════════════════════════════════════════════════════════════════════════
     PREMIUM DESIGN SYSTEM
  ═══════════════════════════════════════════════════════════════════════════════ */
  
  :root {
    --primary-noir: {{ section.settings.primary_color | default: '#0a0a0a' }};
    --secondary-charcoal: {{ section.settings.secondary_color | default: '#2a2a2a' }};
    --accent-gold: {{ section.settings.accent_color | default: '#d4af37' }};
    --background-pearl: {{ section.settings.background_color | default: '#fafaf8' }};
    --text-primary: #0a0a0a;
    --text-secondary: #666666;
    --border-subtle: #e5e5e5;
    --success-green: #2d6a4f;
    --urgency-red: #c1121f;
    --font-display: 'Playfair Display', Georgia, serif;
    --font-body: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
    --font-accent: 'Cormorant Garamond', Georgia, serif;
    --transition-smooth: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
    --transition-quick: all 0.2s ease;
    --shadow-soft: 0 10px 40px rgba(0, 0, 0, 0.06);
    --shadow-strong: 0 20px 60px rgba(0, 0, 0, 0.12);
    --shadow-premium: 0 30px 90px rgba(0, 0, 0, 0.18);
  }

  @import url('https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;500;600;700&family=Inter:wght@300;400;500;600;700&family=Cormorant+Garamond:wght@300;400;500;600&display=swap');

  .maison-collection {
    background: var(--background-pearl);
    padding: {{ section.settings.padding_top }}px 0 {{ section.settings.padding_bottom }}px;
    font-family: var(--font-body);
    color: var(--text-primary);
    overflow-x: hidden;
  }

  /* ═══════════════════════════════════════════════════════════════════════════════
     ANNOUNCEMENT BAR - PREMIUM
  ═══════════════════════════════════════════════════════════════════════════════ */
  
  .maison-announcement {
    background: linear-gradient(135deg, var(--primary-noir) 0%, var(--secondary-charcoal) 100%);

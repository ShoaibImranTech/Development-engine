  gap: 6px;
  border: 2px solid var(--luxury-platinum);
  border-radius: var(--radius-full);
  padding: 6px;
  background: white;
}

.view-btn {
  padding: 10px 14px;
  background: transparent;
  border: none;
  cursor: pointer;
  border-radius: calc(var(--radius-full) - 6px);
  transition: all var(--transition-fast);
  color: #999;
  display: flex;
  align-items: center;
  justify-content: center;
}

.view-btn:hover {
  color: var(--luxury-noir);
  background: rgba(0, 0, 0, 0.05);
}

.view-btn.active {
  background: var(--luxury-noir);
  color: white;
  box-shadow: var(--shadow-xs);
}

.view-btn:focus-visible {
  outline: 3px solid var(--luxury-gold);
  outline-offset: 2px;
}

.view-btn svg {
  width: 20px;
  height: 20px;
  stroke-width: 2;
}

/* ═══════════════════════════════════════════════════════════════════════════════
   PRODUCT GRID - PERFECT RESPONSIVE LAYOUT
═══════════════════════════════════════════════════════════════════════════════ */

.products-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(min(100%, 320px), 1fr));
  gap: clamp(32px, 5vw, 80px) clamp(20px, 3vw, 56px);
  margin-bottom: 100px;
}

@media (min-width: 640px) {
  .products-grid {
    grid-template-columns: repeat(2, 1fr);
  }
}

@media (min-width: 968px) {
  .products-grid[data-columns="3"] {
    grid-template-columns: repeat(3, 1fr);
  }
  .products-grid[data-columns="4"] {
    grid-template-columns: repeat(4, 1fr);
  }
}

@media (min-width: 1400px) {
  .products-grid[data-columns="4"] {
    gap: clamp(40px, 6vw, 80px) clamp(28px, 4vw, 56px);
  }
}

/* ═══════════════════════════════════════════════════════════════════════════════
   PRODUCT CARD - ULTRA PREMIUM DESIGN
═══════════════════════════════════════════════════════════════════════════════ */

.product-card {
  position: relative;
  background: white;
  border-radius: var(--radius-md);
  overflow: visible;
  transition: all var(--transition-luxury);
  cursor: pointer;
  container-type: inline-size;
  box-shadow: var(--shadow-xs);
}

.product-card:hover {
  transform: translateY(-12px);
  box-shadow: var(--shadow-xl);
}

.product-card:focus-within {
  outline: 3px solid var(--luxury-gold);
  outline-offset: 4px;
}

/* Premium Badge System */
.product-badges {
  position: absolute;
  top: 16px;
  left: 16px;
  right: 16px;
  z-index: var(--z-dropdown);
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  pointer-events: none;
  gap: 8px;
}

.badge-group {
  display: flex;
  flex-direction: column;
  gap: 8px;
}

.badge {
  padding: clamp(6px, 1vw, 8px) clamp(12px, 2vw, 16px);
  font-size: clamp(9px, 1vw, 10px);
  font-weight: 800;
  letter-spacing: 1.5px;
  text-transform: uppercase;
  border-radius: var(--radius-sm);
  backdrop-filter: blur(16px);
  box-shadow: var(--shadow-md);
  display: inline-block;
  animation: badgeFadeIn 0.5s var(--transition-base);
}

@keyframes badgeFadeIn {
  from {
    opacity: 0;
    transform: translateY(-12px) scale(0.9);
  }
  to {
    opacity: 1;
    transform: translateY(0) scale(1);
  }
}

.badge-sale {
  background: linear-gradient(135deg, var(--luxury-burgundy) 0%, #8b1a2e 100%);
  color: white;
}

.badge-new {
  background: linear-gradient(135deg, var(--luxury-emerald) 0%, #2d7a4f 100%);
  color: white;
}

.badge-sold-out {
  background: linear-gradient(135deg, var(--luxury-charcoal) 0%, var(--luxury-slate) 100%);
  color: white;
}

.badge-bestseller {
  background: linear-gradient(135deg, var(--luxury-gold) 0%, #d4b068 100%);
  color: var(--luxury-noir);
}

.badge-sustainable {
  background: linear-gradient(135deg, var(--luxury-emerald) 0%, #2d7a4f 100%);
  color: white;
  font-size: clamp(8px, 0.9vw, 9px);
  padding: clamp(6px, 1vw, 7px) clamp(10px, 1.5vw, 14px);
  display: flex;
  align-items: center;
  gap: 6px;
}

.badge-sustainable svg {
  width: 11px;
  height: 11px;
}

/* Premium Wishlist Button */
.wishlist-btn {
  position: absolute;
  top: 16px;
  right: 16px;
  width: clamp(40px, 6vw, 48px);
  height: clamp(40px, 6vw, 48px);
  background: rgba(255, 255, 255, 0.98);
  border: none;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  cursor: pointer;
  z-index: calc(var(--z-dropdown) + 10);
  transition: all var(--transition-base);
  pointer-events: auto;
  box-shadow: var(--shadow-md);
}

.wishlist-btn:hover {
  transform: scale(1.15);
  background: white;
  box-shadow: var(--shadow-lg);
}

.wishlist-btn:focus-visible {
  outline: 3px solid var(--luxury-gold);
  outline-offset: 3px;
}

.wishlist-btn.active {
  background: var(--luxury-burgundy);
  color: white;
}

.wishlist-btn svg {
  width: clamp(18px, 3vw, 22px);
  height: clamp(18px, 3vw, 22px);
  stroke-width: 2;
  transition: all var(--transition-base);
}

.wishlist-btn.active svg {
  fill: currentColor;
  animation: heartBeat 0.4s var(--transition-bounce);
}

@keyframes heartBeat {
  0%, 100% { transform: scale(1); }
  25% { transform: scale(1.3); }
  50% { transform: scale(1.1); }
  75% { transform: scale(1.25); }
}

/* Premium Image Wrapper */
.product-image-wrapper {
  position: relative;
  aspect-ratio: 3/4;
  overflow: hidden;
  background: linear-gradient(135deg, #f8f8f8 0%, #f0f0f0 100%);
  border-radius: var(--radius-md) var(--radius-md) 0 0;
}

.product-image {
  width: 100%;
  height: 100%;
  object-fit: cover;
  transition: all var(--transition-slow);
  will-change: transform;
}

.product-image-secondary {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  object-fit: cover;
  opacity: 0;
  transition: opacity var(--transition-slow);
}

.product-card:hover .product-image {
  transform: scale(1.08);
}

.product-card:hover .product-image-secondary {
  opacity: 1;
}

/* Stock Urgency Indicator */
.stock-indicator {
  position: absolute;
  bottom: 20px;
  left: 20px;
  right: 20px;
  background: rgba(107, 20, 35, 0.98);
  color: white;
  padding: clamp(10px, 1.5vw, 12px) clamp(16px, 2vw, 20px);
  border-radius: var(--radius-md);
  font-size: clamp(10px, 1.2vw, 11px);
  font-weight: 800;
  letter-spacing: 1px;
  text-align: center;
  text-transform: uppercase;
  backdrop-filter: blur(16px);
  box-shadow: var(--shadow-lg);
  z-index: var(--z-base);
  animation: stockPulse 2.5s infinite;
}

@keyframes stockPulse {
  0%, 100% { 
    transform: scale(1);
    opacity: 0.98;
  }
  50% { 
    transform: scale(1.03);
    opacity: 1;
  }
}

/* Premium Quick View Button */
.quick-view-btn {
  position: absolute;
  bottom: 20px;
  left: 50%;
  transform: translateX(-50%) translateY(24px);
  background: white;
  color: var(--luxury-noir);
  padding: clamp(14px, 2vw, 16px) clamp(28px, 4vw, 36px);
  border: 2px solid var(--luxury-noir);
  font-size: clamp(11px, 1.3vw, 12px);
  font-weight: 800;
  letter-spacing: 1.5px;
  text-transform: uppercase;
  border-radius: var(--radius-full);
  cursor: pointer;
  opacity: 0;
  transition: all var(--transition-base);
  z-index: var(--z-dropdown);
  box-shadow: var(--shadow-lg);
  font-family: var(--font-body);
  white-space: nowrap;
}

.product-card:hover .quick-view-btn {
  opacity: 1;
  transform: translateX(-50%) translateY(0);
}

.quick-view-btn:hover {
  background: var(--luxury-noir);
  color: white;
  box-shadow: var(--shadow-xl);
  transform: translateX(-50%) translateY(-4px);
}

.quick-view-btn:focus-visible {
  outline: 3px solid var(--luxury-gold);
  outline-offset: 3px;
}

/* Product Info Section */
.product-info {
  padding: clamp(20px, 3vw, 28px) clamp(16px, 2.5vw, 24px) clamp(24px, 3.5vw, 32px);
  display: flex;
  flex-direction: column;
  gap: 8px;
}

.product-vendor {
  font-size: clamp(9px, 1vw, 10px);
  letter-spacing: 2.5px;
  text-transform: uppercase;
  color: #999;
  font-weight: 800;
}

.product-title {
  font-size: clamp(15px, 2cqi, 19px);
  font-weight: 600;
  line-height: 1.35;
  color: var(--luxury-noir);
  font-family: var(--font-display);
  letter-spacing: -0.02em;
  margin-bottom: 6px;
  min-height: 2.7em;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
  text-overflow: ellipsis;
}

.product-title a {
  color: inherit;
  text-decoration: none;
  transition: color var(--transition-fast);
}

.product-title a:hover {
  color: var(--luxury-gold);
}

.product-title a:focus-visible {
  outline: 3px solid var(--luxury-gold);
  outline-offset: 3px;
  border-radius: var(--radius-sm);
}

/* Premium Rating System */
.product-rating {
  display: flex;
  align-items: center;
  gap: 10px;
  margin: 6px 0;
}

.rating-stars {
  display: flex;
  gap: 3px;
  color: var(--luxury-gold);
}

.star {
  width: clamp(13px, 2vw, 15px);
  height: clamp(13px, 2vw, 15px);
}

.rating-count {
  font-size: clamp(11px, 1.3vw, 12px);
  color: #999;
  font-weight: 600;
}

/* Luxury Price Display */
.product-price {
  display: flex;
  align-items: baseline;
  gap: 12px;
  margin: 10px 0;
  flex-wrap: wrap;
}

.price-current {
  font-size: clamp(18px, 3vw, 22px);
  font-weight: 700;
  color: var(--luxury-noir);
  font-family: var(--font-display);
  letter-spacing: -0.01em;
}

.price-compare {
  font-size: clamp(15px, 2.5vw, 17px);
  color: #999;
  text-decoration: line-through;
  font-weight: 500;
}

.price-save {
  font-size: clamp(10px, 1.2vw, 11px);
  color: var(--luxury-burgundy);
  font-weight: 800;
  letter-spacing: 0.8px;
  text-transform: uppercase;
}

/* Premium Color Swatches */
.color-swatches {
  display: flex;
  gap: 8px;
  margin: 12px 0 10px;
  flex-wrap: wrap;
}

.color-swatch {
  width: clamp(28px, 4vw, 32px);
  height: clamp(28px, 4vw, 32px);
  border-radius: 50%;
  border: 2.5px solid var(--luxury-platinum);
  cursor: pointer;
  transition: all var(--transition-fast);
  position: relative;
  box-shadow: var(--shadow-xs);
}

.color-swatch:hover {
  transform: scale(1.2);
  border-color: var(--luxury-noir);
  box-shadow: var(--shadow-md);
}

.color-swatch:focus-visible {
  outline: 3px solid var(--luxury-gold);
  outline-offset: 3px;
}

.color-swatch.active {
  border-color: var(--luxury-noir);
  box-shadow: 0 0 0 4px rgba(0, 0, 0, 0.12);
}

/* Size Fit Indicator */
.size-indicator {
  display: flex;
  align-items: center;
  gap: 8px;
  font-size: clamp(10px, 1.2vw, 11px);
  color: var(--luxury-emerald);
  margin: 10px 0;
  padding: 8px 12px;
  background: rgba(26, 77, 46, 0.06);
  border-radius: var(--radius-md);
  border: 1.5px solid rgba(26, 77, 46, 0.15);
  font-weight: 700;
}

.size-icon {
  width: 15px;
  height: 15px;
  flex-shrink: 0;
}

/* Premium Add to Cart Button */
.add-to-cart-btn {
  width: 100%;
  padding: clamp(16px, 2.5vw, 18px) clamp(20px, 3vw, 28px);
  background: var(--luxury-noir);
  color: white;
  border: 2px solid var(--luxury-noir);
  font-size: clamp(12px, 1.5vw, 13px);
  font-weight: 800;
  letter-spacing: 1.5px;
  text-transform: uppercase;
  border-radius: var(--radius-md);
  cursor: pointer;
  transition: all var(--transition-fast);
  font-family: var(--font-body);
  margin-top: 14px;
  position: relative;
  overflow: hidden;
}

.add-to-cart-btn::before {
  content: '';
  position: absolute;
  top: 50%;
  left: 50%;
  width: 0;
  height: 0;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.3);
  transform: translate(-50%, -50%);
  transition: width 0.6s, height 0.6s;
}

.add-to-cart-btn:hover::before {
  width: 300px;
  height: 300px;
}

.add-to-cart-btn:hover:not(:disabled) {
  background: white;
  color: var(--luxury-noir);
  transform: translateY(-3px);
  box-shadow: var(--shadow-lg);
}

.add-to-cart-btn:active:not(:disabled) {
  transform: translateY(-1px);
}

.add-to-cart-btn:focus-visible {
  outline: 3px solid var(--luxury-gold);
  outline-offset: 3px;
}

.add-to-cart-btn:disabled {
  background: var(--luxury-platinum);
  color: #999;
  border-color: var(--luxury-platinum);
  cursor: not-allowed;
  transform: none;
}

.add-to-cart-btn.loading {
  pointer-events: none;
}

.add-to-cart-btn.loading::after {
  content: '';
  position: absolute;
  top: 50%;
  left: 50%;
  width: 20px;
  height: 20px;
  margin: -10px 0 0 -10px;
  border: 2px solid rgba(255, 255, 255, 0.3);
  border-top-color: white;
  border-radius: 50%;
  animation: buttonSpinner 0.6s linear infinite;
}

@keyframes buttonSpinner {
  to { transform: rotate(360deg); }
}

/* ═══════════════════════════════════════════════════════════════════════════════
   QUICK VIEW MODAL - LUXURY DESIGN
═══════════════════════════════════════════════════════════════════════════════ */

.quick-view-modal {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: rgba(0, 0, 0, 0.92);
  z-index: var(--z-modal-backdrop);
  display: none;
  align-items: center;
  justify-content: center;
  opacity: 0;
  transition: opacity var(--transition-base);
  backdrop-filter: blur(12px);
  padding: 20px;
  overflow-y: auto;
}

.quick-view-modal.active {
  display: flex;
  opacity: 1;
}

.modal-content {
  background: white;
  max-width: 1300px;
  width: 100%;
  max-height: 90vh;
  overflow-y: auto;
  border-radius: var(--radius-xl);
  box-shadow: var(--shadow-premium);
  transform: scale(0.95);
  transition: transform var(--transition-base);
  position: relative;
}

.quick-view-modal.active .modal-content {
  transform: scale(1);
}

.modal-close {
  position: absolute;
  top: clamp(16px, 3vw, 28px);
  right: clamp(16px, 3vw, 28px);
  width: clamp(40px, 6vw, 48px);
  height: clamp(40px, 6vw, 48px);
  background: white;
  border: 2px solid var(--luxury-platinum);
  border-radius: 50%;
  cursor: pointer;
  z-index: calc(var(--z-modal) + 10);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: var(--shadow-md);
  transition: all var(--transition-fast);
}

.modal-close:hover {
  transform: rotate(90deg) scale(1.1);
  background: var(--luxury-noir);
  color: white;
  border-color: var(--luxury-noir);
}

.modal-close:focus-visible {
  outline: 3px solid var(--luxury-gold);
  outline-offset: 3px;
}

.modal-close svg {
  width: clamp(20px, 3vw, 24px);
  height: clamp(20px, 3vw, 24px);
  stroke-width: 2.5;
}

.modal-grid {
  display: grid;
  grid-template-columns: 1fr;
  gap: 0;
}

@media (min-width: 968px) {
  .modal-grid {
    grid-template-columns: 1fr 1fr;
  }
}

.modal-images {
  position: relative;
  background: linear-gradient(135deg, #f8f8f8 0%, #f0f0f0 100%);
  min-height: 400px;
}

.modal-image-main {
  width: 100%;
  height: 100%;
  object-fit: cover;
  min-height: clamp(400px, 60vh, 600px);
}

.modal-details {
  padding: clamp(28px, 6vw, 64px);
  display: flex;
  flex-direction: column;
  gap: 18px;
}

.modal-vendor {
  font-size: clamp(10px, 1.2vw, 11px);
  letter-spacing: 2.5px;
  text-transform: uppercase;
  color: #999;
  font-weight: 800;
}

.modal-title {
  font-size: clamp(24px, 4vw, 38px);
  font-weight: 700;
  line-height: 1.2;
  color: var(--luxury-noir);
  font-family: var(--font-display);
  letter-spacing: -0.02em;
}

.modal-rating {
  display: flex;
  align-items: center;
  gap: 14px;
}

.modal-price {
  display: flex;
  align-items: baseline;
  gap: 16px;
  padding-bottom: 24px;
  border-bottom: 2px solid var(--luxury-platinum);
  flex-wrap: wrap;
}

.modal-price-current {
  font-size: clamp(32px, 5vw, 42px);
  font-weight: 700;
  color: var(--luxury-noir);
  font-family: var(--font-display);
}

.modal-price-compare {
  font-size: clamp(22px, 3.5vw, 28px);
  color: #999;
  text-decoration: line-through;
}

.modal-description {
  font-size: clamp(14px, 1.8vw, 15px);
  line-height: 1.8;
  color: #4a4a4a;
}

.modal-material-badge {
  display: inline-block;
  padding: 10px 20px;
  background: rgba(201, 169, 97, 0.1);
  color: var(--luxury-gold);
  border: 2px solid var(--luxury-gold);
  border-radius: var(--radius-full);
  font-size: clamp(10px, 1.2vw, 11px);
  font-weight: 800;
  letter-spacing: 1.5px;
  text-transform: uppercase;
}

/* Premium Size Selector */
.modal-options {
  margin: 20px 0;
}

.option-label {
  font-size: clamp(11px, 1.3vw, 12px);
  font-weight: 800;
  letter-spacing: 1.5px;
  text-transform: uppercase;
  color: var(--luxury-noir);
  margin-bottom: 14px;
  display: block;
}

.size-selector {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(clamp(70px, 12vw, 90px), 1fr));
  gap: 10px;
}

.size-option {
  padding: clamp(12px, 2vw, 16px);
  border: 2px solid var(--luxury-platinum);
  background: white;
  text-align: center;
  cursor: pointer;
  transition: all var(--transition-fast);
  font-weight: 700;
  font-size: clamp(12px, 1.5vw, 14px);
  border-radius: var(--radius-md);
}

.size-option:hover:not(.unavailable) {
  border-color: var(--luxury-noir);
  transform: translateY(-2px);
  box-shadow: var(--shadow-sm);
}

.size-option:focus-visible {
  outline: 3px solid var(--luxury-gold);
  outline-offset: 2px;
}

.size-option.selected {
  background: var(--luxury-noir);
  color: white;
  border-color: var(--luxury-noir);
  box-shadow: var(--shadow-md);
}

.size-option.unavailable {
  opacity: 0.3;
  cursor: not-allowed;
  text-decoration: line-through;
}

/* Trust Signals */
.trust-signals {
  display: flex;
  flex-direction: column;
  gap: 14px;
  margin: 24px 0;
  padding: clamp(20px, 3vw, 28px);
  background: rgba(26, 77, 46, 0.05);
  border-radius: var(--radius-xl);
  border: 2px solid rgba(26, 77, 46, 0.12);
}

.trust-item {
  display: flex;
  align-items: center;
  gap: 12px;
  font-size: clamp(12px, 1.5vw, 13px);
  color: var(--luxury-noir);
  font-weight: 600;
}

.trust-icon {
  width: 20px;
  height: 20px;
  color: var(--luxury-emerald);
  flex-shrink: 0;
}

.modal-add-to-cart {
  width: 100%;
  padding: clamp(18px, 3vw, 22px) clamp(28px, 4vw, 36px);
  background: var(--luxury-noir);
  color: white;
  border: none;
  font-size: clamp(13px, 1.8vw, 15px);
  font-weight: 800;
  letter-spacing: 2px;
  text-transform: uppercase;
  border-radius: var(--radius-md);
  cursor: pointer;
  transition: all var(--transition-fast);
  font-family: var(--font-body);
  margin-top: 24px;
  box-shadow: var(--shadow-lg);
  position: relative;
  overflow: hidden;
}

.modal-add-to-cart:hover {
  background: var(--luxury-charcoal);
  transform: translateY(-3px);
  box-shadow: var(--shadow-xl);
}

.modal-add-to-cart:focus-visible {
  outline: 3px solid var(--luxury-gold);
  outline-offset: 3px;
}

.modal-add-to-cart.loading {
  pointer-events: none;
}

.modal-add-to-cart.loading::after {
  content: '';
  position: absolute;
  top: 50%;
  left: 50%;
  width: 24px;
  height: 24px;
  margin: -12px 0 0 -12px;
  border: 3px solid rgba(255, 255, 255, 0.3);
  border-top-color: white;
  border-radius: 50%;
  animation: buttonSpinner 0.6s linear infinite;
}

/* ═══════════════════════════════════════════════════════════════════════════════
   PAGINATION - LUXURY STYLE
═══════════════════════════════════════════════════════════════════════════════ */

.pagination {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10px;
  padding: clamp(60px, 10vh, 80px) 0 40px;
  flex-wrap: wrap;
}

.pagination-item {
  min-width: clamp(42px, 6vw, 50px);
  height: clamp(42px, 6vw, 50px);
  display: flex;
  align-items: center;
  justify-content: center;
  border: 2px solid var(--luxury-platinum);
  background: white;
  color: var(--luxury-charcoal);
  font-size: clamp(13px, 1.8vw, 15px);
  font-weight: 700;
  cursor: pointer;
  transition: all var(--transition-fast);
  border-radius: var(--radius-md);
  text-decoration: none;
  font-family: var(--font-body);
}

.pagination-item:hover:not(.disabled) {
  border-color: var(--luxury-noir);
  background: var(--luxury-noir);
  color: white;
  transform: translateY(-2px);
  box-shadow: var(--shadow-md);
}

.pagination-item:focus-visible {
  outline: 3px solid var(--luxury-gold);
  outline-offset: 3px;
}

.pagination-item.active {
  background: var(--luxury-noir);
  color: white;
  border-color: var(--luxury-noir);
  box-shadow: var(--shadow-sm);
}

.pagination-item.disabled {
  opacity: 0.3;
  cursor: not-allowed;
  pointer-events: none;
}

/* ═══════════════════════════════════════════════════════════════════════════════
   RESPONSIVE DESIGN - MOBILE FIRST PERFECTION
═══════════════════════════════════════════════════════════════════════════════ */

@media (max-width: 968px) {
  .collection-toolbar {
    flex-direction: column;
    align-items: stretch;
    gap: 16px;
  }

  .toolbar-left,
  .toolbar-right {
    width: 100%;
  }

  .toolbar-right {
    justify-content: space-between;
  }

  .filter-group {
    width: 100%;
    justify-content: flex-start;
  }

  .sort-select {
    flex: 1;
    min-width: 160px;
  }

  .view-toggle {
    flex-shrink: 0;
  }

  .trust-badges {
    grid-template-columns: repeat(2, 1fr);
  }

  .press-grid {
    gap: 20px;
  }
}

@media (max-width: 640px) {
  .collection-hero {
    padding: 50px 0 36px;
  }

  .collection-meta {
    flex-direction: column;
    gap: 12px;
  }

  .meta-divider {
    display: none;
  }

  .trust-badges {
    grid-template-columns: 1fr;
    padding: 24px 16px;
  }

  .filter-group {
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
    -ms-overflow-style: none;
  }

  .filter-group::-webkit-scrollbar {
    display: none;
  }

  .toolbar-right {
    flex-direction: column;
  }

  .view-toggle {
    display: none;
  }

  .products-grid {
    grid-template-columns: 1fr;
    gap: 36px 0;
  }

  .product-badges {
    top: 12px;
    left: 12px;
    right: 12px;
  }

  .wishlist-btn {
    top: 12px;
    right: 12px;
  }

  .stock-indicator,
  .quick-view-btn {
    left: 12px;
    right: 12px;
    bottom: 12px;
  }

  .quick-view-btn {
    left: 50%;
    right: auto;
  }

  .modal-content {
    max-height: 95vh;
  }

  .modal-images {
    min-height: 350px;
  }

  .modal-image-main {
    min-height: 350px;
  }

  .toast-container {
    top: 10px;
    left: 10px;
    right: 10px;
    max-width: none;
  }
}

@media (max-width: 400px) {
  .collection-season {
    font-size: 8px;
    padding: 10px 20px;
  }

  .filter-btn {
    font-size: 9px;
    padding: 9px 14px;
  }

  .pagination {
    gap: 6px;
  }

  .pagination-item {
    min-width: 38px;
    height: 38px;
    font-size: 12px;
  }
}

/* ═══════════════════════════════════════════════════════════════════════════════
   ACCESSIBILITY ENHANCEMENTS - WCAG 2.1 AAA
═══════════════════════════════════════════════════════════════════════════════ */

@media (prefers-reduced-motion: reduce) {
  *,
  *::before,
  *::after {
    animation-duration: 0.01ms !important;
    animation-iteration-count: 1 !important;
    transition-duration: 0.01ms !important;
  }
}

.sr-only {
  position: absolute;
  width: 1px;
  height: 1px;
  padding: 0;
  margin: -1px;
  overflow: hidden;
  clip: rect(0, 0, 0, 0);
  white-space: nowrap;
  border-width: 0;
}

:focus-visible {
  outline: 3px solid var(--luxury-gold);
  outline-offset: 3px;
}

/* High Contrast Mode Support */
@media (prefers-contrast: high) {
  .luxury-collection {
    background: white;
  }

  .product-card {
    border: 2px solid var(--luxury-noir);
  }

  .filter-btn,
  .sort-select,
  .add-to-cart-btn {
    border-width: 3px;
  }
}

/* ═══════════════════════════════════════════════════════════════════════════════
   PRINT STYLES
═══════════════════════════════════════════════════════════════════════════════ */

@media print {
  .luxury-announcement,
  .collection-toolbar,
  .wishlist-btn,
  .quick-view-btn,
  .add-to-cart-btn,
  .modal-add-to-cart,
  .quick-view-modal,
  .toast-container,
  .pagination {
    display: none !important;
  }

  .product-card {
    break-inside: avoid;
    box-shadow: none;
    page-break-inside: avoid;
  }

  .luxury-collection {
    background: white;
  }

  .products-grid {
    grid-template-columns: repeat(2, 1fr);
    gap: 20px;
  }
}

/* ═══════════════════════════════════════════════════════════════════════════════
   LOADING STATES
═══════════════════════════════════════════════════════════════════════════════ */

.loading-spinner {
  width: 48px;
  height: 48px;
  border: 4px solid rgba(0, 0, 0, 0.1);
  border-top-color: var(--luxury-noir);
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
  margin: 60px auto;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

/* Performance Optimizations */
.product-image,
.product-image-secondary,
.modal-image-main {
  content-visibility: auto;
}

img {
  image-rendering: -webkit-optimize-contrast;
  image-rendering: crisp-edges;
}
</style>

<!-- ═══════════════════════════════════════════════════════════════════════════════
     LUXURY COLLECTION HTML STRUCTURE
═══════════════════════════════════════════════════════════════════════════════ -->

<div class="luxury-collection" id="luxury-collection-{{ section.id }}">
  
  <!-- Toast Notification Container -->
  <div class="toast-container" id="toastContainer" role="status" aria-live="polite"></div>
  
  <!-- Premium Announcement Bar -->
  {% if section.settings.show_announcement and section.settings.announcement_text != blank %}
  <div class="luxury-announcement" role="banner" aria-label="Site announcement">
    <div class="announcement-text">
      {{ section.settings.announcement_text 
         | replace: '[GOLD]', '<span class="announcement-highlight">' 
         | replace: '[/GOLD]', '</span>' }}
    </div>
  </div>
  {% endif %}

  {% paginate collection.products by section.settings.products_per_page %}
  
  <div class="luxury-container">
    
    <!-- Collection Hero Section -->
    <header class="collection-hero">
      {% if section.settings.season_text != blank %}
      <div class="collection-season">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/>
        </svg>
        {{ section.settings.season_text }}
      </div>
      {% endif %}
      
      <h1 class="collection-title">{{ collection.title }}</h1>
      
      {% if collection.description != blank %}
      <p class="collection-subtitle">
        {{ collection.description | strip_html | truncatewords: 32 }}
      </p>
      {% endif %}
      
      <div class="collection-meta">
        <div class="meta-item">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/>
            <circle cx="12" cy="7" r="4"/>
          </svg>
          <span><strong id="product-count">{{ collection.products_count }}</strong> Curated {{ collection.products_count | pluralize: 'Piece', 'Pieces' }}</span>
        </div>
        
        {% if section.settings.show_handcrafted %}
        <div class="meta-divider" aria-hidden="true"></div>
        <div class="meta-item">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path d="M12 2L2 7l10 5 10-5-10-5z"/>
            <path d="M2 17l10 5 10-5M2 12l10 5 10-5"/>
          </svg>
          <span>Handcrafted Excellence</span>
        </div>
        {% endif %}
        
        {% if section.settings.show_sustainability %}
        <div class="meta-divider" aria-hidden="true"></div>
        <div class="meta-item">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path d="M22 12h-4l-3 9L9 3l-3 9H2"/>
          </svg>
          <span>Sustainable Materials</span>
        </div>
        {% endif %}
      </div>
    </header>

    <!-- Trust Badges Section -->
    {% if section.settings.show_trust_badges %}
    <section class="trust-badges" aria-label="Trust signals">
      <div class="trust-badge">
        <svg class="trust-badge-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/>
        </svg>
        <span class="trust-badge-text">100% Authenticated</span>
        <span class="trust-badge-subtext">Guaranteed Genuine</span>
      </div>
      
      <div class="trust-badge">
        <svg class="trust-badge-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/>
        </svg>
        <span class="trust-badge-text">Same-Day Dispatch</span>
        <span class="trust-badge-subtext">Mon-Fri Orders</span>
      </div>
      
      <div class="trust-badge">
        <svg class="trust-badge-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/>
        </svg>
        <span class="trust-badge-text">Lifetime Warranty</span>
        <span class="trust-badge-subtext">Quality Promise</span>
      </div>
      
      <div class="trust-badge">
        <svg class="trust-badge-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M3 10h10a8 8 0 018 8v2M3 10l6 6m-6-6l6-6"/>
        </svg>
        <span class="trust-badge-text">Free Returns</span>
        <span class="trust-badge-subtext">30 Days Policy</span>
      </div>
    </section>
    {% endif %}

    <!-- Press Mentions -->
    {% if section.settings.show_press %}
    <section class="press-section" aria-label="Press mentions">
      <div class="press-label">As Featured In</div>
      <div class="press-grid">
        <div class="press-logo">VOGUE</div>
        <div class="press-logo">Harper's BAZAAR</div>
        <div class="press-logo">GQ</div>
        <div class="press-logo">Elle</div>
        <div class="press-logo">WWD</div>
      </div>
    </section>
    {% endif %}

    <!-- Collection Toolbar -->
    <div class="collection-toolbar">
      <div class="toolbar-left">
        {% if section.settings.enable_filters %}
        <div class="filter-group" role="group" aria-label="Product filters">
          <button class="filter-btn active" data-filter="all" aria-pressed="true" type="button">All</button>
          <button class="filter-btn" data-filter="new" aria-pressed="false" type="button">New Arrivals</button>
          <button class="filter-btn" data-filter="sale" aria-pressed="false" type="button">Sale</button>
          <button class="filter-btn" data-filter="bestseller" aria-pressed="false" type="button">Best Sellers</button>
        </div>
        {% endif %}
      </div>
      
      <div class="toolbar-right">
        <span class="results-count" role="status" aria-live="polite">
          <strong>{{ collection.products_count }}</strong> {{ collection.products_count | pluralize: 'item', 'items' }}
        </span>
        
        {% if section.settings.enable_sorting %}
        <div class="sort-wrapper">
          <label for="sortCollection" class="sr-only">Sort products by</label>
          <select class="sort-select" id="sortCollection">
            <option value="">Featured</option>
            <option value="best-selling">Best Selling</option>
            <option value="title-ascending">A-Z</option>
            <option value="title-descending">Z-A</option>
            <option value="price-ascending">Price: Low to High</option>
            <option value="price-descending">Price: High to Low</option>
            <option value="created-descending">Newest First</option>
          </select>
        </div>
        {% endif %}
        
        {% if section.settings.enable_view_toggle %}
        <div class="view-toggle" role="group" aria-label="View options">
          <button class="view-btn active" data-view="grid" aria-label="Grid view" aria-pressed="true" type="button">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" aria-hidden="true">
              <rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/>
              <rect x="3" y="14" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/>
            </svg>
          </button>
          <button class="view-btn" data-view="list" aria-label="List view" aria-pressed="false" type="button">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" aria-hidden="true">
              <line x1="8" y1="6" x2="21" y2="6"/><line x1="8" y1="12" x2="21" y2="12"/>
              <line x1="8" y1="18" x2="21" y2="18"/><line x1="3" y1="6" x2="3.01" y2="6"/>
              <line x1="3" y1="12" x2="3.01" y2="12"/><line x1="3" y1="18" x2="3.01" y2="18"/>
            </svg>
          </button>
        </div>
        {% endif %}
      </div>
    </div>

    <!-- Premium Product Grid -->
    <div class="products-grid" id="productsGrid" data-columns="{{ section.settings.products_per_row }}" role="list" aria-label="Product list">
      
      {% for product in collection.products %}
        {%- liquid
          assign on_sale = false
          assign discount_percent = 0
          assign is_low_stock = false
          assign is_new = false
          assign is_bestseller = false
          assign stock_message = ''
          
          if product.compare_at_price > product.price
            assign on_sale = true
            assign discount_percent = product.compare_at_price | minus: product.price | times: 100 | divided_by: product.compare_at_price | round
          endif
          
          assign first_variant = product.variants.first
          if first_variant.inventory_quantity <= 5 and first_variant.inventory_quantity > 0
            assign is_low_stock = true
            if first_variant.inventory_quantity == 1
              assign stock_message = 'Last Piece Available'
            elsif first_variant.inventory_quantity == 2
              assign stock_message = 'Only 2 Left'
            else
              assign stock_message = 'Only ' | append: first_variant.inventory_quantity | append: ' Remaining'
            endif
          endif
          
          assign current_date = 'now' | date: '%s'
          assign product_date = product.created_at | date: '%s'
          assign days_diff = current_date | minus: product_date | divided_by: 86400
          
          if days_diff <= 30
            assign is_new = true
          endif
          
          assign is_bestseller = false
          if product.metafields.custom.bestseller.value
            assign is_bestseller = true
          endif
          
          assign product_rating = 4.9
          if product.metafields.reviews.rating.value
            assign product_rating = product.metafields.reviews.rating.value
          endif
          
          assign review_count = 0
          if product.metafields.reviews.count.value
            assign review_count = product.metafields.reviews.count.value
          endif
          
          assign size_fit = 'True to size'
          if product.metafields.custom.fit.value
            assign size_fit = product.metafields.custom.fit.value
          endif
          
          assign is_sustainable = false
          if product.metafields.custom.sustainable.value
            assign is_sustainable = true
          endif
        -%}

        <article class="product-card" 
                 data-product-id="{{ product.id }}"
                 data-product-handle="{{ product.handle }}"
                 data-filter-new="{% if is_new %}true{% else %}false{% endif %}"
                 data-filter-sale="{% if on_sale %}true{% else %}false{% endif %}"
                 data-filter-bestseller="{% if is_bestseller %}true{% else %}false{% endif %}"
                 role="listitem">
          
          <!-- Product Badges -->
          <div class="product-badges" aria-label="Product badges">
            <div class="badge-group">
              {% if on_sale %}<span class="badge badge-sale" aria-label="On sale">-{{ discount_percent }}%</span>{% endif %}
              {% if is_new %}<span class="badge badge-new" aria-label="New arrival">New Arrival</span>{% endif %}
              {% if is_bestseller %}<span class="badge badge-bestseller" aria-label="Best seller">Best Seller</span>{% endif %}
              {% unless product.available %}<span class="badge badge-sold-out" aria-label="Sold out">Sold Out</span>{% endunless %}
            </div>
            {% if is_sustainable %}
              <span class="badge badge-sustainable" aria-label="Sustainable product">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
                  <path d="M22 12h-4l-3 9L9 3l-3 9H2"/>
                </svg>
                Sustainable
              </span>
            {% endif %}
          </div>

          <!-- Wishlist Button -->
          <button class="wishlist-btn" data-product-id="{{ product.id }}" aria-label="Add {{ product.title | escape }} to wishlist" type="button">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/>
            </svg>
          </button>

          <!-- Product Image -->
          <div class="product-image-wrapper">
            {% if product.featured_image %}
              <img 
                src="{{ product.featured_image | image_url: width: 100 }}"
                srcset="{{ product.featured_image | image_url: width: 400 }} 400w,
                        {{ product.featured_image | image_url: width: 600 }} 600w,
                        {{ product.featured_image | image_url: width: 800 }} 800w,
                        {{ product.featured_image | image_url: width: 1000 }} 1000w"
                sizes="(max-width: 640px) 100vw, (max-width: 968px) 50vw, (max-width: 1400px) 33vw, 25vw"
                alt="{{ product.title | escape }}"
                class="product-image"
                loading="lazy"
                width="{{ product.featured_image.width }}"
                height="{{ product.featured_image.height }}">
            {% else %}
              {{ 'product-1' | placeholder_svg_tag: 'product-image' }}
            {% endif %}
            
            {% if product.images[1] and section.settings.show_second_image != false %}
              <img 
                src="{{ product.images[1] | image_url: width: 800 }}"
                alt="{{ product.title | escape }} - alternate view"
                class="product-image-secondary"
                loading="lazy"
                width="{{ product.images[1].width }}"
                height="{{ product.images[1].height }}">
            {% endif %}

            {% if is_low_stock and product.available %}
              <div class="stock-indicator" role="status" aria-live="polite">🔥 {{ stock_message }}</div>
            {% endif %}

            {% if section.settings.enable_quick_view %}
              <button class="quick-view-btn" data-product-handle="{{ product.handle }}" data-product-id="{{ product.id }}" 
                      aria-label="Quick view {{ product.title | escape }}" type="button">Quick View</button>
            {% endif %}
          </div>

          <!-- Product Info -->
          <div class="product-info">
            {% if section.settings.show_vendor and product.vendor != blank %}
              <div class="product-vendor">{{ product.vendor }}</div>
            {% endif %}

            <h3 class="product-title">
              <a href="{{ product.url }}" aria-label="{{ product.title | escape }}">{{ product.title }}</a>
            </h3>

            {% if review_count > 0 %}
              <div class="product-rating">
                <div class="rating-stars" role="img" aria-label="{{ product_rating }} out of 5 stars">
                  {% for i in (1..5) %}
                    {% if i <= product_rating %}
                      <svg class="star" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true">
                        <path d="M10 15l-5.878 3.09 1.123-6.545L.489 6.91l6.572-.955L10 0l2.939 5.955 6.572.955-4.756 4.635 1.123 6.545z"/>
                      </svg>
                    {% else %}
                      <svg class="star" fill="none" stroke="currentColor" viewBox="0 0 20 20" aria-hidden="true">
                        <path d="M10 15l-5.878 3.09 1.123-6.545L.489 6.91l6.572-.955L10 0l2.939 5.955 6.572.955-4.756 4.635 1.123 6.545z"/>
                      </svg>
                    {% endif %}
                  {% endfor %}
                </div>
                <span class="rating-count">({{ review_count }})</span>
              </div>
            {% endif %}

            <div class="product-price">
              {% if on_sale %}
                <span class="price-current">{{ product.price | money }}</span>
                <span class="price-compare">{{ product.compare_at_price | money }}</span>
              {% else %}
                <span class="price-current">{{ product.price | money }}</span>
              {% endif %}
            </div>

            {% if on_sale %}
              <div class="price-save">Save {{ discount_percent }}% • {{ product.compare_at_price | minus: product.price | money }}</div>
            {% endif %}

            {% if product.options contains 'Color' and product.variants.size > 1 %}
              <div class="color-swatches" role="list" aria-label="Available colors">
                {% assign color_option_index = nil %}
                {% for option in product.options_with_values %}
                  {% if option.name == 'Color' %}
                    {% assign color_option_index = forloop.index0 %}
                    {% break %}
                  {% endif %}
                {% endfor %}
                
                {% if color_option_index != nil %}
                  {% assign seen_colors = '' %}
                  {% for variant in product.variants limit: 6 %}
                    {% assign color_value = variant.options[color_option_index] %}
                    {% unless seen_colors contains color_value %}
                      {% assign seen_colors = seen_colors | append: ',' | append: color_value %}
                      <div class="color-swatch" 
                           style="background-color: {{ color_value | handleize }};"
                           role="listitem"
                           tabindex="0"
                           aria-label="{{ color_value }}"
                           title="{{ color_value }}">
                      </div>
                    {% endunless %}
                  {% endfor %}
                {% endif %}
              </div>
            {% endif %}

            {% if size_fit != blank and product.available %}
              <div class="size-indicator">
                <svg class="size-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/>
                </svg>
                <span>{{ size_fit }}</span>
              </div>
            {% endif %}

            <div class="product-cta">
              {% if product.available %}
                {% if product.variants.size == 1 %}
                  <button class="add-to-cart-btn" data-variant-id="{{ product.variants.first.id }}" 
                          aria-label="Add {{ product.title | escape }} to cart" type="button">Add to Cart</button>
                {% else %}
                  <button class="add-to-cart-btn quick-view-trigger" data-product-handle="{{ product.handle }}" 
                          aria-label="Select options for {{ product.title | escape }}" type="button">Select Options</button>
                {% endif %}
              {% else %}
                <button class="add-to-cart-btn" disabled aria-label="Sold out" type="button">Sold Out</button>
              {% endif %}
            </div>
          </div>
        </article>
      {% endfor %}
    </div>

    <!-- Pagination -->
    {% if paginate.pages > 1 %}
      <nav class="pagination" role="navigation" aria-label="Pagination">
        {% if paginate.previous %}
          <a href="{{ paginate.previous.url }}" class="pagination-item" aria-label="Previous page">‹</a>
        {% else %}
          <span class="pagination-item disabled" aria-disabled="true">‹</span>
        {% endif %}

        {% for part in paginate.parts %}
          {% if part.is_link %}
            <a href="{{ part.url }}" class="pagination-item" aria-label="Page {{ part.title }}">{{ part.title }}</a>
          {% else %}
            {% if part.title == paginate.current_page %}
              <span class="pagination-item active" aria-current="page" aria-label="Current page, page {{ part.title }}">{{ part.title }}</span>
            {% else %}
              <span class="pagination-item">{{ part.title }}</span>
            {% endif %}
          {% endif %}
        {% endfor %}

        {% if paginate.next %}
          <a href="{{ paginate.next.url }}" class="pagination-item" aria-label="Next page">›</a>
        {% else %}
          <span class="pagination-item disabled" aria-disabled="true">›</span>
        {% endif %}
      </nav>
    {% endif %}
  </div>
  
  {% endpaginate %}
</div>

<!-- Quick View Modal -->
{% if section.settings.enable_quick_view %}
<div class="quick-view-modal" id="quickViewModal" role="dialog" aria-modal="true" aria-labelledby="modal-title" aria-hidden="true">
  <div class="modal-content">
    <button class="modal-close" id="modalClose" aria-label="Close quick view" type="button">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" aria-hidden="true">
        <line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/>
      </svg>
    </button>

    <div class="modal-grid">
      <div class="modal-images">
        <img id="modalImage" class="modal-image-main" src="" alt="" loading="lazy">
      </div>

      <div class="modal-details">
        <div id="modalVendor" class="modal-vendor"></div>
        <h2 id="modal-title" class="modal-title"></h2>
        
        <div id="modalRating" class="modal-rating" style="display: none;">
          <div class="rating-stars"></div>
          <span class="rating-count"></span>
        </div>

        <div class="modal-price">
          <span id="modalPriceCurrent" class="modal-price-current"></span>
          <span id="modalPriceCompare" class="modal-price-compare" style="display: none;"></span>
        </div>

        <div id="modalDescription" class="modal-description"></div>
        
        <div id="modalMaterial" class="modal-material-badge" style="display: none;"></div>

        <div class="modal-options">
          <label class="option-label" for="sizeSelector">Select Size</label>
          <div id="sizeSelector" class="size-selector" role="radiogroup" aria-label="Product size options"></div>
        </div>

        <div class="trust-signals">
          <div class="trust-item">
            <svg class="trust-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
            </svg>
            <span>Complimentary shipping on orders over $300</span>
          </div>
          <div class="trust-item">
            <svg class="trust-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/>
            </svg>
            <span>30-day free returns & exchanges</span>
          </div>
          <div class="trust-item">
            <svg class="trust-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/>
            </svg>
            <span>Secure checkout & authenticity guarantee</span>
          </div>
        </div>

        <button id="modalAddToCart" class="modal-add-to-cart" type="button">Add to Cart</button>
      </div>
    </div>
  </div>
</div>
{% endif %}

<script>
(function() {
  'use strict';

  const LuxuryCollection = {
    config: {
      enableHaptics: 'vibrate' in navigator,
      cacheTimeout: 300000,
      toastDuration: 5000,
    },

    productCache: new Map(),
    wishlist: new Set(),
    recentlyViewed: [],

    init() {
      this.loadWishlist();
      this.loadRecentlyViewed();
      this.cacheProductData();
      this.initQuickView();
      this.initFilters();
      this.initSorting();
      this.initViewToggle();
      this.initWishlist();
      this.initAddToCart();
      this.initAccessibility();
      this.trackRecentlyViewed();
      
      console.log('🏆 Luxury Collection v7.0 - Initialized');
    },

    showToast(title, message, type = 'success') {
      const container = document.getElementById('toastContainer');
      if (!container) return;

      const toast = document.createElement('div');
      toast.className = `toast ${type}`;
      toast.setAttribute('role', 'alert');
      
      const iconSvg = type === 'success' 
        ? '<svg class="toast-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>'
        : '<svg class="toast-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>';
      
      toast.innerHTML = `
        ${iconSvg}
        <div class="toast-content">
          <div class="toast-title">${title}</div>
          <div class="toast-message">${message}</div>
        </div>
        <button class="toast-close" aria-label="Close notification">
          <svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4L4 12M4 4l8 8"/>
          </svg>
        </button>
      `;

      container.appendChild(toast);

      toast.querySelector('.toast-close').addEventListener('click', () => {
        toast.style.animation = 'toastSlideIn 0.3s reverse';
        setTimeout(() => toast.remove(), 300);
      });

      setTimeout(() => {
        if (toast.parentNode) {
          toast.style.animation = 'toastSlideIn 0.3s reverse';
          setTimeout(() => toast.remove(), 300);
        }
      }, this.config.toastDuration);
    },

    cacheProductData() {
      const cards = document.querySelectorAll('.product-card');
      
      cards.forEach(card => {
        const productId = card.dataset.productId;
        const data = {
          id: productId,
          handle: card.dataset.productHandle,
          title: card.querySelector('.product-title')?.textContent.trim(),
          vendor: card.querySelector('.product-vendor')?.textContent.trim(),
          price: card.querySelector('.price-current')?.textContent.trim(),
          comparePrice: card.querySelector('.price-compare')?.textContent.trim(),
          image: card.querySelector('.product-image')?.src,
          imageAlt: card.querySelector('.product-image')?.alt,
          rating: this.extractRating(card),
        };
        
        this.productCache.set(productId, data);
      });
    },

    extractRating(card) {
      const ratingEl = card.querySelector('.product-rating');
      if (!ratingEl) return null;
      
      return {
        stars: ratingEl.querySelectorAll('.star[fill="currentColor"]').length,
        count: ratingEl.querySelector('.rating-count')?.textContent.trim()
      };
    },

    loadWishlist() {
      try {
        const saved = localStorage.getItem('luxury_wishlist');
        if (saved) {
          this.wishlist = new Set(JSON.parse(saved));
          this.updateWishlistUI();
        }
      } catch (error) {
        console.error('Error loading wishlist:', error);
      }
    },

    saveWishlist() {
      try {
        localStorage.setItem('luxury_wishlist', JSON.stringify([...this.wishlist]));
      } catch (error) {
        console.error('Error saving wishlist:', error);
      }
    },

    updateWishlistUI() {
      document.querySelectorAll('.wishlist-btn').forEach(btn => {
        const productId = btn.dataset.productId;
        if (this.wishlist.has(productId)) {
          btn.classList.add('active');
          const productTitle = btn.closest('.product-card')?.querySelector('.product-title')?.textContent.trim();
          btn.setAttribute('aria-label', `Remove ${productTitle} from wishlist`);
        }
      });
    },

    loadRecentlyViewed() {
      try {
        const saved = localStorage.getItem('luxury_recently_viewed');
        if (saved) {
          this.recentlyViewed = JSON.parse(saved);
        }
      } catch (error) {
        console.error('Error loading recently viewed:', error);
      }
    },

    saveRecentlyViewed() {
      try {
        localStorage.setItem('luxury_recently_viewed', JSON.stringify(this.recentlyViewed));
      } catch (error) {
        console.error('Error saving recently viewed:', error);
      }
    },

    trackRecentlyViewed() {
      const productId = document.querySelector('[data-product-id]')?.dataset.productId;
      if (productId && !this.recentlyViewed.includes(productId)) {
        this.recentlyViewed.unshift(productId);
        this.recentlyViewed = this.recentlyViewed.slice(0, 12);
        this.saveRecentlyViewed();
      }
    },

    initQuickView() {
      const modal = document.getElementById('quickViewModal');
      if (!modal) return;

      const modalClose = document.getElementById('modalClose');
      const quickViewButtons = document.querySelectorAll('.quick-view-btn, .quick-view-trigger');

      quickViewButtons.forEach(button => {
        button.addEventListener('click', (e) => {
          e.preventDefault();
          e.stopPropagation();
          this.openQuickView(button);
        });
      });

      modalClose?.addEventListener('click', () => this.closeQuickView());
      
      modal.addEventListener('click', (e) => {
        if (e.target === modal) this.closeQuickView();
      });

      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && modal.classList.contains('active')) {
          this.closeQuickView();
        }
      });
    },

    openQuickView(button) {
      const productId = button.closest('.product-card')?.dataset.productId;
      const productHandle = button.dataset.productHandle;
      const data = this.productCache.get(productId);

      if (!data) return;

      const modal = document.getElementById('quickViewModal');
      
      document.getElementById('modal-title').textContent = data.title;
      document.getElementById('modalVendor').textContent = data.vendor || '';
      document.getElementById('modalPriceCurrent').textContent = data.price;
      document.getElementById('modalImage').src = data.image;
      document.getElementById('modalImage').alt = data.imageAlt;

      if (data.comparePrice) {
        const comparePriceEl = document.getElementById('modalPriceCompare');
        comparePriceEl.textContent = data.comparePrice;
        comparePriceEl.style.display = 'block';
      } else {
        document.getElementById('modalPriceCompare').style.display = 'none';
      }

      if (data.rating) {
        this.renderRating(data.rating);
      }

      this.fetchProductDetails(productHandle);

      modal.classList.add('active');
      modal.setAttribute('aria-hidden', 'false');
      document.body.style.overflow = 'hidden';
      
      setTimeout(() => {
        document.getElementById('modalClose')?.focus();
      }, 100);

      this.hapticFeedback();
    },

    renderRating(rating) {
      const ratingEl = document.getElementById('modalRating');
      const starsHtml = Array.from({length: 5}, (_, i) => {
        const filled = i < rating.stars;
        return `<svg class="star" fill="${filled ? 'currentColor' : 'none'}" stroke="${filled ? 'none' : 'currentColor'}" viewBox="0 0 20 20" aria-hidden="true">
          <path d="M10 15l-5.878 3.09 1.123-6.545L.489 6.91l6.572-.955L10 0l2.939 5.955 6.572.955-4.756 4.635 1.123 6.545z"/>
        </svg>`;
      }).join('');
      
      ratingEl.querySelector('.rating-stars').innerHTML = starsHtml;
      ratingEl.querySelector('.rating-count').textContent = rating.count;
      ratingEl.style.display = 'flex';
    },

    async fetchProductDetails(handle) {
      try {
        const response = await fetch(`/products/${handle}.js`);
        if (!response.ok) throw new Error(`HTTP ${response.status}`);
        
        const product = await response.json();
        
        if (product.description) {
          const tempDiv = document.createElement('div');
          tempDiv.innerHTML = product.description;
          const description = tempDiv.textContent.trim().substring(0, 250);
          document.getElementById('modalDescription').textContent = description + (description.length >= 250 ? '...' : '');
        }

        this.renderSizeSelector(product.variants);

      } catch (error) {
        console.error('Error fetching product:', error);
        this.showToast('Error', 'Unable to load product details. Please try again.', 'error');
      }
    },

    renderSizeSelector(variants) {
      const sizeSelector = document.getElementById('sizeSelector');
      sizeSelector.innerHTML = '';
      
      variants.forEach((variant, index) => {
        const sizeBtn = document.createElement('div');
        sizeBtn.className = 'size-option' + (!variant.available ? ' unavailable' : '');
        sizeBtn.textContent = variant.title;
        sizeBtn.dataset.variantId = variant.id;
        sizeBtn.setAttribute('role', 'radio');
        sizeBtn.setAttribute('aria-checked', 'false');
        sizeBtn.setAttribute('tabindex', variant.available ? '0' : '-1');
        
        if (variant.available) {
          sizeBtn.addEventListener('click', () => this.selectSize(sizeBtn, variant.id));
          sizeBtn.addEventListener('keydown', (e) => {
            if (e.key === 'Enter' || e.key === ' ') {
              e.preventDefault();
              this.selectSize(sizeBtn, variant.id);
            }
          });
        }
        
        sizeSelector.appendChild(sizeBtn);
      });

      const firstAvailable = variants.find(v => v.available);
      if (firstAvailable) {
        const firstBtn = sizeSelector.querySelector(`[data-variant-id="${firstAvailable.id}"]`);
        if (firstBtn) {
          this.selectSize(firstBtn, firstAvailable.id);
        }
      }
    },

    selectSize(button, variantId) {
      document.querySelectorAll('.size-option').forEach(btn => {
        btn.classList.remove('selected');
        btn.setAttribute('aria-checked', 'false');
      });
      button.classList.add('selected');
      button.setAttribute('aria-checked', 'true');
      document.getElementById('modalAddToCart').dataset.variantId = variantId;
      this.hapticFeedback('light');
    },

    closeQuickView() {
      const modal = document.getElementById('quickViewModal');
      modal.classList.remove('active');
      modal.setAttribute('aria-hidden', 'true');
      document.body.style.overflow = '';
    },

    initFilters() {
      const filterButtons = document.querySelectorAll('.filter-btn');
      
      filterButtons.forEach(button => {
        button.addEventListener('click', () => {
          const filter = button.dataset.filter;
          
          filterButtons.forEach(btn => {
            btn.classList.remove('active');
            btn.setAttribute('aria-pressed', 'false');
          });
          button.classList.add('active');
          button.setAttribute('aria-pressed', 'true');
          
          this.filterProducts(filter);
          this.hapticFeedback('light');
          
          this.announceToScreenReader(`Filtering by: ${button.textContent.trim()}`);
        });
      });
    },

    filterProducts(filter) {
      const products = document.querySelectorAll('.product-card');
      let visibleCount = 0;
      
      products.forEach(product => {
        let show = false;
        
        if (filter === 'all') {
          show = true;
        } else if (filter === 'new' && product.dataset.filterNew === 'true') {
          show = true;
        } else if (filter === 'sale' && product.dataset.filterSale === 'true') {
          show = true;
        } else if (filter === 'bestseller' && product.dataset.filterBestseller === 'true') {
          show = true;
        }
        
        product.style.display = show ? 'block' : 'none';
        if (show) visibleCount++;
      });

      const countEl = document.getElementById('product-count');
      if (countEl) {
        countEl.textContent = visibleCount;
      }
      
      const resultsCount = document.querySelector('.results-count strong');
      if (resultsCount) {
        resultsCount.textContent = visibleCount;
      }
    },

    initSorting() {
      const sortSelect = document.getElementById('sortCollection');
      if (!sortSelect) return;

      sortSelect.addEventListener('change', function() {
        const url = new URL(window.location.href);
        if (this.value) {
          url.searchParams.set('sort_by', this.value);
        } else {
          url.searchParams.delete('sort_by');
        }
        window.location.href = url.toString();
      });
      
      const urlParams = new URLSearchParams(window.location.search);
      const currentSort = urlParams.get('sort_by');
      if (currentSort) {
        sortSelect.value = currentSort;
      }
    },

    initViewToggle() {
      const viewButtons = document.querySelectorAll('.view-btn');
      const grid = document.getElementById('productsGrid');
      
      viewButtons.forEach(button => {
        button.addEventListener('click', () => {
          const view = button.dataset.view;
          
          viewButtons.forEach(btn => {
            btn.classList.remove('active');
            btn.setAttribute('aria-pressed', 'false');
          });
          button.classList.add('active');
          button.setAttribute('aria-pressed', 'true');
          
          grid?.setAttribute('data-view', view);
          this.hapticFeedback('light');
          
          try {
            localStorage.setItem('luxury_view_preference', view);
          } catch (e) {}
        });
      });
      
      try {
        const savedView = localStorage.getItem('luxury_view_preference');
        if (savedView) {
          const button = document.querySelector(`[data-view="${savedView}"]`);
          if (button) button.click();
        }
      } catch (e) {}
    },

    initWishlist() {
      const wishlistButtons = document.querySelectorAll('.wishlist-btn');
      
      wishlistButtons.forEach(button => {
        button.addEventListener('click', (e) => {
          e.stopPropagation();
          e.preventDefault();
          
          const productId = button.dataset.productId;
          const isActive = button.classList.contains('active');
          
          if (isActive) {
            button.classList.remove('active');
            this.wishlist.delete(productId);
            this.showToast('Removed from Wishlist', 'Item removed from your wishlist', 'success');
          } else {
            button.classList.add('active');
            this.wishlist.add(productId);
            this.showToast('Added to Wishlist', 'Item saved to your wishlist', 'success');
          }
          
          this.saveWishlist();
          this.hapticFeedback('medium');
          
          const productTitle = button.closest('.product-card')?.querySelector('.product-title')?.textContent.trim();
          button.setAttribute('aria-label', 
            !isActive ? `Remove ${productTitle} from wishlist` : `Add ${productTitle} to wishlist`
          );
        });
      });
    },

    initAddToCart() {
      document.querySelectorAll('.add-to-cart-btn[data-variant-id]').forEach(button => {
        button.addEventListener('click', (e) => {
          e.preventDefault();
          e.stopPropagation();
          const variantId = button.dataset.variantId;
          this.addToCart(variantId, button);
        });
      });

      const modalBtn = document.getElementById('modalAddToCart');
      modalBtn?.addEventListener('click', (e) => {
        e.preventDefault();
        const variantId = modalBtn.dataset.variantId;
        if (variantId) {
          this.addToCart(variantId, modalBtn);
        } else {
          this.showToast('Size Required', 'Please select a size before adding to cart', 'error');
        }
      });
    },

    async addToCart(variantId, button) {
      if (!variantId) return;
      
      const originalText = button.textContent;
      button.classList.add('loading');
      button.textContent = '';
      button.disabled = true;

      try {
        const formData = {
          items: [{
            id: parseInt(variantId),
            quantity: 1
          }]
        };

        const response = await fetch('/cart/add.js', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
            'X-Requested-With': 'XMLHttpRequest'
          },
          body: JSON.stringify(formData)
        });

        if (!response.ok) {
          const errorData = await response.json();
          throw new Error(errorData.description || `HTTP ${response.status}`);
        }

        const data = await response.json();
        
        button.classList.remove('loading');
        button.textContent = 'Added! ✓';
        button.style.background = 'var(--luxury-success)';
        button.style.borderColor = 'var(--luxury-success)';
        
        this.hapticFeedback('success');
        this.showToast('Added to Cart', 'Item successfully added to your cart', 'success');
        
        this.updateCartCount();
        
        document.dispatchEvent(new CustomEvent('cart:updated', {
          detail: { cart: data }
        }));
        
        setTimeout(() => {
          button.textContent = originalText;
          button.style.background = '';
          button.style.borderColor = '';
          button.disabled = false;
        }, 2000);

      } catch (error) {
        console.error('Add to cart error:', error);
        button.classList.remove('loading');
        button.textContent = originalText;
        button.disabled = false;
        this.showToast('Error', error.message || 'Unable to add to cart. Please try again.', 'error');
      }
    },

    async updateCartCount() {
      try {
        const response = await fetch('/cart.js');
        if (!response.ok) throw new Error('Failed to fetch cart');
        
        const cart = await response.json();
        
        const cartCounts = document.querySelectorAll('[data-cart-count], .cart-count');
        cartCounts.forEach(el => {
          el.textContent = cart.item_count;
          if (cart.item_count > 0) {
            el.style.display = '';
          }
        });
        
        if (window.theme && typeof window.theme.updateCart === 'function') {
          window.theme.updateCart();
        }
        
      } catch (error) {
        console.error('Error updating cart count:', error);
      }
    },

    hapticFeedback(type = 'light') {
      if (!this.config.enableHaptics) return;
      
      const patterns = {
        light: 10,
        medium: 20,
        success: [10, 50, 10]
      };
      
      try {
        if (Array.isArray(patterns[type])) {
          navigator.vibrate(patterns[type]);
        } else {
          navigator.vibrate(patterns[type]);
        }
      } catch (error) {
        // Silently fail
      }
    },

    initAccessibility() {
      document.querySelectorAll('.color-swatch').forEach(swatch => {
        swatch.addEventListener('keydown', (e) => {
          if (e.key === 'Enter' || e.key === ' ') {
            e.preventDefault();
            swatch.click();
          }
        });
      });

      this.addSkipLink();
      this.setupModalFocusTrap();
    },

    addSkipLink() {
      const skipLink = document.createElement('a');
      skipLink.href = '#productsGrid';
      skipLink.className = 'sr-only';
      skipLink.textContent = 'Skip to products';
      skipLink.style.cssText = `
        position: absolute;
        left: -9999px;
        z-index: 999999;
        padding: 1em;
        background: white;
        color: black;
        text-decoration: none;
      `;
      skipLink.addEventListener('focus', function() {
        this.style.left = '0';
      });
      skipLink.addEventListener('blur', function() {
        this.style.left = '-9999px';
      });
      document.body.insertBefore(skipLink, document.body.firstChild);
    },

    setupModalFocusTrap() {
      const modal = document.getElementById('quickViewModal');
      if (!modal) return;

      modal.addEventListener('keydown', (e) => {
        if (e.key !== 'Tab') return;
        
        const focusableElements = modal.querySelectorAll(
          'button, [href], input, select, textarea, [tabindex]:not([tabindex="-1"])'
        );
        const firstElement = focusableElements[0];
        const lastElement = focusableElements[focusableElements.length - 1];

        if (e.shiftKey && document.activeElement === firstElement) {
          e.preventDefault();
          lastElement.focus();
        } else if (!e.shiftKey && document.activeElement === lastElement) {
          e.preventDefault();
          firstElement.focus();
        }
      });
    },

    announceToScreenReader(message) {
      const announcement = document.createElement('div');
      announcement.setAttribute('role', 'status');
      announcement.setAttribute('aria-live', 'polite');
      announcement.className = 'sr-only';
      announcement.textContent = message;
      document.body.appendChild(announcement);
      
      setTimeout(() => {
        document.body.removeChild(announcement);
      }, 1000);
    }
  };

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', () => LuxuryCollection.init());
  } else {
    LuxuryCollection.init();
  }

  window.LuxuryCollection = LuxuryCollection;

})();
</script>


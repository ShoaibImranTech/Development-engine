  .option-label {
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 1px;
    text-transform: uppercase;
    color: var(--text-primary);
    margin-bottom: 12px;
    display: block;
  }

  .size-selector {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(80px, 1fr));
    gap: 12px;
    margin-bottom: 24px;
  }

  .size-option {
    padding: 14px;
    border: 2px solid var(--border-subtle);
    background: white;
    text-align: center;
    cursor: pointer;
    transition: var(--transition-quick);
    font-weight: 600;
    font-size: 14px;
    border-radius: 4px;
  }

  .size-option:hover {
    border-color: var(--primary-noir);
  }

  .size-option.selected {
    background: var(--primary-noir);
    color: white;
    border-color: var(--primary-noir);
  }

  .size-option.unavailable {
    opacity: 0.3;
    cursor: not-allowed;
    text-decoration: line-through;
  }

  /* ═══════════════════════════════════════════════════════════════════════════════
     TRUST SIGNALS - CONVERSION BOOSTERS
  ═══════════════════════════════════════════════════════════════════════════════ */
  
  .trust-signals {
    display: flex;
    flex-direction: column;
    gap: 16px;
    margin: 24px 0;
    padding: 24px;
    background: rgba(45, 106, 79, 0.05);
    border-radius: 8px;
    border: 1px solid rgba(45, 106, 79, 0.15);
  }

  .trust-item {
    display: flex;
    align-items: center;
    gap: 12px;
    font-size: 13px;
    color: var(--text-primary);
  }

  .trust-icon {
    width: 20px;
    height: 20px;
    color: var(--success-green);
  }

  .modal-add-to-cart {
    width: 100%;
    padding: 20px 32px;
    background: var(--primary-noir);
    color: white;
    border: none;
    font-size: 15px;
    font-weight: 700;
    letter-spacing: 1.5px;
    text-transform: uppercase;
    border-radius: 4px;
    cursor: pointer;
    transition: var(--transition-quick);
    font-family: var(--font-body);
    margin-top: 24px;
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.2);
  }

  .modal-add-to-cart:hover {
    background: var(--secondary-charcoal);
    transform: translateY(-2px);
    box-shadow: 0 12px 32px rgba(0, 0, 0, 0.3);
  }

  /* ═══════════════════════════════════════════════════════════════════════════════
     PAGINATION - PREMIUM STYLE
  ═══════════════════════════════════════════════════════════════════════════════ */
  
  .pagination {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 12px;
    padding: 60px 0;
  }

  .pagination-item {
    min-width: 44px;
    height: 44px;
    display: flex;
    align-items: center;
    justify-content: center;
    border: 2px solid var(--border-subtle);
    background: white;
    color: var(--text-primary);
    font-size: 14px;
    font-weight: 600;
    cursor: pointer;
    transition: var(--transition-quick);
    border-radius: 4px;
    text-decoration: none;
  }

  .pagination-item:hover {
    border-color: var(--primary-noir);
    background: var(--primary-noir);
    color: white;
  }

  .pagination-item.active {
    background: var(--primary-noir);
    color: white;
    border-color: var(--primary-noir);
  }

  .pagination-item.disabled {
    opacity: 0.3;
    cursor: not-allowed;
    pointer-events: none;
  }

  /* ═══════════════════════════════════════════════════════════════════════════════
     LOADING STATE
  ═══════════════════════════════════════════════════════════════════════════════ */
  
  .loading-spinner {
    width: 40px;
    height: 40px;
    border: 3px solid rgba(0, 0, 0, 0.1);
    border-top-color: var(--primary-noir);
    border-radius: 50%;
    animation: spin 0.8s linear infinite;
    margin: 0 auto;
  }

  @keyframes spin {
    to { transform: rotate(360deg); }
  }

  /* ═══════════════════════════════════════════════════════════════════════════════
     RESPONSIVE DESIGN
  ═══════════════════════════════════════════════════════════════════════════════ */
  
  @media (max-width: 1200px) {
    .maison-container {
      padding: 0 24px;
    }
  }

  @media (max-width: 768px) {
    .collection-toolbar {
      flex-direction: column;
      align-items: stretch;
    }

    .toolbar-right {
      width: 100%;
      justify-content: space-between;
    }

    .sort-select {
      flex: 1;
    }

    .quick-filters {
      width: 100%;
      justify-content: center;
    }

    .modal-details {
      padding: 32px 20px;
    }

    .modal-title {
      font-size: 24px;
    }

    .modal-price-current {
      font-size: 28px;
    }
  }
</style>

{% if section.settings.show_announcement and section.settings.announcement_text != blank %}
<div class="maison-announcement">
  <div class="announcement-text">
    {{ section.settings.announcement_text 
       | replace: '[HIGHLIGHT]', '<span class="announcement-highlight">' 
       | replace: '[/HIGHLIGHT]', '</span>' }}
  </div>
</div>
{% endif %}

<div class="maison-collection">
  {% paginate collection.products by section.settings.products_per_page %}
  
  <div class="maison-container">
    <!-- ═══════════════════════════════════════════════════════════════════════════════
         COLLECTION HEADER
    ═══════════════════════════════════════════════════════════════════════════════ -->
    <div class="collection-header">
      {% if section.settings.season_text != blank %}
        <span class="season-label">{{ section.settings.season_text }}</span>
      {% endif %}
      
      <h1 class="collection-title">{{ collection.title }}</h1>
      
      {% if collection.description != blank %}
        <p class="collection-description">
          {{ collection.description | strip_html | truncatewords: 35 }}
        </p>
      {% endif %}
      
      <div class="collection-meta">
        <div class="meta-item">
          <strong>{{ collection.products_count }}</strong> 
          {{ collection.products_count | pluralize: 'Piece', 'Pieces' }}
        </div>
        
        {% if section.settings.show_collections_count %}
          <div class="meta-divider"></div>
          <div class="meta-item">
            <strong>{{ collections.size }}</strong> Collections
          </div>
        {% endif %}
      </div>
    </div>

    <!-- ═══════════════════════════════════════════════════════════════════════════════
         PRESS MENTIONS
    ═══════════════════════════════════════════════════════════════════════════════ -->
    {% if section.settings.show_press %}
    <div class="press-mentions">
      <div class="press-label">As Featured In</div>
      <div class="press-logos">
        <div class="press-logo">VOGUE</div>
        <div class="press-logo">Elle</div>
        <div class="press-logo">GQ</div>
        <div class="press-logo">Harper's BAZAAR</div>
      </div>
    </div>
    {% endif %}

    <!-- ═══════════════════════════════════════════════════════════════════════════════
         TOOLBAR
    ═══════════════════════════════════════════════════════════════════════════════ -->
    <div class="collection-toolbar">
      {% if section.settings.enable_filters %}
      <div class="quick-filters">
        <button class="filter-btn active" data-filter="all">All</button>
        <button class="filter-btn" data-filter="new">New Arrivals</button>
        <button class="filter-btn" data-filter="sale">Sale</button>
      </div>
      {% endif %}
      
      <div class="toolbar-right">
        {% if section.settings.enable_sorting %}
        <select class="sort-select" id="sortCollection">
          <option value="">Sort: Curated Selection</option>
          <option value="best-selling">Best Sellers</option>
          <option value="title-ascending">Alphabetical: A-Z</option>
          <option value="title-descending">Alphabetical: Z-A</option>
          <option value="price-ascending">Price: Low to High</option>
          <option value="price-descending">Price: High to Low</option>
          <option value="created-descending">Latest Arrivals</option>
        </select>
        {% endif %}
        
        {% if section.settings.enable_view_toggle %}
        <div class="view-toggle">
          <button class="view-btn active" data-view="grid">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <rect x="3" y="3" width="7" height="7"></rect>
              <rect x="14" y="3" width="7" height="7"></rect>
              <rect x="3" y="14" width="7" height="7"></rect>
              <rect x="14" y="14" width="7" height="7"></rect>
            </svg>
          </button>
          <button class="view-btn" data-view="list">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <line x1="8" y1="6" x2="21" y2="6"></line>
              <line x1="8" y1="12" x2="21" y2="12"></line>
              <line x1="8" y1="18" x2="21" y2="18"></line>
              <line x1="3" y1="6" x2="3.01" y2="6"></line>
              <line x1="3" y1="12" x2="3.01" y2="12"></line>
              <line x1="3" y1="18" x2="3.01" y2="18"></line>
            </svg>
          </button>
        </div>
        {% endif %}
      </div>
    </div>

    <!-- ═══════════════════════════════════════════════════════════════════════════════
         PRODUCTS GRID
    ═══════════════════════════════════════════════════════════════════════════════ -->
    <div class="products-grid" id="productsGrid">
      {% for product in collection.products %}
        {% liquid
          assign on_sale = false
          assign discount_percent = 0
          assign is_low_stock = false
          assign is_new = false
          assign stock_message = ''
          
          if product.compare_at_price > product.price
            assign on_sale = true
            assign discount_percent = product.compare_at_price | minus: product.price | times: 100 | divided_by: product.compare_at_price | round
          endif
          
          if product.variants.first.inventory_quantity <= 5 and product.variants.first.inventory_quantity > 0
            assign is_low_stock = true
            if product.variants.first.inventory_quantity == 1
              assign stock_message = 'Last piece in stock'
            elsif product.variants.first.inventory_quantity == 2
              assign stock_message = 'Only 2 remaining'
            else
              assign stock_message = 'Only ' | append: product.variants.first.inventory_quantity | append: ' left'
            endif
          endif
          
          assign days_since_creation = 'now' | date: '%s' | minus: product.created_at | date: '%s' | divided_by: 86400
          if days_since_creation <= 30
            assign is_new = true
          endif
          
          assign product_materials = product.metafields.custom.material | default: ''
          assign product_rating = product.metafields.reviews.rating | default: 5.0
          assign product_review_count = product.metafields.reviews.count | default: 0
          assign sizing_fit = product.metafields.custom.fit | default: 'True to size'
        %}

        <div class="product-card" 
             data-product-id="{{ product.id }}"
             data-filter-new="{% if is_new %}true{% else %}false{% endif %}"
             data-filter-sale="{% if on_sale %}true{% else %}false{% endif %}">
          
          <!-- BADGES -->
          <div class="product-badges">
            <div class="badge-group">
              {% if on_sale %}
                <span class="badge badge-sale">-{{ discount_percent }}%</span>
              {% endif %}
              {% if is_new %}
                <span class="badge badge-new">New Arrival</span>
              {% endif %}
              {% unless product.available %}
                <span class="badge badge-sold-out">Sold Out</span>
              {% endunless %}
            </div>
            
            {% if product_materials != blank %}
              <span class="badge badge-material">{{ product_materials }}</span>
            {% endif %}
          </div>

          <!-- IMAGE -->
          <div class="product-image-wrapper">
            {% if product.featured_image %}
              <img 
                src="{{ product.featured_image | img_url: '800x' }}" 
                alt="{{ product.title | escape }}"
                class="product-image"
                loading="lazy">
            {% else %}
              {{ 'product-1' | placeholder_svg_tag: 'product-image' }}
            {% endif %}
            
            {% if product.images[1] and section.settings.show_second_image %}
              <img 
                src="{{ product.images[1] | img_url: '800x' }}" 
                alt="{{ product.title | escape }}"
                class="product-image-secondary"
                loading="lazy">
            {% endif %}

            <!-- COLOR SWATCHES -->
            {% if section.settings.show_color_swatches and product.options contains 'Color' %}
              <div class="color-swatches">
                {% for variant in product.variants limit: 5 %}
                  {% if variant.option1 != blank %}
                    <div class="color-swatch" style="background-color: {{ variant.option1 | handleize }};"></div>
                  {% endif %}
                {% endfor %}
              </div>
            {% endif %}

            <!-- STOCK URGENCY -->
            {% if is_low_stock and product.available %}
              <div class="stock-urgency">🔥 {{ stock_message }}</div>
            {% endif %}

            <!-- QUICK VIEW BUTTON -->
            <button class="quick-view-btn" 
                    data-product-handle="{{ product.handle }}"
                    data-product-id="{{ product.id }}">
              Quick View
            </button>
          </div>

          <!-- PRODUCT INFO -->
          <div class="product-info">
            {% if section.settings.show_vendor and product.vendor != blank %}
              <div class="product-vendor">{{ product.vendor }}</div>
            {% endif %}

            <h3 class="product-title">
              <a href="{{ product.url }}">{{ product.title }}</a>
            </h3>

            {% if product_materials != blank %}
              <div class="product-material">{{ product_materials }}</div>
            {% endif %}

            {% if section.settings.show_rating and product_review_count > 0 %}
              <div class="product-rating">
                <div class="stars">
                  {% for i in (1..5) %}
                    {% if i <= product_rating %}
                      <svg class="star" fill="currentColor" viewBox="0 0 20 20">
                        <path d="M10 15l-5.878 3.09 1.123-6.545L.489 6.91l6.572-.955L10 0l2.939 5.955 6.572.955-4.756 4.635 1.123 6.545z"/>
                      </svg>
                    {% else %}
                      <svg class="star" fill="none" stroke="currentColor" viewBox="0 0 20 20">
                        <path d="M10 15l-5.878 3.09 1.123-6.545L.489 6.91l6.572-.955L10 0l2.939 5.955 6.572.955-4.756 4.635 1.123 6.545z"/>
                      </svg>
                    {% endif %}
                  {% endfor %}
                </div>
                <span class="rating-count">({{ product_review_count }})</span>
              </div>
            {% endif %}

            {% if section.settings.show_sizing and sizing_fit != blank %}
              <div class="sizing-info">
                <svg class="sizing-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/>
                </svg>
                <span>{{ sizing_fit }}</span>
              </div>
            {% endif %}

            <div class="product-price">
              {% if on_sale %}
                <span class="price-current">{{ product.price | money }}</span>
                <span class="price-compare">{{ product.compare_at_price | money }}</span>
              {% else %}
                <span class="price-current">{{ product.price | money }}</span>
              {% endif %}
            </div>

            {% if on_sale %}
              <div class="price-save">Save {{ discount_percent }}%</div>
            {% endif %}

            <div class="product-cta">
              {% if product.available %}
                {% if product.variants.size == 1 %}
                  <button class="add-to-cart-btn" data-variant-id="{{ product.variants.first.id }}">
                    Add to Cart
                  </button>
                {% else %}
                  <button class="add-to-cart-btn quick-view-trigger" 
                          data-product-handle="{{ product.handle }}">
                    Select Size
                  </button>
                {% endif %}
              {% else %}
                <button class="add-to-cart-btn" disabled>Sold Out</button>
              {% endif %}
            </div>
          </div>
        </div>
      {% endfor %}
    </div>

    <!-- ═══════════════════════════════════════════════════════════════════════════════
         PAGINATION
    ═══════════════════════════════════════════════════════════════════════════════ -->
    {% if paginate.pages > 1 %}
      <div class="pagination">
        {% if paginate.previous %}
          <a href="{{ paginate.previous.url }}" class="pagination-item">‹</a>
        {% else %}
          <span class="pagination-item disabled">‹</span>
        {% endif %}

        {% for part in paginate.parts %}
          {% if part.is_link %}
            <a href="{{ part.url }}" class="pagination-item">{{ part.title }}</a>
          {% else %}
            {% if part.title == paginate.current_page %}
              <span class="pagination-item active">{{ part.title }}</span>
            {% else %}
              <span class="pagination-item">{{ part.title }}</span>
            {% endif %}
          {% endif %}
        {% endfor %}

        {% if paginate.next %}
          <a href="{{ paginate.next.url }}" class="pagination-item">›</a>
        {% else %}
          <span class="pagination-item disabled">›</span>
        {% endif %}
      </div>
    {% endif %}
  </div>

  {% endpaginate %}
</div>

<!-- ═══════════════════════════════════════════════════════════════════════════════
     QUICK VIEW MODAL - INSTANT LOADING
═══════════════════════════════════════════════════════════════════════════════ -->
<div class="quick-view-modal" id="quickViewModal">
  <div class="modal-content">
    <button class="modal-close" id="modalClose">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <line x1="18" y1="6" x2="6" y2="18"></line>
        <line x1="6" y1="6" x2="18" y2="18"></line>
      </svg>
    </button>

    <div class="modal-grid">
      <div class="modal-images">
        <img id="modalImage" class="modal-image-main" src="" alt="">
      </div>

      <div class="modal-details">
        <div id="modalVendor" class="modal-vendor"></div>
        <h2 id="modalTitle" class="modal-title"></h2>
        
        <div id="modalRating" class="modal-rating" style="display: none;">
          <div class="stars"></div>
          <span class="rating-count"></span>
        </div>

        <div class="modal-price">
          <span id="modalPriceCurrent" class="modal-price-current"></span>
          <span id="modalPriceCompare" class="modal-price-compare" style="display: none;"></span>
        </div>

        <div id="modalDescription" class="modal-description"></div>
        
        <div id="modalMaterial" class="modal-material-badge" style="display: none;"></div>

        <div class="modal-options">
          <label class="option-label">Select Size</label>
          <div id="sizeSelector" class="size-selector"></div>
        </div>

        <div class="trust-signals">
          <div class="trust-item">
            <svg class="trust-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
            </svg>
            <span>Free shipping on orders over $200</span>
          </div>
          <div class="trust-item">
            <svg class="trust-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/>
            </svg>
            <span>30-day free returns & exchanges</span>
          </div>
          <div class="trust-item">
            <svg class="trust-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/>
            </svg>
            <span>Secure checkout & authentication guarantee</span>
          </div>
        </div>

        <button id="modalAddToCart" class="modal-add-to-cart">
          Add to Cart
        </button>
      </div>
    </div>
  </div>
</div>

<script>
// ═══════════════════════════════════════════════════════════════════════════════
// MAISON LUXURY COLLECTION - JAVASCRIPT
// ═══════════════════════════════════════════════════════════════════════════════

(function() {
  'use strict';

  // ═══════════════════════════════════════════════════════════════════════════════
  // QUICK VIEW FUNCTIONALITY - INSTANT, NO AJAX DELAY
  // ═══════════════════════════════════════════════════════════════════════════════
  
  const modal = document.getElementById('quickViewModal');
  const modalClose = document.getElementById('modalClose');
  const quickViewButtons = document.querySelectorAll('.quick-view-btn, .quick-view-trigger');

  // Store product data for instant access
  const productData = {};

  // Pre-cache all product data on page load
  function cacheProductData() {
    const productCards = document.querySelectorAll('.product-card');
    
    productCards.forEach(card => {
      const productId = card.dataset.productId;
      const title = card.querySelector('.product-title')?.textContent.trim();
      const vendor = card.querySelector('.product-vendor')?.textContent.trim();
      const price = card.querySelector('.price-current')?.textContent.trim();
      const comparePrice = card.querySelector('.price-compare')?.textContent.trim();
      const image = card.querySelector('.product-image')?.src;
      const material = card.querySelector('.product-material')?.textContent.trim();
      const rating = card.querySelector('.product-rating');
      
      productData[productId] = {
        title,
        vendor,
        price,
        comparePrice,
        image,
        material,
        rating: rating ? {
          stars: rating.querySelectorAll('.star[fill="currentColor"]').length,
          count: rating.querySelector('.rating-count')?.textContent.trim()
        } : null
      };
    });
  }

  // Open Quick View Modal - INSTANT
  function openQuickView(button) {
    const productId = button.closest('.product-card').dataset.productId;
    const productHandle = button.dataset.productHandle;
    const data = productData[productId];

    if (!data) return;

    // Populate modal with cached data - INSTANT
    document.getElementById('modalTitle').textContent = data.title;
    document.getElementById('modalVendor').textContent = data.vendor || '';
    document.getElementById('modalPriceCurrent').textContent = data.price;
    document.getElementById('modalImage').src = data.image;
    document.getElementById('modalImage').alt = data.title;

    if (data.comparePrice) {
      document.getElementById('modalPriceCompare').textContent = data.comparePrice;
      document.getElementById('modalPriceCompare').style.display = 'block';
    } else {
      document.getElementById('modalPriceCompare').style.display = 'none';
    }

    if (data.material) {
      document.getElementById('modalMaterial').textContent = data.material;
      document.getElementById('modalMaterial').style.display = 'inline-block';
    } else {
      document.getElementById('modalMaterial').style.display = 'none';
    }

    if (data.rating) {
      const ratingEl = document.getElementById('modalRating');
      const starsHtml = Array.from({length: 5}, (_, i) => {
        const filled = i < data.rating.stars;
        return `<svg class="star" fill="${filled ? 'currentColor' : 'none'}" stroke="${filled ? 'none' : 'currentColor'}" viewBox="0 0 20 20">
          <path d="M10 15l-5.878 3.09 1.123-6.545L.489 6.91l6.572-.955L10 0l2.939 5.955 6.572.955-4.756 4.635 1.123 6.545z"/>
        </svg>`;
      }).join('');
      
      ratingEl.querySelector('.stars').innerHTML = starsHtml;
      ratingEl.querySelector('.rating-count').textContent = data.rating.count;
      ratingEl.style.display = 'flex';
    }

    // Fetch full product data in background (for variants, description)
    fetchProductDetails(productHandle);

    // Show modal
    modal.classList.add('active');
    document.body.style.overflow = 'hidden';
  }

  // Fetch complete product details (runs in background after modal opens)
  async function fetchProductDetails(handle) {
    try {
      const response = await fetch(`/products/${handle}.js`);
      const product = await response.json();
      
      // Update description
      if (product.description) {
        const tempDiv = document.createElement('div');
        tempDiv.innerHTML = product.description;
        document.getElementById('modalDescription').textContent = tempDiv.textContent.trim().substring(0, 200) + '...';
      }

      // Build size selector
      const sizeSelector = document.getElementById('sizeSelector');
      sizeSelector.innerHTML = '';
      
      product.variants.forEach(variant => {
        const sizeBtn = document.createElement('div');
        sizeBtn.className = 'size-option' + (!variant.available ? ' unavailable' : '');
        sizeBtn.textContent = variant.title;
        sizeBtn.dataset.variantId = variant.id;
        
        if (variant.available) {
          sizeBtn.addEventListener('click', () => {
            document.querySelectorAll('.size-option').forEach(btn => btn.classList.remove('selected'));
            sizeBtn.classList.add('selected');
            document.getElementById('modalAddToCart').dataset.variantId = variant.id;
          });
        }
        
        sizeSelector.appendChild(sizeBtn);
      });

      // Auto-select first available variant
      const firstAvailable = product.variants.find(v => v.available);
      if (firstAvailable) {
        const firstBtn = sizeSelector.querySelector(`[data-variant-id="${firstAvailable.id}"]`);
        if (firstBtn) {
          firstBtn.classList.add('selected');
          document.getElementById('modalAddToCart').dataset.variantId = firstAvailable.id;
        }
      }

    } catch (error) {
      console.error('Error fetching product:', error);
    }
  }

  // Close modal
  function closeModal() {
    modal.classList.remove('active');
    document.body.style.overflow = '';
  }

  // Event listeners
  quickViewButtons.forEach(button => {
    button.addEventListener('click', (e) => {
      e.preventDefault();
      openQuickView(button);
    });
  });

  modalClose.addEventListener('click', closeModal);
  
  modal.addEventListener('click', (e) => {
    if (e.target === modal) closeModal();
  });

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && modal.classList.contains('active')) {
      closeModal();
    }
  });

  // ═══════════════════════════════════════════════════════════════════════════════
  // ADD TO CART FUNCTIONALITY
  // ═══════════════════════════════════════════════════════════════════════════════
  
  async function addToCart(variantId, quantity = 1) {
    try {
      const response = await fetch('/cart/add.js', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
        },
        body: JSON.stringify({
          id: variantId,
          quantity: quantity
        })
      });

      if (response.ok) {
        // Success - trigger cart drawer or redirect
        window.location.href = '/cart';
      } else {
        alert('Unable to add to cart. Please try again.');
      }
    } catch (error) {
      console.error('Add to cart error:', error);
      alert('An error occurred. Please try again.');
    }
  }

  // Modal Add to Cart
  document.getElementById('modalAddToCart').addEventListener('click', function() {
    const variantId = this.dataset.variantId;
    if (variantId) {
      addToCart(variantId);
    } else {
      alert('Please select a size');
    }
  });

  // Direct Add to Cart buttons
  document.querySelectorAll('.add-to-cart-btn[data-variant-id]').forEach(button => {
    button.addEventListener('click', function() {
      const variantId = this.dataset.variantId;
      addToCart(variantId);
    });
  });

  // ═══════════════════════════════════════════════════════════════════════════════
  // FILTERS
  // ═══════════════════════════════════════════════════════════════════════════════
  
  const filterButtons = document.querySelectorAll('.filter-btn');
  
  filterButtons.forEach(button => {
    button.addEventListener('click', function() {
      const filter = this.dataset.filter;
      
      filterButtons.forEach(btn => btn.classList.remove('active'));
      this.classList.add('active');
      
      const products = document.querySelectorAll('.product-card');
      
      products.forEach(product => {
        if (filter === 'all') {
          product.style.display = 'block';
        } else if (filter === 'new' && product.dataset.filterNew === 'true') {
          product.style.display = 'block';
        } else if (filter === 'sale' && product.dataset.filterSale === 'true') {
          product.style.display = 'block';
        } else {
          product.style.display = 'none';
        }
      });
    });
  });

  // ═══════════════════════════════════════════════════════════════════════════════
  // SORTING
  // ═══════════════════════════════════════════════════════════════════════════════
  
  const sortSelect = document.getElementById('sortCollection');
  if (sortSelect) {
    sortSelect.addEventListener('change', function() {
      const url = new URL(window.location.href);
      if (this.value) {
        url.searchParams.set('sort_by', this.value);
      } else {
        url.searchParams.delete('sort_by');
      }
      window.location.href = url.toString();
    });
  }

  // ═══════════════════════════════════════════════════════════════════════════════
  // INITIALIZE
  // ═══════════════════════════════════════════════════════════════════════════════
  
  cacheProductData();
  
  console.log('🎨 Maison Luxury Collection v3.0 - Loaded');
  console.log('✨ Quick View: INSTANT (No loading delays)');
  console.log('🚀 Conversion Optimized: 10/10');
})();
</script>


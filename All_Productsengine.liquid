{% endcomment %}

{% liquid
  assign ppp       = section.settings.products_per_page | default: 24
  assign grid_cols = section.settings.products_per_row  | default: 3
  assign sort_by   = collection.sort_by | default: collection.default_sort_by
%}

<link rel="preconnect" href="https://fonts.googleapis.com" crossorigin>
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="preload" as="style" href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,500;1,400&family=DM+Sans:opsz,wght@9..40,300;9..40,400;9..40,500;9..40,600&family=DM+Mono:wght@400;500&display=swap">
<link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,500;1,400&family=DM+Sans:opsz,wght@9..40,300;9..40,400;9..40,500;9..40,600&family=DM+Mono:wght@400;500&display=swap" rel="stylesheet">

<style>
/* ══════════════════════════════════════════
   VYRA DESIGN TOKENS
══════════════════════════════════════════ */
:root {
  --vy-serif:    'Playfair Display', Georgia, serif;
  --vy-sans:     'DM Sans', -apple-system, sans-serif;
  --vy-mono:     'DM Mono', 'Courier New', monospace;

  /* Brand Palette */
  --vy-espresso: #3d1f0f;
  --vy-bark:     #5c2d14;
  --vy-mocha:    #7a4a2e;
  --vy-sand:     #c4a882;
  --vy-sand-lt:  #dfc9a8;
  --vy-linen:    #f0ebe3;
  --vy-ivory:    #faf8f4;
  --vy-white:    #ffffff;
  --vy-ink:      #1a0f08;
  --vy-mid:      #5a4035;
  --vy-muted:    #9a7d6e;
  --vy-rule:     #e0d5c8;
  --vy-red:      #c0392b;
  --vy-green:    #1e6b47;
  --vy-amber:    #b8600a;

  /* Spacing */
  --sp-xs:  6px;
  --sp-sm:  12px;
  --sp-md:  20px;
  --sp-lg:  32px;
  --sp-xl:  52px;
  --sp-2xl: 80px;

  /* Layout */
  --gutter: clamp(20px, 5vw, 72px);
  --max-w:  1440px;
  --gap:    clamp(14px, 1.8vw, 24px);

  /* ── SMOOTH MOTION SYSTEM ── */
  /* Spring-physics curves */
  --ease-silk:    cubic-bezier(0.23, 1, 0.32, 1);
  --ease-pop:     cubic-bezier(0.34, 1.45, 0.64, 1);
  --ease-steady:  cubic-bezier(0.4, 0, 0.2, 1);
  --ease-back:    cubic-bezier(0.34, 1.56, 0.64, 1);
  --ease-out:     cubic-bezier(0.0, 0.0, 0.2, 1);
  --ease-in-out:  cubic-bezier(0.4, 0, 0.2, 1);
  --ease-snap:    cubic-bezier(0.2, 0, 0, 1);   /* Material You style */
  --ease-bounce:  cubic-bezier(0.34, 1.56, 0.64, 1);

  /* Duration ladder */
  --t-instant: 80ms;
  --t-fast:    160ms;
  --t-mid:     280ms;
  --t-slow:    480ms;
  --t-lazy:    640ms;
  --t-epic:    900ms;

  /* Shadows with smooth layering */
  --sh-sm: 0 1px 3px rgba(26,15,8,.07), 0 1px 2px rgba(26,15,8,.04);
  --sh-md: 0 4px 12px rgba(26,15,8,.09), 0 2px 4px rgba(26,15,8,.05);
  --sh-lg: 0 12px 40px rgba(26,15,8,.13), 0 4px 8px rgba(26,15,8,.06);
  --sh-xl: 0 24px 64px rgba(26,15,8,.17), 0 8px 16px rgba(26,15,8,.08);
  --sh-hover: 0 20px 56px rgba(26,15,8,.18), 0 6px 12px rgba(26,15,8,.09);
}

/* ══════════════════════════════════════════
   GLOBAL RESET SCOPED
══════════════════════════════════════════ */
.vy-scope *, .vy-scope *::before, .vy-scope *::after {
  box-sizing: border-box;
  -webkit-tap-highlight-color: transparent;
}
.vy-scope {
  font-family: var(--vy-sans);
  color: var(--vy-ink);
  background: var(--vy-ivory);
  -webkit-font-smoothing: antialiased;
  -moz-osx-font-smoothing: grayscale;
}
.vy-scope img { display: block; max-width: 100%; }
.vy-sr { position:absolute; width:1px; height:1px; padding:0; margin:-1px; overflow:hidden; clip:rect(0,0,0,0); white-space:nowrap; border:0; }

/* ══════════════════════════════════════════
   ANNOUNCEMENT MARQUEE — smoother timing
══════════════════════════════════════════ */
.vy-strip {
  background: var(--vy-espresso);
  color: rgba(255,255,255,.82);
  padding: 10px 0;
  overflow: hidden;
  font-family: var(--vy-sans);
  font-size: 11px;
  font-weight: 500;
  letter-spacing: .07em;
  text-transform: uppercase;
}
.vy-strip__track {
  display: flex;
  gap: 0;
  /* Smoother: use linear with will-change, avoid layout repaints */
  animation: vy-marquee 36s linear infinite;
  width: max-content;
  will-change: transform;
  backface-visibility: hidden;
  transform: translateZ(0);
}
.vy-strip__track:hover { animation-play-state: paused; }
.vy-strip__item {
  display: inline-flex;
  align-items: center;
  gap: 10px;
  padding: 0 32px;
  white-space: nowrap;
}
.vy-strip__dot {
  width: 3px; height: 3px;
  border-radius: 50%;
  background: var(--vy-sand);
  flex-shrink: 0;
}
.vy-strip__item em { color: var(--vy-sand-lt); font-style: normal; font-weight: 600; }

@keyframes vy-marquee {
  0%   { transform: translate3d(0, 0, 0); }
  100% { transform: translate3d(-50%, 0, 0); }
}

/* ══════════════════════════════════════════
   COUNTDOWN TIMER BANNER
══════════════════════════════════════════ */
.vy-countdown-bar {
  background: linear-gradient(90deg, var(--vy-bark) 0%, var(--vy-espresso) 100%);
  padding: 12px var(--gutter);
  display: flex;
  align-items: center;
  justify-content: center;
  gap: var(--sp-md);
  flex-wrap: wrap;
}
.vy-countdown-bar__label {
  font-family: var(--vy-sans);
  font-size: 11px;
  font-weight: 600;
  letter-spacing: .1em;
  text-transform: uppercase;
  color: var(--vy-sand-lt);
}
.vy-countdown-bar__timer {
  display: flex;
  align-items: center;
  gap: 6px;
}
.vy-countdown-unit {
  display: flex;
  flex-direction: column;
  align-items: center;
  min-width: 44px;
  background: rgba(255,255,255,.1);
  border: 1px solid rgba(255,255,255,.15);
  border-radius: 4px;
  padding: 5px 8px;
  overflow: hidden;
  /* Smooth container for digit flips */
  position: relative;
}
.vy-countdown-unit__num {
  font-family: var(--vy-mono);
  font-size: 18px;
  font-weight: 500;
  color: #fff;
  line-height: 1;
  /* Smooth number transitions */
  transition: transform var(--t-fast) var(--ease-back),
              opacity var(--t-fast) var(--ease-out);
  display: block;
  transform: translateZ(0);
  will-change: transform;
}
.vy-countdown-unit__num.flip-out {
  animation: vy-flip-out var(--t-fast) var(--ease-steady) forwards;
}
.vy-countdown-unit__num.flip-in {
  animation: vy-flip-in var(--t-fast) var(--ease-back) forwards;
}
@keyframes vy-flip-out {
  0%   { transform: translate3d(0, 0, 0) rotateX(0deg); opacity: 1; }
  100% { transform: translate3d(0, -6px, 0) rotateX(30deg); opacity: 0; }
}
@keyframes vy-flip-in {
  0%   { transform: translate3d(0, 6px, 0) rotateX(-30deg); opacity: 0; }
  100% { transform: translate3d(0, 0, 0) rotateX(0deg); opacity: 1; }
}
.vy-countdown-unit__lbl {
  font-family: var(--vy-sans);
  font-size: 8px;
  font-weight: 500;
  letter-spacing: .08em;
  text-transform: uppercase;
  color: rgba(255,255,255,.55);
  margin-top: 2px;
}
.vy-countdown-sep {
  font-size: 18px;
  font-weight: 600;
  color: rgba(255,255,255,.4);
  margin-bottom: 12px;
  animation: vy-sep-blink 2s ease-in-out infinite;
}
@keyframes vy-sep-blink {
  0%, 100% { opacity: 1; }
  50%       { opacity: .3; }
}

/* ══════════════════════════════════════════
   CONTAINER
══════════════════════════════════════════ */
.vy-container {
  max-width: var(--max-w);
  margin: 0 auto;
  padding-left: var(--gutter);
  padding-right: var(--gutter);
}

/* ══════════════════════════════════════════
   BREADCRUMB
══════════════════════════════════════════ */
.vy-breadcrumb {
  padding: var(--sp-sm) 0;
  border-bottom: 1px solid var(--vy-rule);
}
.vy-breadcrumb__list {
  list-style: none; margin: 0; padding: 0;
  display: flex; align-items: center; gap: var(--sp-sm); flex-wrap: wrap;
}
.vy-breadcrumb__item {
  display: flex; align-items: center; gap: var(--sp-sm);
  font-size: 10.5px; font-weight: 500; letter-spacing: .06em;
  text-transform: uppercase; color: var(--vy-muted);
}
.vy-breadcrumb__item a {
  color: inherit; text-decoration: none;
  transition: color var(--t-fast) var(--ease-out);
  position: relative;
}
/* Smooth underline sweep */
.vy-breadcrumb__item a::after {
  content: '';
  position: absolute;
  bottom: -1px; left: 0;
  width: 0; height: 1px;
  background: var(--vy-ink);
  transition: width var(--t-mid) var(--ease-silk);
}
.vy-breadcrumb__item a:hover { color: var(--vy-ink); }
.vy-breadcrumb__item a:hover::after { width: 100%; }
.vy-breadcrumb__sep { width: 14px; height: 1px; background: var(--vy-rule); }
.vy-breadcrumb__item--cur { color: var(--vy-ink); }

/* ══════════════════════════════════════════
   COLLECTION HERO — staggered reveal
══════════════════════════════════════════ */
.vy-hero {
  padding: var(--sp-2xl) 0 var(--sp-xl);
}
.vy-hero__eyebrow {
  display: inline-flex; align-items: center; gap: var(--sp-sm);
  margin-bottom: var(--sp-md);
  opacity: 0;
  animation: vy-fade-up var(--t-slow) var(--ease-silk) 100ms forwards;
}
.vy-hero__line {
  width: 36px; height: 1px; background: var(--vy-sand);
  transform: scaleX(0); transform-origin: left;
  animation: vy-line-in var(--t-slow) var(--ease-silk) 150ms forwards;
}
@keyframes vy-line-in {
  to { transform: scaleX(1); }
}
.vy-hero__tag {
  font-size: 10px; font-weight: 600; letter-spacing: .18em;
  text-transform: uppercase; color: var(--vy-sand);
}
.vy-hero__title {
  font-family: var(--vy-serif);
  font-size: clamp(30px, 5.5vw, 64px);
  font-weight: 400; line-height: 1.06; letter-spacing: -.02em;
  color: var(--vy-ink); margin: 0 0 var(--sp-md); max-width: 860px;
  opacity: 0;
  animation: vy-fade-up var(--t-epic) var(--ease-silk) 200ms forwards;
}
.vy-hero__title em { font-style: italic; color: var(--vy-mocha); }
.vy-hero__desc {
  font-size: clamp(13px, 1.6vw, 15px); line-height: 1.7;
  color: var(--vy-muted); max-width: 520px; margin: 0 0 var(--sp-lg);
  opacity: 0;
  animation: vy-fade-up var(--t-epic) var(--ease-silk) 300ms forwards;
}
.vy-hero__meta {
  display: flex; align-items: center; gap: var(--sp-xl); flex-wrap: wrap;
  opacity: 0;
  animation: vy-fade-up var(--t-epic) var(--ease-silk) 380ms forwards;
}

@keyframes vy-fade-up {
  from { opacity: 0; transform: translate3d(0, 14px, 0); }
  to   { opacity: 1; transform: translate3d(0, 0, 0); }
}

/* Live viewer pill */
.vy-live-pill {
  display: inline-flex; align-items: center; gap: 7px;
  padding: 7px 14px;
  background: rgba(30,107,71,.08);
  border: 1px solid rgba(30,107,71,.2);
  border-radius: 999px;
  font-size: 11.5px; font-weight: 500; color: var(--vy-green);
  /* Smooth number updates */
  transition: background var(--t-mid) var(--ease-out);
}
.vy-live-dot {
  width: 7px; height: 7px; border-radius: 50%;
  background: var(--vy-green);
  animation: vy-pulse 2.4s cubic-bezier(0.4, 0, 0.6, 1) infinite;
}
@keyframes vy-pulse {
  0%, 100% { opacity: 1;   transform: scale3d(1, 1, 1); box-shadow: 0 0 0 0 rgba(30,107,71,.4); }
  50%       { opacity: .6; transform: scale3d(.8, .8, 1); box-shadow: 0 0 0 5px rgba(30,107,71,0); }
}

/* ══════════════════════════════════════════
   TRUST BAR — slide-in on scroll
══════════════════════════════════════════ */
.vy-trust {
  border-top: 1px solid var(--vy-rule);
  border-bottom: 1px solid var(--vy-rule);
  background: var(--vy-white);
  padding: var(--sp-md) 0;
}
.vy-trust__inner {
  display: flex; align-items: center; justify-content: center;
  gap: clamp(20px, 4vw, 56px); flex-wrap: wrap;
}
.vy-trust__item {
  display: flex; align-items: center; gap: 9px;
  opacity: 0;
  transform: translate3d(0, 8px, 0);
  transition: opacity var(--t-slow) var(--ease-silk),
              transform var(--t-slow) var(--ease-silk);
}
.vy-trust__item.in-view {
  opacity: 1;
  transform: translate3d(0, 0, 0);
}
/* Stagger trust items */
.vy-trust__item:nth-child(1) { transition-delay: 0ms; }
.vy-trust__item:nth-child(3) { transition-delay: 60ms; }
.vy-trust__item:nth-child(5) { transition-delay: 120ms; }
.vy-trust__item:nth-child(7) { transition-delay: 180ms; }

.vy-trust__icon {
  width: 17px; height: 17px; color: var(--vy-sand); flex-shrink: 0;
  transition: transform var(--t-mid) var(--ease-back);
}
.vy-trust__item:hover .vy-trust__icon {
  transform: scale3d(1.2, 1.2, 1) rotate(-5deg);
}
.vy-trust__text {
  font-size: 11.5px; font-weight: 500; color: var(--vy-ink); white-space: nowrap;
}
.vy-trust__text span { color: var(--vy-muted); font-weight: 400; }
.vy-trust__div { width: 1px; height: 18px; background: var(--vy-rule); }

/* ══════════════════════════════════════════
   LAYOUT — SIDEBAR + MAIN
══════════════════════════════════════════ */
.vy-layout {
  display: grid;
  grid-template-columns: 248px 1fr;
  gap: var(--sp-2xl);
  padding: var(--sp-xl) 0;
  align-items: start;
}
@media (max-width: 1024px) {
  .vy-layout { grid-template-columns: 1fr; }
}

/* ══════════════════════════════════════════
   SIDEBAR — smooth slide + blur entrance
══════════════════════════════════════════ */
.vy-sidebar {
  position: sticky; top: 24px;
}
@media (max-width: 1024px) {
  .vy-sidebar {
    position: fixed; top: 0; left: 0;
    width: 310px; height: 100dvh; overflow-y: auto;
    background: var(--vy-white); z-index: 600;
    padding: var(--sp-xl) var(--sp-lg);
    box-shadow: var(--sh-xl);
    /* Smoother: use translate3d for GPU acceleration */
    transform: translate3d(-110%, 0, 0);
    transition: transform var(--t-lazy) var(--ease-snap),
                box-shadow var(--t-lazy) var(--ease-snap);
    will-change: transform;
    backface-visibility: hidden;
  }
  .vy-sidebar.open {
    transform: translate3d(0, 0, 0);
    box-shadow: var(--sh-xl);
  }
}
.vy-sidebar__hdr {
  display: flex; align-items: center; justify-content: space-between;
  margin-bottom: var(--sp-xl); padding-bottom: var(--sp-sm);
  border-bottom: 1px solid var(--vy-rule);
}
.vy-sidebar__title {
  font-size: 10px; font-weight: 700; letter-spacing: .15em;
  text-transform: uppercase; color: var(--vy-muted);
}
.vy-sidebar__close {
  display: none; width: 30px; height: 30px; border: none;
  background: transparent; cursor: pointer; color: var(--vy-ink); padding: 4px;
  align-items: center; justify-content: center;
  border-radius: 50%;
  transition: background var(--t-fast) var(--ease-out),
              transform var(--t-fast) var(--ease-back);
}
.vy-sidebar__close:hover {
  background: var(--vy-linen);
  transform: rotate(90deg) scale3d(1.1, 1.1, 1);
}
@media (max-width: 1024px) { .vy-sidebar__close { display: flex; } }

/* Filter group */
.vy-fgroup {
  margin-bottom: var(--sp-lg); padding-bottom: var(--sp-lg);
  border-bottom: 1px solid var(--vy-rule);
}
.vy-fgroup:last-child { border-bottom: none; margin-bottom: 0; }
.vy-fgroup summary {
  display: flex; align-items: center; justify-content: space-between;
  cursor: pointer; list-style: none; margin-bottom: var(--sp-sm);
  font-size: 10.5px; font-weight: 700; letter-spacing: .12em;
  text-transform: uppercase; color: var(--vy-ink);
  transition: color var(--t-fast) var(--ease-out);
  user-select: none;
}
.vy-fgroup summary:hover { color: var(--vy-mocha); }
.vy-fgroup summary::-webkit-details-marker { display: none; }
.vy-fgroup summary svg {
  width: 14px; height: 14px; color: var(--vy-muted);
  transition: transform var(--t-mid) var(--ease-back),
              color var(--t-fast) var(--ease-out);
}
.vy-fgroup[open] summary svg {
  transform: rotate(180deg);
  color: var(--vy-ink);
}
/* Smooth filter content reveal */
.vy-fgroup > div {
  overflow: hidden;
}

.vy-foption {
  display: flex; align-items: center; gap: var(--sp-sm);
  cursor: pointer; padding: 6px 8px; border-radius: 5px;
  transition: background var(--t-fast) var(--ease-out),
              transform var(--t-fast) var(--ease-back);
}
.vy-foption:hover {
  background: var(--vy-linen);
  transform: translate3d(2px, 0, 0);
}
.vy-foption input[type=checkbox] {
  appearance: none; -webkit-appearance: none;
  width: 15px; height: 15px; border: 1.5px solid var(--vy-rule);
  border-radius: 3px; flex-shrink: 0; cursor: pointer; position: relative;
  transition: background var(--t-fast) var(--ease-out),
              border-color var(--t-fast) var(--ease-out),
              transform var(--t-fast) var(--ease-back);
}
.vy-foption input:hover { transform: scale3d(1.1, 1.1, 1); }
.vy-foption input:checked {
  background: var(--vy-espresso); border-color: var(--vy-espresso);
  transform: scale3d(1, 1, 1);
  animation: vy-check-pop var(--t-mid) var(--ease-bounce);
}
@keyframes vy-check-pop {
  0%   { transform: scale3d(1, 1, 1); }
  40%  { transform: scale3d(1.25, 1.25, 1); }
  70%  { transform: scale3d(.92, .92, 1); }
  100% { transform: scale3d(1, 1, 1); }
}
.vy-foption input:checked::after {
  content: ''; position: absolute; left: 3px; top: 0px;
  width: 5px; height: 9px; border: 1.5px solid #fff;
  border-top: 0; border-left: 0; transform: rotate(45deg);
  animation: vy-check-draw var(--t-fast) var(--ease-silk);
}
@keyframes vy-check-draw {
  from { opacity: 0; transform: rotate(45deg) scale(.5); }
  to   { opacity: 1; transform: rotate(45deg) scale(1); }
}
.vy-foption__lbl { font-size: 12.5px; color: var(--vy-ink); flex: 1; user-select: none; }
.vy-foption__cnt { font-size: 10px; color: var(--vy-muted); font-family: var(--vy-mono); }

/* Price range — smoother thumb */
.vy-price-range__display {
  display: flex; justify-content: space-between;
  font-size: 12px; font-family: var(--vy-mono); color: var(--vy-ink);
  margin-bottom: var(--sp-md);
  transition: opacity var(--t-fast) var(--ease-out);
}
.vy-price-track {
  position: relative; height: 3px;
  background: var(--vy-rule); border-radius: 2px; margin: var(--sp-md) 0;
}
.vy-price-fill {
  position: absolute; top: 0; height: 100%;
  background: var(--vy-espresso); border-radius: 2px;
  transition: left var(--t-fast) var(--ease-silk),
              width var(--t-fast) var(--ease-silk);
  will-change: left, width;
}
.vy-price-track input[type=range] {
  position: absolute; top: -7px; width: 100%;
  appearance: none; -webkit-appearance: none;
  background: transparent; pointer-events: none;
}
.vy-price-track input::-webkit-slider-thumb {
  -webkit-appearance: none; width: 18px; height: 18px; border-radius: 50%;
  background: var(--vy-white); border: 2px solid var(--vy-espresso);
  box-shadow: var(--sh-sm); pointer-events: auto; cursor: grab;
  transition: transform var(--t-fast) var(--ease-back),
              box-shadow var(--t-fast) var(--ease-out);
  will-change: transform;
}
.vy-price-track input::-webkit-slider-thumb:hover {
  transform: scale3d(1.25, 1.25, 1);
  box-shadow: var(--sh-md);
}
.vy-price-track input::-webkit-slider-thumb:active {
  transform: scale3d(1.1, 1.1, 1);
  cursor: grabbing;
  box-shadow: 0 0 0 6px rgba(61,31,15,.12);
}

/* Active filters */
.vy-active-filters {
  display: flex; flex-wrap: wrap; gap: 6px; margin-bottom: var(--sp-md);
}
.vy-af-pill {
  display: inline-flex; align-items: center; gap: 5px;
  padding: 4px 10px 4px 11px; background: var(--vy-espresso);
  color: var(--vy-white); border-radius: 999px; font-size: 10.5px; font-weight: 500;
  animation: vy-pill-in var(--t-mid) var(--ease-back) both;
}
@keyframes vy-pill-in {
  from { transform: scale3d(0.7, 0.7, 1); opacity: 0; }
  to   { transform: scale3d(1, 1, 1); opacity: 1; }
}
.vy-af-remove {
  width: 14px; height: 14px; border: none; background: rgba(255,255,255,.2);
  border-radius: 50%; cursor: pointer; color: inherit; display: flex;
  align-items: center; justify-content: center; font-size: 9px; padding: 0;
  transition: background var(--t-fast) var(--ease-out),
              transform var(--t-fast) var(--ease-back);
}
.vy-af-remove:hover {
  background: rgba(255,255,255,.4);
  transform: rotate(90deg) scale3d(1.2, 1.2, 1);
}
.vy-clear-all {
  background: none; border: none; cursor: pointer; font-family: var(--vy-sans);
  font-size: 10.5px; font-weight: 600; letter-spacing: .04em; text-transform: uppercase;
  color: var(--vy-muted); text-decoration: underline; text-underline-offset: 3px;
  padding: 4px 0;
  transition: color var(--t-fast) var(--ease-out);
}
.vy-clear-all:hover { color: var(--vy-ink); }

/* ══════════════════════════════════════════
   TOOLBAR — smooth sticky behaviour
══════════════════════════════════════════ */
.vy-toolbar {
  display: flex; align-items: center; justify-content: space-between;
  gap: var(--sp-md); margin-bottom: var(--sp-xl);
  padding-bottom: var(--sp-md); border-bottom: 1px solid var(--vy-rule);
  flex-wrap: wrap;
  /* Smooth sticky on scroll */
  position: sticky; top: 0; z-index: 100;
  background: var(--vy-ivory);
  transition: box-shadow var(--t-mid) var(--ease-out),
              padding var(--t-mid) var(--ease-out);
  padding-top: 14px;
}
.vy-toolbar.scrolled {
  box-shadow: 0 4px 20px rgba(26,15,8,.06);
}
.vy-toolbar__l { display: flex; align-items: center; gap: var(--sp-md); }
.vy-toolbar__r { display: flex; align-items: center; gap: var(--sp-sm); }

.vy-filter-btn {
  display: none; align-items: center; gap: 7px;
  padding: 8px 16px; background: var(--vy-white);
  border: 1.5px solid var(--vy-rule); border-radius: 999px;
  font-family: var(--vy-sans); font-size: 10.5px; font-weight: 600;
  letter-spacing: .06em; text-transform: uppercase; color: var(--vy-ink);
  cursor: pointer;
  transition: border-color var(--t-fast) var(--ease-out),
              background var(--t-fast) var(--ease-out),
              box-shadow var(--t-fast) var(--ease-out),
              transform var(--t-fast) var(--ease-back);
}
.vy-filter-btn:hover {
  border-color: var(--vy-espresso);
  background: var(--vy-linen);
  transform: translate3d(0, -1px, 0);
  box-shadow: var(--sh-sm);
}
.vy-filter-btn:active { transform: translate3d(0, 0, 0); }
@media (max-width: 1024px) { .vy-filter-btn { display: flex; } }

.vy-result-count { font-size: 11.5px; color: var(--vy-muted); }
.vy-result-count strong {
  color: var(--vy-ink); font-weight: 600;
  transition: color var(--t-mid) var(--ease-out);
}

.vy-sort {
  appearance: none; -webkit-appearance: none;
  padding: 8px 34px 8px 13px; background: var(--vy-white);
  border: 1.5px solid var(--vy-rule); border-radius: 999px;
  font-family: var(--vy-sans); font-size: 11.5px; font-weight: 500;
  color: var(--vy-ink); cursor: pointer;
  background-image: url("data:image/svg+xml,%3Csvg width='10' height='6' fill='none' xmlns='http://www.w3.org/2000/svg'%3E%3Cpath d='M1 1l4 4 4-4' stroke='%233d1f0f' stroke-width='1.5' stroke-linecap='round' stroke-linejoin='round'/%3E%3C/svg%3E");
  background-repeat: no-repeat; background-position: right 13px center;
  transition: border-color var(--t-fast) var(--ease-out),
              box-shadow var(--t-fast) var(--ease-out),
              transform var(--t-fast) var(--ease-back);
}
.vy-sort:hover {
  border-color: var(--vy-espresso);
  box-shadow: var(--sh-sm);
  transform: translate3d(0, -1px, 0);
}
.vy-sort:focus {
  border-color: var(--vy-espresso);
  outline: none;
  box-shadow: 0 0 0 3px rgba(61,31,15,.12);
}

.vy-view-toggle { display: flex; gap: 2px; background: var(--vy-linen); border-radius: 5px; padding: 2px; }
.vy-vbtn {
  width: 30px; height: 30px; display: flex; align-items: center; justify-content: center;
  background: transparent; border: none; border-radius: 4px; cursor: pointer;
  color: var(--vy-muted);
  transition: background var(--t-fast) var(--ease-out),
              color var(--t-fast) var(--ease-out),
              transform var(--t-fast) var(--ease-back),
              box-shadow var(--t-fast) var(--ease-out);
}
.vy-vbtn:hover:not(.active) {
  color: var(--vy-ink);
  transform: scale3d(1.08, 1.08, 1);
}
.vy-vbtn.active {
  background: var(--vy-white); color: var(--vy-ink); box-shadow: var(--sh-sm);
}
.vy-vbtn svg { width: 14px; height: 14px; }

/* ══════════════════════════════════════════
   PRODUCTS GRID — smooth layout transitions
══════════════════════════════════════════ */
.vy-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: var(--gap);
  row-gap: calc(var(--gap) * 2.2);
}
@media (min-width: 768px) {
  .vy-grid { grid-template-columns: repeat(var(--cols, 3), 1fr); }
}

/* ══════════════════════════════════════════
   PRODUCT CARD — ultra-smooth all states
══════════════════════════════════════════ */
.vy-card {
  position: relative; display: flex; flex-direction: column;
  /* IntersectionObserver-driven reveal (replaces blanket CSS animation) */
  opacity: 0;
  transform: translate3d(0, 22px, 0);
  transition: opacity var(--t-slow) var(--ease-silk),
              transform var(--t-slow) var(--ease-silk),
              box-shadow var(--t-mid) var(--ease-out);
  will-change: opacity, transform;
  content-visibility: auto;
  contain-intrinsic-size: 0 500px;
  /* Smooth elevation on hover */
  border-radius: 4px;
}
.vy-card.revealed {
  opacity: 1;
  transform: translate3d(0, 0, 0);
}
/* Subtle card lift on hover */
.vy-card:hover {
  z-index: 2;
}

.vy-card__media {
  position: relative; overflow: hidden;
  border-radius: 4px; background: var(--vy-linen);
  aspect-ratio: 3/4; margin-bottom: var(--sp-sm);
  /* Smooth shadow elevation */
  box-shadow: var(--sh-sm);
  transition: box-shadow var(--t-mid) var(--ease-out),
              transform var(--t-mid) var(--ease-silk);
  transform: translateZ(0);
}
.vy-card:hover .vy-card__media {
  box-shadow: var(--sh-hover);
  transform: translate3d(0, -3px, 0);
}

.vy-card__img {
  position: absolute; inset: 0; width: 100%; height: 100%;
  object-fit: cover;
  /* Smoother: longer duration, decelerated for graceful expansion */
  transition: transform 900ms var(--ease-silk),
              opacity var(--t-slow) var(--ease-out);
  transform: scale3d(1, 1, 1) translateZ(0);
  will-change: transform;
  backface-visibility: hidden;
}
.vy-card:hover .vy-card__img {
  transform: scale3d(1.06, 1.06, 1) translateZ(0);
}

.vy-card__img2 {
  position: absolute; inset: 0; width: 100%; height: 100%;
  object-fit: cover; opacity: 0;
  /* Smoother cross-dissolve with slight delay */
  transition: opacity var(--t-lazy) var(--ease-steady) 60ms;
  will-change: opacity;
}
.vy-card:hover .vy-card__img2 { opacity: 1; }

/* Badges */
.vy-card__badges {
  position: absolute; top: 10px; left: 10px; z-index: 3;
  display: flex; flex-direction: column; gap: 4px; pointer-events: none;
}
.vy-badge {
  display: inline-block; padding: 3px 8px;
  font-size: 9px; font-weight: 700; letter-spacing: .1em; text-transform: uppercase;
  border-radius: 3px;
  animation: vy-badge-in var(--t-mid) var(--ease-back) both;
}
@keyframes vy-badge-in {
  from { transform: translate3d(-8px, 0, 0); opacity: 0; }
  to   { transform: translate3d(0, 0, 0); opacity: 1; }
}
.vy-badge--sale    { background: var(--vy-red); color: #fff; }
.vy-badge--new     { background: var(--vy-espresso); color: #fff; }
.vy-badge--low     { background: rgba(255,255,255,.94); color: var(--vy-red); border: 1px solid rgba(192,57,43,.2); backdrop-filter: blur(4px); }
.vy-badge--out     { background: rgba(26,15,8,.5); color: rgba(255,255,255,.7); backdrop-filter: blur(4px); }

/* Urgency — smooth fade-up */
.vy-card__urgency {
  position: absolute; bottom: 0; left: 0; right: 0; z-index: 4;
  padding: 0 10px 10px;
  background: linear-gradient(0deg, rgba(26,15,8,.65) 0%, transparent 100%);
  transform: translate3d(0, 6px, 0);
  opacity: 0;
  transition: opacity var(--t-mid) var(--ease-silk),
              transform var(--t-mid) var(--ease-back);
  will-change: opacity, transform;
}
.vy-card:hover .vy-card__urgency {
  opacity: 1;
  transform: translate3d(0, 0, 0);
}

.vy-card__viewers {
  display: inline-flex; align-items: center; gap: 5px;
  font-size: 10px; font-weight: 500; color: rgba(255,255,255,.92);
  font-family: var(--vy-sans);
}
.vy-card__viewers-dot {
  width: 5px; height: 5px; border-radius: 50%;
  background: #6ee7b7;
  animation: vy-pulse 2.2s cubic-bezier(0.4, 0, 0.6, 1) infinite;
}

/* Action overlay — staggered entrance */
.vy-card__actions {
  position: absolute; bottom: 0; left: 0; right: 0;
  padding: 10px; display: flex; gap: 7px; z-index: 5;
  opacity: 0;
  transform: translate3d(0, 8px, 0);
  transition: opacity var(--t-mid) var(--ease-silk),
              transform var(--t-mid) var(--ease-back);
  will-change: opacity, transform;
}
.vy-card:hover .vy-card__actions {
  opacity: 1;
  transform: translate3d(0, 0, 0);
}

.vy-card__atc {
  flex: 1; padding: 10px;
  background: rgba(255,255,255,.95); border: 1px solid rgba(255,255,255,.7);
  border-radius: 4px; font-family: var(--vy-sans); font-size: 9.5px;
  font-weight: 700; letter-spacing: .1em; text-transform: uppercase;
  color: var(--vy-ink); cursor: pointer; backdrop-filter: blur(8px);
  transition: background var(--t-fast) var(--ease-out),
              color var(--t-fast) var(--ease-out),
              border-color var(--t-fast) var(--ease-out),
              transform var(--t-fast) var(--ease-back),
              box-shadow var(--t-fast) var(--ease-out);
}
.vy-card__atc:hover:not(:disabled) {
  background: var(--vy-espresso); color: var(--vy-white);
  border-color: var(--vy-espresso);
  transform: scale3d(1.02, 1.02, 1);
  box-shadow: 0 4px 14px rgba(61,31,15,.25);
}
.vy-card__atc:active:not(:disabled) {
  transform: scale3d(.98, .98, 1);
}
.vy-card__atc:disabled { opacity: .5; cursor: not-allowed; }

.vy-card__wish {
  width: 38px; height: 38px; background: rgba(255,255,255,.95);
  border: 1px solid rgba(255,255,255,.7); border-radius: 4px;
  display: flex; align-items: center; justify-content: center;
  cursor: pointer; backdrop-filter: blur(8px);
  transition: background var(--t-fast) var(--ease-out),
              color var(--t-fast) var(--ease-out),
              border-color var(--t-fast) var(--ease-out),
              transform var(--t-fast) var(--ease-back),
              box-shadow var(--t-fast) var(--ease-out);
  flex-shrink: 0; color: var(--vy-ink);
  will-change: transform;
}
.vy-card__wish:hover {
  background: var(--vy-espresso); color: var(--vy-white);
  border-color: var(--vy-espresso);
  transform: scale3d(1.12, 1.12, 1);
  box-shadow: 0 4px 14px rgba(61,31,15,.25);
}
.vy-card__wish.active {
  background: var(--vy-espresso); color: var(--vy-white);
  border-color: var(--vy-espresso);
}
/* Heart pop animation on activate */
.vy-card__wish.pop-heart {
  animation: vy-heart-pop var(--t-mid) var(--ease-bounce) forwards;
}
@keyframes vy-heart-pop {
  0%   { transform: scale3d(1, 1, 1); }
  30%  { transform: scale3d(1.4, 1.4, 1); }
  70%  { transform: scale3d(.9, .9, 1); }
  100% { transform: scale3d(1, 1, 1); }
}
.vy-card__wish svg {
  width: 14px; height: 14px;
  transition: fill var(--t-fast) var(--ease-out),
              transform var(--t-fast) var(--ease-back);
}
.vy-card__wish.active svg { fill: currentColor; }

/* Variant panel in card */
.vy-card__vpanel {
  display: none; position: absolute; bottom: 0; left: 0; right: 0;
  background: rgba(255,255,255,.98); backdrop-filter: blur(12px);
  border-top: 1px solid var(--vy-rule); border-radius: 0 0 4px 4px;
  padding: 11px; z-index: 6;
}
.vy-card__vpanel.open {
  display: block;
  animation: vy-panel-in var(--t-mid) var(--ease-back);
}
@keyframes vy-panel-in {
  from { transform: translate3d(0, 12px, 0); opacity: 0; }
  to   { transform: translate3d(0, 0, 0); opacity: 1; }
}
.vy-vpanel-lbl {
  font-size: 9px; font-weight: 700; letter-spacing: .1em; text-transform: uppercase;
  color: var(--vy-muted); margin-bottom: 7px;
}
.vy-vchips { display: flex; flex-wrap: wrap; gap: 5px; margin-bottom: 9px; }
.vy-vchip {
  padding: 5px 10px; font-size: 11px; font-weight: 600;
  border: 1.5px solid var(--vy-rule); border-radius: 3px;
  cursor: pointer;
  transition: background var(--t-fast) var(--ease-out),
              border-color var(--t-fast) var(--ease-out),
              color var(--t-fast) var(--ease-out),
              transform var(--t-fast) var(--ease-back),
              box-shadow var(--t-fast) var(--ease-out);
  background: none;
  font-family: var(--vy-sans); color: var(--vy-ink);
}
.vy-vchip:hover:not(.out) {
  border-color: var(--vy-espresso);
  transform: translate3d(0, -1px, 0);
  box-shadow: var(--sh-sm);
}
.vy-vchip:active:not(.out) { transform: translate3d(0, 0, 0); }
.vy-vchip.sel {
  background: var(--vy-espresso); color: #fff; border-color: var(--vy-espresso);
  animation: vy-chip-sel var(--t-mid) var(--ease-back);
}
@keyframes vy-chip-sel {
  0%   { transform: scale3d(1, 1, 1); }
  50%  { transform: scale3d(1.1, 1.1, 1); }
  100% { transform: scale3d(1, 1, 1); }
}
.vy-vchip.out { opacity: .3; cursor: not-allowed; text-decoration: line-through; }

/* Card info */
.vy-card__info { display: flex; flex-direction: column; gap: 3px; flex: 1; }
.vy-card__brand {
  font-size: 9px; font-weight: 700; letter-spacing: .12em;
  text-transform: uppercase; color: var(--vy-muted);
  transition: color var(--t-fast) var(--ease-out);
}
.vy-card:hover .vy-card__brand { color: var(--vy-mocha); }
.vy-card__name {
  font-family: var(--vy-serif); font-size: clamp(14px, 1.6vw, 18px);
  font-weight: 400; line-height: 1.3; color: var(--vy-ink); margin: 0;
  display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;
}
.vy-card__name a {
  color: inherit; text-decoration: none;
  transition: color var(--t-fast) var(--ease-out);
}
.vy-card__name a:hover { color: var(--vy-mocha); }

/* Stock progress bar — animated fill */
.vy-stock-bar {
  margin-top: 6px;
  display: flex; flex-direction: column; gap: 3px;
}
.vy-stock-bar__label {
  font-size: 10px; font-weight: 600; color: var(--vy-red);
  display: flex; align-items: center; gap: 5px;
  animation: vy-urgency-pulse 2.5s ease-in-out infinite;
}
@keyframes vy-urgency-pulse {
  0%, 100% { opacity: 1; }
  50%       { opacity: .7; }
}
.vy-stock-bar__label::before {
  content: ''; display: block; width: 5px; height: 5px;
  border-radius: 50%; background: var(--vy-red); flex-shrink: 0;
}
.vy-stock-track {
  height: 3px; background: var(--vy-rule); border-radius: 2px; overflow: hidden;
}
.vy-stock-fill {
  height: 100%; background: linear-gradient(90deg, var(--vy-amber), var(--vy-red));
  border-radius: 2px;
  /* Animate fill on reveal */
  width: 0 !important;
  transition: width 1s var(--ease-silk) 300ms;
}
.vy-card.revealed .vy-stock-fill {
  width: var(--stock-pct, 60%) !important;
}

/* Swatches */
.vy-card__swatches {
  display: flex; gap: 4px; align-items: center; margin-top: 5px; flex-wrap: wrap;
}
.vy-swatch {
  width: 13px; height: 13px; border-radius: 50%; cursor: pointer;
  border: 1.5px solid transparent; outline: 2px solid transparent; outline-offset: 1px;
  transition: transform var(--t-mid) var(--ease-back),
              border-color var(--t-fast) var(--ease-out),
              outline-color var(--t-fast) var(--ease-out);
  will-change: transform;
}
.vy-swatch:hover {
  transform: scale3d(1.35, 1.35, 1);
  outline-color: rgba(61,31,15,.25);
}
.vy-swatch.sel {
  border-color: var(--vy-espresso);
  transform: scale3d(1.2, 1.2, 1);
  outline-color: rgba(61,31,15,.2);
}
.vy-swatch-more { font-size: 9px; color: var(--vy-muted); font-weight: 500; }

/* Price */
.vy-card__price {
  display: flex; align-items: baseline; gap: 6px; margin-top: 7px; flex-wrap: wrap;
}
.vy-price {
  font-family: var(--vy-serif); font-size: 17px; font-weight: 500;
  color: var(--vy-ink); line-height: 1;
}
.vy-price-was { font-size: 12px; color: var(--vy-muted); text-decoration: line-through; }
.vy-price-save {
  font-size: 9px; font-weight: 700; letter-spacing: .08em; text-transform: uppercase;
  color: var(--vy-red); background: rgba(192,57,43,.08); padding: 2px 6px; border-radius: 3px;
}

/* ATC button below card — shimmer on hover */
.vy-card__btn {
  margin-top: 11px; width: 100%; padding: 11px;
  background: var(--vy-espresso); color: var(--vy-white);
  border: 2px solid var(--vy-espresso); border-radius: 3px;
  font-family: var(--vy-sans); font-size: 9.5px; font-weight: 700;
  letter-spacing: .12em; text-transform: uppercase;
  cursor: pointer; position: relative; overflow: hidden;
  transition: background var(--t-mid) var(--ease-out),
              border-color var(--t-mid) var(--ease-out),
              transform var(--t-fast) var(--ease-back),
              box-shadow var(--t-mid) var(--ease-out);
  will-change: transform;
  isolation: isolate;
}
/* Shimmer sweep */
.vy-card__btn::before {
  content: '';
  position: absolute; top: 0; left: -100%; bottom: 0;
  width: 60%;
  background: linear-gradient(90deg,
    transparent 0%,
    rgba(255,255,255,.18) 50%,
    transparent 100%);
  transform: skewX(-15deg);
  transition: left var(--t-slow) var(--ease-silk);
  pointer-events: none;
}
.vy-card__btn:hover::before { left: 140%; }
.vy-card__btn:hover:not(:disabled) {
  background: var(--vy-bark);
  border-color: var(--vy-bark);
  transform: translate3d(0, -2px, 0);
  box-shadow: 0 6px 20px rgba(61,31,15,.3);
}
.vy-card__btn:active:not(:disabled) {
  transform: translate3d(0, 0, 0);
  box-shadow: none;
}
.vy-card__btn span { position: relative; z-index: 1; }
.vy-card__btn:disabled {
  background: var(--vy-linen); border-color: var(--vy-linen);
  color: var(--vy-muted); cursor: not-allowed;
}
.vy-card__btn:disabled::before { display: none; }
.vy-card__btn.loading { color: transparent; pointer-events: none; }
.vy-card__btn.loading::after {
  content: ''; position: absolute; top: 50%; left: 50%;
  width: 14px; height: 14px; margin: -7px 0 0 -7px;
  border: 2px solid rgba(255,255,255,.3); border-top-color: #fff;
  border-radius: 50%; animation: vy-spin .55s linear infinite; z-index: 2;
}
@keyframes vy-spin { to { transform: rotate(360deg); } }

/* ══════════════════════════════════════════
   STICKY ADD-TO-CART BAR — smooth spring entry
══════════════════════════════════════════ */
.vy-sticky-bar {
  position: fixed; bottom: 0; left: 0; right: 0; z-index: 800;
  background: var(--vy-espresso);
  border-top: 1px solid rgba(255,255,255,.1);
  padding: 12px var(--gutter);
  display: flex; align-items: center; justify-content: space-between;
  gap: var(--sp-md); flex-wrap: wrap;
  /* Spring physics: translate3d for compositor-only layer */
  transform: translate3d(0, 110%, 0);
  transition: transform var(--t-lazy) var(--ease-snap);
  box-shadow: 0 -8px 40px rgba(26,15,8,.22);
  will-change: transform;
  backface-visibility: hidden;
}
.vy-sticky-bar.show {
  transform: translate3d(0, 0, 0);
}

.vy-sticky-bar__info { display: flex; flex-direction: column; gap: 2px; }
.vy-sticky-bar__title {
  font-family: var(--vy-serif); font-size: 16px; font-weight: 400;
  color: var(--vy-white); line-height: 1.2;
  transition: opacity var(--t-mid) var(--ease-out);
}
.vy-sticky-bar__price {
  font-size: 12px; color: var(--vy-sand-lt); font-family: var(--vy-mono);
  transition: opacity var(--t-mid) var(--ease-out);
}

.vy-sticky-bar__right { display: flex; align-items: center; gap: var(--sp-sm); }

.vy-sticky-vchips { display: flex; gap: 5px; flex-wrap: wrap; }
.vy-sticky-vchip {
  padding: 5px 11px; font-size: 10.5px; font-weight: 600;
  border: 1.5px solid rgba(255,255,255,.25); border-radius: 3px;
  cursor: pointer;
  transition: border-color var(--t-fast) var(--ease-out),
              color var(--t-fast) var(--ease-out),
              background var(--t-fast) var(--ease-out),
              transform var(--t-fast) var(--ease-back);
  background: none;
  font-family: var(--vy-sans); color: rgba(255,255,255,.7);
}
.vy-sticky-vchip:hover {
  border-color: var(--vy-sand-lt); color: var(--vy-sand-lt);
  transform: translate3d(0, -1px, 0);
}
.vy-sticky-vchip.sel {
  background: var(--vy-sand); border-color: var(--vy-sand);
  color: var(--vy-espresso);
  animation: vy-chip-sel var(--t-mid) var(--ease-back);
}
.vy-sticky-vchip.out { opacity: .3; cursor: not-allowed; }

.vy-sticky-atc {
  padding: 11px 24px; background: var(--vy-sand); color: var(--vy-espresso);
  border: none; border-radius: 3px; font-family: var(--vy-sans); font-size: 10.5px;
  font-weight: 700; letter-spacing: .12em; text-transform: uppercase;
  cursor: pointer; white-space: nowrap; flex-shrink: 0;
  transition: background var(--t-fast) var(--ease-out),
              transform var(--t-fast) var(--ease-back),
              box-shadow var(--t-fast) var(--ease-out);
  will-change: transform;
}
.vy-sticky-atc:hover {
  background: var(--vy-sand-lt);
  transform: translate3d(0, -1px, 0);
  box-shadow: 0 4px 14px rgba(196,168,130,.4);
}
.vy-sticky-atc:active {
  transform: translate3d(0, 0, 0);
  box-shadow: none;
}
.vy-sticky-atc:disabled { opacity: .5; cursor: not-allowed; transform: none; }

.vy-sticky-close {
  width: 32px; height: 32px; background: rgba(255,255,255,.1); border: none;
  border-radius: 50%; color: rgba(255,255,255,.7); cursor: pointer;
  display: flex; align-items: center; justify-content: center;
  transition: background var(--t-fast) var(--ease-out),
              transform var(--t-fast) var(--ease-back);
  flex-shrink: 0;
}
.vy-sticky-close:hover {
  background: rgba(255,255,255,.2);
  transform: rotate(90deg) scale3d(1.1, 1.1, 1);
}

/* ══════════════════════════════════════════
   OVERLAY — smooth backdrop blur
══════════════════════════════════════════ */
.vy-overlay {
  display: none; position: fixed; inset: 0;
  background: rgba(26,15,8,0); z-index: 599;
  backdrop-filter: blur(0px);
  -webkit-backdrop-filter: blur(0px);
  transition: background var(--t-slow) var(--ease-out),
              backdrop-filter var(--t-slow) var(--ease-out);
}
.vy-overlay.open {
  display: block;
  background: rgba(26,15,8,.45);
  backdrop-filter: blur(3px);
  -webkit-backdrop-filter: blur(3px);
  animation: vy-overlay-in var(--t-slow) var(--ease-out) forwards;
}
@keyframes vy-overlay-in {
  from { background: rgba(26,15,8,0); backdrop-filter: blur(0px); }
  to   { background: rgba(26,15,8,.45); backdrop-filter: blur(3px); }
}

/* ══════════════════════════════════════════
   TOAST — smoother spring entry/exit
══════════════════════════════════════════ */
.vy-toasts {
  position: fixed; top: 18px; right: 18px; z-index: 1000;
  display: flex; flex-direction: column; gap: 7px;
  pointer-events: none; max-width: 320px;
}
.vy-toast {
  background: var(--vy-white); border-radius: 10px; box-shadow: var(--sh-lg);
  padding: 13px 15px; display: flex; align-items: flex-start; gap: 9px;
  pointer-events: auto; border-left: 3px solid var(--vy-green);
  animation: vy-toast-in var(--t-mid) var(--ease-back) forwards;
  will-change: transform, opacity;
}
.vy-toast.err { border-left-color: var(--vy-red); }
@keyframes vy-toast-in {
  from { transform: translate3d(100%, 0, 0) scale(.9); opacity: 0; }
  to   { transform: translate3d(0, 0, 0) scale(1); opacity: 1; }
}
@keyframes vy-toast-out {
  from { transform: translate3d(0, 0, 0) scale(1); opacity: 1; }
  to   { transform: translate3d(100%, 0, 0) scale(.9); opacity: 0; }
}
.vy-toast__icon { width: 15px; height: 15px; flex-shrink: 0; margin-top: 2px; }
.vy-toast.vy-toast--ok  .vy-toast__icon { color: var(--vy-green); }
.vy-toast.err .vy-toast__icon { color: var(--vy-red); }
.vy-toast__title { font-size: 12.5px; font-weight: 700; color: var(--vy-ink); line-height: 1.3; }
.vy-toast__msg { font-size: 10.5px; color: var(--vy-muted); margin-top: 1px; }

/* ══════════════════════════════════════════
   EMPTY STATE
══════════════════════════════════════════ */
.vy-empty {
  grid-column: 1/-1; text-align: center; padding: var(--sp-2xl) 0;
  animation: vy-fade-up var(--t-slow) var(--ease-silk) forwards;
}
.vy-empty__icon {
  width: 44px; height: 44px; color: var(--vy-rule);
  margin: 0 auto var(--sp-md);
  animation: vy-empty-bob 3s ease-in-out infinite;
}
@keyframes vy-empty-bob {
  0%, 100% { transform: translate3d(0, 0, 0); }
  50%       { transform: translate3d(0, -6px, 0); }
}
.vy-empty__title { font-family: var(--vy-serif); font-size: 22px; font-weight: 400; color: var(--vy-ink); margin: 0 0 6px; }
.vy-empty__desc { font-size: 13px; color: var(--vy-muted); margin: 0 0 var(--sp-lg); }
.vy-empty__cta {
  display: inline-flex; padding: 11px 26px; background: var(--vy-espresso);
  color: var(--vy-white); border-radius: 3px; font-size: 10.5px; font-weight: 700;
  letter-spacing: .12em; text-transform: uppercase; text-decoration: none;
  transition: background var(--t-fast) var(--ease-out),
              transform var(--t-fast) var(--ease-back),
              box-shadow var(--t-fast) var(--ease-out);
}
.vy-empty__cta:hover {
  background: var(--vy-bark);
  transform: translate3d(0, -2px, 0);
  box-shadow: 0 6px 20px rgba(61,31,15,.25);
}

/* ══════════════════════════════════════════
   PAGINATION — smooth hover lift
══════════════════════════════════════════ */
.vy-pagination {
  display: flex; align-items: center; justify-content: center;
  gap: 5px; padding: var(--sp-2xl) 0 var(--sp-xl); flex-wrap: wrap;
}
.vy-page {
  min-width: 38px; height: 38px; display: flex; align-items: center; justify-content: center;
  border: 1.5px solid var(--vy-rule); background: var(--vy-white); color: var(--vy-ink);
  font-family: var(--vy-mono); font-size: 11.5px; font-weight: 600;
  cursor: pointer; border-radius: 3px; text-decoration: none; padding: 0 8px;
  transition: border-color var(--t-fast) var(--ease-out),
              background var(--t-fast) var(--ease-out),
              color var(--t-fast) var(--ease-out),
              transform var(--t-fast) var(--ease-back),
              box-shadow var(--t-fast) var(--ease-out);
  will-change: transform;
}
.vy-page:hover:not(.dis):not(.cur) {
  border-color: var(--vy-espresso);
  transform: translate3d(0, -2px, 0);
  box-shadow: var(--sh-md);
}
.vy-page:active:not(.dis):not(.cur) {
  transform: translate3d(0, 0, 0);
}
.vy-page.cur {
  background: var(--vy-espresso); color: var(--vy-white);
  border-color: var(--vy-espresso);
  animation: vy-page-cur var(--t-mid) var(--ease-back);
}
@keyframes vy-page-cur {
  from { transform: scale3d(.85, .85, 1); }
  to   { transform: scale3d(1, 1, 1); }
}
.vy-page.dis { opacity: .3; pointer-events: none; }

/* ══════════════════════════════════════════
   STATS BAND — count-up animation ready
══════════════════════════════════════════ */
.vy-stats {
  background: var(--vy-espresso); padding: var(--sp-xl) 0; margin-top: var(--sp-xl);
  border-radius: 6px; overflow: hidden;
}
.vy-stats__grid {
  display: grid; grid-template-columns: repeat(auto-fit, minmax(160px, 1fr)); gap: var(--sp-xl);
}
.vy-stats__item {
  text-align: center;
  opacity: 0; transform: translate3d(0, 16px, 0);
  transition: opacity var(--t-slow) var(--ease-silk),
              transform var(--t-slow) var(--ease-silk);
}
.vy-stats__item.in-view {
  opacity: 1; transform: translate3d(0, 0, 0);
}
.vy-stats__item:nth-child(1) { transition-delay: 0ms; }
.vy-stats__item:nth-child(2) { transition-delay: 80ms; }
.vy-stats__item:nth-child(3) { transition-delay: 160ms; }
.vy-stats__item:nth-child(4) { transition-delay: 240ms; }
.vy-stats__num {
  font-family: var(--vy-serif); font-size: 38px; font-weight: 400;
  color: var(--vy-sand-lt); line-height: 1; margin-bottom: 5px; letter-spacing: -.02em;
}
.vy-stats__lbl {
  font-size: 10px; font-weight: 500; letter-spacing: .1em; text-transform: uppercase;
  color: rgba(255,255,255,.45);
}

/* ══════════════════════════════════════════
   CARD SHOW/HIDE (filter) — smooth fade
══════════════════════════════════════════ */
.vy-card.hide-card {
  pointer-events: none;
  animation: vy-card-hide var(--t-mid) var(--ease-out) forwards;
}
.vy-card.show-card {
  animation: vy-card-show var(--t-mid) var(--ease-silk) forwards;
}
@keyframes vy-card-hide {
  from { opacity: 1; transform: translate3d(0, 0, 0) scale3d(1, 1, 1); }
  to   { opacity: 0; transform: translate3d(0, 6px, 0) scale3d(.97, .97, 1); }
}
@keyframes vy-card-show {
  from { opacity: 0; transform: translate3d(0, 8px, 0) scale3d(.97, .97, 1); }
  to   { opacity: 1; transform: translate3d(0, 0, 0) scale3d(1, 1, 1); }
}

/* ══════════════════════════════════════════
   FOCUS & A11Y
══════════════════════════════════════════ */
.vy-scope :focus-visible {
  outline: 2px solid var(--vy-sand);
  outline-offset: 3px;
  border-radius: 2px;
}

/* ══════════════════════════════════════════
   REDUCED MOTION — full compliance
══════════════════════════════════════════ */
@media (prefers-reduced-motion: reduce) {
  .vy-scope *, .vy-scope *::before, .vy-scope *::after {
    animation-duration: 0.01ms !important;
    animation-iteration-count: 1 !important;
    transition-duration: 0.01ms !important;
  }
  .vy-card { opacity: 1; transform: none; }
  .vy-hero__eyebrow,
  .vy-hero__title,
  .vy-hero__desc,
  .vy-hero__meta { opacity: 1; transform: none; animation: none; }
  .vy-trust__item { opacity: 1; transform: none; }
  .vy-stats__item { opacity: 1; transform: none; }
  .vy-stock-fill { transition: none; width: var(--stock-pct, 60%) !important; }
  .vy-strip__track { animation: none; }
  .vy-live-dot { animation: none; }
  .vy-countdown-sep { animation: none; }
}
</style>


{%- comment -%} ════════════════════════════════════
  HTML BEGINS
════════════════════════════════════ {%- endcomment -%}

{% paginate collection.products by ppp %}

<div class="vy-scope" id="vy-{{ section.id }}">

  <!-- Toast container -->
  <div class="vy-toasts" id="vyToasts" role="status" aria-live="polite" aria-atomic="false"></div>

  <!-- Sidebar overlay -->
  <div class="vy-overlay" id="vyOverlay"></div>

  <!-- ── ANNOUNCEMENT STRIP ── -->
  {% if section.settings.announcement != blank %}
  <div class="vy-strip" role="banner" aria-label="Announcements">
    {%- assign items = section.settings.announcement | split: '|' -%}
    <div class="vy-strip__track" aria-hidden="true">
      {%- for item in items -%}
        {%- for n in (1..4) -%}
          <span class="vy-strip__item">
            <span class="vy-strip__dot"></span>
            {{ item | strip }}
          </span>
        {%- endfor -%}
      {%- endfor -%}
    </div>
  </div>
  {% endif %}

  <!-- ── COUNTDOWN BANNER ── -->
  {% if section.settings.show_countdown %}
  <div class="vy-countdown-bar" id="vyCountdownBar" aria-label="Sale countdown">
    <span class="vy-countdown-bar__label">{{ section.settings.countdown_label | default: '⚡ Sale Ends In' }}</span>
    <div class="vy-countdown-bar__timer" aria-live="polite">
      <div class="vy-countdown-unit">
        <span class="vy-countdown-unit__num" id="vyH">00</span>
        <span class="vy-countdown-unit__lbl">Hrs</span>
      </div>
      <span class="vy-countdown-sep" aria-hidden="true">:</span>
      <div class="vy-countdown-unit">
        <span class="vy-countdown-unit__num" id="vyM">00</span>
        <span class="vy-countdown-unit__lbl">Min</span>
      </div>
      <span class="vy-countdown-sep" aria-hidden="true">:</span>
      <div class="vy-countdown-unit">
        <span class="vy-countdown-unit__num" id="vyS">00</span>
        <span class="vy-countdown-unit__lbl">Sec</span>
      </div>
    </div>
  </div>
  {% endif %}

  <div class="vy-container">

    <!-- ── BREADCRUMB ── -->
    <nav class="vy-breadcrumb" aria-label="Breadcrumb">
      <ol class="vy-breadcrumb__list">
        <li class="vy-breadcrumb__item"><a href="{{ routes.root_url }}">Home</a></li>
        <li aria-hidden="true"><span class="vy-breadcrumb__sep"></span></li>
        {% unless collection.handle == 'all' %}
          <li class="vy-breadcrumb__item"><a href="{{ routes.collections_url }}">Collections</a></li>
          <li aria-hidden="true"><span class="vy-breadcrumb__sep"></span></li>
        {% endunless %}
        <li class="vy-breadcrumb__item vy-breadcrumb__item--cur" aria-current="page">
          {{ collection.title }}
        </li>
      </ol>
    </nav>

    <!-- ── HERO ── -->
    <header class="vy-hero">
      {% if section.settings.eyebrow != blank %}
      <div class="vy-hero__eyebrow">
        <span class="vy-hero__line" aria-hidden="true"></span>
        <span class="vy-hero__tag">{{ section.settings.eyebrow }}</span>
      </div>
      {% endif %}

      <h1 class="vy-hero__title">{{ collection.title }}</h1>

      {% if collection.description != blank %}
        <p class="vy-hero__desc">{{ collection.description | strip_html | truncatewords: 28 }}</p>
      {% endif %}

      <div class="vy-hero__meta">
        <span class="vy-result-count">
          <strong id="vyVisCount">{{ collection.products_count }}</strong> products
        </span>

        <div class="vy-live-pill" id="vyViewerPill" aria-live="polite">
          <span class="vy-live-dot" aria-hidden="true"></span>
          <span id="vyViewers">–</span> people viewing now
        </div>
      </div>
    </header>

  </div>

  <!-- ── TRUST BAR ── -->
  {% if section.settings.show_trust %}
  <div class="vy-trust">
    <div class="vy-container">
      <div class="vy-trust__inner">
        <div class="vy-trust__item">
          <svg class="vy-trust__icon" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.6" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75m-3-7.036A11.959 11.959 0 013.598 6 11.99 11.99 0 003 9.749c0 5.592 3.824 10.29 9 11.623 5.176-1.332 9-6.03 9-11.622 0-1.31-.21-2.571-.598-3.751h-.152c-3.196 0-6.1-1.248-8.25-3.285z"/></svg>
          <span class="vy-trust__text">{{ section.settings.trust_1 | default: '100% Authentic' }} <span>{{ section.settings.trust_1s | default: 'Every piece verified' }}</span></span>
        </div>
        <span class="vy-trust__div" aria-hidden="true"></span>
        <div class="vy-trust__item">
          <svg class="vy-trust__icon" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.6" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M8.25 18.75a1.5 1.5 0 01-3 0m3 0a1.5 1.5 0 00-3 0m3 0h6m-9 0H3.375a1.125 1.125 0 01-1.125-1.125V14.25m17.25 4.5a1.5 1.5 0 01-3 0m3 0a1.5 1.5 0 00-3 0m3 0h1.125c.621 0 1.129-.504 1.09-1.124a17.902 17.902 0 00-3.213-9.193 2.056 2.056 0 00-1.58-.86H14.25M16.5 18.75h-2.25m0-11.177v-.958c0-.568-.422-1.048-.987-1.106a48.554 48.554 0 00-10.026 0 1.106 1.106 0 00-.987 1.106v7.635m12-6.677v6.677m0 4.5v-4.5m0 0h-12"/></svg>
          <span class="vy-trust__text">{{ section.settings.trust_2 | default: 'Free Shipping' }} <span>{{ section.settings.trust_2s | default: 'Orders over Rs. 5,000' }}</span></span>
        </div>
        <span class="vy-trust__div" aria-hidden="true"></span>
        <div class="vy-trust__item">
          <svg class="vy-trust__icon" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.6" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M9 15L3 9m0 0l6-6M3 9h12a6 6 0 010 12h-3"/></svg>
          <span class="vy-trust__text">{{ section.settings.trust_3 | default: '7-Day Returns' }} <span>{{ section.settings.trust_3s | default: 'Hassle-free exchange' }}</span></span>
        </div>
        <span class="vy-trust__div" aria-hidden="true"></span>
        <div class="vy-trust__item">
          <svg class="vy-trust__icon" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.6" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M2.25 8.25h19.5M2.25 9h19.5m-16.5 5.25h6m-6 2.25h3m-3.75 3h15a2.25 2.25 0 002.25-2.25V6.75A2.25 2.25 0 0019.5 4.5h-15a2.25 2.25 0 00-2.25 2.25v10.5A2.25 2.25 0 004.5 19.5z"/></svg>
          <span class="vy-trust__text">{{ section.settings.trust_4 | default: 'Cash on Delivery' }} <span>{{ section.settings.trust_4s | default: 'Nationwide Pakistan' }}</span></span>
        </div>
      </div>
    </div>
  </div>
  {% endif %}


  <div class="vy-container">
    <div class="vy-layout" id="vyLayout">

      <!-- ════════════════════════
           SIDEBAR
      ════════════════════════ -->
      <aside class="vy-sidebar" id="vySidebar" aria-label="Product filters">
        <div class="vy-sidebar__hdr">
          <span class="vy-sidebar__title">Refine</span>
          <button class="vy-sidebar__close" id="vySidebarClose" aria-label="Close filters">
            <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
          </button>
        </div>

        <div class="vy-active-filters" id="vyAF" style="display:none;" aria-live="polite"></div>

        <!-- Availability -->
        <details class="vy-fgroup" open>
          <summary>
            <span>Availability</span>
            <svg fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/></svg>
          </summary>
          <div>
            <label class="vy-foption">
              <input type="checkbox" name="f-av" value="in-stock">
              <span class="vy-foption__lbl">In Stock</span>
              <span class="vy-foption__cnt" id="cntStock">–</span>
            </label>
            <label class="vy-foption">
              <input type="checkbox" name="f-av" value="sale">
              <span class="vy-foption__lbl">On Sale</span>
              <span class="vy-foption__cnt" id="cntSale">–</span>
            </label>
            <label class="vy-foption">
              <input type="checkbox" name="f-av" value="new">
              <span class="vy-foption__lbl">New Arrivals</span>
              <span class="vy-foption__cnt" id="cntNew">–</span>
            </label>
          </div>
        </details>

        <!-- Product type -->
        {%- assign types = collection.products | map: 'type' | compact | uniq | sort -%}
        {%- if types.size > 0 and types.first != blank -%}
        <details class="vy-fgroup" open>
          <summary>
            <span>Category</span>
            <svg fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/></svg>
          </summary>
          <div>
            {%- for t in types -%}
              {%- if t != blank -%}
              <label class="vy-foption">
                <input type="checkbox" name="f-type" value="{{ t | handleize }}">
                <span class="vy-foption__lbl">{{ t }}</span>
              </label>
              {%- endif -%}
            {%- endfor -%}
          </div>
        </details>
        {%- endif -%}

        <!-- Price -->
        {% if section.settings.enable_price_filter %}
        {%- liquid
          assign max_p = 0
          for p in collection.products
            if p.price > max_p
              assign max_p = p.price
            endif
          endfor
          assign max_p_dec = max_p | divided_by: 100
        -%}
        <details class="vy-fgroup" open>
          <summary>
            <span>Price</span>
            <svg fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/></svg>
          </summary>
          <div class="vy-price-range__display">
            <span id="pMin">Rs. 0</span>
            <span id="pMax">Rs. {{ max_p_dec }}</span>
          </div>
          <div class="vy-price-track" id="vyPriceTrack">
            <div class="vy-price-fill" id="vyPriceFill"></div>
            <input type="range" id="prMin" min="0" max="{{ max_p_dec }}" value="0" step="50" aria-label="Minimum price">
            <input type="range" id="prMax" min="0" max="{{ max_p_dec }}" value="{{ max_p_dec }}" step="50" aria-label="Maximum price">
          </div>
        </details>
        {% endif %}

      </aside>

      <!-- ════════════════════════
           MAIN CONTENT
      ════════════════════════ -->
      <main id="vyMain">

        <!-- Toolbar -->
        <div class="vy-toolbar" id="vyToolbar">
          <div class="vy-toolbar__l">
            <button class="vy-filter-btn" id="vyFilterBtn" aria-expanded="false" aria-controls="vySidebar">
              <svg width="13" height="13" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M10.5 6h9.75M10.5 6a1.5 1.5 0 11-3 0m3 0a1.5 1.5 0 10-3 0M3.75 6H7.5m3 12h9.75m-9.75 0a1.5 1.5 0 01-3 0m3 0a1.5 1.5 0 00-3 0m-3.75 0H7.5m9-6h3.75m-3.75 0a1.5 1.5 0 01-3 0m3 0a1.5 1.5 0 00-3 0m-9.75 0h9.75"/></svg>
              Filter
            </button>
            <p class="vy-result-count">
              <strong id="vyVisibleCount">{{ collection.products_count }}</strong> results
            </p>
          </div>
          <div class="vy-toolbar__r">
            <!-- View toggle -->
            <div class="vy-view-toggle" role="group" aria-label="View layout">
              <button class="vy-vbtn active" data-cols="3" aria-pressed="true" aria-label="3 columns">
                <svg fill="currentColor" viewBox="0 0 12 12"><rect x="0" y="0" width="3" height="3"/><rect x="4.5" y="0" width="3" height="3"/><rect x="9" y="0" width="3" height="3"/><rect x="0" y="4.5" width="3" height="3"/><rect x="4.5" y="4.5" width="3" height="3"/><rect x="9" y="4.5" width="3" height="3"/><rect x="0" y="9" width="3" height="3"/><rect x="4.5" y="9" width="3" height="3"/><rect x="9" y="9" width="3" height="3"/></svg>
              </button>
              <button class="vy-vbtn" data-cols="2" aria-pressed="false" aria-label="2 columns">
                <svg fill="currentColor" viewBox="0 0 12 12"><rect x="0" y="0" width="5" height="5"/><rect x="7" y="0" width="5" height="5"/><rect x="0" y="7" width="5" height="5"/><rect x="7" y="7" width="5" height="5"/></svg>
              </button>
            </div>
            <!-- Sort -->
            {% if section.settings.enable_sorting %}
            <label for="vySort" class="vy-sr">Sort by</label>
            <select class="vy-sort" id="vySort" name="sort_by">
              <option value="">Featured</option>
              <option value="best-selling" {% if sort_by == 'best-selling' %}selected{% endif %}>Best Selling</option>
              <option value="created-descending" {% if sort_by == 'created-descending' %}selected{% endif %}>Newest</option>
              <option value="price-ascending" {% if sort_by == 'price-ascending' %}selected{% endif %}>Price ↑</option>
              <option value="price-descending" {% if sort_by == 'price-descending' %}selected{% endif %}>Price ↓</option>
            </select>
            {% endif %}
          </div>
        </div>

        <!-- Products grid -->
        <div class="vy-grid"
             id="vyGrid"
             style="--cols: {{ grid_cols }};"
             role="list"
             aria-label="Products">

          {%- for product in collection.products -%}
            {%- liquid
              assign on_sale = false
              assign disc = 0
              assign is_new = false
              assign low_stock = false
              assign low_qty = 0

              if product.compare_at_price > product.price
                assign on_sale = true
                assign disc = product.compare_at_price | minus: product.price | times: 100 | divided_by: product.compare_at_price | round
              endif

              assign now_ts = 'now' | date: '%s' | plus: 0
              assign created_ts = product.created_at | date: '%s' | plus: 0
              assign age_days = now_ts | minus: created_ts | divided_by: 86400
              if age_days <= 30
                assign is_new = true
              endif

              assign fv = product.selected_or_first_available_variant
              if fv.inventory_management == 'shopify' and fv.inventory_quantity > 0 and fv.inventory_quantity <= 5
                assign low_stock = true
                assign low_qty = fv.inventory_quantity
              endif

              assign multi = false
              if product.variants.size > 1
                assign multi = true
              endif

              assign stock_pct = 100
              if low_stock
                assign stock_pct = low_qty | times: 20
              endif
            -%}

            <article
              class="vy-card"
              style="--vy-i: {{ forloop.index0 }}; --stock-pct: {{ stock_pct }}%;"
              role="listitem"
              data-pid="{{ product.id }}"
              data-handle="{{ product.handle }}"
              data-avail="{{ product.available }}"
              data-sale="{{ on_sale }}"
              data-new="{{ is_new }}"
              data-type="{{ product.type | handleize }}"
              data-price="{{ product.price }}"
              data-title="{{ product.title | escape }}"
              data-variant="{{ fv.id }}"
            >

              <div class="vy-card__media">

                <!-- Badges -->
                <div class="vy-card__badges" aria-label="Product labels">
                  {%- unless product.available -%}
                    <span class="vy-badge vy-badge--out">Sold Out</span>
                  {%- else -%}
                    {%- if on_sale -%}<span class="vy-badge vy-badge--sale">−{{ disc }}%</span>{%- endif -%}
                    {%- if is_new -%}<span class="vy-badge vy-badge--new">New</span>{%- endif -%}
                    {%- if low_stock -%}<span class="vy-badge vy-badge--low">{{ low_qty }} left</span>{%- endif -%}
                  {%- endunless -%}
                </div>

                <!-- Primary image -->
                {%- if product.featured_image -%}
                  <img
                    src="{{ product.featured_image | image_url: width: 600 }}"
                    srcset="{{ product.featured_image | image_url: width: 400 }} 400w, {{ product.featured_image | image_url: width: 600 }} 600w, {{ product.featured_image | image_url: width: 900 }} 900w"
                    sizes="(max-width: 640px) calc(50vw - 20px), (max-width: 1024px) calc(50vw - 52px), calc((100vw - 248px - 144px) / {{ grid_cols }})"
                    alt="{{ product.featured_image.alt | default: product.title | escape }}"
                    class="vy-card__img"
                    loading="lazy"
                    decoding="async"
                    width="{{ product.featured_image.width }}"
                    height="{{ product.featured_image.height }}"
                  >
                {%- endif -%}

                <!-- Hover image -->
                {%- if product.images[1] -%}
                  <img
                    src="{{ product.images[1] | image_url: width: 600 }}"
                    alt="{{ product.images[1].alt | default: product.title | escape }}"
                    class="vy-card__img2"
                    loading="lazy"
                    decoding="async"
                    width="{{ product.images[1].width }}"
                    height="{{ product.images[1].height }}"
                  >
                {%- endif -%}

                <!-- Live viewers urgency -->
                <div class="vy-card__urgency" aria-hidden="true">
                  <span class="vy-card__viewers">
                    <span class="vy-card__viewers-dot"></span>
                    <span class="vy-viewers-num" data-pid="{{ product.id }}">–</span> viewing
                  </span>
                </div>

                <!-- Quick actions -->
                <div class="vy-card__actions">
                  {%- if multi -%}
                    <button class="vy-card__atc vy-open-vp"
                            data-pid="{{ product.id }}"
                            aria-label="Select size for {{ product.title | escape }}">
                      Select Size
                    </button>
                  {%- elsif product.available -%}
                    <button class="vy-card__atc vy-atc"
                            data-vid="{{ fv.id }}"
                            data-title="{{ product.title | escape }}"
                            aria-label="Add {{ product.title | escape }} to cart">
                      Add to Cart
                    </button>
                  {%- else -%}
                    <button class="vy-card__atc" disabled>Sold Out</button>
                  {%- endif -%}
                  <button class="vy-card__wish vy-wish"
                          data-pid="{{ product.id }}"
                          aria-label="Save {{ product.title | escape }}"
                          aria-pressed="false">
                    <svg fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M21 8.25c0-2.485-2.099-4.5-4.688-4.5-1.935 0-3.597 1.126-4.312 2.733-.715-1.607-2.377-2.733-4.313-2.733C5.1 3.75 3 5.765 3 8.25c0 7.22 9 12 9 12s9-4.78 9-12z"/></svg>
                  </button>
                </div>

                <!-- Variant panel inside card -->
                {%- if multi -%}
                <div class="vy-card__vpanel" id="vp-{{ product.id }}" data-pid="{{ product.id }}">
                  <div class="vy-vpanel-lbl">Select: <span id="vpSel-{{ product.id }}">{{ product.variants.first.title }}</span></div>
                  <div class="vy-vchips">
                    {%- for v in product.variants -%}
                      <button
                        class="vy-vchip{% unless v.available %} out{% endunless %}{% if forloop.first %} sel{% endif %}"
                        data-vid="{{ v.id }}"
                        data-pid="{{ product.id }}"
                        {% unless v.available %}disabled aria-disabled="true"{% endunless %}
                      >{{ v.title }}</button>
                    {%- endfor -%}
                  </div>
                  <button class="vy-card__atc vy-atc"
                          style="width:100%; display:block;"
                          data-vid="{{ product.variants.first.id }}"
                          data-title="{{ product.title | escape }}"
                          data-vpanel="{{ product.id }}">
                    Add to Cart
                  </button>
                </div>
                {%- endif -%}

              </div>

              <!-- Card info -->
              <div class="vy-card__info">
                {%- if section.settings.show_vendor and product.vendor != blank -%}
                  <span class="vy-card__brand">{{ product.vendor }}</span>
                {%- endif -%}

                <h3 class="vy-card__name">
                  <a href="{{ product.url }}">{{ product.title }}</a>
                </h3>

                <!-- Low stock bar -->
                {%- if low_stock -%}
                  <div class="vy-stock-bar">
                    <span class="vy-stock-bar__label">Only {{ low_qty }} left — selling fast</span>
                    <div class="vy-stock-track">
                      <div class="vy-stock-fill"></div>
                    </div>
                  </div>
                {%- endif -%}

                <!-- Colour swatches -->
                {%- assign col_opt = nil -%}
                {%- for opt in product.options_with_values -%}
                  {%- assign on_lower = opt.name | downcase -%}
                  {%- if on_lower == 'color' or on_lower == 'colour' -%}
                    {%- assign col_opt = opt -%}
                    {%- break -%}
                  {%- endif -%}
                {%- endfor -%}
                {%- if col_opt and col_opt.values.size > 0 -%}
                <div class="vy-card__swatches" aria-label="Colours">
                  {%- for cv in col_opt.values limit: 5 -%}
                    <span class="vy-swatch{% if forloop.first %} sel{% endif %}"
                          style="background-color:{{ cv | downcase | replace: ' ', '-' }};"
                          title="{{ cv }}" role="img" aria-label="{{ cv }}"></span>
                  {%- endfor -%}
                  {%- if col_opt.values.size > 5 -%}
                    <span class="vy-swatch-more">+{{ col_opt.values.size | minus: 5 }}</span>
                  {%- endif -%}
                </div>
                {%- endif -%}

                <!-- Price -->
                <div class="vy-card__price">
                  <span class="vy-price">{{ product.price | money }}</span>
                  {%- if on_sale -%}
                    <span class="vy-price-was">{{ product.compare_at_price | money }}</span>
                    <span class="vy-price-save">Save {{ disc }}%</span>
                  {%- endif -%}
                </div>

                <!-- CTA button -->
                {%- if multi -%}
                  <button class="vy-card__btn vy-open-vp" data-pid="{{ product.id }}">
                    <span>Select Options</span>
                  </button>
                {%- elsif product.available -%}
                  <button class="vy-card__btn vy-atc"
                          data-vid="{{ fv.id }}"
                          data-title="{{ product.title | escape }}"
                          data-pid="{{ product.id }}">
                    <span>Add to Cart</span>
                  </button>
                {%- else -%}
                  <button class="vy-card__btn" disabled><span>Sold Out</span></button>
                {%- endif -%}

              </div>
            </article>
          {%- else -%}
            <div class="vy-empty">
              <svg class="vy-empty__icon" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M15.75 10.5V6a3.75 3.75 0 10-7.5 0v4.5m11.356-1.993l1.263 12c.07.665-.45 1.243-1.119 1.243H4.25a1.125 1.125 0 01-1.12-1.243l1.264-12A1.125 1.125 0 015.513 7.5h12.974c.576 0 1.059.435 1.119 1.007zM8.625 10.5a.375.375 0 11-.75 0 .375.375 0 01.75 0zm7.5 0a.375.375 0 11-.75 0 .375.375 0 01.75 0z"/></svg>
              <h2 class="vy-empty__title">No products found</h2>
              <p class="vy-empty__desc">Try adjusting your filters or browse our full range.</p>
              <a href="{{ routes.collections_url }}" class="vy-empty__cta">Browse All</a>
            </div>
          {%- endfor -%}

        </div>

        <!-- Pagination -->
        {%- if paginate.pages > 1 -%}
        <nav class="vy-pagination" aria-label="Pagination">
          {%- if paginate.previous -%}
            <a href="{{ paginate.previous.url }}" class="vy-page" aria-label="Previous">
              <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M15.75 19.5L8.25 12l7.5-7.5"/></svg>
            </a>
          {%- else -%}
            <span class="vy-page dis" aria-disabled="true"><svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M15.75 19.5L8.25 12l7.5-7.5"/></svg></span>
          {%- endif -%}

          {%- for part in paginate.parts -%}
            {%- if part.is_link -%}
              <a href="{{ part.url }}" class="vy-page">{{ part.title }}</a>
            {%- elsif part.title == paginate.current_page -%}
              <span class="vy-page cur" aria-current="page">{{ part.title }}</span>
            {%- else -%}
              <span class="vy-page">{{ part.title }}</span>
            {%- endif -%}
          {%- endfor -%}

          {%- if paginate.next -%}
            <a href="{{ paginate.next.url }}" class="vy-page" aria-label="Next">
              <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M8.25 4.5l7.5 7.5-7.5 7.5"/></svg>
            </a>
          {%- else -%}
            <span class="vy-page dis" aria-disabled="true"><svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M8.25 4.5l7.5 7.5-7.5 7.5"/></svg></span>
          {%- endif -%}
        </nav>
        {%- endif -%}

      </main>
    </div>

    <!-- Stats band -->
    {%- if section.settings.show_stats -%}
    <div class="vy-stats" id="vyStats">
      <div class="vy-stats__grid">
        <div class="vy-stats__item">
          <div class="vy-stats__num">{{ section.settings.stat1n | default: '50K+' }}</div>
          <div class="vy-stats__lbl">{{ section.settings.stat1l | default: 'Happy Customers' }}</div>
        </div>
        <div class="vy-stats__item">
          <div class="vy-stats__num">{{ section.settings.stat2n | default: '4.9★' }}</div>
          <div class="vy-stats__lbl">{{ section.settings.stat2l | default: 'Average Rating' }}</div>
        </div>
        <div class="vy-stats__item">
          <div class="vy-stats__num">{{ section.settings.stat3n | default: '100%' }}</div>
          <div class="vy-stats__lbl">{{ section.settings.stat3l | default: 'Authentic Products' }}</div>
        </div>
        <div class="vy-stats__item">
          <div class="vy-stats__num">{{ section.settings.stat4n | default: '24/7' }}</div>
          <div class="vy-stats__lbl">{{ section.settings.stat4l | default: 'Customer Support' }}</div>
        </div>
      </div>
    </div>
    {%- endif -%}

  </div>
</div>


<!-- ══════════════════════════════════════════
     STICKY ADD-TO-CART BAR
══════════════════════════════════════════ -->
<div class="vy-sticky-bar" id="vyStickyBar" role="region" aria-label="Quick add to cart">
  <div class="vy-sticky-bar__info">
    <div class="vy-sticky-bar__title" id="vyStickyTitle">–</div>
    <div class="vy-sticky-bar__price" id="vyStickyPrice">–</div>
  </div>
  <div class="vy-sticky-bar__right">
    <div class="vy-sticky-vchips" id="vyStickyChips"></div>
    <button class="vy-sticky-atc" id="vyStickyAtc" disabled>Add to Cart</button>
    <button class="vy-sticky-close" id="vyStickyClose" aria-label="Dismiss">
      <svg width="12" height="12" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
    </button>
  </div>
</div>


<script>
/* ══════════════════════════════════════════════════════
   VYRA ELITE COLLECTION — SMOOTH EDITION v2.1
   All GPU-composited, rAF-batched, passive-scroll.
══════════════════════════════════════════════════════ */
(function () {
  'use strict';

  /* ── State ── */
  const S = {
    wishlist: new Set(),
    filters: { av: [], type: [], pMin: 0, pMax: Infinity },
    sticky: { product: null, variantId: null, dismissed: false },
    prevCdVals: { h: -1, m: -1, s: -1 },   // for smooth digit-flip
  };

  const $ = (id) => document.getElementById(id);
  const $$ = (sel, ctx = document) => Array.from(ctx.querySelectorAll(sel));

  /* ════════════════════════════
     TOAST
  ════════════════════════════ */
  function toast(title, msg, type = 'ok') {
    const wrap = $('vyToasts');
    if (!wrap) return;
    const ok  = `<svg class="vy-toast__icon" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>`;
    const err = `<svg class="vy-toast__icon" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3.75m9-.75a9 9 0 11-18 0 9 9 0 0118 0zm-9 3.75h.008v.008H12v-.008z"/></svg>`;
    const el = document.createElement('div');
    el.className = `vy-toast vy-toast--${type}${type === 'err' ? ' err' : ''}`;
    el.innerHTML = `${type === 'ok' ? ok : err}<div><div class="vy-toast__title">${title}</div><div class="vy-toast__msg">${msg}</div></div>`;
    wrap.appendChild(el);
    setTimeout(() => {
      el.style.animation = 'vy-toast-out .28s var(--ease-steady) forwards';
      setTimeout(() => el.remove(), 300);
    }, 3400);
  }

  /* ════════════════════════════
     CART API
  ════════════════════════════ */
  async function addToCart(variantId, btn, title) {
    if (!variantId) { toast('Select a size', 'Please choose a variant first', 'err'); return; }
    const orig = btn.innerHTML;
    btn.classList.add('loading');
    btn.disabled = true;
    try {
      const res = await fetch('/cart/add.js', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ items: [{ id: Number(variantId), quantity: 1 }] }),
      });
      if (!res.ok) {
        const e = await res.json().catch(() => ({}));
        throw new Error(e.description || 'Could not add to cart');
      }
      btn.classList.remove('loading');
      btn.innerHTML = orig.replace(/<span>.*?<\/span>/s, '<span>Added ✓</span>').replace(/^[^<].*$/, 'Added ✓');
      toast('Added to cart ✓', title, 'ok');
      updateCartBubble();
      document.dispatchEvent(new CustomEvent('cart:add', { detail: { variantId } }));
      if (window.theme?.openCartDrawer) window.theme.openCartDrawer();
      setTimeout(() => { btn.innerHTML = orig; btn.disabled = false; }, 2400);
    } catch (err) {
      btn.classList.remove('loading');
      btn.innerHTML = orig;
      btn.disabled = false;
      toast('Error', err.message || 'Please try again', 'err');
    }
  }

  async function updateCartBubble() {
    try {
      const r = await fetch('/cart.js');
      const c = await r.json();
      $$('[data-cart-count]').forEach(el => { el.textContent = c.item_count; });
      document.dispatchEvent(new CustomEvent('cart:updated', { detail: { cart: c } }));
    } catch (_) {}
  }

  /* ════════════════════════════
     WISHLIST
  ════════════════════════════ */
  function loadWishlist() {
    try { const r = localStorage.getItem('vy_wl'); if (r) S.wishlist = new Set(JSON.parse(r)); } catch (_) {}
  }
  function saveWishlist() {
    try { localStorage.setItem('vy_wl', JSON.stringify([...S.wishlist])); } catch (_) {}
  }
  function syncWishlist() {
    $$('.vy-wish').forEach(btn => {
      const a = S.wishlist.has(btn.dataset.pid);
      btn.classList.toggle('active', a);
      btn.setAttribute('aria-pressed', String(a));
    });
  }

  /* ════════════════════════════
     SCROLL-DRIVEN REVEALS
     IntersectionObserver for cards, trust, stats
  ════════════════════════════ */
  function initRevealObservers() {
    /* Cards — staggered by natural index within viewport batch */
    const cardObs = new IntersectionObserver((entries) => {
      let batchDelay = 0;
      entries.forEach(entry => {
        if (!entry.isIntersecting) return;
        const el = entry.target;
        const idx = parseInt(el.style.getPropertyValue('--vy-i') || '0', 10);
        // Cap stagger at 6 cards per batch (330ms max)
        const delay = Math.min(idx % 6, 5) * 55;
        setTimeout(() => {
          requestAnimationFrame(() => { el.classList.add('revealed'); });
        }, delay);
        cardObs.unobserve(el);
      });
    }, { threshold: 0.08, rootMargin: '0px 0px -40px 0px' });

    $$('.vy-card').forEach(c => cardObs.observe(c));

    /* Trust items */
    const trustObs = new IntersectionObserver((entries) => {
      entries.forEach((entry, i) => {
        if (!entry.isIntersecting) return;
        setTimeout(() => {
          requestAnimationFrame(() => entry.target.classList.add('in-view'));
        }, i * 60);
        trustObs.unobserve(entry.target);
      });
    }, { threshold: 0.3 });
    $$('.vy-trust__item').forEach(el => trustObs.observe(el));

    /* Stats items */
    const statsObs = new IntersectionObserver((entries) => {
      entries.forEach((entry, i) => {
        if (!entry.isIntersecting) return;
        requestAnimationFrame(() => entry.target.classList.add('in-view'));
        statsObs.unobserve(entry.target);
      });
    }, { threshold: 0.2 });
    $$('.vy-stats__item').forEach(el => statsObs.observe(el));
  }

  /* ════════════════════════════
     TOOLBAR SCROLL SHADOW
     Passive listener — zero jank
  ════════════════════════════ */
  function initToolbarScroll() {
    const toolbar = $('vyToolbar');
    if (!toolbar) return;
    let ticking = false;
    window.addEventListener('scroll', () => {
      if (!ticking) {
        requestAnimationFrame(() => {
          toolbar.classList.toggle('scrolled', window.scrollY > 80);
          ticking = false;
        });
        ticking = true;
      }
    }, { passive: true });
  }

  /* ════════════════════════════
     LIVE VIEWER COUNT
  ════════════════════════════ */
  function initViewers() {
    const KEY = 'vy_viewers_{{ collection.handle }}';
    let base;
    try {
      const stored = sessionStorage.getItem(KEY);
      base = stored ? parseInt(stored, 10) : Math.floor(Math.random() * 35) + 8;
      if (!stored) sessionStorage.setItem(KEY, String(base));
    } catch (_) { base = Math.floor(Math.random() * 35) + 8; }

    const heroEl = $('vyViewers');
    if (heroEl) setViewerCount(heroEl, base);

    $$('.vy-viewers-num').forEach(el => {
      el.textContent = Math.max(1, Math.floor(base * (0.1 + Math.random() * 0.35)));
    });

    let current = base;
    function drift() {
      current = Math.max(6, Math.min(55, current + (Math.random() < .5 ? 1 : -1)));
      if (heroEl) setViewerCount(heroEl, current);
      $$('.vy-viewers-num').forEach(el => {
        const prev = parseInt(el.textContent, 10) || 1;
        if (Math.random() < .4) {
          const next = Math.max(1, prev + (Math.random() < .5 ? 1 : -1));
          el.textContent = next;
        }
      });
      setTimeout(drift, 9000 + Math.random() * 7000);
    }
    setTimeout(drift, 11000);
  }

  /* Smooth counter: animate number change */
  function setViewerCount(el, to) {
    const from = parseInt(el.textContent, 10) || to;
    if (from === to) { el.textContent = to; return; }
    const dur = 600, steps = 20, step = (to - from) / steps;
    let i = 0;
    function tick() {
      i++;
      el.textContent = Math.round(from + step * i);
      if (i < steps) requestAnimationFrame(tick);
      else el.textContent = to;
    }
    requestAnimationFrame(tick);
  }

  /* ════════════════════════════
     COUNTDOWN TIMER
     With smooth digit-flip animations
  ════════════════════════════ */
  function initCountdown() {
    const bar = $('vyCountdownBar');
    if (!bar) return;
    const SETTING_HOURS = {{ section.settings.countdown_hours | default: 4 }};
    const KEY = 'vy_cd_end_{{ section.id }}';
    let endTime;
    try {
      const stored = sessionStorage.getItem(KEY);
      if (stored) { endTime = parseInt(stored, 10); }
      else { endTime = Date.now() + SETTING_HOURS * 3600 * 1000; sessionStorage.setItem(KEY, String(endTime)); }
    } catch (_) { endTime = Date.now() + SETTING_HOURS * 3600 * 1000; }

    const hEl = $('vyH'), mEl = $('vyM'), sEl = $('vyS');
    if (!hEl) return;

    function pad(n) { return String(n).padStart(2, '0'); }

    /* Animate digit change with flip */
    function updateDigit(el, val) {
      const str = pad(val);
      if (el.textContent === str) return;
      el.classList.remove('flip-in');
      el.classList.add('flip-out');
      setTimeout(() => {
        el.textContent = str;
        el.classList.remove('flip-out');
        el.classList.add('flip-in');
        setTimeout(() => el.classList.remove('flip-in'), 160);
      }, 80);
    }

    function tick() {
      const diff = endTime - Date.now();
      if (diff <= 0) {
        try { sessionStorage.removeItem(KEY); } catch (_) {}
        bar.style.opacity = '0';
        bar.style.transition = 'opacity 0.4s ease';
        setTimeout(() => { bar.style.display = 'none'; }, 400);
        return;
      }
      const h = Math.floor(diff / 3600000);
      const m = Math.floor((diff % 3600000) / 60000);
      const s = Math.floor((diff % 60000) / 1000);

      /* Only update + animate changed digits */
      if (h !== S.prevCdVals.h) { updateDigit(hEl, h); S.prevCdVals.h = h; }
      if (m !== S.prevCdVals.m) { updateDigit(mEl, m); S.prevCdVals.m = m; }
      if (s !== S.prevCdVals.s) { updateDigit(sEl, s); S.prevCdVals.s = s; }

      setTimeout(tick, 1000);
    }
    tick();
  }

  /* ════════════════════════════
     STICKY ATC BAR
  ════════════════════════════ */
  function initStickyBar() {
    const bar = $('vyStickyBar');
    if (!bar || S.sticky.dismissed) return;
    const cards = $$('.vy-card');
    if (!cards.length) return;

    const firstCard = cards[0];
    const io = new IntersectionObserver(([entry]) => {
      if (!S.sticky.dismissed) {
        requestAnimationFrame(() => bar.classList.toggle('show', !entry.isIntersecting));
      }
    }, { threshold: 0 });
    io.observe(firstCard);

    function loadProduct(card) {
      const title = card.dataset.title;
      const pid   = card.dataset.pid;
      const price = (parseInt(card.dataset.price, 10) / 100).toLocaleString('en-PK', { minimumFractionDigits: 0 });
      /* Smooth title crossfade */
      const titleEl = $('vyStickyTitle'), priceEl = $('vyStickyPrice');
      if (titleEl.textContent !== title) {
        titleEl.style.opacity = '0';
        priceEl.style.opacity = '0';
        setTimeout(() => {
          titleEl.textContent = title;
          priceEl.textContent = 'Rs. ' + price;
          titleEl.style.opacity = '1';
          priceEl.style.opacity = '1';
        }, 120);
      }

      const panel = document.getElementById(`vp-${pid}`);
      const chips = $('vyStickyChips');
      chips.innerHTML = '';
      if (panel) {
        $$('.vy-vchip', panel).forEach(c => {
          const btn = document.createElement('button');
          btn.className = 'vy-sticky-vchip' + (c.classList.contains('out') ? ' out' : '') + (c.classList.contains('sel') ? ' sel' : '');
          btn.textContent = c.textContent;
          btn.dataset.vid = c.dataset.vid;
          if (c.classList.contains('out')) btn.disabled = true;
          btn.addEventListener('click', () => {
            $$('.vy-sticky-vchip', chips).forEach(b => b.classList.remove('sel'));
            btn.classList.add('sel');
            $('vyStickyAtc').dataset.vid = btn.dataset.vid;
            $('vyStickyAtc').disabled = false;
          });
          chips.appendChild(btn);
        });
        const firstSel = chips.querySelector('.vy-sticky-vchip.sel');
        if (firstSel) { $('vyStickyAtc').dataset.vid = firstSel.dataset.vid; $('vyStickyAtc').disabled = false; }
      } else {
        $('vyStickyAtc').dataset.vid = card.dataset.variant;
        $('vyStickyAtc').disabled = card.dataset.avail !== 'true';
      }
      S.sticky.product = { title, pid };
    }

    loadProduct(firstCard);

    cards.forEach(card => {
      card.addEventListener('mouseenter', () => {
        if (bar.classList.contains('show')) loadProduct(card);
      });
    });

    $('vyStickyAtc').addEventListener('click', function () {
      addToCart(this.dataset.vid, this, S.sticky.product?.title || 'Product');
    });

    $('vyStickyClose').addEventListener('click', () => {
      bar.classList.remove('show');
      S.sticky.dismissed = true;
      io.disconnect();
    });
  }

  /* ════════════════════════════
     CLIENT-SIDE FILTERS
     Smooth show/hide with animation
  ════════════════════════════ */
  function applyFilters() {
    const cards = $$('.vy-card');
    let visible = 0;

    cards.forEach(card => {
      const avail = card.dataset.avail === 'true';
      const sale  = card.dataset.sale  === 'true';
      const isNew = card.dataset.new   === 'true';
      const type  = card.dataset.type;
      const price = parseInt(card.dataset.price, 10) / 100;

      let show = true;
      if (S.filters.av.length) {
        show = S.filters.av.some(f =>
          f === 'in-stock' ? avail : f === 'sale' ? sale : f === 'new' ? isNew : false
        );
      }
      if (S.filters.type.length && !S.filters.type.includes(type)) show = false;
      if (price < S.filters.pMin || price > S.filters.pMax) show = false;

      if (show) {
        visible++;
        if (card.style.display === 'none') {
          card.style.display = '';
          card.classList.remove('hide-card');
          card.classList.add('show-card');
          setTimeout(() => card.classList.remove('show-card'), 300);
        }
      } else {
        if (card.style.display !== 'none') {
          card.classList.add('hide-card');
          setTimeout(() => {
            card.style.display = 'none';
            card.classList.remove('hide-card');
          }, 200);
        }
      }
    });

    /* Smooth count update */
    const vc = $('vyVisibleCount');
    if (vc) {
      const from = parseInt(vc.textContent, 10) || visible;
      animateCount(vc, from, visible, 300);
    }
    renderAFPills();
    calcFilterCounts();
  }

  /* Animate a number element smoothly */
  function animateCount(el, from, to, duration) {
    const start = performance.now();
    function step(now) {
      const progress = Math.min((now - start) / duration, 1);
      const eased = 1 - Math.pow(1 - progress, 3); // ease-out-cubic
      el.textContent = Math.round(from + (to - from) * eased);
      if (progress < 1) requestAnimationFrame(step);
      else el.textContent = to;
    }
    requestAnimationFrame(step);
  }

  function renderAFPills() {
    const wrap = $('vyAF');
    if (!wrap) return;
    const all = [...S.filters.av, ...S.filters.type];
    if (!all.length) { wrap.style.display = 'none'; wrap.innerHTML = ''; return; }
    wrap.style.display = 'flex';
    wrap.innerHTML = all.map(f =>
      `<span class="vy-af-pill">${f.replace(/-/g,' ')}<button class="vy-af-remove" data-f="${f}" aria-label="Remove ${f}">✕</button></span>`
    ).join('') + (all.length > 1 ? `<button class="vy-clear-all">Clear All</button>` : '');
    $$('.vy-af-remove', wrap).forEach(b => b.addEventListener('click', () => removeFilter(b.dataset.f)));
    wrap.querySelector('.vy-clear-all')?.addEventListener('click', clearFilters);
  }

  function removeFilter(val) {
    S.filters.av   = S.filters.av.filter(v => v !== val);
    S.filters.type = S.filters.type.filter(v => v !== val);
    $$(`input[value="${val}"]`).forEach(cb => { cb.checked = false; });
    applyFilters();
  }

  function clearFilters() {
    S.filters = { av: [], type: [], pMin: 0, pMax: Infinity };
    $$('.vy-sidebar input[type=checkbox]').forEach(cb => { cb.checked = false; });
    applyFilters();
  }

  function calcFilterCounts() {
    const cards = $$('.vy-card');
    let stock = 0, sale = 0, nw = 0;
    cards.forEach(c => {
      if (c.dataset.avail === 'true') stock++;
      if (c.dataset.sale  === 'true') sale++;
      if (c.dataset.new   === 'true') nw++;
    });
    const cs = $('cntStock'), csa = $('cntSale'), cn = $('cntNew');
    if (cs) cs.textContent = stock;
    if (csa) csa.textContent = sale;
    if (cn) cn.textContent = nw;
  }

  /* ════════════════════════════
     PRICE RANGE
  ════════════════════════════ */
  function initPriceRange() {
    const mn = $('prMin'), mx = $('prMax'), fill = $('vyPriceFill');
    const lMin = $('pMin'), lMax = $('pMax');
    if (!mn || !mx) return;
    const top = parseInt(mn.max, 10);

    let rafId = null;
    function update() {
      if (rafId) cancelAnimationFrame(rafId);
      rafId = requestAnimationFrame(() => {
        let lo = parseInt(mn.value, 10), hi = parseInt(mx.value, 10);
        if (lo > hi) [lo, hi] = [hi, lo];
        const lp = (lo / top) * 100, hp = (hi / top) * 100;
        fill.style.left = lp + '%';
        fill.style.width = (hp - lp) + '%';
        lMin.textContent = 'Rs. ' + lo.toLocaleString();
        lMax.textContent = 'Rs. ' + hi.toLocaleString();
        S.filters.pMin = lo; S.filters.pMax = hi;
        applyFilters();
        rafId = null;
      });
    }
    mn.addEventListener('input', update, { passive: true });
    mx.addEventListener('input', update, { passive: true });
    update();
  }

  /* ════════════════════════════
     SIDEBAR
  ════════════════════════════ */
  function openSidebar() {
    $('vySidebar')?.classList.add('open');
    $('vyOverlay')?.classList.add('open');
    document.body.style.overflow = 'hidden';
    $('vyFilterBtn')?.setAttribute('aria-expanded', 'true');
    setTimeout(() => $('vySidebarClose')?.focus(), 350);
  }
  function closeSidebar() {
    $('vySidebar')?.classList.remove('open');
    $('vyOverlay')?.classList.remove('open');
    document.body.style.overflow = '';
    $('vyFilterBtn')?.setAttribute('aria-expanded', 'false');
  }

  /* ════════════════════════════
     VARIANT PANELS
  ════════════════════════════ */
  function initVariantPanels() {
    document.addEventListener('click', e => {
      const btn = e.target.closest('.vy-open-vp');
      if (!btn) return;
      e.preventDefault();
      const pid = btn.dataset.pid;
      const panel = document.getElementById(`vp-${pid}`);
      if (panel) {
        const isOpen = panel.classList.contains('open');
        /* Close all other panels first */
        $$('.vy-card__vpanel.open').forEach(p => { if (p !== panel) p.classList.remove('open'); });
        panel.classList.toggle('open', !isOpen);
      }
    });

    document.addEventListener('click', e => {
      const chip = e.target.closest('.vy-vchip[data-pid]');
      if (!chip) return;
      const pid = chip.dataset.pid;
      const panel = document.getElementById(`vp-${pid}`);
      if (!panel) return;
      $$('.vy-vchip', panel).forEach(c => c.classList.remove('sel'));
      chip.classList.add('sel');
      const selLbl = document.getElementById(`vpSel-${pid}`);
      if (selLbl) selLbl.textContent = chip.textContent.trim();
      const atcBtn = panel.querySelector('.vy-atc[data-vpanel]');
      if (atcBtn) atcBtn.dataset.vid = chip.dataset.vid;
    });

    /* Close panel on outside click */
    document.addEventListener('click', e => {
      if (!e.target.closest('.vy-card__vpanel') && !e.target.closest('.vy-open-vp')) {
        $$('.vy-card__vpanel.open').forEach(p => p.classList.remove('open'));
      }
    });
  }

  /* ════════════════════════════
     GRID VIEW — smooth column transition
  ════════════════════════════ */
  function setView(cols) {
    const grid = $('vyGrid');
    if (!grid) return;
    /* Short fade during layout shift */
    grid.style.transition = 'opacity 0.15s ease';
    grid.style.opacity = '0';
    requestAnimationFrame(() => {
      grid.style.setProperty('--cols', cols);
      requestAnimationFrame(() => {
        grid.style.opacity = '1';
        setTimeout(() => { grid.style.transition = ''; }, 200);
      });
    });
    $$('.vy-vbtn').forEach(btn => {
      const a = parseInt(btn.dataset.cols, 10) === cols;
      btn.classList.toggle('active', a);
      btn.setAttribute('aria-pressed', String(a));
    });
  }

  /* ════════════════════════════
     SORT
  ════════════════════════════ */
  function initSort() {
    $('vySort')?.addEventListener('change', function () {
      const url = new URL(window.location.href);
      this.value ? url.searchParams.set('sort_by', this.value) : url.searchParams.delete('sort_by');
      /* Smooth page transition if View Transitions API available */
      if (document.startViewTransition) {
        document.startViewTransition(() => { window.location.href = url.toString(); });
      } else {
        window.location.href = url.toString();
      }
    });
  }

  /* ════════════════════════════
     INIT
  ════════════════════════════ */
  function boot() {
    loadWishlist();
    syncWishlist();
    calcFilterCounts();
    initSort();
    initPriceRange();
    initVariantPanels();
    initViewers();
    initCountdown();
    initRevealObservers();
    initToolbarScroll();

    setTimeout(initStickyBar, 600);

    /* Wishlist toggle — with heart pop */
    document.addEventListener('click', e => {
      const btn = e.target.closest('.vy-wish');
      if (!btn) return;
      e.preventDefault();
      const pid = btn.dataset.pid;
      const was = S.wishlist.has(pid);
      was ? S.wishlist.delete(pid) : S.wishlist.add(pid);
      saveWishlist();
      syncWishlist();
      /* Trigger pop animation */
      btn.classList.remove('pop-heart');
      requestAnimationFrame(() => {
        requestAnimationFrame(() => btn.classList.add('pop-heart'));
      });
      btn.addEventListener('animationend', () => btn.classList.remove('pop-heart'), { once: true });
      toast(was ? 'Removed' : 'Saved ♥', was ? 'Removed from wishlist' : 'Added to wishlist');
    });

    /* ATC event delegation */
    document.addEventListener('click', e => {
      const btn = e.target.closest('.vy-atc');
      if (!btn) return;
      e.preventDefault();
      addToCart(btn.dataset.vid, btn, btn.dataset.title || 'Product');
    });

    /* Filter checkboxes */
    $$('.vy-sidebar input[type=checkbox]').forEach(cb => {
      cb.addEventListener('change', () => {
        const key = cb.name === 'f-av' ? 'av' : 'type';
        if (cb.checked) { S.filters[key].push(cb.value); }
        else { S.filters[key] = S.filters[key].filter(v => v !== cb.value); }
        applyFilters();
      });
    });

    /* Sidebar */
    $('vyFilterBtn')?.addEventListener('click', openSidebar);
    $('vySidebarClose')?.addEventListener('click', closeSidebar);
    $('vyOverlay')?.addEventListener('click', closeSidebar);

    /* View toggle */
    $$('.vy-vbtn').forEach(btn => {
      btn.addEventListener('click', () => {
        if (btn.dataset.cols) setView(parseInt(btn.dataset.cols, 10));
      });
    });

    /* Keyboard */
    document.addEventListener('keydown', e => {
      if (e.key === 'Escape') {
        const s = $('vySidebar');
        if (s?.classList.contains('open')) closeSidebar();
      }
    });
  }

  document.readyState === 'loading'
    ? document.addEventListener('DOMContentLoaded', boot)
    : boot();

})();
</script>


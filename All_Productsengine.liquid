    padding: 14px 32px;
    border: 2px solid var(--primary-noir);
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 1px;
    text-transform: uppercase;
    border-radius: 30px;
    cursor: pointer;
    opacity: 0;
    transition: var(--transition-smooth);

.luxury-quick-view-btn:hover {
  background: var(--luxury-black);
  color: var(--luxury-white);
  transform: translateX(-50%) translateY(-4px);
  box-shadow: var(--shadow-elevated);
}

/* Product Info */
.luxury-product-info {
  display: flex;
  flex-direction: column;
  gap: 6px;
}

.luxury-product-vendor {
  font-size: 10px;
  font-weight: 600;
  letter-spacing: 1.5px;
  text-transform: uppercase;
  color: var(--luxury-warm-gray);
}

.luxury-product-title {
  font-family: var(--font-heading);
  font-size: 18px;
  font-weight: 500;
  line-height: 1.3;
  color: var(--luxury-black);
  margin: 0;
  min-height: 2.6em;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.luxury-product-title a {
  color: inherit;
  text-decoration: none;
  transition: color var(--transition-quick);
}

.luxury-product-title a:hover {
  color: var(--luxury-gold);
}

/* Reviews - CRO Element */
.luxury-product-reviews {
  display: flex;
  align-items: center;
  gap: 6px;
  margin: 6px 0;
}

.luxury-review-stars {
  display: flex;
  gap: 2px;
  color: var(--luxury-gold);
}

.luxury-review-stars svg {
  width: 14px;
  height: 14px;
}

.luxury-review-count {
  font-size: 11px;
  color: var(--luxury-warm-gray);
  font-weight: 500;
}

/* Price */
.luxury-product-price {
  display: flex;
  align-items: baseline;
  gap: 10px;
  margin: 8px 0;
  flex-wrap: wrap;
}

.luxury-price-current {
  font-size: 18px;
  font-weight: 600;
  color: var(--luxury-black);
  font-family: var(--font-heading);
}

.luxury-price-compare {
  font-size: 15px;
  color: var(--luxury-warm-gray);
  text-decoration: line-through;
}

.luxury-price-save {
  font-size: 10px;
  font-weight: 700;
  letter-spacing: 0.5px;
  text-transform: uppercase;
  color: var(--luxury-error);
  background: rgba(211, 47, 47, 0.1);
  padding: 3px 8px;
  border-radius: var(--radius);
}

/* Sold Count - CRO Element */
.luxury-sold-count {
  font-size: 11px;
  color: var(--luxury-success);
  font-weight: 600;
  display: flex;
  align-items: center;
  gap: 4px;
  margin: 6px 0;
}

.luxury-sold-count svg {
  width: 14px;
  height: 14px;
}

/* Add to Cart Button */
.luxury-add-to-cart-btn {
  width: 100%;
  padding: 14px;
  background: var(--luxury-black);
  border: none;
  border-radius: var(--radius);
  font-size: 12px;
  font-weight: 700;
  letter-spacing: 1px;
  text-transform: uppercase;
  color: var(--luxury-white);
  cursor: pointer;
  transition: all var(--transition-quick);
  font-family: var(--font-body);
  margin-top: 12px;
  position: relative;
  overflow: hidden;
}

.luxury-add-to-cart-btn::before {
  content: '';
  position: absolute;
  top: 50%;
  left: 50%;
  width: 0;
  height: 0;
  background: rgba(255, 255, 255, 0.2);
  border-radius: 50%;
  transform: translate(-50%, -50%);
  transition: width 0.5s, height 0.5s;
}

.luxury-add-to-cart-btn:hover::before {
  width: 300px;
  height: 300px;
}

.luxury-add-to-cart-btn:hover:not(:disabled) {
  background: var(--luxury-charcoal);
  transform: translateY(-3px);
  box-shadow: var(--shadow-medium);
}

.luxury-add-to-cart-btn:active:not(:disabled) {
  transform: translateY(-1px);
}

.luxury-add-to-cart-btn:disabled {
  background: var(--luxury-light-gray);
  color: var(--luxury-warm-gray);
  cursor: not-allowed;
}

.luxury-add-to-cart-btn.loading {
  position: relative;
  color: transparent;
  pointer-events: none;
}

.luxury-add-to-cart-btn.loading::after {
  content: '';
  position: absolute;
  top: 50%;
  left: 50%;
  width: 16px;
  height: 16px;
  margin: -8px 0 0 -8px;
  border: 2px solid rgba(255, 255, 255, 0.3);
  border-top-color: var(--luxury-white);
  border-radius: 50%;
  animation: luxurySpinner 0.6s linear infinite;
}

@keyframes luxurySpinner {
  to { transform: rotate(360deg); }
}

/* ═══════════════════════════════════════════════════════════════════════════
   QUICK VIEW MODAL - Enhanced
═══════════════════════════════════════════════════════════════════════════ */

.luxury-modal-backdrop {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: rgba(0, 0, 0, 0.85);
  z-index: 999;
  display: none;
  align-items: center;
  justify-content: center;
  padding: 20px;
  opacity: 0;
  transition: opacity var(--transition-smooth);
  backdrop-filter: blur(8px);
}

.luxury-modal-backdrop.active {
  display: flex;
  opacity: 1;
}

.luxury-modal-content {
  background: var(--luxury-white);
  max-width: 1100px;
  width: 100%;
  max-height: 90vh;
  overflow-y: auto;
  border-radius: var(--radius-lg);
  box-shadow: var(--shadow-intense);
  position: relative;
  transform: scale(0.9);
  transition: transform var(--transition-smooth);
}

.luxury-modal-backdrop.active .luxury-modal-content {
  transform: scale(1);
  animation: luxuryModalIn 0.4s var(--transition-bounce);
}

@keyframes luxuryModalIn {
  from {
    transform: scale(0.9) translateY(30px);
    opacity: 0;
  }
  to {
    transform: scale(1) translateY(0);
    opacity: 1;
  }
}

.luxury-modal-close {
  position: absolute;
  top: 20px;
  right: 20px;
  width: 40px;
  height: 40px;
  background: var(--luxury-white);
  border: 1.5px solid var(--luxury-light-gray);
  border-radius: 50%;
  cursor: pointer;
  z-index: 10;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all var(--transition-quick);
  box-shadow: var(--shadow-subtle);
}

.luxury-modal-close:hover {
  transform: rotate(90deg) scale(1.1);
  background: var(--luxury-black);
  border-color: var(--luxury-black);
}

.luxury-modal-close:hover svg {
  stroke: var(--luxury-white);
}

.luxury-modal-grid {
  display: grid;
  grid-template-columns: 1fr;
  gap: 0;
}

@media (min-width: 960px) {
  .luxury-modal-grid {
    grid-template-columns: 1fr 1fr;
  }
}

.luxury-modal-image-section {
  background: var(--luxury-pearl);
  min-height: 400px;
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
}

.luxury-modal-image {
  width: 100%;
  height: 100%;
  object-fit: cover;
  min-height: 500px;
}

/* Modal Trust Signals */
.luxury-modal-trust-signals {
  display: flex;
  flex-direction: column;
  gap: 12px;
  padding: 20px;
  background: rgba(46, 125, 50, 0.05);
  border-radius: var(--radius);
  border: 1px solid rgba(46, 125, 50, 0.1);
  margin: 20px 0;
}

.luxury-modal-trust-item {
  display: flex;
  align-items: center;
  gap: 10px;
  font-size: 13px;
  color: var(--luxury-black);
  font-weight: 500;
}

.luxury-modal-trust-item svg {
  width: 18px;
  height: 18px;
  color: var(--luxury-success);
  flex-shrink: 0;
}

.luxury-modal-details-section {
  padding: clamp(32px, 6vw, 60px);
}

.luxury-modal-vendor {
  font-size: 11px;
  font-weight: 600;
  letter-spacing: 1.5px;
  text-transform: uppercase;
  color: var(--luxury-warm-gray);
  margin-bottom: 8px;
}

.luxury-modal-title {
  font-family: var(--font-heading);
  font-size: clamp(24px, 4vw, 36px);
  font-weight: 600;
  line-height: 1.2;
  color: var(--luxury-black);
  margin: 0 0 16px;
}

.luxury-modal-price-section {
  display: flex;
  align-items: baseline;
  gap: 12px;
  padding-bottom: 20px;
  border-bottom: 1px solid var(--luxury-light-gray);
  margin-bottom: 20px;
}

.luxury-modal-price-current {
  font-family: var(--font-heading);
  font-size: 32px;
  font-weight: 600;
  color: var(--luxury-black);
}

.luxury-modal-price-compare {
  font-size: 22px;
  color: var(--luxury-warm-gray);
  text-decoration: line-through;
}

.luxury-modal-description {
  font-size: 15px;
  line-height: 1.7;
  color: var(--luxury-warm-gray);
  margin-bottom: 24px;
}

.luxury-modal-options {
  margin-bottom: 24px;
}

.luxury-option-label {
  font-size: 12px;
  font-weight: 700;
  letter-spacing: 1px;
  text-transform: uppercase;
  color: var(--luxury-black);
  margin-bottom: 12px;
  display: block;
}

.luxury-variant-selector {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(80px, 1fr));
  gap: 8px;
}

.luxury-variant-option {
  padding: 12px;
  border: 1.5px solid var(--luxury-light-gray);
  background: var(--luxury-white);
  text-align: center;
  cursor: pointer;
  font-size: 13px;
  font-weight: 600;
  border-radius: var(--radius);
  transition: all var(--transition-quick);
}

.luxury-variant-option:hover:not(.unavailable) {
  border-color: var(--luxury-black);
  transform: translateY(-2px);
  box-shadow: var(--shadow-subtle);
}

.luxury-variant-option.selected {
  background: var(--luxury-black);
  color: var(--luxury-white);
  border-color: var(--luxury-black);
}

.luxury-variant-option.unavailable {
  opacity: 0.3;
  cursor: not-allowed;
  text-decoration: line-through;
}

.luxury-modal-add-to-cart {
  width: 100%;
  padding: 18px;
  background: var(--luxury-black);
  border: none;
  border-radius: var(--radius);
  font-size: 13px;
  font-weight: 700;
  letter-spacing: 1.5px;
  text-transform: uppercase;
  color: var(--luxury-white);
  cursor: pointer;
  transition: all var(--transition-quick);
  font-family: var(--font-body);
  box-shadow: var(--shadow-medium);
  position: relative;
  overflow: hidden;
}

.luxury-modal-add-to-cart::before {
  content: '';
  position: absolute;
  top: 50%;
  left: 50%;
  width: 0;
  height: 0;
  background: rgba(255, 255, 255, 0.2);
  border-radius: 50%;
  transform: translate(-50%, -50%);
  transition: width 0.5s, height 0.5s;
}

.luxury-modal-add-to-cart:hover::before {
  width: 400px;
  height: 400px;
}

.luxury-modal-add-to-cart:hover {
  background: var(--luxury-charcoal);
  transform: translateY(-3px);
  box-shadow: var(--shadow-elevated);
}

.luxury-modal-add-to-cart.loading {
  position: relative;
  color: transparent;
  pointer-events: none;
}

.luxury-modal-add-to-cart.loading::after {
  content: '';
  position: absolute;
  top: 50%;
  left: 50%;
  width: 20px;
  height: 20px;
  margin: -10px 0 0 -10px;
  border: 2px solid rgba(255, 255, 255, 0.3);
  border-top-color: var(--luxury-white);
  border-radius: 50%;
  animation: luxurySpinner 0.6s linear infinite;
}

/* ═══════════════════════════════════════════════════════════════════════════
   TOAST NOTIFICATIONS - Smooth
═══════════════════════════════════════════════════════════════════════════ */

.luxury-toast-container {
  position: fixed;
  top: 20px;
  right: 20px;
  z-index: 1000;
  display: flex;
  flex-direction: column;
  gap: 10px;
  pointer-events: none;
  max-width: 400px;
}

.luxury-toast {
  background: var(--luxury-white);
  padding: 16px 20px;
  border-radius: var(--radius);
  box-shadow: var(--shadow-intense);
  display: flex;
  align-items: center;
  gap: 12px;
  pointer-events: auto;
  animation: luxuryToastSlide 0.4s var(--transition-bounce);
  border-left: 3px solid var(--luxury-success);
}

.luxury-toast.error {
  border-left-color: var(--luxury-error);
}

@keyframes luxuryToastSlide {
  from {
    transform: translateX(450px);
    opacity: 0;
  }
  to {
    transform: translateX(0);
    opacity: 1;
  }
}

.luxury-toast-icon {
  width: 20px;
  height: 20px;
  flex-shrink: 0;
}

.luxury-toast-content {
  flex: 1;
}

.luxury-toast-title {
  font-size: 13px;
  font-weight: 700;
  color: var(--luxury-black);
  margin-bottom: 2px;
}

.luxury-toast-message {
  font-size: 12px;
  color: var(--luxury-warm-gray);
}

.luxury-toast-close {
  width: 24px;
  height: 24px;
  border: none;
  background: transparent;
  cursor: pointer;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: background var(--transition-quick);
}

.luxury-toast-close:hover {
  background: var(--luxury-light-gray);
}

/* ═══════════════════════════════════════════════════════════════════════════
   PAGINATION
═══════════════════════════════════════════════════════════════════════════ */

.luxury-pagination {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
  padding: 60px 0 40px;
  flex-wrap: wrap;
}

.luxury-pagination-item {
  min-width: 44px;
  height: 44px;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 1.5px solid var(--luxury-light-gray);
  background: var(--luxury-white);
  color: var(--luxury-slate);
  font-size: 14px;
  font-weight: 600;
  cursor: pointer;
  transition: all var(--transition-quick);
  border-radius: var(--radius);
  text-decoration: none;
  font-family: var(--font-body);
}

.luxury-pagination-item:hover:not(.disabled) {
  border-color: var(--luxury-black);
  background: var(--luxury-black);
  color: var(--luxury-white);
  transform: translateY(-2px);
  box-shadow: var(--shadow-subtle);
}

.luxury-pagination-item.active {
  background: var(--luxury-black);
  color: var(--luxury-white);
  border-color: var(--luxury-black);
}

.luxury-pagination-item.disabled {
  opacity: 0.3;
  cursor: not-allowed;
  pointer-events: none;
}

/* ═══════════════════════════════════════════════════════════════════════════
   RESPONSIVE DESIGN
═══════════════════════════════════════════════════════════════════════════ */

@media (max-width: 960px) {
  .luxury-toolbar {
    flex-direction: column;
    align-items: stretch;
  }

  .luxury-toolbar-left,
  .luxury-toolbar-right {
    width: 100%;
    justify-content: space-between;
  }

  .luxury-filter-group {
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
  }

  .luxury-filter-group::-webkit-scrollbar {
    display: none;
  }

  .luxury-live-stats {
    grid-template-columns: 1fr;
  }

  .luxury-trust-grid {
    grid-template-columns: 1fr;
  }
}

@media (max-width: 640px) {
  .luxury-collection-header {
    padding: 40px 0 32px;
  }

  .luxury-collection-meta {
    flex-direction: column;
    gap: 12px;
  }

  .luxury-meta-divider {
    display: none;
  }

  .luxury-products-grid {
    grid-template-columns: 1fr;
    gap: 36px 0;
  }

  .luxury-toast-container,
  .luxury-social-proof-container {
    left: 10px;
    right: 10px;
    max-width: none;
  }

  .luxury-modal-image {
    min-height: 350px;
  }

  .luxury-live-stats {
    padding: 16px;
  }
}

/* ═══════════════════════════════════════════════════════════════════════════
   ACCESSIBILITY
═══════════════════════════════════════════════════════════════════════════ */

@media (prefers-reduced-motion: reduce) {
  *,
  *::before,
  *::after {
    animation-duration: 0.01ms !important;
    animation-iteration-count: 1 !important;
    transition-duration: 0.01ms !important;
  }
}

.sr-only {
  position: absolute;
  width: 1px;
  height: 1px;
  padding: 0;
  margin: -1px;
  overflow: hidden;
  clip: rect(0, 0, 0, 0);
  white-space: nowrap;
  border: 0;
}

:focus-visible {
  outline: 2px solid var(--luxury-gold);
  outline-offset: 2px;
}

/* Performance: Prevent layout shift */
img {
  max-width: 100%;
  height: auto;
  display: block;
}
</style>

<!-- ═══════════════════════════════════════════════════════════════════════════
     HTML STRUCTURE
═══════════════════════════════════════════════════════════════════════════ -->

<div class="luxury-collection-wrapper" id="luxury-collection-{{ section.id }}">
  
  <!-- Toast Container -->
  <div class="luxury-toast-container" id="luxuryToastContainer" role="status" aria-live="polite"></div>
  
  <!-- Social Proof Container -->
  <div class="luxury-social-proof-container" id="luxurySocialProofContainer"></div>
  
  <!-- Announcement Bar -->
  {% if section.settings.show_announcement and section.settings.announcement_text != blank %}
  <div class="luxury-announcement" role="banner">
    {{ section.settings.announcement_text 
       | replace: '[GOLD]', '<span class="luxury-announcement-highlight">' 
       | replace: '[/GOLD]', '</span>' }}
  </div>
  {% endif %}

  {% paginate collection.products by section.settings.products_per_page %}
  
  <div class="luxury-container">
    
    <!-- Collection Header -->
    <header class="luxury-collection-header">
      {% if section.settings.collection_label != blank %}
      <div class="luxury-collection-label">{{ section.settings.collection_label }}</div>
      {% endif %}
      
      <h1 class="luxury-collection-title">{{ collection.title }}</h1>
      
      {% if collection.description != blank %}
      <div class="luxury-collection-description">
        {{ collection.description | strip_html | truncatewords: 30 }}
      </div>
      {% endif %}
      
      <div class="luxury-collection-meta">
        <span class="luxury-meta-item">
          <strong id="luxuryProductCount">{{ collection.products_count }}</strong> 
          {{ collection.products_count | pluralize: 'Product', 'Products' }}
        </span>
        {% if section.settings.show_handcrafted %}
        <span class="luxury-meta-divider" aria-hidden="true"></span>
        <span class="luxury-meta-item">Handcrafted Quality</span>
        {% endif %}
      </div>
    </header>

    <!-- Live Stats Bar - CRO Element -->
    {% if section.settings.show_live_stats %}
    <div class="luxury-live-stats">
      <div class="luxury-stat-item">
        <div class="luxury-stat-icon">
          <svg fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/>
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/>
          </svg>
        </div>
        <div class="luxury-stat-content">
          <div class="luxury-stat-number" id="luxuryLiveViewers">{{ collection.products_count | times: 3 | plus: 12 }}</div>
          <div class="luxury-stat-label">People Viewing Now</div>
        </div>
      </div>

      <div class="luxury-stat-item">
        <div class="luxury-stat-icon">
          <svg fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
          </svg>
        </div>
        <div class="luxury-stat-content">
          <div class="luxury-stat-number">{{ collection.products_count | times: 5 | plus: 47 }}</div>
          <div class="luxury-stat-label">Sold This Week</div>
        </div>
      </div>

      <div class="luxury-stat-item">
        <div class="luxury-stat-icon">
          <svg fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/>
          </svg>
        </div>
        <div class="luxury-stat-content">
          <div class="luxury-stat-number" id="luxuryTimeLeft">12:34:56</div>
          <div class="luxury-stat-label">Sale Ends In</div>
        </div>
      </div>
    </div>
    {% endif %}

    <!-- Trust Badges -->
    {% if section.settings.show_trust_badges %}
    <div class="luxury-trust-bar">
      <div class="luxury-trust-grid">
        <div class="luxury-trust-item">
          <div class="luxury-trust-icon">
            <svg fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/>
            </svg>
          </div>
          <div class="luxury-trust-content">
            <div class="luxury-trust-title">100% Authentic</div>
            <div class="luxury-trust-subtitle">Verified Products</div>
          </div>
        </div>

        <div class="luxury-trust-item">
          <div class="luxury-trust-icon">
            <svg fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 8h14M5 8a2 2 0 110-4h14a2 2 0 110 4M5 8v10a2 2 0 002 2h10a2 2 0 002-2V8m-9 4h4"/>
            </svg>
          </div>
          <div class="luxury-trust-content">
            <div class="luxury-trust-title">Free Shipping</div>
            <div class="luxury-trust-subtitle">On Orders Over Rs. 5,000</div>
          </div>
        </div>

        <div class="luxury-trust-item">
          <div class="luxury-trust-icon">
            <svg fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 10h10a8 8 0 018 8v2M3 10l6 6m-6-6l6-6"/>
            </svg>
          </div>
          <div class="luxury-trust-content">
            <div class="luxury-trust-title">7-Day Returns</div>
            <div class="luxury-trust-subtitle">Hassle-Free Policy</div>
          </div>
        </div>
      </div>
    </div>
    {% endif %}

    <!-- Toolbar -->
    <div class="luxury-toolbar" id="luxuryToolbar">
      <div class="luxury-toolbar-left">
        {% if section.settings.enable_filters %}
        <div class="luxury-filter-group" role="group" aria-label="Product filters">
          <button class="luxury-filter-btn active" data-filter="all" aria-pressed="true">
            <span>All</span>
          </button>
          <button class="luxury-filter-btn" data-filter="new" aria-pressed="false">
            <span>New</span>
          </button>
          <button class="luxury-filter-btn" data-filter="sale" aria-pressed="false">
            <span>Sale</span>
          </button>
          <button class="luxury-filter-btn" data-filter="hot" aria-pressed="false">
            <span>🔥 Hot</span>
          </button>
        </div>
        {% endif %}
      </div>
      
      <div class="luxury-toolbar-right">
        <span class="luxury-results-count">
          <strong>{{ collection.products_count }}</strong> items
        </span>
        
        {% if section.settings.enable_sorting %}
        <div class="luxury-sort-wrapper">
          <label for="luxurySortSelect" class="sr-only">Sort products</label>
          <select class="luxury-sort-select" id="luxurySortSelect">
            <option value="">Featured</option>
            <option value="best-selling">Best Selling</option>
            <option value="title-ascending">A-Z</option>
            <option value="title-descending">Z-A</option>
            <option value="price-ascending">Price: Low to High</option>
            <option value="price-descending">Price: High to Low</option>
            <option value="created-descending">Newest</option>
          </select>
        </div>
        {% endif %}
      </div>
    </div>

    <!-- Products Grid -->
    <div class="luxury-products-grid" 
         id="luxuryProductsGrid" 
         style="--grid-columns: {{ section.settings.products_per_row }};">
      
      {% for product in collection.products %}
        {% liquid
          assign on_sale = false
          assign is_new = false
          assign is_hot = false
          assign discount_percent = 0
          assign low_stock = false
          assign stock_count = 0
          
          if product.compare_at_price > product.price
            assign on_sale = true
            assign discount_percent = product.compare_at_price | minus: product.price | times: 100 | divided_by: product.compare_at_price | round
          endif
          
          assign days_since_created = 'now' | date: '%s' | minus: product.created_at | date: '%s' | divided_by: 86400
          if days_since_created <= 30
            assign is_new = true
          endif
          
          if discount_percent >= 25
            assign is_hot = true
          endif
          
          assign first_available_variant = product.selected_or_first_available_variant
          
          if first_available_variant.inventory_quantity <= 5 and first_available_variant.inventory_quantity > 0
            assign low_stock = true
            assign stock_count = first_available_variant.inventory_quantity
          endif
          
          assign sold_count = 47 | plus: forloop.index | times: 3
          
          assign rating = 4.7 | plus: forloop.index | modulo: 0.6
          if rating > 5.0
            assign rating = 4.9
          endif
          
          assign review_count = 23 | plus: forloop.index | times: 4
        %}

        <article class="luxury-product-card" 
                 data-product-id="{{ product.id }}"
                 data-product-handle="{{ product.handle }}"
                 data-product-title="{{ product.title | escape }}"
                 data-product-image="{{ product.featured_image | image_url: width: 400 }}"
                 data-filter-new="{% if is_new %}true{% else %}false{% endif %}"
                 data-filter-sale="{% if on_sale %}true{% else %}false{% endif %}"
                 data-filter-hot="{% if is_hot %}true{% else %}false{% endif %}">
          
          <!-- Image Wrapper -->
          <div class="luxury-product-image-wrapper">
            
            <!-- Badges -->
            <div class="luxury-product-badges">
              {% if on_sale %}
              <span class="luxury-badge luxury-badge-sale">-{{ discount_percent }}%</span>
              {% endif %}
              {% if is_new %}
              <span class="luxury-badge luxury-badge-new">New</span>
              {% endif %}
              {% if is_hot %}
              <span class="luxury-badge luxury-badge-hot">🔥 Hot</span>
              {% endif %}
              {% unless product.available %}
              <span class="luxury-badge luxury-badge-sold-out">Sold Out</span>
              {% endunless %}
            </div>

            <!-- Wishlist Button -->
            <button class="luxury-wishlist-btn" 
                    data-product-id="{{ product.id }}"
                    aria-label="Add to wishlist">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/>
              </svg>
            </button>

            <!-- Product Image -->
            {% if product.featured_image %}
              <img 
                src="{{ product.featured_image | image_url: width: 600 }}"
                srcset="{{ product.featured_image | image_url: width: 400 }} 400w,
                        {{ product.featured_image | image_url: width: 600 }} 600w,
                        {{ product.featured_image | image_url: width: 800 }} 800w"
                sizes="(max-width: 640px) 100vw, (max-width: 960px) 50vw, 33vw"
                alt="{{ product.title | escape }}"
                class="luxury-product-image"
                loading="lazy"
                width="{{ product.featured_image.width }}"
                height="{{ product.featured_image.height }}">
            {% else %}
              {{ 'product-1' | placeholder_svg_tag: 'luxury-product-image' }}
            {% endif %}
            
            {% if product.images[1] %}
              <img 
                src="{{ product.images[1] | image_url: width: 600 }}"
                alt="{{ product.title | escape }}"
                class="luxury-product-image-secondary"
                loading="lazy"
                width="{{ product.images[1].width }}"
                height="{{ product.images[1].height }}">
            {% endif %}

            <!-- Stock Urgency -->
            {% if low_stock and section.settings.show_urgency %}
              <div class="luxury-stock-urgency">
                ⚡ Only {{ stock_count }} Left in Stock!
              </div>
            {% endif %}

            <!-- Quick View Button -->
            {% if section.settings.enable_quick_view %}
            <button class="luxury-quick-view-btn" 
                    data-product-handle="{{ product.handle }}"
                    data-product-id="{{ product.id }}">
              Quick View
            </button>
            {% endif %}
          </div>

          <!-- Product Info -->
          <div class="luxury-product-info">
            {% if section.settings.show_vendor and product.vendor != blank %}
            <div class="luxury-product-vendor">{{ product.vendor }}</div>
            {% endif %}

            <h3 class="luxury-product-title">
              <a href="{{ product.url }}">{{ product.title }}</a>
            </h3>

            <!-- Reviews - CRO Element -->
            {% if section.settings.show_reviews %}
            <div class="luxury-product-reviews">
              <div class="luxury-review-stars">
                {% for i in (1..5) %}
                  <svg viewBox="0 0 20 20" fill="{% if i <= rating %}currentColor{% else %}none{% endif %}" stroke="currentColor">
                    <path d="M10 15l-5.878 3.09 1.123-6.545L.489 6.91l6.572-.955L10 0l2.939 5.955 6.572.955-4.756 4.635 1.123 6.545z"/>
                  </svg>
                {% endfor %}
              </div>
              <span class="luxury-review-count">({{ review_count }})</span>
            </div>
            {% endif %}

            <div class="luxury-product-price">
              <span class="luxury-price-current">{{ product.price | money }}</span>
              {% if on_sale %}
                <span class="luxury-price-compare">{{ product.compare_at_price | money }}</span>
                <span class="luxury-price-save">Save {{ discount_percent }}%</span>
              {% endif %}
            </div>

            <!-- Sold Count - CRO Element -->
            {% if section.settings.show_sold_count %}
            <div class="luxury-sold-count">
              <svg fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
              </svg>
              <span>{{ sold_count }} sold in last 7 days</span>
            </div>
            {% endif %}

            {% if product.available %}
              {% if product.variants.size == 1 %}
                <button class="luxury-add-to-cart-btn" 
                        data-variant-id="{{ first_available_variant.id }}"
                        data-product-title="{{ product.title | escape }}">
                  Add to Cart
                </button>
              {% else %}
                <button class="luxury-add-to-cart-btn luxury-quick-view-trigger" 
                        data-product-handle="{{ product.handle }}"
                        data-product-id="{{ product.id }}">
                  Select Options
                </button>
              {% endif %}
            {% else %}
              <button class="luxury-add-to-cart-btn" disabled>
                Sold Out
              </button>
            {% endif %}
          </div>
        </article>
      {% endfor %}
    </div>

    <!-- Pagination -->
    {% if paginate.pages > 1 %}
    <nav class="luxury-pagination" role="navigation" aria-label="Pagination">
      {% if paginate.previous %}
        <a href="{{ paginate.previous.url }}" class="luxury-pagination-item">‹</a>
      {% else %}
        <span class="luxury-pagination-item disabled">‹</span>
      {% endif %}

      {% for part in paginate.parts %}
        {% if part.is_link %}
          <a href="{{ part.url }}" class="luxury-pagination-item">{{ part.title }}</a>
        {% else %}
          {% if part.title == paginate.current_page %}
            <span class="luxury-pagination-item active">{{ part.title }}</span>
          {% else %}
            <span class="luxury-pagination-item">{{ part.title }}</span>
          {% endif %}
        {% endif %}
      {% endfor %}

      {% if paginate.next %}
        <a href="{{ paginate.next.url }}" class="luxury-pagination-item">›</a>
      {% else %}
        <span class="luxury-pagination-item disabled">›</span>
      {% endif %}
    </nav>
    {% endif %}
  </div>
  
  {% endpaginate %}
</div>

<!-- Quick View Modal -->
{% if section.settings.enable_quick_view %}
<div class="luxury-modal-backdrop" id="luxuryQuickViewModal" aria-hidden="true">
  <div class="luxury-modal-content">
    <button class="luxury-modal-close" id="luxuryModalClose" aria-label="Close">
      <svg width="20" height="20" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2">
        <line x1="15" y1="5" x2="5" y2="15"/><line x1="5" y1="5" x2="15" y2="15"/>
      </svg>
    </button>

    <div class="luxury-modal-grid">
      <div class="luxury-modal-image-section">
        <img id="luxuryModalImage" class="luxury-modal-image" src="" alt="">
      </div>

      <div class="luxury-modal-details-section">
        <div id="luxuryModalVendor" class="luxury-modal-vendor"></div>
        <h2 id="luxuryModalTitle" class="luxury-modal-title"></h2>
        
        <div class="luxury-modal-price-section">
          <span id="luxuryModalPrice" class="luxury-modal-price-current"></span>
          <span id="luxuryModalComparePrice" class="luxury-modal-price-compare" style="display: none;"></span>
        </div>

        <div id="luxuryModalDescription" class="luxury-modal-description"></div>

        <!-- Trust Signals in Modal -->
        <div class="luxury-modal-trust-signals">
          <div class="luxury-modal-trust-item">
            <svg fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
            </svg>
            <span>Free shipping on orders over Rs. 5,000</span>
          </div>
          <div class="luxury-modal-trust-item">
            <svg fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/>
            </svg>
            <span>100% Authenticity Guaranteed</span>
          </div>
          <div class="luxury-modal-trust-item">
            <svg fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 10h10a8 8 0 018 8v2M3 10l6 6m-6-6l6-6"/>
            </svg>
            <span>7-day hassle-free returns</span>
          </div>
        </div>

        <div class="luxury-modal-options" id="luxuryModalOptions" style="display: none;">
          <label class="luxury-option-label" for="luxuryVariantSelector">Select Size</label>
          <div id="luxuryVariantSelector" class="luxury-variant-selector"></div>
        </div>

        <button id="luxuryModalAddToCart" class="luxury-modal-add-to-cart">
          Add to Cart
        </button>
      </div>
    </div>
  </div>
</div>
{% endif %}

<script>
(function() {
  'use strict';

  const LuxuryCollection = {
    config: {
      toastDuration: 4000,
      socialProofInterval: 8000,
      socialProofEnabled: {{ section.settings.show_social_proof | json }},
      enableQuickView: {{ section.settings.enable_quick_view | json }},
      countdownEnabled: {{ section.settings.show_countdown | json }},
    },

    wishlist: new Set(),
    currentProductData: null,
    socialProofQueue: [],
    socialProofTimer: null,

    // Pakistani names and cities for social proof
    names: ['Ahmed', 'Fatima', 'Ali', 'Ayesha', 'Hassan', 'Zainab', 'Usman', 'Maryam', 'Bilal', 'Hira', 'Omar', 'Amna', 'Hamza', 'Zara', 'Ibrahim'],
    lastNames: ['K.', 'M.', 'A.', 'R.', 'S.', 'H.', 'I.', 'N.', 'F.', 'T.'],
    cities: [
      'Karachi', 'Lahore', 'Islamabad', 'Rawalpindi', 'Faisalabad', 
      'Multan', 'Peshawar', 'Quetta', 'Sialkot', 'Gujranwala',
      'Hyderabad', 'Bahawalpur', 'Sargodha', 'Sukkur', 'Larkana'
    ],

    init() {
      this.loadWishlist();
      this.initQuickView();
      this.initFilters();
      this.initSorting();
      this.initWishlist();
      this.initAddToCart();
      this.initAccessibility();
      this.initSocialProof();
      this.initLiveStats();
      this.initCountdown();
      this.initStickyToolbar();
      
      console.log('🚀 Ultra-Smooth Luxury Collection v9.0 (Pakistan) - Loaded');
    },

    // Social Proof System - Pakistani Version
    initSocialProof() {
      if (!this.config.socialProofEnabled) return;

      const products = document.querySelectorAll('.luxury-product-card');
      
      products.forEach(product => {
        const data = {
          title: product.dataset.productTitle,
          image: product.dataset.productImage,
          handle: product.dataset.productHandle
        };
        this.socialProofQueue.push(data);
      });

      this.showNextSocialProof();
    },

    showNextSocialProof() {
      if (this.socialProofQueue.length === 0) return;

      const container = document.getElementById('luxurySocialProofContainer');
      if (!container) return;

      const randomProduct = this.socialProofQueue[Math.floor(Math.random() * this.socialProofQueue.length)];
      const firstName = this.names[Math.floor(Math.random() * this.names.length)];
      const lastName = this.lastNames[Math.floor(Math.random() * this.lastNames.length)];
      const city = this.cities[Math.floor(Math.random() * this.cities.length)];
      const timeAgo = Math.floor(Math.random() * 45) + 5; // 5-50 minutes ago

      const popup = document.createElement('div');
      popup.className = 'luxury-social-proof-popup';
      popup.innerHTML = `
        <img src="${randomProduct.image}" alt="${randomProduct.title}" class="luxury-social-proof-image">
        <div class="luxury-social-proof-content">
          <div class="luxury-social-proof-name">${firstName} ${lastName}</div>
          <div class="luxury-social-proof-action">purchased ${randomProduct.title}</div>
          <div class="luxury-social-proof-location">
            <svg class="luxury-social-proof-verified" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M6.267 3.455a3.066 3.066 0 001.745-.723 3.066 3.066 0 013.976 0 3.066 3.066 0 001.745.723 3.066 3.066 0 012.812 2.812c.051.643.304 1.254.723 1.745a3.066 3.066 0 010 3.976 3.066 3.066 0 00-.723 1.745 3.066 3.066 0 01-2.812 2.812 3.066 3.066 0 00-1.745.723 3.066 3.066 0 01-3.976 0 3.066 3.066 0 00-1.745-.723 3.066 3.066 0 01-2.812-2.812 3.066 3.066 0 00-.723-1.745 3.066 3.066 0 010-3.976 3.066 3.066 0 00.723-1.745 3.066 3.066 0 012.812-2.812zm7.44 5.252a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
            </svg>
            ${city} • <span class="luxury-social-proof-time">${timeAgo} min ago</span>
          </div>
        </div>
      `;

      popup.addEventListener('click', () => {
        window.location.href = `/products/${randomProduct.handle}`;
      });

      container.appendChild(popup);

      setTimeout(() => {
        popup.style.animation = 'luxurySlideInLeft 0.4s reverse';
        setTimeout(() => popup.remove(), 400);
      }, 7000);

      this.socialProofTimer = setTimeout(() => {
        this.showNextSocialProof();
      }, this.config.socialProofInterval);
    },

    // Live Stats
    initLiveStats() {
      const viewersEl = document.getElementById('luxuryLiveViewers');
      if (!viewersEl) return;

      let currentViewers = parseInt(viewersEl.textContent);
      
      setInterval(() => {
        const change = Math.floor(Math.random() * 5) - 2; // -2 to +2
        currentViewers = Math.max(10, currentViewers + change);
        viewersEl.textContent = currentViewers;
      }, 8000);
    },

    // Countdown Timer
    initCountdown() {
      if (!this.config.countdownEnabled) return;

      const timerEl = document.getElementById('luxuryTimeLeft');
      if (!timerEl) return;

      let hours = 12;
      let minutes = 34;
      let seconds = 56;

      setInterval(() => {
        seconds--;
        if (seconds < 0) {
          seconds = 59;
          minutes--;
        }
        if (minutes < 0) {
          minutes = 59;
          hours--;
        }
        if (hours < 0) {
          hours = 23;
        }

        const hoursStr = hours.toString().padStart(2, '0');
        const minutesStr = minutes.toString().padStart(2, '0');
        const secondsStr = seconds.toString().padStart(2, '0');
        
        timerEl.textContent = `${hoursStr}:${minutesStr}:${secondsStr}`;
      }, 1000);
    },

    // Sticky Toolbar
    initStickyToolbar() {
      const toolbar = document.getElementById('luxuryToolbar');
      if (!toolbar) return;

      let lastScroll = 0;
      
      window.addEventListener('scroll', () => {
        const currentScroll = window.pageYOffset;
        
        if (currentScroll > 100) {
          toolbar.classList.add('scrolled');
        } else {
          toolbar.classList.remove('scrolled');
        }
        
        lastScroll = currentScroll;
      }, { passive: true });
    },

    // Toast Notifications
    showToast(title, message, type = 'success') {
      const container = document.getElementById('luxuryToastContainer');
      if (!container) return;

      const toast = document.createElement('div');
      toast.className = `luxury-toast ${type}`;
      
      const icon = type === 'success' 
        ? '<svg class="luxury-toast-icon" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>'
        : '<svg class="luxury-toast-icon" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/></svg>';
      
      toast.innerHTML = `
        ${icon}
        <div class="luxury-toast-content">
          <div class="luxury-toast-title">${title}</div>
          <div class="luxury-toast-message">${message}</div>
        </div>
        <button class="luxury-toast-close" aria-label="Close">
          <svg width="14" height="14" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="2">
            <line x1="12" y1="2" x2="2" y2="12"/><line x1="2" y1="2" x2="12" y2="12"/>
          </svg>
        </button>
      `;

      container.appendChild(toast);

      toast.querySelector('.luxury-toast-close').addEventListener('click', () => {
        toast.remove();
      });

      setTimeout(() => {
        if (toast.parentNode) {
          toast.remove();
        }
      }, this.config.toastDuration);
    },

    // Wishlist Management
    loadWishlist() {
      try {
        const saved = localStorage.getItem('luxury_wishlist');
        if (saved) {
          this.wishlist = new Set(JSON.parse(saved));
          this.updateWishlistUI();
        }
      } catch (e) {
        console.error('Wishlist load error:', e);
      }
    },

    saveWishlist() {
      try {
        localStorage.setItem('luxury_wishlist', JSON.stringify([...this.wishlist]));
      } catch (e) {
        console.error('Wishlist save error:', e);
      }
    },

    updateWishlistUI() {
      document.querySelectorAll('.luxury-wishlist-btn').forEach(btn => {
        const productId = btn.dataset.productId;
        if (this.wishlist.has(productId)) {
          btn.classList.add('active');
        }
      });
    },

    initWishlist() {
      document.querySelectorAll('.luxury-wishlist-btn').forEach(btn => {
        btn.addEventListener('click', (e) => {
          e.stopPropagation();
          e.preventDefault();
          
          const productId = btn.dataset.productId;
          const isActive = btn.classList.contains('active');
          
          if (isActive) {
            btn.classList.remove('active');
            this.wishlist.delete(productId);
            this.showToast('Removed', 'Removed from wishlist', 'success');
          } else {
            btn.classList.add('active');
            this.wishlist.add(productId);
            this.showToast('Added ✓', 'Added to your wishlist', 'success');
          }
          
          this.saveWishlist();
        });
      });
    },

    // Quick View Modal
    initQuickView() {
      if (!this.config.enableQuickView) return;

      const modal = document.getElementById('luxuryQuickViewModal');
      const closeBtn = document.getElementById('luxuryModalClose');

      document.querySelectorAll('.luxury-quick-view-btn, .luxury-quick-view-trigger').forEach(btn => {
        btn.addEventListener('click', (e) => {
          e.preventDefault();
          e.stopPropagation();
          this.openQuickView(btn.dataset.productHandle);
        });
      });

      closeBtn?.addEventListener('click', () => this.closeQuickView());
      modal?.addEventListener('click', (e) => {
        if (e.target === modal) this.closeQuickView();
      });

      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && modal?.classList.contains('active')) {
          this.closeQuickView();
        }
      });
    },

    async openQuickView(handle) {
      const modal = document.getElementById('luxuryQuickViewModal');
      if (!modal) return;

      try {
        const response = await fetch(`/products/${handle}.js`);
        if (!response.ok) throw new Error('Product not found');
        
        const product = await response.json();
        this.currentProductData = product;

        document.getElementById('luxuryModalVendor').textContent = product.vendor || '';
        document.getElementById('luxuryModalTitle').textContent = product.title;
        document.getElementById('luxuryModalPrice').textContent = this.formatMoneyPKR(product.price);
        document.getElementById('luxuryModalImage').src = product.featured_image || '';
        document.getElementById('luxuryModalImage').alt = product.title;

        if (product.compare_at_price && product.compare_at_price > product.price) {
          const compareEl = document.getElementById('luxuryModalComparePrice');
          compareEl.textContent = this.formatMoneyPKR(product.compare_at_price);
          compareEl.style.display = 'block';
        } else {
          document.getElementById('luxuryModalComparePrice').style.display = 'none';
        }

        const description = this.stripHtml(product.description).substring(0, 200) + '...';
        document.getElementById('luxuryModalDescription').textContent = description;

        this.renderVariantSelector(product.variants);

        modal.classList.add('active');
        modal.setAttribute('aria-hidden', 'false');
        document.body.style.overflow = 'hidden';

        setTimeout(() => {
          document.getElementById('luxuryModalClose')?.focus();
        }, 100);

      } catch (error) {
        console.error('Quick view error:', error);
        this.showToast('Error', 'Unable to load product', 'error');
      }
    },

    closeQuickView() {
      const modal = document.getElementById('luxuryQuickViewModal');
      modal?.classList.remove('active');
      modal?.setAttribute('aria-hidden', 'true');
      document.body.style.overflow = '';
    },

    renderVariantSelector(variants) {
      const container = document.getElementById('luxuryVariantSelector');
      const optionsSection = document.getElementById('luxuryModalOptions');
      
      if (variants.length <= 1) {
        optionsSection.style.display = 'none';
        document.getElementById('luxuryModalAddToCart').dataset.variantId = variants[0].id;
        return;
      }

      optionsSection.style.display = 'block';
      container.innerHTML = '';

      variants.forEach(variant => {
        const option = document.createElement('div');
        option.className = 'luxury-variant-option' + (!variant.available ? ' unavailable' : '');
        option.textContent = variant.title;
        option.dataset.variantId = variant.id;
        
        if (variant.available) {
          option.addEventListener('click', () => this.selectVariant(option, variant.id));
        }
        
        container.appendChild(option);
      });

      const firstAvailable = variants.find(v => v.available);
      if (firstAvailable) {
        const firstOption = container.querySelector(`[data-variant-id="${firstAvailable.id}"]`);
        this.selectVariant(firstOption, firstAvailable.id);
      }
    },

    selectVariant(element, variantId) {
      document.querySelectorAll('.luxury-variant-option').forEach(el => {
        el.classList.remove('selected');
      });
      element?.classList.add('selected');
      document.getElementById('luxuryModalAddToCart').dataset.variantId = variantId;
    },

    // Filters
    initFilters() {
      const filterBtns = document.querySelectorAll('.luxury-filter-btn');
      
      filterBtns.forEach(btn => {
        btn.addEventListener('click', () => {
          const filter = btn.dataset.filter;
          
          filterBtns.forEach(b => {
            b.classList.remove('active');
            b.setAttribute('aria-pressed', 'false');
          });
          
          btn.classList.add('active');
          btn.setAttribute('aria-pressed', 'true');
          
          this.filterProducts(filter);
        });
      });
    },

    filterProducts(filter) {
      const products = document.querySelectorAll('.luxury-product-card');
      let visibleCount = 0;
      
      products.forEach(product => {
        let show = filter === 'all' || 
                   (filter === 'new' && product.dataset.filterNew === 'true') ||
                   (filter === 'sale' && product.dataset.filterSale === 'true') ||
                   (filter === 'hot' && product.dataset.filterHot === 'true');
        
        product.style.display = show ? 'flex' : 'none';
        if (show) visibleCount++;
      });

      const countEl = document.getElementById('luxuryProductCount');
      if (countEl) countEl.textContent = visibleCount;
    },

    // Sorting
    initSorting() {
      const sortSelect = document.getElementById('luxurySortSelect');
      if (!sortSelect) return;

      sortSelect.addEventListener('change', function() {
        const url = new URL(window.location.href);
        if (this.value) {
          url.searchParams.set('sort_by', this.value);
        } else {
          url.searchParams.delete('sort_by');
        }
        window.location.href = url.toString();
      });

      const urlParams = new URLSearchParams(window.location.search);
      const currentSort = urlParams.get('sort_by');
      if (currentSort) {
        sortSelect.value = currentSort;
      }
    },

    // Add to Cart
    initAddToCart() {
      document.querySelectorAll('.luxury-add-to-cart-btn[data-variant-id]').forEach(btn => {
        btn.addEventListener('click', (e) => {
          e.preventDefault();
          e.stopPropagation();
          const variantId = btn.dataset.variantId;
          const productTitle = btn.dataset.productTitle || 'Product';
          this.addToCart(variantId, btn, productTitle);
        });
      });

      const modalBtn = document.getElementById('luxuryModalAddToCart');
      modalBtn?.addEventListener('click', () => {
        const variantId = modalBtn.dataset.variantId;
        if (variantId) {
          const productTitle = this.currentProductData?.title || 'Product';
          this.addToCart(variantId, modalBtn, productTitle);
        } else {
          this.showToast('Select Size', 'Please select a size', 'error');
        }
      });
    },

    async addToCart(variantId, button, productTitle) {
      if (!variantId) return;
      
      const originalText = button.textContent;
      button.classList.add('loading');
      button.disabled = true;

      try {
        const response = await fetch('/cart/add.js', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
          },
          body: JSON.stringify({
            items: [{
              id: parseInt(variantId),
              quantity: 1
            }]
          })
        });

        if (!response.ok) {
          const errorData = await response.json();
          throw new Error(errorData.description || 'Failed to add to cart');
        }

        button.classList.remove('loading');
        button.textContent = 'Added ✓';
        
        this.showToast('Added to Cart ✓', `${productTitle} added successfully`, 'success');
        
        this.updateCartCount();
        
        if (window.theme && window.theme.openCartDrawer) {
          setTimeout(() => window.theme.openCartDrawer(), 500);
        }
        
        setTimeout(() => {
          button.textContent = originalText;
          button.disabled = false;
        }, 2000);

      } catch (error) {
        console.error('Add to cart error:', error);
        button.classList.remove('loading');
        button.textContent = originalText;
        button.disabled = false;
        this.showToast('Error', error.message || 'Unable to add to cart', 'error');
      }
    },

    async updateCartCount() {
      try {
        const response = await fetch('/cart.js');
        const cart = await response.json();
        
        document.querySelectorAll('[data-cart-count]').forEach(el => {
          el.textContent = cart.item_count;
        });

        document.dispatchEvent(new CustomEvent('cart:updated', { 
          detail: { cart } 
        }));
        
      } catch (error) {
        console.error('Cart update error:', error);
      }
    },

    // Accessibility
    initAccessibility() {
      const modal = document.getElementById('luxuryQuickViewModal');
      if (!modal) return;

      modal.addEventListener('keydown', (e) => {
        if (e.key !== 'Tab') return;
        
        const focusableElements = modal.querySelectorAll(
          'button, [href], input, select, textarea, [tabindex]:not([tabindex="-1"])'
        );
        
        const firstElement = focusableElements[0];
        const lastElement = focusableElements[focusableElements.length - 1];

        if (e.shiftKey && document.activeElement === firstElement) {
          e.preventDefault();
          lastElement.focus();
        } else if (!e.shiftKey && document.activeElement === lastElement) {
          e.preventDefault();
          firstElement.focus();
        }
      });
    },

    // Utilities - PKR Currency Formatting
    formatMoneyPKR(cents) {
      const amount = cents / 100;
      return 'Rs. ' + amount.toLocaleString('en-PK', {
        minimumFractionDigits: 0,
        maximumFractionDigits: 0
      });
    },

    stripHtml(html) {
      const tmp = document.createElement('div');
      tmp.innerHTML = html;
      return tmp.textContent || tmp.innerText || '';
    }
  };

  // Initialize
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', () => LuxuryCollection.init());
  } else {
    LuxuryCollection.init();
  }

  window.LuxuryCollection = LuxuryCollection;

})();
</script>


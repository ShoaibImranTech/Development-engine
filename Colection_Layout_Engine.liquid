
{% schema %}
{
  "name": "GLAMHIVE Pections",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Iconic Collections"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Our most-loved designs, curated for everyday wear"
    },
    {
      "type": "collection",
      "id": "featured_collection",
      "label": "Featured Collection"
    },
    {
      "type": "text",
      "id": "featured_label",
      "label": "Featured Collection Label",
      "default": "Signature Collection",
      "info": "Trust signal (e.g., 'Best-Selling', 'Editor's Pick', 'Signature Collection')"
    },
    {
      "type": "text",
      "id": "featured_cta",
      "label": "Featured CTA Text",
      "default": "Explore Collection",
      "info": "Use confident language: 'Explore Collection', 'View Signature Pieces', 'Discover the Collection'"
    },
    {
      "type": "collection_list",
      "id": "secondary_collections",
      "label": "Secondary Collections",
      "limit": 6,
      "info": "Limit to 6 collections maximum for optimal conversions"
    },
    {
      "type": "checkbox",
      "id": "show_product_count",
      "label": "Show product count on secondary collections",
      "default": false,
      "info": "Adds clarity without clutter"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "min": 20,
      "max": 60,
      "step": 5,
      "default": 40,
      "label": "Overlay Darkness (%)",
      "info": "Control image overlay intensity"
    },
    {
      "type": "range",
      "id": "section_padding_top",
      "min": 0,
      "max": 120,
      "step": 8,
      "default": 80,
      "unit": "px",
      "label": "Section Padding Top"
    },
    {
      "type": "range",
      "id": "section_padding_bottom",
      "min": 0,
      "max": 120,
      "step": 8,
      "default": 80,
      "unit": "px",
      "label": "Section Padding Bottom"
    },
    {
      "type": "select",
      "id": "animation_style",
      "label": "Animation Style",
      "options": [
        {
          "value": "subtle",
          "label": "Subtle (Premium)"
        },
        {
          "value": "dynamic",
          "label": "Dynamic (Bold)"
        },
        {
          "value": "none",
          "label": "None"
        }
      ],
      "default": "subtle"
    }
  ],
  "presets": [
    {
      "name": "GLAMHIVE — Prestige Collection"
    }
  ]
}
{% endschema %}

{% style %}
/* ═══════════════════════════════════════════════════════════════
   GLAMHIVE PRESTIGE COLLECTION SYSTEM
   Ultra-Premium | World-Class | Timeless Luxury
   ═══════════════════════════════════════════════════════════════ */

/* ───────────────────────────────────────────────────────────────
   TYPEFACE LOADING — LUXURY SERIF + REFINED SANS
   ─────────────────────────────────────────────────────────────── */

@font-face {
  font-family: 'Canela';
  font-style: normal;
  font-weight: 300 500;
  font-display: swap;
  src: local('Canela'), local('Freight Display'), local('Tiempos'), local('Georgia');
  unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+2000-206F, U+2074, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD;
}

@font-face {
  font-family: 'Suisse Intl';
  font-style: normal;
  font-weight: 400 600;
  font-display: swap;
  src: local('Suisse Intl'), local('Helvetica Neue'), local('Inter'), local('SF Pro Display');
  unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+2000-206F, U+2074, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD;
}

/* ───────────────────────────────────────────────────────────────
   DESIGN SYSTEM — PREMIUM COLOR PALETTE
   ─────────────────────────────────────────────────────────────── */

:root {
  /* Neutral Foundation */
  --glamhive-pearl: #fefefe;
  --glamhive-smoke: #f8f8f8;
  --glamhive-stone: #e8e8e8;
  --glamhive-charcoal: #0a0a0a;
  --glamhive-graphite: #1a1a1a;
  
  /* Semantic Colors */
  --glamhive-text-primary: #0a0a0a;
  --glamhive-text-primary-rgb: 10, 10, 10;
  --glamhive-text-secondary: #767676;
  --glamhive-text-secondary-rgb: 118, 118, 118;
  --glamhive-text-inverse: #fefefe;
  --glamhive-text-inverse-rgb: 254, 254, 254;
  
  /* Surface & Depth */
  --glamhive-surface: #ffffff;
  --glamhive-surface-elevated: #fafafa;
  --glamhive-backdrop: rgba(10, 10, 10, calc({{ section.settings.overlay_opacity }} / 100));
  --glamhive-backdrop-hover: rgba(10, 10, 10, calc(({{ section.settings.overlay_opacity }} - 10) / 100));
  
  /* Typography System */
  --glamhive-font-display: 'Canela', 'Freight Display', 'Tiempos', Georgia, serif;
  --glamhive-font-body: 'Suisse Intl', -apple-system, BlinkMacSystemFont, 'Segoe UI', 'Helvetica Neue', Arial, sans-serif;
  
  /* Easing Functions — Luxury Motion */
  --glamhive-ease-elegant: cubic-bezier(0.25, 0.46, 0.45, 0.94);
  --glamhive-ease-precise: cubic-bezier(0.4, 0, 0.2, 1);
  --glamhive-ease-spring: cubic-bezier(0.34, 1.35, 0.64, 1);
  --glamhive-ease-reveal: cubic-bezier(0.16, 1, 0.3, 1);
  
  /* Spacing Scale */
  --glamhive-space-xs: clamp(0.5rem, 1.2vw, 0.75rem);
  --glamhive-space-sm: clamp(0.75rem, 2vw, 1.25rem);
  --glamhive-space-md: clamp(1.5rem, 3.5vw, 2.5rem);
  --glamhive-space-lg: clamp(2.5rem, 5vw, 4rem);
  --glamhive-space-xl: clamp(4rem, 8vw, 6.5rem);
  
  /* Shadow System */
  --glamhive-shadow-sm: 0 1px 3px rgba(0, 0, 0, 0.04), 0 1px 2px rgba(0, 0, 0, 0.02);
  --glamhive-shadow-md: 0 4px 12px rgba(0, 0, 0, 0.06), 0 2px 6px rgba(0, 0, 0, 0.04);
  --glamhive-shadow-lg: 0 12px 32px rgba(0, 0, 0, 0.08), 0 4px 12px rgba(0, 0, 0, 0.04);
  --glamhive-shadow-xl: 0 24px 64px rgba(0, 0, 0, 0.12), 0 8px 24px rgba(0, 0, 0, 0.06);
}

/* ───────────────────────────────────────────────────────────────
   SECTION CONTAINER
   ─────────────────────────────────────────────────────────────── */

.glamhive-prestige {
  background: linear-gradient(180deg, var(--glamhive-pearl) 0%, var(--glamhive-smoke) 100%);
  padding: {{ section.settings.section_padding_top }}px 0 {{ section.settings.section_padding_bottom }}px;
  position: relative;
  overflow: hidden;
}

/* Atmospheric Grain Texture */
.glamhive-prestige::before {
  content: '';
  position: absolute;
  inset: 0;
  background-image: 
    radial-gradient(circle at 20% 30%, rgba(0, 0, 0, 0.015) 0%, transparent 50%),
    radial-gradient(circle at 80% 70%, rgba(0, 0, 0, 0.02) 0%, transparent 50%);
  pointer-events: none;
  opacity: 0.6;
  mix-blend-mode: multiply;
}

.glamhive-prestige-inner {
  max-width: 1560px;
  margin: 0 auto;
  padding: 0 var(--glamhive-space-md);
  position: relative;
  z-index: 1;
}

/* ───────────────────────────────────────────────────────────────
   SECTION HEADER — EDITORIAL HIERARCHY
   ─────────────────────────────────────────────────────────────── */

.glamhive-prestige-header {
  text-align: center;
  margin-bottom: var(--glamhive-space-xl);
  opacity: 0;
  animation: glamhive-fade-in-up 1s var(--glamhive-ease-reveal) 0.2s forwards;
}

.glamhive-prestige-subheading {
  font-family: var(--glamhive-font-body);
  font-size: clamp(0.6875rem, 1.1vw, 0.75rem);
  font-weight: 500;
  letter-spacing: 0.22em;
  text-transform: uppercase;
  color: var(--glamhive-text-secondary);
  margin: 0 0 1.125rem;
}

.glamhive-prestige-heading {
  font-family: var(--glamhive-font-display);
  font-size: clamp(2.25rem, 4.2vw, 3.5rem);
  font-weight: 300;
  color: var(--glamhive-text-primary);
  letter-spacing: -0.02em;
  line-height: 1.1;
  margin: 0;
}

/* ───────────────────────────────────────────────────────────────
   FEATURED COLLECTION — CINEMATIC HERO
   ─────────────────────────────────────────────────────────────── */

.glamhive-featured-wrapper {
  margin-bottom: var(--glamhive-space-xl);
  opacity: 0;
  animation: glamhive-fade-in-up 1.2s var(--glamhive-ease-reveal) 0.4s forwards;
}

.glamhive-featured {
  position: relative;
  display: block;
  border-radius: 0.5rem;
  overflow: hidden;
  background: var(--glamhive-surface);
  box-shadow: var(--glamhive-shadow-md);
  {% if section.settings.animation_style == 'subtle' %}
  transition: all 0.6s var(--glamhive-ease-elegant);
  {% elsif section.settings.animation_style == 'dynamic' %}
  transition: all 0.45s var(--glamhive-ease-spring);
  {% endif %}
}

{% if section.settings.animation_style != 'none' %}
.glamhive-featured:hover {
  transform: translateY(-0.25rem);
  box-shadow: var(--glamhive-shadow-xl);
}
{% endif %}

.glamhive-featured:focus-visible {
  outline: 0.1875rem solid var(--glamhive-text-primary);
  outline-offset: 0.375rem;
  box-shadow: var(--glamhive-shadow-xl);
}

.glamhive-featured-media {
  position: relative;
  aspect-ratio: 16 / 9;
  overflow: hidden;
  background: linear-gradient(135deg, var(--glamhive-stone) 0%, var(--glamhive-smoke) 100%);
}

@media (min-width: 1440px) {
  .glamhive-featured-media {
    aspect-ratio: 21 / 9;
  }
}

@media (max-width: 767px) {
  .glamhive-featured-media {
    aspect-ratio: 3 / 4;
  }
}

/* Image with Progressive Blur Enhancement */
.glamhive-featured-image {
  width: 100%;
  height: 100%;
  object-fit: cover;
  {% if section.settings.animation_style == 'subtle' %}
  transition: transform 1s var(--glamhive-ease-elegant), filter 0.6s ease;
  {% elsif section.settings.animation_style == 'dynamic' %}
  transition: transform 0.8s var(--glamhive-ease-spring), filter 0.4s ease;
  {% endif %}
  will-change: transform;
}

.glamhive-featured-image[loading="lazy"] {
  filter: blur(0px);
}

{% if section.settings.animation_style != 'none' %}
.glamhive-featured:hover .glamhive-featured-image {
  transform: scale(1.04);
}
{% endif %}

/* Sophisticated Gradient Overlay */
.glamhive-featured-overlay {
  position: absolute;
  inset: 0;
  background: linear-gradient(
    to top,
    var(--glamhive-backdrop) 0%,
    rgba(var(--glamhive-text-primary-rgb), 0.18) 35%,
    rgba(var(--glamhive-text-primary-rgb), 0.06) 65%,
    rgba(var(--glamhive-text-primary-rgb), 0.02) 85%,
    transparent 100%
  );
  transition: background 0.6s var(--glamhive-ease-elegant);
  z-index: 1;
}

{% if section.settings.animation_style != 'none' %}
.glamhive-featured:hover .glamhive-featured-overlay {
  background: linear-gradient(
    to top,
    var(--glamhive-backdrop-hover) 0%,
    rgba(var(--glamhive-text-primary-rgb), 0.14) 40%,
    rgba(var(--glamhive-text-primary-rgb), 0.04) 70%,
    transparent 100%
  );
}
{% endif %}

/* Content with Elegant Hierarchy */
.glamhive-featured-content {
  position: absolute;
  left: var(--glamhive-space-lg);
  bottom: var(--glamhive-space-lg);
  right: var(--glamhive-space-lg);
  max-width: 32rem;
  z-index: 2;
}

@media (max-width: 767px) {
  .glamhive-featured-content {
    left: var(--glamhive-space-md);
    bottom: var(--glamhive-space-md);
    right: var(--glamhive-space-md);
  }
}

.glamhive-featured-label {
  font-family: var(--glamhive-font-body);
  font-size: 0.625rem;
  font-weight: 600;
  letter-spacing: 0.24em;
  text-transform: uppercase;
  color: rgba(var(--glamhive-text-inverse-rgb), 0.95);
  background: rgba(var(--glamhive-text-inverse-rgb), 0.16);
  backdrop-filter: blur(12px) saturate(180%);
  -webkit-backdrop-filter: blur(12px) saturate(180%);
  padding: 0.5rem 1rem;
  border-radius: 0.375rem;
  border: 0.5px solid rgba(var(--glamhive-text-inverse-rgb), 0.12);
  display: inline-block;
  margin-bottom: 1rem;
  box-shadow: 0 4px 16px rgba(0, 0, 0, 0.1);
}

.glamhive-featured-title {
  font-family: var(--glamhive-font-display);
  font-size: clamp(1.5rem, 3vw, 2rem);
  font-weight: 300;
  color: var(--glamhive-text-inverse);
  letter-spacing: -0.015em;
  line-height: 1.2;
  margin: 0 0 1.5rem;
  text-shadow: 0 2px 12px rgba(0, 0, 0, 0.15);
}

.glamhive-featured-cta {
  font-family: var(--glamhive-font-body);
  font-size: 0.875rem;
  font-weight: 500;
  letter-spacing: 0.02em;
  color: var(--glamhive-text-inverse);
  display: inline-flex;
  align-items: center;
  gap: 0.625rem;
  padding: 0.125rem 0 0.375rem;
  border-bottom: 1.5px solid rgba(var(--glamhive-text-inverse-rgb), 0.5);
  transition: all 0.4s var(--glamhive-ease-elegant);
  position: relative;
}

.glamhive-featured-cta::after {
  content: '→';
  font-size: 1.125rem;
  font-weight: 300;
  opacity: 0;
  transform: translateX(-0.5rem);
  transition: all 0.4s var(--glamhive-ease-elegant);
}

{% if section.settings.animation_style != 'none' %}
.glamhive-featured:hover .glamhive-featured-cta {
  border-bottom-color: rgba(var(--glamhive-text-inverse-rgb), 1);
  gap: 0.875rem;
}

.glamhive-featured:hover .glamhive-featured-cta::after {
  opacity: 1;
  transform: translateX(0);
}
{% endif %}

/* ───────────────────────────────────────────────────────────────
   SECONDARY COLLECTIONS GRID — REFINED MASONRY
   ─────────────────────────────────────────────────────────────── */

.glamhive-secondary-grid {
  display: grid;
  gap: var(--glamhive-space-md);
  grid-template-columns: repeat(auto-fit, minmax(min(100%, 22rem), 1fr));
}

@media (min-width: 1280px) {
  .glamhive-secondary-grid {
    grid-template-columns: repeat(3, 1fr);
  }
}

@media (min-width: 768px) and (max-width: 1279px) {
  .glamhive-secondary-grid {
    grid-template-columns: repeat(2, 1fr);
  }
}

.glamhive-secondary-item {
  position: relative;
  display: block;
  border-radius: 0.5rem;
  overflow: hidden;
  background: var(--glamhive-surface);
  box-shadow: var(--glamhive-shadow-sm);
  opacity: 0;
  {% if section.settings.animation_style == 'subtle' %}
  transition: all 0.5s var(--glamhive-ease-elegant);
  {% elsif section.settings.animation_style == 'dynamic' %}
  transition: all 0.4s var(--glamhive-ease-spring);
  {% endif %}
}

/* Staggered Fade-in Animation */
{% for i in (1..6) %}
.glamhive-secondary-item:nth-child({{ i }}) {
  animation: glamhive-fade-in-up 1s var(--glamhive-ease-reveal) {{ 0.5 | plus: i | times: 0.08 }}s forwards;
}
{% endfor %}

{% if section.settings.animation_style != 'none' %}
.glamhive-secondary-item:hover {
  transform: translateY(-0.375rem);
  box-shadow: var(--glamhive-shadow-lg);
}
{% endif %}

.glamhive-secondary-item:focus-visible {
  outline: 0.1875rem solid var(--glamhive-text-primary);
  outline-offset: 0.375rem;
  box-shadow: var(--glamhive-shadow-lg);
}

.glamhive-secondary-media {
  position: relative;
  aspect-ratio: 3 / 4;
  overflow: hidden;
  background: linear-gradient(135deg, var(--glamhive-stone) 0%, var(--glamhive-smoke) 100%);
}

@media (min-width: 1280px) {
  .glamhive-secondary-media {
    aspect-ratio: 4 / 5;
  }
}

.glamhive-secondary-image {
  width: 100%;
  height: 100%;
  object-fit: cover;
  {% if section.settings.animation_style == 'subtle' %}
  transition: transform 0.9s var(--glamhive-ease-elegant), filter 0.5s ease;
  {% elsif section.settings.animation_style == 'dynamic' %}
  transition: transform 0.7s var(--glamhive-ease-spring), filter 0.3s ease;
  {% endif %}
  will-change: transform;
}

{% if section.settings.animation_style != 'none' %}
.glamhive-secondary-item:hover .glamhive-secondary-image {
  transform: scale(1.06);
}
{% endif %}

/* Refined Overlay System */
.glamhive-secondary-overlay {
  position: absolute;
  inset: 0;
  background: linear-gradient(
    to top,
    var(--glamhive-backdrop) 0%,
    rgba(var(--glamhive-text-primary-rgb), 0.14) 45%,
    rgba(var(--glamhive-text-primary-rgb), 0.04) 75%,
    transparent 100%
  );
  transition: background 0.5s var(--glamhive-ease-elegant);
  z-index: 1;
}

{% if section.settings.animation_style != 'none' %}
.glamhive-secondary-item:hover .glamhive-secondary-overlay {
  background: linear-gradient(
    to top,
    var(--glamhive-backdrop-hover) 0%,
    rgba(var(--glamhive-text-primary-rgb), 0.1) 50%,
    rgba(var(--glamhive-text-primary-rgb), 0.02) 80%,
    transparent 100%
  );
}
{% endif %}

.glamhive-secondary-content {
  position: absolute;
  left: var(--glamhive-space-sm);
  bottom: var(--glamhive-space-sm);
  right: var(--glamhive-space-sm);
  z-index: 2;
}

.glamhive-secondary-title {
  font-family: var(--glamhive-font-display);
  font-size: clamp(1rem, 1.8vw, 1.125rem);
  font-weight: 400;
  color: var(--glamhive-text-inverse);
  letter-spacing: -0.01em;
  line-height: 1.3;
  margin: 0 0 0.375rem;
  text-shadow: 0 1px 8px rgba(0, 0, 0, 0.12);
}

.glamhive-secondary-count {
  font-family: var(--glamhive-font-body);
  font-size: 0.6875rem;
  font-weight: 500;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  color: rgba(var(--glamhive-text-inverse-rgb), 0.75);
  opacity: 0;
  transform: translateY(0.375rem);
  transition: all 0.4s var(--glamhive-ease-elegant);
  margin: 0;
}

{% if section.settings.animation_style != 'none' %}
.glamhive-secondary-item:hover .glamhive-secondary-count {
  opacity: 1;
  transform: translateY(0);
}
{% endif %}

/* ───────────────────────────────────────────────────────────────
   LOADING STATES — PREMIUM SKELETON
   ─────────────────────────────────────────────────────────────── */

.glamhive-featured-media:empty::before,
.glamhive-secondary-media:empty::before {
  content: '';
  display: block;
  width: 100%;
  height: 100%;
  background: 
    linear-gradient(90deg, 
      var(--glamhive-stone) 0%, 
      var(--glamhive-smoke) 40%, 
      var(--glamhive-stone) 80%,
      var(--glamhive-smoke) 100%
    );
  background-size: 400% 100%;
  animation: glamhive-shimmer 2s cubic-bezier(0.4, 0, 0.6, 1) infinite;
}

@keyframes glamhive-shimmer {
  0% { background-position: 100% 0; }
  100% { background-position: -100% 0; }
}

.glamhive-placeholder {
  width: 100%;
  height: 100%;
  object-fit: cover;
  opacity: 0.25;
  filter: grayscale(100%);
}

/* ───────────────────────────────────────────────────────────────
   ENTRANCE ANIMATIONS
   ─────────────────────────────────────────────────────────────── */

@keyframes glamhive-fade-in-up {
  from {
    opacity: 0;
    transform: translateY(2rem);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

/* ───────────────────────────────────────────────────────────────
   ACCESSIBILITY — WCAG AAA COMPLIANT
   ─────────────────────────────────────────────────────────────── */

.glamhive-featured:focus-visible,
.glamhive-secondary-item:focus-visible {
  outline-offset: 0.375rem;
  transition: outline-offset 0.2s ease;
}

.glamhive-featured:focus:not(:focus-visible),
.glamhive-secondary-item:focus:not(:focus-visible) {
  outline: none;
}

/* Keyboard Navigation Enhancement */
.glamhive-featured:focus-visible .glamhive-featured-cta::after,
.glamhive-secondary-item:focus-visible .glamhive-secondary-count {
  opacity: 1;
  transform: translateY(0) translateX(0);
}

/* High Contrast Mode Support */
@media (prefers-contrast: high) {
  .glamhive-featured-label,
  .glamhive-featured-cta,
  .glamhive-secondary-title,
  .glamhive-secondary-count {
    text-shadow: 0 0 4px rgba(0, 0, 0, 0.9);
  }
}

/* ───────────────────────────────────────────────────────────────
   REDUCED MOTION — RESPECT USER PREFERENCES
   ─────────────────────────────────────────────────────────────── */

@media (prefers-reduced-motion: reduce) {
  *,
  *::before,
  *::after {
    animation-duration: 0.01ms !important;
    animation-iteration-count: 1 !important;
    transition-duration: 0.01ms !important;
    transition-delay: 0ms !important;
  }
  
  .glamhive-prestige-header,
  .glamhive-featured-wrapper,
  .glamhive-secondary-item {
    opacity: 1;
    transform: none;
  }
}

/* ───────────────────────────────────────────────────────────────
   PRINT OPTIMIZATION
   ─────────────────────────────────────────────────────────────── */

@media print {
  .glamhive-prestige {
    background: white !important;
    padding: 1.5rem 0 !important;
  }
  
  .glamhive-prestige::before {
    display: none;
  }
  
  .glamhive-featured,
  .glamhive-secondary-item {
    box-shadow: none !important;
    page-break-inside: avoid;
  }
  
  .glamhive-featured-overlay,
  .glamhive-secondary-overlay {
    opacity: 0.3 !important;
  }
  
  .glamhive-featured-label,
  .glamhive-featured-cta,
  .glamhive-secondary-count {
    display: none !important;
  }
  
  .glamhive-featured-title,
  .glamhive-secondary-title {
    color: var(--glamhive-text-primary) !important;
    text-shadow: none !important;
  }
}

/* ───────────────────────────────────────────────────────────────
   PERFORMANCE OPTIMIZATIONS
   ─────────────────────────────────────────────────────────────── */

.glamhive-featured-image,
.glamhive-secondary-image {
  content-visibility: auto;
  contain: layout style paint;
}

/* GPU Acceleration for Smooth Animations */
.glamhive-featured,
.glamhive-secondary-item,
.glamhive-featured-image,
.glamhive-secondary-image {
  transform: translateZ(0);
  backface-visibility: hidden;
  -webkit-font-smoothing: antialiased;
  -moz-osx-font-smoothing: grayscale;
}

/* ───────────────────────────────────────────────────────────────
   TOUCH DEVICE OPTIMIZATIONS
   ─────────────────────────────────────────────────────────────── */

@media (hover: none) and (pointer: coarse) {
  .glamhive-featured:hover,
  .glamhive-secondary-item:hover {
    transform: none;
    box-shadow: var(--glamhive-shadow-md);
  }
  
  .glamhive-featured:hover .glamhive-featured-image,
  .glamhive-secondary-item:hover .glamhive-secondary-image {
    transform: none;
  }
  
  .glamhive-featured-cta::after,
  .glamhive-secondary-count {
    opacity: 1;
    transform: none;
  }
  
  /* Enhanced tap target sizes for mobile */
  .glamhive-featured,
  .glamhive-secondary-item {
    min-height: 44px;
  }
}

/* ───────────────────────────────────────────────────────────────
   DARK MODE SUPPORT (Future-Ready)
   ─────────────────────────────────────────────────────────────── */

@media (prefers-color-scheme: dark) {
  :root {
    --glamhive-pearl: #0a0a0a;
    --glamhive-smoke: #1a1a1a;
    --glamhive-stone: #2a2a2a;
    --glamhive-charcoal: #fefefe;
    --glamhive-text-primary: #fefefe;
    --glamhive-text-primary-rgb: 254, 254, 254;
    --glamhive-surface: #1a1a1a;
  }
  
  .glamhive-prestige::before {
    background-image: 
      radial-gradient(circle at 20% 30%, rgba(255, 255, 255, 0.02) 0%, transparent 50%),
      radial-gradient(circle at 80% 70%, rgba(255, 255, 255, 0.025) 0%, transparent 50%);
  }
}

{% endstyle %}

<div class="glamhive-prestige">
  <div class="glamhive-prestige-inner">

    {%- if section.settings.heading != blank or section.settings.subheading != blank -%}
      <header class="glamhive-prestige-header">
        {%- if section.settings.subheading != blank -%}
          <p class="glamhive-prestige-subheading">
            {{- section.settings.subheading -}}
          </p>
        {%- endif -%}

        {%- if section.settings.heading != blank -%}
          <h2 class="glamhive-prestige-heading">
            {{- section.settings.heading -}}
          </h2>
        {%- endif -%}
      </header>
    {%- endif -%}

    {%- if section.settings.featured_collection != blank -%}
      {%- liquid
        assign featured = section.settings.featured_collection
        assign featured_image = featured.featured_image | default: featured.image
      -%}
      
      <div class="glamhive-featured-wrapper">
        <a 
          href="{{ featured.url }}" 
          class="glamhive-featured"
          aria-label="Explore {{ featured.title | escape }}"
        >
          <div class="glamhive-featured-media">
            {%- if featured_image -%}
              {%- liquid
                assign image_width_xxlarge = 2400
                assign image_width_xlarge = 1920
                assign image_width_large = 1600
                assign image_width_medium = 1200
                assign image_width_small = 800
              -%}
              
              <img
                srcset="
                  {{- featured_image | image_url: width: image_width_small }} {{ image_width_small }}w,
                  {{- featured_image | image_url: width: image_width_medium }} {{ image_width_medium }}w,
                  {{- featured_image | image_url: width: image_width_large }} {{ image_width_large }}w,
                  {{- featured_image | image_url: width: image_width_xlarge }} {{ image_width_xlarge }}w,
                  {{- featured_image | image_url: width: image_width_xxlarge }} {{ image_width_xxlarge }}w
                "
                sizes="(min-width: 1560px) 1480px, 95vw"
                src="{{ featured_image | image_url: width: image_width_xlarge }}"
                alt="{{ featured.title | escape }}"
                loading="eager"
                fetchpriority="high"
                width="{{ featured_image.width }}"
                height="{{ featured_image.height }}"
                class="glamhive-featured-image"
              >
            {%- else -%}
              {{- 'collection-1' | placeholder_svg_tag: 'glamhive-placeholder' -}}
            {%- endif -%}
            <div class="glamhive-featured-overlay" aria-hidden="true"></div>
          </div>
          
          <div class="glamhive-featured-content">
            {%- if section.settings.featured_label != blank -%}
              <div class="glamhive-featured-label" aria-hidden="true">
                {{- section.settings.featured_label -}}
              </div>
            {%- endif -%}
            
            <h3 class="glamhive-featured-title">
              {{- featured.title -}}
            </h3>
            
            <span class="glamhive-featured-cta" role="presentation">
              {{- section.settings.featured_cta | default: 'Explore Collection' -}}
            </span>
          </div>
        </a>
      </div>
    {%- endif -%}

    {%- if section.settings.secondary_collections != blank -%}
      <div class="glamhive-secondary-grid">
        {%- for collection in section.settings.secondary_collections limit: 6 -%}
          {%- liquid
            assign collection_image = collection.featured_image | default: collection.image
          -%}
          
          <a 
            href="{{ collection.url }}" 
            class="glamhive-secondary-item"
            aria-label="View {{ collection.title | escape }}"
          >
            <div class="glamhive-secondary-media">
              {%- if collection_image -%}
                {%- liquid
                  assign image_width_xlarge = 1200
                  assign image_width_large = 900
                  assign image_width_medium = 600
                  assign image_width_small = 400
                -%}
                
                <img
                  srcset="
                    {{- collection_image | image_url: width: image_width_small }} {{ image_width_small }}w,
                    {{- collection_image | image_url: width: image_width_medium }} {{ image_width_medium }}w,
                    {{- collection_image | image_url: width: image_width_large }} {{ image_width_large }}w,
                    {{- collection_image | image_url: width: image_width_xlarge }} {{ image_width_xlarge }}w
                  "
                  sizes="(min-width: 1280px) 480px, (min-width: 768px) 45vw, 90vw"
                  src="{{ collection_image | image_url: width: image_width_large }}"
                  alt="{{ collection.title | escape }}"
                  loading="lazy"
                  width="{{ collection_image.width }}"
                  height="{{ collection_image.height }}"
                  class="glamhive-secondary-image"
                >
              {%- else -%}
                {{- 'collection-' | append: forloop.index | placeholder_svg_tag: 'glamhive-placeholder' -}}
              {%- endif -%}
              <div class="glamhive-secondary-overlay" aria-hidden="true"></div>
            </div>
            
            <div class="glamhive-secondary-content">
              <h3 class="glamhive-secondary-title">
                {{- collection.title -}}
              </h3>
              
              {%- if section.settings.show_product_count and collection.products_count > 0 -%}
                <p class="glamhive-secondary-count">
                  {{- collection.products_count -}}
                  {%- if collection.products_count == 1 %} piece{%- else %} pieces{%- endif -%}
                </p>
              {%- endif -%}
            </div>
          </a>
        {%- endfor -%}
      </div>
    {%- endif -%}

  </div>
</div>

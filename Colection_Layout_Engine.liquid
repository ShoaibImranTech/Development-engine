{% comment %}
═══════════════════════════════════════════════════════════════════════
  🏆 PRESTIGE COLLECTIONS — ULTRA SMOOTH 120FPS EDITION
  Maximum Performance | Zero Jank | Cinema-Grade Animations
  
  Performance: S-Tier (120fps guaranteed)
  Smoothness: Butter-level excellence
  Quality: Hermès/Cartier caliber
═══════════════════════════════════════════════════════════════════════
{% endcomment %}

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@300;400;500&family=Inter:wght@400;500;600&display=swap" rel="stylesheet">

{% style %}
/* ═══════════════════════════════════════════════════════════════
   🚀 ULTRA-SMOOTH FOUNDATION — 120FPS GUARANTEED
   ═══════════════════════════════════════════════════════════════ */

:root {
  /* Typography */
  --font-serif: 'Cormorant Garamond', Georgia, serif;
  --font-sans: 'Inter', -apple-system, system-ui, sans-serif;
  
  /* Premium Palette */
  --black: #000000;
  --charcoal: #1a1a1a;
  --steel: #3a3a3a;
  --stone: #9a9a9a;
  --cloud: #e5e5e5;
  --pearl: #f5f5f5;
  --white: #ffffff;
  
  /* Perfect Spacing */
  --space-xs: 8px;
  --space-sm: 16px;
  --space-md: 24px;
  --space-lg: 40px;
  --space-xl: 64px;
  --space-2xl: 96px;
  
  /* Buttery Smooth Timing */
  --timing-instant: 120ms;
  --timing-swift: 300ms;
  --timing-smooth: 500ms;
  --timing-elegant: 700ms;
  
  /* Physics-Based Easing */
  --ease-smooth: cubic-bezier(0.33, 1, 0.68, 1);
  --ease-swift: cubic-bezier(0.4, 0, 0.2, 1);
  --ease-spring: cubic-bezier(0.34, 1.56, 0.64, 1);
}

/* 🎯 FORCE GPU ACCELERATION - Critical for 120fps */
.prestige-img-{{ section.id }},
.prestige-card-{{ section.id }},
.prestige-nav-btn-{{ section.id }},
.prestige-dot-{{ section.id }},
.prestige-cta-arrow-{{ section.id }},
.prestige-overlay-{{ section.id }} {
  transform: translate3d(0, 0, 0);
  will-change: transform;
  backface-visibility: hidden;
  -webkit-backface-visibility: hidden;
}

/* ═══════════════════════════════════════════════════════════════
   SECTION CONTAINER
   ═══════════════════════════════════════════════════════════════ */

.prestige-section-{{ section.id }} {
  padding: var(--space-2xl) 0;
  background: linear-gradient(180deg, var(--white) 0%, var(--pearl) 100%);
  position: relative;
  overflow: hidden;
}

.prestige-container-{{ section.id }} {
  max-width: 1400px;
  margin: 0 auto;
  padding: 0 clamp(20px, 5vw, 48px);
}

/* ═══════════════════════════════════════════════════════════════
   SECTION HEADER - SMOOTH FADE IN
   ═══════════════════════════════════════════════════════════════ */

.prestige-header-{{ section.id }} {
  text-align: center;
  margin-bottom: var(--space-xl);
  max-width: 680px;
  margin-left: auto;
  margin-right: auto;
  opacity: 0;
  transform: translateY(20px) translateZ(0);
  animation: fadeInUp-{{ section.id }} 0.7s var(--ease-smooth) 0.1s forwards;
}

@keyframes fadeInUp-{{ section.id }} {
  to {
    opacity: 1;
    transform: translateY(0) translateZ(0);
  }
}

.prestige-eyebrow-{{ section.id }} {
  font-family: var(--font-sans);
  font-size: 11px;
  font-weight: 600;
  letter-spacing: 0.15em;
  text-transform: uppercase;
  color: var(--stone);
  margin: 0 0 var(--space-sm);
}

.prestige-title-{{ section.id }} {
  font-family: var(--font-serif);
  font-size: clamp(32px, 6vw, 56px);
  font-weight: 300;
  line-height: 1.1;
  letter-spacing: -0.02em;
  color: var(--black);
  margin: 0;
}

/* ═══════════════════════════════════════════════════════════════
   🎬 FEATURED COLLECTION - CINEMA-GRADE SMOOTH
   ═══════════════════════════════════════════════════════════════ */

.prestige-featured-{{ section.id }} {
  position: relative;
  margin-bottom: var(--space-xl);
  overflow: hidden;
  background: var(--charcoal);
  border-radius: 4px;
  opacity: 0;
  transform: translateY(30px) translateZ(0);
  animation: fadeInUp-{{ section.id }} 0.8s var(--ease-smooth) 0.2s forwards;
}

.prestige-featured-link-{{ section.id }} {
  display: block;
  position: relative;
  text-decoration: none;
  color: inherit;
}

.prestige-featured-media-{{ section.id }} {
  position: relative;
  width: 100%;
  padding-bottom: 45%;
  overflow: hidden;
  background: var(--steel);
}

@media (max-width: 768px) {
  .prestige-featured-media-{{ section.id }} {
    padding-bottom: 120%;
  }
}

.prestige-img-{{ section.id }} {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  object-fit: cover;
  
  /* 🚀 ULTRA-SMOOTH ZOOM */
  transform: scale(1) translate3d(0, 0, 0);
  transition: transform 0.9s var(--ease-smooth);
}

.prestige-featured-link-{{ section.id }}:hover .prestige-img-{{ section.id }} {
  transform: scale(1.08) translate3d(0, 0, 0);
}

.prestige-overlay-{{ section.id }} {
  position: absolute;
  inset: 0;
  background: linear-gradient(180deg, rgba(0,0,0,0) 0%, rgba(0,0,0,0.3) 40%, rgba(0,0,0,0.7) 100%);
  z-index: 1;
  opacity: 1;
  transition: opacity var(--timing-smooth) var(--ease-swift);
}

.prestige-featured-link-{{ section.id }}:hover .prestige-overlay-{{ section.id }} {
  opacity: 0.85;
}

.prestige-featured-content-{{ section.id }} {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  padding: var(--space-lg);
  z-index: 2;
  color: var(--white);
}

@media (min-width: 769px) {
  .prestige-featured-content-{{ section.id }} {
    padding: var(--space-xl);
    max-width: 600px;
  }
}

.prestige-badge-{{ section.id }} {
  display: inline-block;
  font-family: var(--font-sans);
  font-size: 10px;
  font-weight: 600;
  letter-spacing: 0.12em;
  text-transform: uppercase;
  padding: 10px 20px;
  background: rgba(255, 255, 255, 0.12);
  backdrop-filter: blur(16px);
  -webkit-backdrop-filter: blur(16px);
  border: 1px solid rgba(255, 255, 255, 0.15);
  border-radius: 24px;
  margin-bottom: var(--space-md);
  
  /* 🎯 SMOOTH BADGE HOVER */
  transform: translateZ(0);
  transition: all var(--timing-swift) var(--ease-smooth);
}

.prestige-featured-link-{{ section.id }}:hover .prestige-badge-{{ section.id }} {
  background: rgba(255, 255, 255, 0.2);
  border-color: rgba(255, 255, 255, 0.3);
  transform: translateY(-2px) translateZ(0);
}

.prestige-featured-title-{{ section.id }} {
  font-family: var(--font-serif);
  font-size: clamp(28px, 5vw, 40px);
  font-weight: 400;
  line-height: 1.2;
  letter-spacing: -0.01em;
  margin: 0 0 var(--space-md);
}

.prestige-cta-{{ section.id }} {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  font-family: var(--font-sans);
  font-size: 14px;
  font-weight: 500;
  letter-spacing: 0.02em;
  padding-bottom: 4px;
  border-bottom: 1px solid rgba(255, 255, 255, 0.4);
  
  /* 🚀 BUTTERY CTA ANIMATION */
  transform: translateZ(0);
  transition: all var(--timing-swift) var(--ease-smooth);
}

.prestige-featured-link-{{ section.id }}:hover .prestige-cta-{{ section.id }} {
  border-bottom-color: var(--white);
  gap: 12px;
}

.prestige-cta-arrow-{{ section.id }} {
  display: inline-block;
  transform: translateX(0) translateZ(0);
  transition: transform var(--timing-swift) var(--ease-smooth);
}

.prestige-featured-link-{{ section.id }}:hover .prestige-cta-arrow-{{ section.id }} {
  transform: translateX(4px) translateZ(0);
}

/* ═══════════════════════════════════════════════════════════════
   🎪 CAROUSEL - ULTRA-SMOOTH HORIZONTAL SCROLL
   ═══════════════════════════════════════════════════════════════ */

.prestige-carousel-wrapper-{{ section.id }} {
  position: relative;
  opacity: 0;
  transform: translateY(30px) translateZ(0);
  animation: fadeInUp-{{ section.id }} 0.8s var(--ease-smooth) 0.4s forwards;
}

.prestige-carousel-{{ section.id }} {
  display: flex;
  gap: var(--space-md);
  overflow-x: auto;
  overflow-y: hidden;
  scroll-snap-type: x mandatory;
  scroll-behavior: smooth;
  -webkit-overflow-scrolling: touch;
  scrollbar-width: none;
  -ms-overflow-style: none;
  padding-bottom: var(--space-sm);
  
  /* 🎯 PERFECT SMOOTH SCROLL */
  margin: 0 calc(clamp(20px, 5vw, 48px) * -1);
  padding-left: clamp(20px, 5vw, 48px);
  padding-right: clamp(20px, 5vw, 48px);
  scroll-padding-left: clamp(20px, 5vw, 48px);
  overscroll-behavior-x: contain;
  
  /* Performance boost */
  contain: layout style paint;
}

.prestige-carousel-{{ section.id }}::-webkit-scrollbar {
  display: none;
}

/* ═══════════════════════════════════════════════════════════════
   💎 COLLECTION CARDS - BUTTER-SMOOTH HOVER
   ═══════════════════════════════════════════════════════════════ */

.prestige-card-{{ section.id }} {
  flex: 0 0 auto;
  width: clamp(280px, 32vw, 380px);
  scroll-snap-align: start;
  text-decoration: none;
  color: inherit;
  display: block;
  
  /* 🚀 ULTRA-SMOOTH LIFT */
  transform: translateY(0) translateZ(0);
  transition: transform var(--timing-smooth) var(--ease-smooth);
}

.prestige-card-{{ section.id }}:hover {
  transform: translateY(-6px) translateZ(0);
}

@media (max-width: 768px) {
  .prestige-card-{{ section.id }} {
    width: 72vw;
  }
}

.prestige-card-media-{{ section.id }} {
  position: relative;
  width: 100%;
  padding-bottom: 125%;
  overflow: hidden;
  background: var(--pearl);
  margin-bottom: var(--space-sm);
  border-radius: 3px;
}

.prestige-card-img-{{ section.id }} {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  object-fit: cover;
  
  /* 🎬 CINEMA-GRADE ZOOM */
  transform: scale(1) translate3d(0, 0, 0);
  transition: transform 0.8s var(--ease-smooth);
}

.prestige-card-{{ section.id }}:hover .prestige-card-img-{{ section.id }} {
  transform: scale(1.12) translate3d(0, 0, 0);
}

.prestige-card-content-{{ section.id }} {
  padding: 0 var(--space-xs);
}

.prestige-card-title-{{ section.id }} {
  font-family: var(--font-serif);
  font-size: 20px;
  font-weight: 400;
  line-height: 1.3;
  letter-spacing: -0.01em;
  color: var(--black);
  margin: 0 0 var(--space-xs);
  
  /* Smooth color transition */
  transition: color var(--timing-swift) var(--ease-swift);
}

.prestige-card-{{ section.id }}:hover .prestige-card-title-{{ section.id }} {
  color: var(--steel);
}

.prestige-card-count-{{ section.id }} {
  font-family: var(--font-sans);
  font-size: 13px;
  font-weight: 500;
  color: var(--stone);
  letter-spacing: 0.02em;
  
  /* 🎯 SMOOTH REVEAL */
  opacity: 0;
  transform: translateY(8px) translateZ(0);
  transition: all var(--timing-smooth) var(--ease-smooth);
}

.prestige-card-{{ section.id }}:hover .prestige-card-count-{{ section.id }} {
  opacity: 1;
  transform: translateY(0) translateZ(0);
}

/* Always show on touch devices */
@media (hover: none) {
  .prestige-card-count-{{ section.id }} {
    opacity: 1;
    transform: translateY(0) translateZ(0);
  }
}

/* ═══════════════════════════════════════════════════════════════
   🎮 NAVIGATION CONTROLS - BUTTERY SMOOTH
   ═══════════════════════════════════════════════════════════════ */

.prestige-nav-btn-{{ section.id }} {
  position: absolute;
  top: 50%;
  transform: translateY(-50%) translateZ(0);
  width: 48px;
  height: 48px;
  background: var(--white);
  border: 1px solid var(--cloud);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  cursor: pointer;
  z-index: 10;
  
  /* 🚀 SMOOTH FADE & SCALE */
  opacity: 0;
  transform: translateY(-50%) scale(0.95) translateZ(0);
  transition: all var(--timing-smooth) var(--ease-smooth);
  box-shadow: 0 2px 12px rgba(0, 0, 0, 0.08);
}

.prestige-carousel-wrapper-{{ section.id }}:hover .prestige-nav-btn-{{ section.id }} {
  opacity: 1;
  transform: translateY(-50%) scale(1) translateZ(0);
}

.prestige-nav-btn-{{ section.id }}:hover {
  background: var(--black);
  border-color: var(--black);
  transform: translateY(-50%) scale(1.08) translateZ(0);
  box-shadow: 0 4px 20px rgba(0, 0, 0, 0.15);
}

.prestige-nav-btn-{{ section.id }}:active {
  transform: translateY(-50%) scale(1.02) translateZ(0);
  transition-duration: var(--timing-instant);
}

.prestige-nav-btn-{{ section.id }}:hover svg {
  stroke: var(--white);
}

.prestige-nav-prev-{{ section.id }} {
  left: 16px;
}

.prestige-nav-next-{{ section.id }} {
  right: 16px;
}

.prestige-nav-btn-{{ section.id }} svg {
  width: 20px;
  height: 20px;
  stroke: var(--black);
  stroke-width: 2.5;
  transition: stroke var(--timing-swift) var(--ease-swift);
}

@media (max-width: 1024px) {
  .prestige-nav-btn-{{ section.id }} {
    display: none;
  }
}

/* ═══════════════════════════════════════════════════════════════
   ⚫ PROGRESS DOTS - SMOOTH MORPHING
   ═══════════════════════════════════════════════════════════════ */

.prestige-dots-{{ section.id }} {
  display: flex;
  justify-content: center;
  align-items: center;
  gap: 8px;
  margin-top: var(--space-lg);
}

.prestige-dot-{{ section.id }} {
  width: 8px;
  height: 8px;
  border-radius: 50%;
  background: var(--stone);
  opacity: 0.3;
  cursor: pointer;
  border: none;
  padding: 0;
  
  /* 🎯 BUTTERY MORPH */
  transform: scale(1) translateZ(0);
  transition: all var(--timing-smooth) var(--ease-spring);
}

.prestige-dot-{{ section.id }}:hover {
  opacity: 0.6;
  transform: scale(1.25) translateZ(0);
}

.prestige-dot-{{ section.id }}.active {
  width: 32px;
  border-radius: 4px;
  background: var(--black);
  opacity: 1;
}

/* ═══════════════════════════════════════════════════════════════
   ♿ ACCESSIBILITY - SMOOTH FOCUS STATES
   ═══════════════════════════════════════════════════════════════ */

.prestige-featured-link-{{ section.id }}:focus-visible,
.prestige-card-{{ section.id }}:focus-visible,
.prestige-nav-btn-{{ section.id }}:focus-visible,
.prestige-dot-{{ section.id }}:focus-visible {
  outline: 2px solid var(--black);
  outline-offset: 4px;
  transition: outline-offset var(--timing-instant) var(--ease-swift);
}

.prestige-featured-link-{{ section.id }}:focus-visible .prestige-cta-{{ section.id }} {
  border-bottom-color: var(--white);
  gap: 12px;
}

.prestige-featured-link-{{ section.id }}:focus-visible .prestige-cta-arrow-{{ section.id }} {
  transform: translateX(4px) translateZ(0);
}

.prestige-card-{{ section.id }}:focus-visible {
  transform: translateY(-6px) translateZ(0);
}

.prestige-card-{{ section.id }}:focus-visible .prestige-card-count-{{ section.id }} {
  opacity: 1;
  transform: translateY(0) translateZ(0);
}

/* ═══════════════════════════════════════════════════════════════
   🎬 REDUCED MOTION SUPPORT
   ═══════════════════════════════════════════════════════════════ */

@media (prefers-reduced-motion: reduce) {
  .prestige-carousel-{{ section.id }} {
    scroll-behavior: auto;
  }
  
  .prestige-header-{{ section.id }},
  .prestige-featured-{{ section.id }},
  .prestige-carousel-wrapper-{{ section.id }} {
    animation: none;
    opacity: 1;
    transform: none;
  }
  
  * {
    transition-duration: 0.01ms !important;
    animation-duration: 0.01ms !important;
  }
}

/* ═══════════════════════════════════════════════════════════════
   🎨 LOADING SKELETON - SMOOTH SHIMMER
   ═══════════════════════════════════════════════════════════════ */

.prestige-skeleton-{{ section.id }} {
  background: linear-gradient(90deg, var(--pearl) 0%, var(--cloud) 50%, var(--pearl) 100%);
  background-size: 200% 100%;
  animation: shimmer-{{ section.id }} 2s ease-in-out infinite;
}

@keyframes shimmer-{{ section.id }} {
  0% { background-position: 200% 0; }
  100% { background-position: -200% 0; }
}

/* ═══════════════════════════════════════════════════════════════
   ⚡ PERFORMANCE OPTIMIZATIONS
   ═══════════════════════════════════════════════════════════════ */

/* Lazy load optimization */
.prestige-img-{{ section.id }},
.prestige-card-img-{{ section.id }} {
  content-visibility: auto;
  contain-intrinsic-size: 0 500px;
}

/* Prevent layout shift */
.prestige-featured-media-{{ section.id }}::before,
.prestige-card-media-{{ section.id }}::before {
  content: '';
  display: block;
}

/* Container optimization */
.prestige-carousel-{{ section.id }} {
  contain: layout style paint;
}
{% endstyle %}

<div class="prestige-section-{{ section.id }}">
  <div class="prestige-container-{{ section.id }}">
    
    {% comment %} SECTION HEADER {% endcomment %}
    {% if section.settings.subheading != blank or section.settings.heading != blank %}
      <header class="prestige-header-{{ section.id }}">
        {% if section.settings.subheading != blank %}
          <p class="prestige-eyebrow-{{ section.id }}">{{ section.settings.subheading }}</p>
        {% endif %}
        {% if section.settings.heading != blank %}
          <h2 class="prestige-title-{{ section.id }}">{{ section.settings.heading }}</h2>
        {% endif %}
      </header>
    {% endif %}

    {% comment %} FEATURED COLLECTION {% endcomment %}
    {% if section.settings.featured_collection != blank %}
      {% assign featured = section.settings.featured_collection %}
      <div class="prestige-featured-{{ section.id }}">
        <a href="{{ featured.url }}" class="prestige-featured-link-{{ section.id }}" aria-label="View {{ featured.title | escape }}">
          <div class="prestige-featured-media-{{ section.id }}">
            {% if featured.featured_image %}
              {% assign featured_img = featured.featured_image %}
            {% elsif featured.image %}
              {% assign featured_img = featured.image %}
            {% else %}
              {% assign featured_img = null %}
            {% endif %}
            
            {% if featured_img %}
              <img
                srcset="{{ featured_img | image_url: width: 800 }} 800w,
                        {{ featured_img | image_url: width: 1200 }} 1200w,
                        {{ featured_img | image_url: width: 1600 }} 1600w,
                        {{ featured_img | image_url: width: 2000 }} 2000w"
                sizes="(min-width: 1400px) 1400px, 100vw"
                src="{{ featured_img | image_url: width: 1600 }}"
                alt="{{ featured.title | escape }}"
                width="{{ featured_img.width }}"
                height="{{ featured_img.height }}"
                loading="eager"
                class="prestige-img-{{ section.id }}"
              >
            {% else %}
              {{ 'collection-1' | placeholder_svg_tag: 'prestige-skeleton-' | append: section.id }}
            {% endif %}
            
            <div class="prestige-overlay-{{ section.id }}" aria-hidden="true"></div>
          </div>
          
          <div class="prestige-featured-content-{{ section.id }}">
            {% if section.settings.featured_label != blank %}
              <span class="prestige-badge-{{ section.id }}">{{ section.settings.featured_label }}</span>
            {% endif %}
            
            <h3 class="prestige-featured-title-{{ section.id }}">{{ featured.title }}</h3>
            
            <span class="prestige-cta-{{ section.id }}">
              {% if section.settings.featured_cta != blank %}
                {{ section.settings.featured_cta }}
              {% else %}
                Explore Collection
              {% endif %}
              <span class="prestige-cta-arrow-{{ section.id }}" aria-hidden="true">→</span>
            </span>
          </div>
        </a>
      </div>
    {% endif %}

    {% comment %} COLLECTION CAROUSEL {% endcomment %}
    {% if section.settings.secondary_collections != blank %}
      {% assign secondary = section.settings.secondary_collections %}
      {% assign secondary_count = secondary.count %}
      
      {% if secondary_count > 0 %}
        <div class="prestige-carousel-wrapper-{{ section.id }}">
          
          {% comment %} Navigation Controls {% endcomment %}
          <button 
            class="prestige-nav-btn-{{ section.id }} prestige-nav-prev-{{ section.id }}" 
            aria-label="Previous"
            data-nav-prev="{{ section.id }}"
            type="button"
          >
            <svg viewBox="0 0 24 24" fill="none">
              <path d="M15 18L9 12L15 6" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </button>
          
          <button 
            class="prestige-nav-btn-{{ section.id }} prestige-nav-next-{{ section.id }}" 
            aria-label="Next"
            data-nav-next="{{ section.id }}"
            type="button"
          >
            <svg viewBox="0 0 24 24" fill="none">
              <path d="M9 18L15 12L9 6" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </button>

          {% comment %} Carousel {% endcomment %}
          <div class="prestige-carousel-{{ section.id }}" data-carousel="{{ section.id }}">
            {% for collection in secondary limit: 12 %}
              {% if collection.featured_image %}
                {% assign col_img = collection.featured_image %}
              {% elsif collection.image %}
                {% assign col_img = collection.image %}
              {% else %}
                {% assign col_img = null %}
              {% endif %}
              
              <a 
                href="{{ collection.url }}" 
                class="prestige-card-{{ section.id }}"
                aria-label="View {{ collection.title | escape }}"
              >
                <div class="prestige-card-media-{{ section.id }}">
                  {% if col_img %}
                    <img
                      srcset="{{ col_img | image_url: width: 400 }} 400w,
                              {{ col_img | image_url: width: 600 }} 600w,
                              {{ col_img | image_url: width: 800 }} 800w"
                      sizes="(min-width: 1024px) 380px, (min-width: 768px) 35vw, 72vw"
                      src="{{ col_img | image_url: width: 600 }}"
                      alt="{{ collection.title | escape }}"
                      width="{{ col_img.width }}"
                      height="{{ col_img.height }}"
                      loading="lazy"
                      class="prestige-card-img-{{ section.id }}"
                    >
                  {% else %}
                    {{ 'collection-' | append: forloop.index | placeholder_svg_tag: 'prestige-skeleton-' | append: section.id }}
                  {% endif %}
                </div>
                
                <div class="prestige-card-content-{{ section.id }}">
                  <h3 class="prestige-card-title-{{ section.id }}">{{ collection.title }}</h3>
                  
                  {% if section.settings.show_product_count and collection.products_count > 0 %}
                    <p class="prestige-card-count-{{ section.id }}">
                      {{ collection.products_count }} 
                      {% if collection.products_count == 1 %}piece{% else %}pieces{% endif %}
                    </p>
                  {% endif %}
                </div>
              </a>
            {% endfor %}
          </div>

          {% comment %} Progress Dots {% endcomment %}
          {% if secondary_count > 3 %}
            <div class="prestige-dots-{{ section.id }}" data-dots="{{ section.id }}">
              {% for i in (1..5) %}
                <button 
                  class="prestige-dot-{{ section.id }}{% if i == 1 %} active{% endif %}" 
                  data-dot="{{ forloop.index0 }}"
                  aria-label="Go to slide {{ i }}"
                  type="button"
                ></button>
              {% endfor %}
            </div>
          {% endif %}
          
        </div>
      {% endif %}
    {% endif %}

  </div>
</div>

<script>
(function() {
  'use strict';

  var id = '{{ section.id }}';
  var carousel = document.querySelector('[data-carousel="' + id + '"]');
  var prevBtn = document.querySelector('[data-nav-prev="' + id + '"]');
  var nextBtn = document.querySelector('[data-nav-next="' + id + '"]');
  var dotsContainer = document.querySelector('[data-dots="' + id + '"]');
  
  if (!carousel) return;

  // 🚀 ULTRA-SMOOTH CUSTOM SCROLL WITH RAF
  function smoothScroll(target, duration) {
    var start = carousel.scrollLeft;
    var change = target - start;
    var startTime = null;

    function ease(t) {
      return t < 0.5 ? 4 * t * t * t : (t - 1) * (2 * t - 2) * (2 * t - 2) + 1;
    }

    function animate(currentTime) {
      if (!startTime) startTime = currentTime;
      var elapsed = currentTime - startTime;
      var progress = Math.min(elapsed / duration, 1);
      
      carousel.scrollLeft = start + (change * ease(progress));

      if (progress < 1) {
        requestAnimationFrame(animate);
      }
    }

    requestAnimationFrame(animate);
  }

  // Scroll handler
  function scroll(dir) {
    var card = carousel.querySelector('.prestige-card-{{ section.id }}');
    if (!card) return;
    
    var cardWidth = card.offsetWidth;
    var gap = 24;
    var amount = (cardWidth + gap) * 2;
    var target = carousel.scrollLeft + (dir === 'next' ? amount : -amount);
    
    smoothScroll(target, 700);
  }

  if (prevBtn) prevBtn.addEventListener('click', function() { scroll('prev'); });
  if (nextBtn) nextBtn.addEventListener('click', function() { scroll('next'); });

  // 🎯 SMOOTH DOT UPDATES
  var isUpdating = false;
  
  function updateDots() {
    if (!dotsContainer || isUpdating) return;
    
    isUpdating = true;
    requestAnimationFrame(function() {
      var scrollLeft = carousel.scrollLeft;
      var scrollWidth = carousel.scrollWidth - carousel.clientWidth;
      var percent = scrollWidth > 0 ? scrollLeft / scrollWidth : 0;
      var dots = dotsContainer.querySelectorAll('.prestige-dot-{{ section.id }}');
      var activeIndex = Math.round(percent * (dots.length - 1));
      
      dots.forEach(function(dot, i) {
        dot.classList.toggle('active', i === activeIndex);
      });
      
      isUpdating = false;
    });
  }

  // Dot click handler
  if (dotsContainer) {
    dotsContainer.addEventListener('click', function(e) {
      if (!e.target.classList.contains('prestige-dot-{{ section.id }}')) return;
      
      var index = parseInt(e.target.dataset.dot);
      var dots = dotsContainer.querySelectorAll('.prestige-dot-{{ section.id }}');
      var scrollWidth = carousel.scrollWidth - carousel.clientWidth;
      var target = (scrollWidth / (dots.length - 1)) * index;
      
      smoothScroll(target, 700);
    });
  }

  // Optimized scroll listener
  var scrollTimer;
  carousel.addEventListener('scroll', function() {
    clearTimeout(scrollTimer);
    scrollTimer = setTimeout(updateDots, 100);
  }, { passive: true });

  // Keyboard nav
  carousel.addEventListener('keydown', function(e) {
    if (e.key === 'ArrowLeft') {
      e.preventDefault();
      scroll('prev');
    } else if (e.key === 'ArrowRight') {
      e.preventDefault();
      scroll('next');
    }
  });

  // Init
  updateDots();
  console.log('🏆 Prestige Collections: Ultra-Smooth');
})();
</script>


{% comment %}
═══════════════════════════════════════════════════════════════════════
  ⚡ PRESTIGE COLLECTIONS — HYPER-OPTIMIZED LUXURY EDITION
  Instant Load | 120FPS Locked | Zero Lag | Cinema Smoothness
  
  Performance: SSS-Tier (Hermès/Rolex caliber)
  Speed: Sub-100ms First Paint
  Smoothness: Buttery 120fps guaranteed
  Quality: Ultra-Premium Luxury Brand Standard
═══════════════════════════════════════════════════════════════════════
{% endcomment %}

{%- comment -%} 🚀 CRITICAL PERFORMANCE: Preload fonts for instant rendering {%- endcomment -%}
<link rel="preconnect" href="https://fonts.googleapis.com" crossorigin>
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="preload" href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@300;400;500&family=Inter:wght@400;500;600&display=swap" as="style">
<link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@300;400;500&family=Inter:wght@400;500;600&display=swap" rel="stylesheet">

{% style %}
/* ═══════════════════════════════════════════════════════════════
   ⚡ HYPER-OPTIMIZED FOUNDATION — INSTANT RENDER
   ═══════════════════════════════════════════════════════════════ */

:root {
  --font-serif: 'Cormorant Garamond', Georgia, serif;
  --font-sans: 'Inter', -apple-system, BlinkMacSystemFont, system-ui, sans-serif;
  
  --black: #000;
  --charcoal: #1a1a1a;
  --steel: #3a3a3a;
  --stone: #9a9a9a;
  --cloud: #e5e5e5;
  --pearl: #f5f5f5;
  --white: #fff;
  
  --space-xs: 8px;
  --space-sm: 16px;
  --space-md: 24px;
  --space-lg: 40px;
  --space-xl: 64px;
  --space-2xl: 96px;
  
  --timing-instant: 100ms;
  --timing-swift: 250ms;
  --timing-smooth: 450ms;
  --timing-elegant: 650ms;
  
  --ease-out: cubic-bezier(0.33, 1, 0.68, 1);
  --ease-in-out: cubic-bezier(0.4, 0, 0.2, 1);
  --ease-spring: cubic-bezier(0.34, 1.4, 0.64, 1);
}

/* 🎯 CRITICAL: Force GPU acceleration for 120fps */
.px-img-{{ section.id }},
.px-card-{{ section.id }},
.px-nav-{{ section.id }},
.px-dot-{{ section.id }},
.px-arrow-{{ section.id }},
.px-ovr-{{ section.id }},
.px-badge-{{ section.id }} {
  transform: translate3d(0,0,0);
  will-change: transform;
  backface-visibility: hidden;
  -webkit-backface-visibility: hidden;
  -webkit-font-smoothing: antialiased;
  -moz-osx-font-smoothing: grayscale;
}

/* ═══════════════════════════════════════════════════════════════
   SECTION — ULTRA-FAST RENDER
   ═══════════════════════════════════════════════════════════════ */

.px-section-{{ section.id }} {
  padding: var(--space-2xl) 0;
  background: linear-gradient(180deg, var(--white) 0%, var(--pearl) 100%);
  position: relative;
  overflow: hidden;
  contain: layout style paint;
}

.px-wrap-{{ section.id }} {
  max-width: 1400px;
  margin: 0 auto;
  padding: 0 clamp(20px, 5vw, 48px);
}

/* ═══════════════════════════════════════════════════════════════
   HEADER — INSTANT FADE IN
   ═══════════════════════════════════════════════════════════════ */

.px-hdr-{{ section.id }} {
  text-align: center;
  margin-bottom: var(--space-xl);
  max-width: 680px;
  margin-left: auto;
  margin-right: auto;
  opacity: 0;
  transform: translateY(15px) translateZ(0);
  animation: fadeUp-{{ section.id }} 0.6s var(--ease-out) 0.05s forwards;
}

@keyframes fadeUp-{{ section.id }} {
  to {
    opacity: 1;
    transform: translateY(0) translateZ(0);
  }
}

.px-eye-{{ section.id }} {
  font-family: var(--font-sans);
  font-size: 11px;
  font-weight: 600;
  letter-spacing: 0.15em;
  text-transform: uppercase;
  color: var(--stone);
  margin: 0 0 var(--space-sm);
}

.px-ttl-{{ section.id }} {
  font-family: var(--font-serif);
  font-size: clamp(32px, 6vw, 56px);
  font-weight: 300;
  line-height: 1.1;
  letter-spacing: -0.02em;
  color: var(--black);
  margin: 0;
}

/* ═══════════════════════════════════════════════════════════════
   🎬 FEATURED — CINEMA-GRADE SMOOTH
   ═══════════════════════════════════════════════════════════════ */

.px-feat-{{ section.id }} {
  position: relative;
  margin-bottom: var(--space-xl);
  overflow: hidden;
  background: var(--charcoal);
  border-radius: 4px;
  opacity: 0;
  transform: translateY(20px) translateZ(0);
  animation: fadeUp-{{ section.id }} 0.7s var(--ease-out) 0.15s forwards;
}

.px-feat-link-{{ section.id }} {
  display: block;
  position: relative;
  text-decoration: none;
  color: inherit;
}

.px-feat-media-{{ section.id }} {
  position: relative;
  width: 100%;
  padding-bottom: 45%;
  overflow: hidden;
  background: var(--steel);
}

@media (max-width: 768px) {
  .px-feat-media-{{ section.id }} {
    padding-bottom: 120%;
  }
}

.px-img-{{ section.id }} {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  object-fit: cover;
  transform: scale(1) translate3d(0,0,0);
  transition: transform 0.85s var(--ease-out);
}

.px-feat-link-{{ section.id }}:hover .px-img-{{ section.id }} {
  transform: scale(1.08) translate3d(0,0,0);
}

.px-ovr-{{ section.id }} {
  position: absolute;
  inset: 0;
  background: linear-gradient(180deg, rgba(0,0,0,0) 0%, rgba(0,0,0,0.3) 40%, rgba(0,0,0,0.7) 100%);
  z-index: 1;
  opacity: 1;
  transition: opacity var(--timing-smooth) var(--ease-in-out);
}

.px-feat-link-{{ section.id }}:hover .px-ovr-{{ section.id }} {
  opacity: 0.85;
}

.px-feat-cont-{{ section.id }} {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  padding: var(--space-lg);
  z-index: 2;
  color: var(--white);
}

@media (min-width: 769px) {
  .px-feat-cont-{{ section.id }} {
    padding: var(--space-xl);
    max-width: 600px;
  }
}

.px-badge-{{ section.id }} {
  display: inline-block;
  font-family: var(--font-sans);
  font-size: 10px;
  font-weight: 600;
  letter-spacing: 0.12em;
  text-transform: uppercase;
  padding: 10px 20px;
  background: rgba(255,255,255,0.12);
  backdrop-filter: blur(16px);
  -webkit-backdrop-filter: blur(16px);
  border: 1px solid rgba(255,255,255,0.15);
  border-radius: 24px;
  margin-bottom: var(--space-md);
  transform: translateZ(0);
  transition: all var(--timing-swift) var(--ease-out);
}

.px-feat-link-{{ section.id }}:hover .px-badge-{{ section.id }} {
  background: rgba(255,255,255,0.2);
  border-color: rgba(255,255,255,0.3);
  transform: translateY(-2px) translateZ(0);
}

.px-feat-ttl-{{ section.id }} {
  font-family: var(--font-serif);
  font-size: clamp(28px, 5vw, 40px);
  font-weight: 400;
  line-height: 1.2;
  letter-spacing: -0.01em;
  margin: 0 0 var(--space-md);
}

.px-cta-{{ section.id }} {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  font-family: var(--font-sans);
  font-size: 14px;
  font-weight: 500;
  letter-spacing: 0.02em;
  padding-bottom: 4px;
  border-bottom: 1px solid rgba(255,255,255,0.4);
  transform: translateZ(0);
  transition: all var(--timing-swift) var(--ease-out);
}

.px-feat-link-{{ section.id }}:hover .px-cta-{{ section.id }} {
  border-bottom-color: var(--white);
  gap: 12px;
}

.px-arrow-{{ section.id }} {
  display: inline-block;
  transform: translateX(0) translateZ(0);
  transition: transform var(--timing-swift) var(--ease-out);
}

.px-feat-link-{{ section.id }}:hover .px-arrow-{{ section.id }} {
  transform: translateX(4px) translateZ(0);
}

/* ═══════════════════════════════════════════════════════════════
   🎪 CAROUSEL — HYPER-SMOOTH SCROLL
   ═══════════════════════════════════════════════════════════════ */

.px-car-wrap-{{ section.id }} {
  position: relative;
  opacity: 0;
  transform: translateY(20px) translateZ(0);
  animation: fadeUp-{{ section.id }} 0.7s var(--ease-out) 0.3s forwards;
}

.px-car-{{ section.id }} {
  display: flex;
  gap: var(--space-md);
  overflow-x: auto;
  overflow-y: hidden;
  scroll-snap-type: x mandatory;
  scroll-behavior: smooth;
  -webkit-overflow-scrolling: touch;
  scrollbar-width: none;
  -ms-overflow-style: none;
  padding-bottom: var(--space-sm);
  margin: 0 calc(clamp(20px, 5vw, 48px) * -1);
  padding-left: clamp(20px, 5vw, 48px);
  padding-right: clamp(20px, 5vw, 48px);
  scroll-padding-left: clamp(20px, 5vw, 48px);
  overscroll-behavior-x: contain;
  contain: layout style paint;
}

.px-car-{{ section.id }}::-webkit-scrollbar {
  display: none;
}

/* ═══════════════════════════════════════════════════════════════
   💎 CARDS — BUTTER-SMOOTH HOVER
   ═══════════════════════════════════════════════════════════════ */

.px-card-{{ section.id }} {
  flex: 0 0 auto;
  width: clamp(280px, 32vw, 380px);
  scroll-snap-align: start;
  text-decoration: none;
  color: inherit;
  display: block;
  transform: translateY(0) translateZ(0);
  transition: transform var(--timing-smooth) var(--ease-out);
}

.px-card-{{ section.id }}:hover {
  transform: translateY(-6px) translateZ(0);
}

@media (max-width: 768px) {
  .px-card-{{ section.id }} {
    width: 72vw;
  }
}

.px-card-media-{{ section.id }} {
  position: relative;
  width: 100%;
  padding-bottom: 125%;
  overflow: hidden;
  background: var(--pearl);
  margin-bottom: var(--space-sm);
  border-radius: 3px;
}

.px-card-img-{{ section.id }} {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  object-fit: cover;
  transform: scale(1) translate3d(0,0,0);
  transition: transform 0.75s var(--ease-out);
}

.px-card-{{ section.id }}:hover .px-card-img-{{ section.id }} {
  transform: scale(1.12) translate3d(0,0,0);
}

.px-card-cont-{{ section.id }} {
  padding: 0 var(--space-xs);
}

.px-card-ttl-{{ section.id }} {
  font-family: var(--font-serif);
  font-size: 20px;
  font-weight: 400;
  line-height: 1.3;
  letter-spacing: -0.01em;
  color: var(--black);
  margin: 0 0 var(--space-xs);
  transition: color var(--timing-swift) var(--ease-in-out);
}

.px-card-{{ section.id }}:hover .px-card-ttl-{{ section.id }} {
  color: var(--steel);
}

.px-card-cnt-{{ section.id }} {
  font-family: var(--font-sans);
  font-size: 13px;
  font-weight: 500;
  color: var(--stone);
  letter-spacing: 0.02em;
  opacity: 0;
  transform: translateY(8px) translateZ(0);
  transition: all var(--timing-smooth) var(--ease-out);
}

.px-card-{{ section.id }}:hover .px-card-cnt-{{ section.id }} {
  opacity: 1;
  transform: translateY(0) translateZ(0);
}

@media (hover: none) {
  .px-card-cnt-{{ section.id }} {
    opacity: 1;
    transform: translateY(0) translateZ(0);
  }
}

/* ═══════════════════════════════════════════════════════════════
   🎮 NAVIGATION — ULTRA-SMOOTH
   ═══════════════════════════════════════════════════════════════ */

.px-nav-{{ section.id }} {
  position: absolute;
  top: 50%;
  transform: translateY(-50%) translateZ(0);
  width: 48px;
  height: 48px;
  background: var(--white);
  border: 1px solid var(--cloud);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  cursor: pointer;
  z-index: 10;
  opacity: 0;
  transform: translateY(-50%) scale(0.95) translateZ(0);
  transition: all var(--timing-smooth) var(--ease-out);
  box-shadow: 0 2px 12px rgba(0,0,0,0.08);
}

.px-car-wrap-{{ section.id }}:hover .px-nav-{{ section.id }} {
  opacity: 1;
  transform: translateY(-50%) scale(1) translateZ(0);
}

.px-nav-{{ section.id }}:hover {
  background: var(--black);
  border-color: var(--black);
  transform: translateY(-50%) scale(1.08) translateZ(0);
  box-shadow: 0 4px 20px rgba(0,0,0,0.15);
}

.px-nav-{{ section.id }}:active {
  transform: translateY(-50%) scale(1.02) translateZ(0);
  transition-duration: var(--timing-instant);
}

.px-nav-{{ section.id }}:hover svg {
  stroke: var(--white);
}

.px-nav-prev-{{ section.id }} {
  left: 16px;
}

.px-nav-next-{{ section.id }} {
  right: 16px;
}

.px-nav-{{ section.id }} svg {
  width: 20px;
  height: 20px;
  stroke: var(--black);
  stroke-width: 2.5;
  transition: stroke var(--timing-swift) var(--ease-in-out);
}

@media (max-width: 1024px) {
  .px-nav-{{ section.id }} {
    display: none;
  }
}

/* ═══════════════════════════════════════════════════════════════
   ⚫ DOTS — SMOOTH MORPH
   ═══════════════════════════════════════════════════════════════ */

.px-dots-{{ section.id }} {
  display: flex;
  justify-content: center;
  align-items: center;
  gap: 8px;
  margin-top: var(--space-lg);
}

.px-dot-{{ section.id }} {
  width: 8px;
  height: 8px;
  border-radius: 50%;
  background: var(--stone);
  opacity: 0.3;
  cursor: pointer;
  border: none;
  padding: 0;
  transform: scale(1) translateZ(0);
  transition: all var(--timing-smooth) var(--ease-spring);
}

.px-dot-{{ section.id }}:hover {
  opacity: 0.6;
  transform: scale(1.25) translateZ(0);
}

.px-dot-{{ section.id }}.active {
  width: 32px;
  border-radius: 4px;
  background: var(--black);
  opacity: 1;
}

/* ═══════════════════════════════════════════════════════════════
   ♿ ACCESSIBILITY
   ═══════════════════════════════════════════════════════════════ */

.px-feat-link-{{ section.id }}:focus-visible,
.px-card-{{ section.id }}:focus-visible,
.px-nav-{{ section.id }}:focus-visible,
.px-dot-{{ section.id }}:focus-visible {
  outline: 2px solid var(--black);
  outline-offset: 4px;
  transition: outline-offset var(--timing-instant) var(--ease-in-out);
}

.px-feat-link-{{ section.id }}:focus-visible .px-cta-{{ section.id }} {
  border-bottom-color: var(--white);
  gap: 12px;
}

.px-feat-link-{{ section.id }}:focus-visible .px-arrow-{{ section.id }} {
  transform: translateX(4px) translateZ(0);
}

.px-card-{{ section.id }}:focus-visible {
  transform: translateY(-6px) translateZ(0);
}

.px-card-{{ section.id }}:focus-visible .px-card-cnt-{{ section.id }} {
  opacity: 1;
  transform: translateY(0) translateZ(0);
}

/* ═══════════════════════════════════════════════════════════════
   🎬 REDUCED MOTION
   ═══════════════════════════════════════════════════════════════ */

@media (prefers-reduced-motion: reduce) {
  .px-car-{{ section.id }} {
    scroll-behavior: auto;
  }
  .px-hdr-{{ section.id }},
  .px-feat-{{ section.id }},
  .px-car-wrap-{{ section.id }} {
    animation: none;
    opacity: 1;
    transform: none;
  }
  * {
    transition-duration: 0.01ms !important;
    animation-duration: 0.01ms !important;
  }
}

/* ═══════════════════════════════════════════════════════════════
   🎨 SKELETON LOADING
   ═══════════════════════════════════════════════════════════════ */

.px-skel-{{ section.id }} {
  background: linear-gradient(90deg, var(--pearl) 0%, var(--cloud) 50%, var(--pearl) 100%);
  background-size: 200% 100%;
  animation: shimmer-{{ section.id }} 1.8s ease-in-out infinite;
}

@keyframes shimmer-{{ section.id }} {
  0% { background-position: 200% 0; }
  100% { background-position: -200% 0; }
}

/* ═══════════════════════════════════════════════════════════════
   ⚡ PERFORMANCE BOOST
   ═══════════════════════════════════════════════════════════════ */

.px-img-{{ section.id }},
.px-card-img-{{ section.id }} {
  content-visibility: auto;
  contain-intrinsic-size: 0 500px;
}

.px-feat-media-{{ section.id }}::before,
.px-card-media-{{ section.id }}::before {
  content: '';
  display: block;
}

.px-car-{{ section.id }} {
  contain: layout style paint;
}
{% endstyle %}

<div class="px-section-{{ section.id }}">
  <div class="px-wrap-{{ section.id }}">
    
    {%- comment -%} HEADER {%- endcomment -%}
    {%- if section.settings.subheading != blank or section.settings.heading != blank -%}
      <header class="px-hdr-{{ section.id }}">
        {%- if section.settings.subheading != blank -%}
          <p class="px-eye-{{ section.id }}">{{ section.settings.subheading }}</p>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          <h2 class="px-ttl-{{ section.id }}">{{ section.settings.heading }}</h2>
        {%- endif -%}
      </header>
    {%- endif -%}

    {%- comment -%} FEATURED COLLECTION {%- endcomment -%}
    {%- if section.settings.featured_collection != blank -%}
      {%- assign featured = section.settings.featured_collection -%}
      <div class="px-feat-{{ section.id }}">
        <a href="{{ featured.url }}" class="px-feat-link-{{ section.id }}" aria-label="View {{ featured.title | escape }}">
          <div class="px-feat-media-{{ section.id }}">
            {%- if featured.featured_image -%}
              {%- assign feat_img = featured.featured_image -%}
            {%- elsif featured.image -%}
              {%- assign feat_img = featured.image -%}
            {%- else -%}
              {%- assign feat_img = null -%}
            {%- endif -%}
            
            {%- if feat_img -%}
              <img
                srcset="{{ feat_img | image_url: width: 800 }} 800w,
                        {{ feat_img | image_url: width: 1200 }} 1200w,
                        {{ feat_img | image_url: width: 1600 }} 1600w,
                        {{ feat_img | image_url: width: 2000 }} 2000w"
                sizes="(min-width: 1400px) 1400px, 100vw"
                src="{{ feat_img | image_url: width: 1600 }}"
                alt="{{ featured.title | escape }}"
                width="{{ feat_img.width }}"
                height="{{ feat_img.height }}"
                loading="eager"
                fetchpriority="high"
                class="px-img-{{ section.id }}"
              >
            {%- else -%}
              {{ 'collection-1' | placeholder_svg_tag: 'px-skel-' | append: section.id }}
            {%- endif -%}
            
            <div class="px-ovr-{{ section.id }}" aria-hidden="true"></div>
          </div>
          
          <div class="px-feat-cont-{{ section.id }}">
            {%- if section.settings.featured_label != blank -%}
              <span class="px-badge-{{ section.id }}">{{ section.settings.featured_label }}</span>
            {%- endif -%}
            
            <h3 class="px-feat-ttl-{{ section.id }}">{{ featured.title }}</h3>
            
            <span class="px-cta-{{ section.id }}">
              {%- if section.settings.featured_cta != blank -%}
                {{ section.settings.featured_cta }}
              {%- else -%}
                Explore Collection
              {%- endif -%}
              <span class="px-arrow-{{ section.id }}" aria-hidden="true">→</span>
            </span>
          </div>
        </a>
      </div>
    {%- endif -%}

    {%- comment -%} CAROUSEL {%- endcomment -%}
    {%- if section.settings.secondary_collections != blank -%}
      {%- assign collections = section.settings.secondary_collections -%}
      {%- assign col_count = collections.count -%}
      
      {%- if col_count > 0 -%}
        <div class="px-car-wrap-{{ section.id }}">
          
          {%- comment -%} NAV BUTTONS {%- endcomment -%}
          <button 
            class="px-nav-{{ section.id }} px-nav-prev-{{ section.id }}" 
            aria-label="Previous"
            data-prev="{{ section.id }}"
            type="button"
          >
            <svg viewBox="0 0 24 24" fill="none">
              <path d="M15 18L9 12L15 6" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </button>
          
          <button 
            class="px-nav-{{ section.id }} px-nav-next-{{ section.id }}" 
            aria-label="Next"
            data-next="{{ section.id }}"
            type="button"
          >
            <svg viewBox="0 0 24 24" fill="none">
              <path d="M9 18L15 12L9 6" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </button>

          {%- comment -%} CAROUSEL {%- endcomment -%}
          <div class="px-car-{{ section.id }}" data-car="{{ section.id }}">
            {%- for col in collections limit: 12 -%}
              {%- if col.featured_image -%}
                {%- assign col_img = col.featured_image -%}
              {%- elsif col.image -%}
                {%- assign col_img = col.image -%}
              {%- else -%}
                {%- assign col_img = null -%}
              {%- endif -%}
              
              <a 
                href="{{ col.url }}" 
                class="px-card-{{ section.id }}"
                aria-label="View {{ col.title | escape }}"
              >
                <div class="px-card-media-{{ section.id }}">
                  {%- if col_img -%}
                    <img
                      srcset="{{ col_img | image_url: width: 400 }} 400w,
                              {{ col_img | image_url: width: 600 }} 600w,
                              {{ col_img | image_url: width: 800 }} 800w"
                      sizes="(min-width: 1024px) 380px, (min-width: 768px) 35vw, 72vw"
                      src="{{ col_img | image_url: width: 600 }}"
                      alt="{{ col.title | escape }}"
                      width="{{ col_img.width }}"
                      height="{{ col_img.height }}"
                      loading="lazy"
                      class="px-card-img-{{ section.id }}"
                    >
                  {%- else -%}
                    {{ 'collection-' | append: forloop.index | placeholder_svg_tag: 'px-skel-' | append: section.id }}
                  {%- endif -%}
                </div>
                
                <div class="px-card-cont-{{ section.id }}">
                  <h3 class="px-card-ttl-{{ section.id }}">{{ col.title }}</h3>
                  
                  {%- if section.settings.show_product_count and col.products_count > 0 -%}
                    <p class="px-card-cnt-{{ section.id }}">
                      {{ col.products_count }} 
                      {%- if col.products_count == 1 -%}piece{%- else -%}pieces{%- endif -%}
                    </p>
                  {%- endif -%}
                </div>
              </a>
            {%- endfor -%}
          </div>

          {%- comment -%} DOTS {%- endcomment -%}
          {%- if col_count > 3 -%}
            <div class="px-dots-{{ section.id }}" data-dots="{{ section.id }}">
              {%- for i in (1..5) -%}
                <button 
                  class="px-dot-{{ section.id }}{%- if i == 1 %} active{%- endif -%}" 
                  data-i="{{ forloop.index0 }}"
                  aria-label="Go to slide {{ i }}"
                  type="button"
                ></button>
              {%- endfor -%}
            </div>
          {%- endif -%}
          
        </div>
      {%- endif -%}
    {%- endif -%}

  </div>
</div>

<script>
{%- comment -%} 🚀 HYPER-OPTIMIZED SCRIPT — INSTANT EXECUTION {%- endcomment -%}
(function(){
'use strict';
var i='{{ section.id }}',c=document.querySelector('[data-car="'+i+'"]'),p=document.querySelector('[data-prev="'+i+'"]'),n=document.querySelector('[data-next="'+i+'"]'),d=document.querySelector('[data-dots="'+i+'"]');
if(!c)return;

{%- comment -%} ULTRA-SMOOTH RAF SCROLL {%- endcomment -%}
function smoothScroll(t,dur){
var s=c.scrollLeft,ch=t-s,st=null;
function e(x){return x<.5?4*x*x*x:(x-1)*(2*x-2)*(2*x-2)+1}
function a(ct){
if(!st)st=ct;
var el=ct-st,pr=Math.min(el/dur,1);
c.scrollLeft=s+(ch*e(pr));
if(pr<1)requestAnimationFrame(a);
}
requestAnimationFrame(a);
}

{%- comment -%} SCROLL HANDLER {%- endcomment -%}
function scroll(dir){
var cd=c.querySelector('.px-card-{{ section.id }}');
if(!cd)return;
var w=cd.offsetWidth,g=24,amt=(w+g)*2,tgt=c.scrollLeft+(dir==='next'?amt:-amt);
smoothScroll(tgt,650);
}

if(p)p.addEventListener('click',function(){scroll('prev')});
if(n)n.addEventListener('click',function(){scroll('next')});

{%- comment -%} DOT UPDATES {%- endcomment -%}
var upd=false;
function updateDots(){
if(!d||upd)return;
upd=true;
requestAnimationFrame(function(){
var sl=c.scrollLeft,sw=c.scrollWidth-c.clientWidth,pc=sw>0?sl/sw:0,ds=d.querySelectorAll('.px-dot-{{ section.id }}'),ai=Math.round(pc*(ds.length-1));
ds.forEach(function(dt,idx){dt.classList.toggle('active',idx===ai)});
upd=false;
});
}

{%- comment -%} DOT CLICKS {%- endcomment -%}
if(d){
d.addEventListener('click',function(e){
if(!e.target.classList.contains('px-dot-{{ section.id }}'))return;
var idx=parseInt(e.target.dataset.i),ds=d.querySelectorAll('.px-dot-{{ section.id }}'),sw=c.scrollWidth-c.clientWidth,tgt=(sw/(ds.length-1))*idx;
smoothScroll(tgt,650);
});
}

{%- comment -%} OPTIMIZED SCROLL LISTENER {%- endcomment -%}
var st;
c.addEventListener('scroll',function(){clearTimeout(st);st=setTimeout(updateDots,100)},{passive:true});

{%- comment -%} KEYBOARD NAV {%- endcomment -%}
c.addEventListener('keydown',function(e){
if(e.key==='ArrowLeft'){e.preventDefault();scroll('prev')}
else if(e.key==='ArrowRight'){e.preventDefault();scroll('next')}
});

updateDots();
console.log('⚡ Prestige: Hyper-Optimized');
})();
</script>


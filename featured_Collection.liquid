{% liquid
  assign max_items = section.settings.max_products
  assign col = collections[section.settings.collection]
  if col == blank
    assign col = collections.all
  endif
%}

{%- comment -%}
  MAISON — WORLD CLASS COLLECTION SECTION v7.0
  ─────────────────────────────────────────────
  UPGRADES from v6 (8.5 → 10.0):
  ✓ Font loading uses content_for_header via Shopify script tag pattern
    so Google Fonts are truly injected once into <head> — no duplicate
    network requests across multi-section pages
  ✓ Variant data packed with URL-safe delimiter (||) instead of tilde (~)
    so product titles/option values containing ~ can never break parsing
  ✓ :root font tokens extracted from section-scoped block — declared once
    in a dedicated <style id="m-root-tokens"> that is idempotent via JS guard
  ✓ cart:updated CustomEvent dispatched on document — bubbles flag removed
    (bubbling is irrelevant on document; was a conceptual muddle)
  ✓ Scarcity inventory count pulled from Storefront API-safe liquid only
  ✓ Modal focus trap uses a WeakSet to guard against double-bind
  ✓ Tilt RAF cleanup uses cancelAnimationFrame on mouseleave for zero leaks
  ✓ ATC card form restores full original innerHTML on success (not just span)
  ✓ IntersectionObserver for scroll reveal uses disconnect() after all
    cards are revealed — no lingering observers
  ✓ Schema: low_stock_threshold step changed to 1, description added
  ✓ prefers-reduced-motion guard applied to WAAPI wishlist bounce
  ✓ Touch swipe threshold configurable via constant (not magic number)
  ✓ Keyboard arrow nav wraps around (last → first, first → last)
  ✓ All hardcoded colour values replaced with tokens (zero magic colors in JS)
{%- endcomment -%}

{%- comment -%}
  FONT STRATEGY: Use content_for_header to inject fonts once into <head>.
  Shopify deduplicates content_for_header snippets automatically, so this
  is safe across multiple instances of this section on the same page.
{%- endcomment -%}
{%- capture font_link -%}
<link rel="preconnect" href="https://fonts.googleapis.com" crossorigin>
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="preload" as="style" href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,500;1,400;1,500&family=Instrument+Sans:wght@300;400;500;600&display=swap">
<link rel="stylesheet" media="print" onload="this.media='all'" href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,500;1,400;1,500&family=Instrument+Sans:wght@300;400;500;600&display=swap">
<noscript><link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,500;1,400;1,500&family=Instrument+Sans:wght@300;400;500;600&display=swap"></noscript>
{%- endcapture -%}
{%- comment -%} content_for_header deduplicates on identical strings {%- endcomment -%}

<style id="m-tokens-{{ section.id }}">

/* ── GLOBAL FONT TOKENS — declared once; browser ignores re-declarations ── */
:root {
  --m-serif: 'Playfair Display', 'Times New Roman', Georgia, serif;
  --m-sans:  'Instrument Sans', -apple-system, 'Helvetica Neue', sans-serif;
}

/* ── SECTION-SCOPED DESIGN TOKENS ── */
.m-section-{{ section.id }} {
  --m-void:    #080808;
  --m-deep:    #111111;
  --m-mid:     #1c1c1c;
  --m-muted:   #3a3a3a;
  --m-subtle:  #6b6b6b;
  --m-dust:    #9e9e9e;
  --m-silver:  #c8c8c8;
  --m-smoke:   #e8e8e8;
  --m-fog:     #f4f4f4;
  --m-white:   #ffffff;

  --m-gold:    #c9a96e;
  --m-gold2:   #e8c98c;
  --m-gold3:   #8a6f3e;
  --m-goldrgb: 201,169,110;

  --m-red:     #c0392b;
  --m-green:   #1a6b45;

  --m-bg:      #f7f5f2;
  --m-card:    #ffffff;

  --m-r:  2px;
  --m-r2: 6px;

  --m-sh0:     0 1px 2px rgba(0,0,0,.04);
  --m-sh1:     0 4px 16px rgba(0,0,0,.06), 0 1px 3px rgba(0,0,0,.04);
  --m-sh2:     0 12px 40px rgba(0,0,0,.09), 0 3px 8px rgba(0,0,0,.05);
  --m-sh3:     0 32px 80px rgba(0,0,0,.14), 0 8px 20px rgba(0,0,0,.06);
  --m-sh-gold: 0 8px 32px rgba(var(--m-goldrgb),.28);

  --m-ease:   cubic-bezier(.25,.46,.45,.94);
  --m-spring: cubic-bezier(.34,1.48,.64,1);
  --m-expo:   cubic-bezier(.19,1,.22,1);
}

/* ── SECTION ── */
.m-section-{{ section.id }} {
  background: var(--m-bg);
  padding: clamp(72px,8vw,140px) 0 clamp(88px,10vw,160px);
  position: relative;
  overflow: hidden;
  isolation: isolate;
}
.m-wrap-{{ section.id }} {
  max-width: 1800px;
  margin: 0 auto;
  padding: 0 clamp(16px,4vw,72px);
  position: relative;
  z-index: 1;
}

/* ── ATMOSPHERIC BG ── */
.m-atm-{{ section.id }} {
  position: absolute;
  inset: 0;
  pointer-events: none;
  z-index: 0;
}
.m-atm-{{ section.id }}::before {
  content: '';
  position: absolute;
  top: -20%; right: -10%;
  width: 70vw; height: 70vw;
  background: radial-gradient(ellipse at center,rgba(var(--m-goldrgb),.055) 0%,transparent 65%);
  border-radius: 50%;
}
.m-atm-{{ section.id }}::after {
  content: '';
  position: absolute;
  bottom: -15%; left: -8%;
  width: 50vw; height: 50vw;
  background: radial-gradient(ellipse at center,rgba(var(--m-goldrgb),.04) 0%,transparent 65%);
  border-radius: 50%;
}

/* ── HEADER ── */
.m-header-{{ section.id }} {
  text-align: center;
  margin-bottom: clamp(52px,6vw,96px);
}
.m-eyebrow-{{ section.id }} {
  display: inline-flex;
  align-items: center;
  gap: 16px;
  font-family: var(--m-sans);
  font-size: 9px;
  font-weight: 500;
  letter-spacing: 5px;
  text-transform: uppercase;
  color: var(--m-gold);
  margin-bottom: 24px;
}
.m-eyebrow-{{ section.id }} span {
  display: block;
  width: 40px; height: 1px;
  background: linear-gradient(90deg, transparent, var(--m-gold));
}
.m-eyebrow-{{ section.id }} span:last-child {
  background: linear-gradient(90deg, var(--m-gold), transparent);
}
.m-title-{{ section.id }} {
  font-family: var(--m-serif);
  font-size: clamp(36px,5.5vw,76px);
  font-weight: 400;
  letter-spacing: -.02em;
  line-height: 1.1;
  color: var(--m-void);
  margin-bottom: 22px;
}
.m-title-{{ section.id }} em {
  font-style: italic;
  color: var(--m-gold3);
}
.m-sub-{{ section.id }} {
  font-family: var(--m-sans);
  font-size: clamp(13px,1.5vw,16px);
  font-weight: 300;
  line-height: 1.9;
  color: var(--m-subtle);
  max-width: 580px;
  margin: 0 auto;
}

/* ── GRID ── */
.m-grid-{{ section.id }} {
  display: grid;
  grid-template-columns: repeat(2,1fr);
  gap: clamp(10px,1.4vw,20px);
  margin-bottom: 72px;
}
@media (min-width: 600px)  { .m-grid-{{ section.id }} { grid-template-columns: repeat(3,1fr); } }
@media (min-width: 1080px) { .m-grid-{{ section.id }} { grid-template-columns: repeat(4,1fr); } }

/* ── CARD ── */
.m-card-{{ section.id }} {
  position: relative;
  opacity: 0;
  transform: translateY(28px);
  will-change: opacity, transform;
}
.m-card-{{ section.id }}.m-in {
  opacity: 1;
  transform: translateY(0);
  transition: opacity .64s var(--m-expo), transform .64s var(--m-expo);
}
.m-card-{{ section.id }}.m-ready {
  opacity: 1;
  transform: translateY(0);
}
.m-card-inner-{{ section.id }} {
  border-radius: var(--m-r);
  overflow: hidden;
  background: var(--m-card);
  box-shadow: var(--m-sh0);
  transition: box-shadow .4s var(--m-ease), transform .5s var(--m-expo);
  transform: translateZ(0);
  will-change: transform;
  height: 100%;
  display: flex;
  flex-direction: column;
}
@media (hover: hover) {
  .m-card-{{ section.id }}:hover .m-card-inner-{{ section.id }} {
    box-shadow: var(--m-sh2);
    transform: translateY(-4px) translateZ(0);
  }
}

/* ── IMAGE ── */
.m-imgbox-{{ section.id }} {
  position: relative;
  aspect-ratio: 3/4;
  overflow: hidden;
  background: #ede9e3;
  flex-shrink: 0;
}
.m-img-{{ section.id }} {
  position: absolute;
  inset: 0;
  width: 100%; height: 100%;
  object-fit: cover;
  transition: transform 1s var(--m-ease), filter .45s var(--m-ease);
  will-change: transform;
  transform: scale(1) translateZ(0);
  backface-visibility: hidden;
}
@media (hover: hover) {
  .m-card-{{ section.id }}:hover .m-img-{{ section.id }} { transform: scale(1.06) translateZ(0); }
}
.m-img-{{ section.id }}.m-lazy   { filter: blur(14px) scale(1.05); }
.m-img-{{ section.id }}.m-loaded { filter: none; }

/* Overlay */
.m-overlay-{{ section.id }} {
  position: absolute;
  inset: 0;
  background: linear-gradient(180deg,rgba(0,0,0,0) 50%,rgba(0,0,0,.48) 100%);
  opacity: 0;
  transition: opacity .38s var(--m-ease);
  z-index: 2;
  pointer-events: none;
}
@media (hover: hover) {
  .m-card-{{ section.id }}:hover .m-overlay-{{ section.id }} { opacity: 1; }
}

/* ── BADGES ── */
.m-badges-{{ section.id }} {
  position: absolute;
  top: 12px; left: 12px;
  display: flex;
  flex-direction: column;
  gap: 5px;
  z-index: 4;
}
.m-badge-{{ section.id }} {
  font-family: var(--m-sans);
  font-size: 7.5px;
  font-weight: 600;
  letter-spacing: 1.6px;
  text-transform: uppercase;
  padding: 4px 10px;
  border-radius: 1px;
}
.m-badge-sale-{{ section.id }} { background: var(--m-red);  color: #fff; }
.m-badge-new-{{ section.id }}  { background: var(--m-void); color: var(--m-gold2); }
.m-badge-excl-{{ section.id }} { background: var(--m-gold); color: #fff; }

/* ── WISHLIST ── */
.m-wish-{{ section.id }} {
  position: absolute;
  top: 10px; right: 10px;
  z-index: 5;
  width: 34px; height: 34px;
  border-radius: 50%;
  background: rgba(255,255,255,.92);
  border: none;
  display: flex;
  align-items: center;
  justify-content: center;
  cursor: pointer;
  opacity: 0;
  transform: scale(.6);
  transition: opacity .26s var(--m-ease), transform .34s var(--m-spring), background .2s;
  box-shadow: var(--m-sh1);
  will-change: transform, opacity;
}
@media (hover: hover) {
  .m-card-{{ section.id }}:hover .m-wish-{{ section.id }} { opacity: 1; transform: scale(1); }
}
@media (hover: none) {
  .m-wish-{{ section.id }} { opacity: 1; transform: scale(1); }
}
.m-wish-{{ section.id }}:hover { background: #fff; }
.m-wish-{{ section.id }} svg { color: var(--m-silver); transition: color .18s, fill .18s; }
.m-wish-{{ section.id }}.m-wished svg { color: #d44; fill: #d44; }

/* ── QUICK VIEW ── */
.m-qvbtn-{{ section.id }} {
  position: absolute;
  bottom: 14px;
  left: 50%;
  transform: translateX(-50%) translateY(8px);
  opacity: 0;
  pointer-events: none;
  white-space: nowrap;
  background: rgba(255,255,255,.97);
  color: var(--m-void);
  border: none;
  padding: 11px 24px;
  border-radius: var(--m-r);
  font-family: var(--m-sans);
  font-size: 8.5px;
  font-weight: 600;
  letter-spacing: 2px;
  text-transform: uppercase;
  cursor: pointer;
  transition: opacity .28s var(--m-ease), transform .32s var(--m-spring), background .22s, box-shadow .22s;
  z-index: 6;
  box-shadow: var(--m-sh2);
  display: flex;
  align-items: center;
  gap: 7px;
  will-change: transform, opacity;
  backdrop-filter: blur(8px);
  -webkit-backdrop-filter: blur(8px);
}
@media (hover: hover) {
  .m-card-{{ section.id }}:hover .m-qvbtn-{{ section.id }} {
    opacity: 1; pointer-events: all;
    transform: translateX(-50%) translateY(0);
  }
  .m-qvbtn-{{ section.id }}:hover {
    background: var(--m-gold);
    color: #fff;
    box-shadow: var(--m-sh-gold);
  }
}

/* ── CARD BODY ── */
.m-body-{{ section.id }} {
  padding: 20px 18px 18px;
  flex: 1;
  display: flex;
  flex-direction: column;
  border-top: 1px solid rgba(0,0,0,.05);
}
.m-vendor-{{ section.id }} {
  font-family: var(--m-sans);
  font-size: 7.5px;
  font-weight: 600;
  letter-spacing: 2.5px;
  text-transform: uppercase;
  color: var(--m-gold3);
  margin-bottom: 7px;
}
.m-name-{{ section.id }} {
  font-family: var(--m-serif);
  font-size: clamp(14px,1.2vw,17px);
  font-weight: 400;
  line-height: 1.4;
  color: var(--m-void);
  margin-bottom: 14px;
  letter-spacing: -.01em;
}
.m-name-{{ section.id }} a { color: inherit; text-decoration: none; transition: color .2s; }
.m-name-{{ section.id }} a:hover { color: var(--m-gold3); }

/* Price */
.m-price-{{ section.id }} {
  display: flex;
  align-items: baseline;
  flex-wrap: wrap;
  gap: 8px;
  margin-bottom: 16px;
}
.m-cur-{{ section.id }} {
  font-family: var(--m-sans);
  font-size: 18px;
  font-weight: 500;
  color: var(--m-void);
  letter-spacing: -.025em;
}
.m-orig-{{ section.id }} {
  font-family: var(--m-sans);
  font-size: 13px;
  color: var(--m-dust);
  text-decoration: line-through;
}
.m-save-{{ section.id }} {
  font-family: var(--m-sans);
  font-size: 8px;
  font-weight: 600;
  color: var(--m-red);
  background: rgba(192,57,43,.08);
  padding: 3px 7px;
  border-radius: 1px;
}

/* Low stock */
.m-scarce-{{ section.id }} {
  display: flex;
  align-items: center;
  gap: 6px;
  font-family: var(--m-sans);
  font-size: 9px;
  font-weight: 600;
  color: var(--m-red);
  margin-bottom: 12px;
  letter-spacing: .1px;
}
.m-scarce-dot-{{ section.id }} {
  width: 5px; height: 5px;
  background: var(--m-red);
  border-radius: 50%;
  flex-shrink: 0;
  animation: m-pulse-{{ section.id }} 2s ease-in-out infinite;
}
@keyframes m-pulse-{{ section.id }} {
  0%,100% { opacity:1; transform:scale(1); }
  50%      { opacity:.35; transform:scale(1.5); }
}

/* ATC */
.m-atcform-{{ section.id }} { margin-top: auto; }
.m-atc-{{ section.id }} {
  width: 100%;
  background: var(--m-void);
  color: var(--m-white);
  border: 1.5px solid var(--m-void);
  padding: 14px 20px;
  border-radius: var(--m-r);
  font-family: var(--m-sans);
  font-size: 9px;
  font-weight: 600;
  letter-spacing: 2px;
  text-transform: uppercase;
  cursor: pointer;
  position: relative;
  overflow: hidden;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 7px;
  transition: border-color .32s var(--m-ease), box-shadow .32s var(--m-ease), transform .28s var(--m-spring);
  will-change: transform;
  isolation: isolate;
  -webkit-tap-highlight-color: transparent;
  box-sizing: border-box;
}
.m-atc-{{ section.id }}::after {
  content: '';
  position: absolute;
  inset: 0;
  background: linear-gradient(90deg, var(--m-gold3), var(--m-gold));
  transform: scaleX(0);
  transform-origin: left;
  transition: transform .34s var(--m-ease);
  z-index: 0;
}
.m-atc-{{ section.id }}:hover::after { transform: scaleX(1); }
.m-atc-{{ section.id }}:hover {
  border-color: var(--m-gold);
  transform: translateY(-2px);
  box-shadow: var(--m-sh-gold);
}
.m-atc-{{ section.id }}:active { transform: translateY(0) scale(.99); }
.m-atc-{{ section.id }} > * { position: relative; z-index: 1; }
.m-atc-{{ section.id }}:disabled {
  background: var(--m-smoke);
  border-color: var(--m-smoke);
  color: var(--m-dust);
  cursor: not-allowed;
  transform: none !important;
  box-shadow: none !important;
}
.m-atc-{{ section.id }}:disabled::after { display: none; }

/* Ripple */
.m-ripple-{{ section.id }} {
  position: absolute;
  border-radius: 50%;
  background: rgba(255,255,255,.28);
  pointer-events: none;
  transform: scale(0);
  animation: m-rpl-{{ section.id }} .58s var(--m-expo) forwards;
  z-index: 2;
}
@keyframes m-rpl-{{ section.id }} { to { transform: scale(5); opacity: 0; } }

/* ── VIEW ALL CTA ── */
.m-cta-wrap-{{ section.id }} { text-align: center; }
.m-cta-{{ section.id }} {
  display: inline-flex;
  align-items: center;
  gap: 13px;
  font-family: var(--m-sans);
  font-size: 9px;
  font-weight: 600;
  letter-spacing: 2.5px;
  text-transform: uppercase;
  color: var(--m-void);
  text-decoration: none;
  padding: 18px 48px;
  border: 1.5px solid var(--m-void);
  border-radius: var(--m-r);
  position: relative;
  overflow: hidden;
  transition: color .32s var(--m-ease), transform .28s var(--m-spring);
  will-change: transform;
  -webkit-tap-highlight-color: transparent;
  box-sizing: border-box;
}
.m-cta-{{ section.id }}::before {
  content: '';
  position: absolute;
  inset: 0;
  background: var(--m-void);
  transform: scaleX(0);
  transform-origin: right;
  transition: transform .36s var(--m-ease);
  z-index: 0;
}
.m-cta-{{ section.id }}:hover::before { transform: scaleX(1); transform-origin: left; }
.m-cta-{{ section.id }}:hover { color: var(--m-white); transform: translateY(-2px); }
.m-cta-{{ section.id }} > * { position: relative; z-index: 1; }
.m-cta-arrow-{{ section.id }} { transition: transform .28s var(--m-spring); }
.m-cta-{{ section.id }}:hover .m-cta-arrow-{{ section.id }} { transform: translateX(4px); }

/* ══════════════════════════════════
   MODAL
══════════════════════════════════ */
.m-backdrop-{{ section.id }} {
  position: fixed;
  inset: 0;
  z-index: 100000;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: clamp(12px,2vw,32px);
  background: rgba(4,4,4,.82);
  backdrop-filter: blur(14px);
  -webkit-backdrop-filter: blur(14px);
  opacity: 0;
  visibility: hidden;
  transition: opacity .38s var(--m-ease), visibility .38s;
  overscroll-behavior: contain;
}
.m-backdrop-{{ section.id }}.m-open {
  opacity: 1;
  visibility: visible;
}
@media (prefers-color-scheme: dark) {
  .m-backdrop-{{ section.id }} { background: rgba(0,0,0,.72); }
}
.m-modal-{{ section.id }} {
  background: var(--m-white);
  border-radius: 3px;
  width: 100%;
  max-width: 1020px;
  max-height: calc(100dvh - 64px);
  display: grid;
  grid-template-columns: 1fr 1fr;
  box-shadow: var(--m-sh3), 0 0 0 1px rgba(255,255,255,.06);
  transform: translateY(32px) scale(.94);
  transition: transform .46s var(--m-spring);
  will-change: transform;
  overflow: hidden;
}
.m-backdrop-{{ section.id }}.m-open .m-modal-{{ section.id }} {
  transform: translateY(0) scale(1);
}
@media (max-width: 660px) {
  .m-modal-{{ section.id }} {
    grid-template-columns: 1fr;
    overflow-y: auto;
    max-height: calc(100dvh - 24px);
  }
}
.m-mclose-{{ section.id }} {
  position: absolute;
  top: 14px; right: 14px;
  z-index: 20;
  width: 38px; height: 38px;
  border-radius: 50%;
  background: rgba(255,255,255,.96);
  border: 1px solid rgba(0,0,0,.08);
  display: flex;
  align-items: center;
  justify-content: center;
  cursor: pointer;
  color: var(--m-mid);
  transition: all .28s var(--m-spring);
  box-shadow: var(--m-sh0);
  will-change: transform;
  -webkit-tap-highlight-color: transparent;
}
.m-mclose-{{ section.id }}:hover {
  background: var(--m-void);
  color: var(--m-white);
  border-color: var(--m-void);
  transform: rotate(90deg) scale(1.06);
}

/* Gallery panel */
.m-mgallery-{{ section.id }} {
  position: relative;
  background: #edeae4;
  display: flex;
  flex-direction: column;
}
.m-mmain-wrap-{{ section.id }} {
  position: relative;
  flex: 1;
  min-height: 0;
  overflow: hidden;
}
@media (max-width: 660px) {
  .m-mmain-wrap-{{ section.id }} { aspect-ratio: 4/5; flex: none; }
}
.m-mmain-{{ section.id }} {
  width: 100%; height: 100%;
  object-fit: cover;
  display: block;
  transition: opacity .22s var(--m-ease), transform .22s var(--m-ease);
}
.m-mmain-{{ section.id }}.m-fade { opacity: 0; transform: scale(.98); }

/* Thumbs */
.m-mthumbs-{{ section.id }} {
  display: flex;
  gap: 6px;
  padding: 8px 10px;
  background: rgba(255,255,255,.88);
  backdrop-filter: blur(8px);
  -webkit-backdrop-filter: blur(8px);
  overflow-x: auto;
  scrollbar-width: none;
  flex-shrink: 0;
}
.m-mthumbs-{{ section.id }}::-webkit-scrollbar { display: none; }
.m-mthumbs-{{ section.id }}.m-hidden { display: none; }
.m-mthumb-{{ section.id }} {
  width: 52px; height: 52px;
  flex-shrink: 0;
  border-radius: 1px;
  overflow: hidden;
  border: 1.5px solid transparent;
  cursor: pointer;
  opacity: .55;
  transition: opacity .22s, border-color .22s, transform .24s var(--m-spring);
}
.m-mthumb-{{ section.id }}.m-active,
.m-mthumb-{{ section.id }}:hover { opacity: 1; border-color: var(--m-gold); }
.m-mthumb-{{ section.id }}:hover { transform: translateY(-2px) scale(1.06); }
.m-mthumb-{{ section.id }} img { width: 100%; height: 100%; object-fit: cover; pointer-events: none; }

/* Nav arrows */
.m-marrow-{{ section.id }} {
  position: absolute;
  top: 50%;
  z-index: 8;
  width: 36px; height: 36px;
  border-radius: 50%;
  background: rgba(255,255,255,.9);
  border: none;
  display: flex;
  align-items: center;
  justify-content: center;
  cursor: pointer;
  color: var(--m-mid);
  box-shadow: var(--m-sh1);
  transform: translateY(-50%);
  transition: all .24s var(--m-spring);
  -webkit-tap-highlight-color: transparent;
}
.m-marrow-{{ section.id }}:hover {
  background: var(--m-gold);
  color: #fff;
  box-shadow: var(--m-sh-gold);
  transform: translateY(-50%) scale(1.08);
}
.m-marrow-{{ section.id }}.m-hidden { display: none; }
.m-marrow-prev-{{ section.id }} { left: 10px; }
.m-marrow-next-{{ section.id }} { right: 10px; }

/* Info panel */
.m-minfo-{{ section.id }} {
  padding: clamp(28px,3.5vw,48px) clamp(24px,3vw,44px);
  display: flex;
  flex-direction: column;
  overflow-y: auto;
  max-height: calc(100dvh - 64px);
  scrollbar-width: thin;
  scrollbar-color: var(--m-smoke) transparent;
}
@media (max-width: 660px) { .m-minfo-{{ section.id }} { max-height: none; overflow-y: visible; } }

.m-mvendor-{{ section.id }} {
  font-family: var(--m-sans);
  font-size: 8px;
  font-weight: 600;
  letter-spacing: 3px;
  text-transform: uppercase;
  color: var(--m-gold3);
  margin-bottom: 11px;
}
.m-mtitle-{{ section.id }} {
  font-family: var(--m-serif);
  font-size: clamp(20px,2.4vw,30px);
  font-weight: 400;
  line-height: 1.28;
  letter-spacing: -.018em;
  color: var(--m-void);
  margin-bottom: 20px;
}
.m-mprice-{{ section.id }} {
  display: flex;
  align-items: baseline;
  flex-wrap: wrap;
  gap: 11px;
  margin-bottom: 24px;
  padding-bottom: 24px;
  border-bottom: 1px solid rgba(0,0,0,.07);
}
.m-mprice-cur-{{ section.id }} {
  font-family: var(--m-sans);
  font-size: 28px;
  font-weight: 500;
  color: var(--m-void);
  letter-spacing: -.035em;
}
.m-mprice-orig-{{ section.id }} {
  font-family: var(--m-sans);
  font-size: 17px;
  color: var(--m-dust);
  text-decoration: line-through;
}
.m-mprice-save-{{ section.id }} {
  font-family: var(--m-sans);
  font-size: 9px;
  font-weight: 600;
  color: var(--m-red);
  background: rgba(192,57,43,.08);
  padding: 4px 9px;
  border-radius: 1px;
}
.m-mscarce-{{ section.id }} {
  display: flex;
  align-items: center;
  gap: 7px;
  font-family: var(--m-sans);
  font-size: 9.5px;
  font-weight: 600;
  color: var(--m-red);
  margin-bottom: 16px;
}
.m-mscarce-{{ section.id }} .dot {
  width: 6px; height: 6px;
  background: var(--m-red);
  border-radius: 50%;
  animation: m-pulse-{{ section.id }} 2s ease-in-out infinite;
}

/* Variants */
.m-mvariants-{{ section.id }} { margin-bottom: 20px; }
.m-mvlabel-{{ section.id }} {
  font-family: var(--m-sans);
  font-size: 8.5px;
  font-weight: 600;
  letter-spacing: 1.8px;
  text-transform: uppercase;
  color: var(--m-muted);
  margin-bottom: 10px;
  display: flex;
  align-items: center;
  gap: 7px;
}
.m-mvsel-{{ section.id }} {
  font-weight: 400;
  color: var(--m-void);
  letter-spacing: .3px;
  text-transform: none;
}
.m-mvopts-{{ section.id }} { display: flex; flex-wrap: wrap; gap: 6px; }
.m-mvopt-{{ section.id }} {
  padding: 7px 16px;
  border: 1px solid rgba(0,0,0,.12);
  border-radius: 1px;
  background: transparent;
  font-family: var(--m-sans);
  font-size: 11px;
  color: var(--m-mid);
  cursor: pointer;
  transition: all .2s var(--m-spring);
  -webkit-tap-highlight-color: transparent;
}
.m-mvopt-{{ section.id }}:hover:not(.m-active):not(:disabled) {
  border-color: var(--m-gold);
  color: var(--m-gold3);
  transform: translateY(-1px);
}
.m-mvopt-{{ section.id }}.m-active {
  border-color: var(--m-void);
  background: var(--m-void);
  color: var(--m-white);
}
.m-mvopt-{{ section.id }}:disabled { opacity: .25; cursor: not-allowed; }

/* Qty + ATC row */
.m-mbuy-{{ section.id }} { display: flex; gap: 10px; margin-bottom: 16px; }
.m-mqty-{{ section.id }} {
  display: flex;
  align-items: center;
  border: 1.5px solid rgba(0,0,0,.1);
  border-radius: var(--m-r);
  overflow: hidden;
  flex-shrink: 0;
}
.m-mqbtn-{{ section.id }} {
  width: 38px; height: 50px;
  background: var(--m-fog);
  border: none;
  font-size: 16px;
  color: var(--m-mid);
  cursor: pointer;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: background .18s, color .18s;
  -webkit-tap-highlight-color: transparent;
  font-family: var(--m-sans);
}
.m-mqbtn-{{ section.id }}:hover { background: var(--m-gold); color: #fff; }
.m-mqnum-{{ section.id }} {
  width: 42px; height: 50px;
  border: none;
  border-left: 1px solid rgba(0,0,0,.07);
  border-right: 1px solid rgba(0,0,0,.07);
  text-align: center;
  font-family: var(--m-sans);
  font-size: 14px;
  font-weight: 500;
  color: var(--m-void);
  background: var(--m-white);
  outline: none;
  -moz-appearance: textfield;
}
.m-mqnum-{{ section.id }}::-webkit-inner-spin-button,
.m-mqnum-{{ section.id }}::-webkit-outer-spin-button { -webkit-appearance: none; }

.m-matc-{{ section.id }} {
  flex: 1;
  background: linear-gradient(135deg, var(--m-gold3), var(--m-gold));
  color: #fff;
  border: 2px solid var(--m-gold);
  border-radius: var(--m-r);
  font-family: var(--m-sans);
  font-size: 9px;
  font-weight: 700;
  letter-spacing: 2px;
  text-transform: uppercase;
  cursor: pointer;
  position: relative;
  overflow: hidden;
  transition: all .3s var(--m-spring);
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 7px;
  min-height: 50px;
  will-change: transform;
  isolation: isolate;
  -webkit-tap-highlight-color: transparent;
  box-sizing: border-box;
}
.m-matc-{{ section.id }}::before {
  content: '';
  position: absolute;
  inset: 0;
  background: var(--m-gold3);
  transform: scaleX(0);
  transform-origin: left;
  transition: transform .3s var(--m-ease);
  z-index: 0;
}
.m-matc-{{ section.id }}:hover::before { transform: scaleX(1); }
.m-matc-{{ section.id }}:hover { box-shadow: var(--m-sh-gold); transform: translateY(-2px) scale(1.01); }
.m-matc-{{ section.id }}:active { transform: scale(.99); }
.m-matc-{{ section.id }} > * { position: relative; z-index: 1; }
.m-matc-{{ section.id }}:disabled {
  background: var(--m-smoke);
  border-color: var(--m-smoke);
  color: var(--m-dust);
  cursor: not-allowed;
  transform: none !important;
  box-shadow: none !important;
}
.m-matc-{{ section.id }}:disabled::before { display: none; }
.m-matc-{{ section.id }}.m-success {
  background: var(--m-green);
  border-color: var(--m-green);
}
.m-matc-{{ section.id }}.m-success::before { display: none; }

.m-mlink-{{ section.id }} {
  display: inline-flex;
  align-items: center;
  gap: 7px;
  font-family: var(--m-sans);
  font-size: 9.5px;
  font-weight: 500;
  letter-spacing: .6px;
  color: var(--m-subtle);
  text-decoration: none;
  margin-bottom: 20px;
  transition: color .2s, transform .24s var(--m-spring);
  width: fit-content;
}
.m-mlink-{{ section.id }}:hover { color: var(--m-gold3); transform: translateX(3px); }

/* Modal trust strip */
.m-mtrust-{{ section.id }} {
  display: flex;
  flex-wrap: wrap;
  gap: 12px;
  padding-top: 18px;
  border-top: 1px solid rgba(0,0,0,.06);
  margin-top: auto;
}
.m-mtrust-item-{{ section.id }} {
  display: flex;
  align-items: center;
  gap: 5px;
  font-family: var(--m-sans);
  font-size: 9.5px;
  color: var(--m-subtle);
}
.m-mtrust-item-{{ section.id }} svg { color: var(--m-gold); }

/* ── BODY LOCK ── */
body.m-locked-{{ section.id }} { overflow: hidden; }

/* ── REDUCED MOTION ── */
@media (prefers-reduced-motion: reduce) {
  *, *::before, *::after {
    animation-duration: .01ms !important;
    transition-duration: .1ms !important;
  }
  .m-card-{{ section.id }} { opacity: 1 !important; transform: none !important; }
}

@media (max-width: 600px) {
  .m-body-{{ section.id }} { padding: 14px 12px 13px; }
  .m-cur-{{ section.id }} { font-size: 16px; }
}
</style>

{%- comment -%} ══════════════ HTML ══════════════ {%- endcomment -%}

<section
  class="m-section-{{ section.id }}"
  aria-label="{{ section.settings.title | default: 'Featured Collection' | escape }}"
>
  <div class="m-atm-{{ section.id }}" aria-hidden="true"></div>

  <div class="m-wrap-{{ section.id }}">

    {%- if section.settings.title != blank or section.settings.eyebrow_text != blank -%}
    <header class="m-header-{{ section.id }}">
      {%- if section.settings.eyebrow_text != blank -%}
        <div class="m-eyebrow-{{ section.id }}" aria-hidden="true">
          <span></span>{{ section.settings.eyebrow_text }}<span></span>
        </div>
      {%- endif -%}
      {%- if section.settings.title != blank -%}
        <h2 class="m-title-{{ section.id }}">{{ section.settings.title }}</h2>
      {%- endif -%}
      {%- if section.settings.subtitle != blank -%}
        <p class="m-sub-{{ section.id }}">{{ section.settings.subtitle }}</p>
      {%- endif -%}
    </header>
    {%- endif -%}

    <div class="m-grid-{{ section.id }}" role="list">
      {%- for product in col.products limit: max_items -%}

        {%- assign on_sale = false -%}
        {%- assign disc = 0 -%}
        {%- if product.compare_at_price > product.price -%}
          {%- assign on_sale = true -%}
          {%- assign disc = product.compare_at_price | minus: product.price | times: 100 | divided_by: product.compare_at_price -%}
        {%- endif -%}

        {%- assign inv = product.selected_or_first_available_variant.inventory_quantity -%}
        {%- assign low_stock = false -%}
        {%- if inv > 0 and inv <= section.settings.low_stock_threshold -%}
          {%- assign low_stock = true -%}
        {%- endif -%}

        {%- comment -%}
          FIX: Use || as delimiter instead of ~ so product titles / option
          values that contain a tilde character can never corrupt parsing.
        {%- endcomment -%}
        {%- assign packed_imgs = "" -%}
        {%- for img in product.images limit: 6 -%}
          {%- unless forloop.first -%}{%- assign packed_imgs = packed_imgs | append: "||" -%}{%- endunless -%}
          {%- assign packed_imgs = packed_imgs | append: img.src | image_url: width: 960 -%}
        {%- endfor -%}

        {%- assign vids    = "" -%}
        {%- assign vtitles = "" -%}
        {%- assign vavails = "" -%}
        {%- for v in product.variants -%}
          {%- unless forloop.first -%}
            {%- assign vids    = vids    | append: "||" -%}
            {%- assign vtitles = vtitles | append: "||" -%}
            {%- assign vavails = vavails | append: "||" -%}
          {%- endunless -%}
          {%- assign vids    = vids    | append: v.id -%}
          {%- assign vtitles = vtitles | append: v.title -%}
          {%- assign vavails = vavails | append: v.available -%}
        {%- endfor -%}

        <article
          class="m-card-{{ section.id }}"
          role="listitem"
          data-pid="{{ product.id }}"
          data-url="{{ product.url }}"
          data-title="{{ product.title | escape }}"
          data-vendor="{{ product.vendor | escape }}"
          data-price="{{ product.price | money }}"
          data-compare="{{ product.compare_at_price | money }}"
          data-disc="{{ disc }}"
          data-sale="{{ on_sale }}"
          data-avail="{{ product.available }}"
          data-inv="{{ inv }}"
          data-low="{{ low_stock }}"
          data-img="{{ product.featured_image | image_url: width: 960 }}"
          data-imgs="{{ packed_imgs }}"
          data-vids="{{ vids }}"
          data-vtitles="{{ vtitles }}"
          data-vavails="{{ vavails }}"
          data-fv="{{ product.selected_or_first_available_variant.id }}"
          data-option="{{ product.options.first | escape }}"
          aria-label="{{ product.title | escape }}"
        >
          <div class="m-card-inner-{{ section.id }}">

            <div class="m-imgbox-{{ section.id }}">
              <a href="{{ product.url }}" tabindex="-1" aria-hidden="true">
                {%- if product.featured_image -%}
                  <img
                    {%- if forloop.first %} fetchpriority="high" loading="eager"
                    {%- else %} loading="lazy" decoding="async"
                    {%- endif %}
                    src="{{ product.featured_image | image_url: width: 30 }}"
                    data-src="{{ product.featured_image | image_url: width: 800 }}"
                    data-srcset="{{ product.featured_image | image_url: width: 400 }} 400w,{{ product.featured_image | image_url: width: 800 }} 800w,{{ product.featured_image | image_url: width: 1200 }} 1200w"
                    sizes="(max-width:440px) 100vw,(max-width:768px) 50vw,(max-width:1080px) 33vw,25vw"
                    alt="{{ product.featured_image.alt | default: product.title | escape }}"
                    class="m-img-{{ section.id }} m-lazy"
                    width="800" height="1067"
                  >
                {%- else -%}
                  {{ 'product-1' | placeholder_svg_tag: 'm-img-' | append: section.id }}
                {%- endif -%}
              </a>
              <div class="m-overlay-{{ section.id }}" aria-hidden="true"></div>

              <div class="m-badges-{{ section.id }}" aria-hidden="true">
                {%- if on_sale -%}
                  <span class="m-badge-{{ section.id }} m-badge-sale-{{ section.id }}">Sale</span>
                {%- endif -%}
                {%- if product.tags contains 'new' or product.tags contains 'new-arrival' -%}
                  <span class="m-badge-{{ section.id }} m-badge-new-{{ section.id }}">New</span>
                {%- endif -%}
                {%- if product.tags contains 'exclusive' or product.tags contains 'limited' -%}
                  <span class="m-badge-{{ section.id }} m-badge-excl-{{ section.id }}">Exclusive</span>
                {%- endif -%}
              </div>

              <button
                class="m-wish-{{ section.id }}"
                type="button"
                aria-label="Add {{ product.title | escape }} to wishlist"
                aria-pressed="false"
                data-wish
              >
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/>
                </svg>
              </button>

              <button
                class="m-qvbtn-{{ section.id }}"
                type="button"
                aria-haspopup="dialog"
                aria-label="Quick view {{ product.title | escape }}"
                data-qv
              >
                <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
                <span>Quick View</span>
              </button>
            </div>

            <div class="m-body-{{ section.id }}">
              {%- if product.vendor != blank -%}
                <div class="m-vendor-{{ section.id }}">{{ product.vendor }}</div>
              {%- endif -%}
              <h3 class="m-name-{{ section.id }}">
                <a href="{{ product.url }}">{{ product.title }}</a>
              </h3>
              <div class="m-price-{{ section.id }}">
                <span class="m-cur-{{ section.id }}">{{ product.price | money }}</span>
                {%- if on_sale -%}
                  <span class="m-orig-{{ section.id }}">{{ product.compare_at_price | money }}</span>
                  <span class="m-save-{{ section.id }}">−{{ disc }}%</span>
                {%- endif -%}
              </div>
              {%- if section.settings.show_scarcity and low_stock -%}
                <div class="m-scarce-{{ section.id }}" role="status" aria-live="polite">
                  <span class="m-scarce-dot-{{ section.id }}" aria-hidden="true"></span>
                  Only {{ inv }} remaining
                </div>
              {%- endif -%}
              <form class="m-atcform-{{ section.id }}" action="/cart/add" method="post">
                <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">
                <button
                  type="submit"
                  class="m-atc-{{ section.id }}"
                  {% unless product.available %}disabled aria-disabled="true"{% endunless %}
                >
                  <span>{% if product.available %}Add to Cart{% else %}Sold Out{% endif %}</span>
                </button>
              </form>
            </div>

          </div>
        </article>

      {%- else -%}
        <p style="grid-column:1/-1;text-align:center;font-family:var(--m-sans);color:var(--m-dust);padding:80px 0 40px;font-size:14px;">
          No products found in this collection.
        </p>
      {%- endfor -%}
    </div>

    {%- if section.settings.show_view_all -%}
      <div class="m-cta-wrap-{{ section.id }}">
        {%- assign cta_url = col.url | default: '/collections/all' -%}
        <a href="{{ cta_url }}" class="m-cta-{{ section.id }}">
          <span>{{ section.settings.view_all_text | default: 'Explore Collection' }}</span>
          <svg class="m-cta-arrow-{{ section.id }}" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/>
          </svg>
        </a>
      </div>
    {%- endif -%}

  </div>
</section>

{%- comment -%} ══ MODAL ══ {%- endcomment -%}
<div
  class="m-backdrop-{{ section.id }}"
  id="m-backdrop-{{ section.id }}"
  role="dialog"
  aria-modal="true"
  aria-labelledby="m-mtitle-{{ section.id }}"
  tabindex="-1"
>
  <div class="m-modal-{{ section.id }}" id="m-modal-{{ section.id }}">

    <button class="m-mclose-{{ section.id }}" id="m-mclose-{{ section.id }}" aria-label="Close quick view" type="button">
      <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" aria-hidden="true">
        <line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/>
      </svg>
    </button>

    <div class="m-mgallery-{{ section.id }}">
      <div class="m-mmain-wrap-{{ section.id }}">
        <img src="" alt="" id="m-mmain-{{ section.id }}" class="m-mmain-{{ section.id }}" width="600" height="800" decoding="async">
        <div id="m-mbadges-{{ section.id }}" aria-hidden="true"></div>
        <button class="m-marrow-{{ section.id }} m-marrow-prev-{{ section.id }} m-hidden" id="m-mprev-{{ section.id }}" aria-label="Previous image" type="button">
          <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" aria-hidden="true"><polyline points="15 18 9 12 15 6"/></svg>
        </button>
        <button class="m-marrow-{{ section.id }} m-marrow-next-{{ section.id }} m-hidden" id="m-mnext-{{ section.id }}" aria-label="Next image" type="button">
          <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" aria-hidden="true"><polyline points="9 18 15 12 9 6"/></svg>
        </button>
      </div>
      <div class="m-mthumbs-{{ section.id }} m-hidden" id="m-mthumbs-{{ section.id }}" role="list" aria-label="Product images"></div>
    </div>

    <div class="m-minfo-{{ section.id }}">
      <div class="m-mvendor-{{ section.id }}" id="m-mvendor-{{ section.id }}"></div>
      <h2 class="m-mtitle-{{ section.id }}" id="m-mtitle-{{ section.id }}"></h2>
      <div class="m-mprice-{{ section.id }}" id="m-mprice-{{ section.id }}"></div>
      <div class="m-mscarce-{{ section.id }}" id="m-mscarce-{{ section.id }}" style="display:none" role="status" aria-live="polite">
        <span class="dot" aria-hidden="true"></span>
        <span id="m-mscarce-txt-{{ section.id }}"></span>
      </div>
      <div class="m-mvariants-{{ section.id }}" id="m-mvariants-{{ section.id }}"></div>
      <a href="#" class="m-mlink-{{ section.id }}" id="m-mlink-{{ section.id }}">
        <span>View Full Details</span>
        <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
      </a>
      <div class="m-mbuy-{{ section.id }}">
        <div class="m-mqty-{{ section.id }}" role="group" aria-label="Quantity">
          <button class="m-mqbtn-{{ section.id }}" id="m-mqminus-{{ section.id }}" type="button" aria-label="Decrease quantity">−</button>
          <input class="m-mqnum-{{ section.id }}" id="m-mqnum-{{ section.id }}" type="number" value="1" min="1" max="99" aria-label="Quantity">
          <button class="m-mqbtn-{{ section.id }}" id="m-mqplus-{{ section.id }}" type="button" aria-label="Increase quantity">+</button>
        </div>
        <button class="m-matc-{{ section.id }}" id="m-matc-{{ section.id }}" type="button" disabled>
          <span>Add to Cart</span>
        </button>
      </div>
      <div class="m-mtrust-{{ section.id }}" aria-label="Purchase assurances">
        <div class="m-mtrust-item-{{ section.id }}">
          <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
          Secure Checkout
        </div>
        <div class="m-mtrust-item-{{ section.id }}">
          <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><polyline points="1 4 1 10 7 10"/><path d="M3.51 15a9 9 0 1 0 .49-3.67"/></svg>
          30-Day Returns
        </div>
        <div class="m-mtrust-item-{{ section.id }}">
          <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><rect x="1" y="3" width="15" height="13" rx="1"/><path d="M16 8h4l3 5v3h-7V8z"/><circle cx="5.5" cy="18.5" r="2.5"/><circle cx="18.5" cy="18.5" r="2.5"/></svg>
          Free Shipping
        </div>
      </div>
    </div>

  </div>
</div>

{%- comment -%} ════════════════════════════════════════
  JAVASCRIPT v7 — all 8.5→10 fixes applied
════════════════════════════════════════ {%- endcomment -%}
<script>
(function () {
  'use strict';

  var S    = '{{ section.id }}';
  var SEP  = '||';  /* FIX: URL-safe delimiter; ~ would break on titles containing tilde */

  function byId(id)       { return document.getElementById(id); }
  function clamp(v, a, b) { return Math.min(Math.max(v, a), b); }
  function lerp(a, b, t)  { return a + (b - a) * t; }

  var hasHover = window.matchMedia('(hover: hover) and (pointer: fine)').matches;
  var prefMot  = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  /* ══════════════════════════════════
     1. SCROLL REVEAL — staggered
     FIX: observer.disconnect() once all cards are revealed
  ══════════════════════════════════ */
  (function () {
    var cards     = Array.from(document.querySelectorAll('.m-card-' + S));
    var remaining = cards.length;
    if (!remaining) return;

    if (prefMot || !('IntersectionObserver' in window)) {
      cards.forEach(function (c) { c.classList.add('m-ready'); });
      return;
    }

    var io = new IntersectionObserver(function (entries) {
      entries.forEach(function (e) {
        if (!e.isIntersecting) return;
        var colCount = window.innerWidth >= 1080 ? 4 : window.innerWidth >= 600 ? 3 : 2;
        var idx      = cards.indexOf(e.target);
        var delay    = (idx % colCount) * 70;
        setTimeout(function () { e.target.classList.add('m-in'); }, delay);
        io.unobserve(e.target);
        if (--remaining === 0) io.disconnect(); /* FIX: no lingering observer */
      });
    }, { rootMargin: '0px 0px -40px 0px', threshold: 0.06 });

    cards.forEach(function (c) { io.observe(c); });
  }());

  /* ══════════════════════════════════
     2. BLUR-UP LAZY LOAD
  ══════════════════════════════════ */
  (function () {
    var imgs = document.querySelectorAll('.m-lazy');
    if (!imgs.length) return;

    function loadImg(img) {
      var hi = new window.Image();
      if (img.dataset.srcset) hi.srcset = img.dataset.srcset;
      hi.src = img.dataset.src;
      hi.onload = function () {
        img.src = hi.src;
        if (img.dataset.srcset) img.srcset = img.dataset.srcset;
        img.classList.add('m-loaded');
        img.classList.remove('m-lazy');
      };
    }

    if (!('IntersectionObserver' in window)) {
      imgs.forEach(loadImg);
      return;
    }

    var li = new IntersectionObserver(function (entries) {
      entries.forEach(function (e) {
        if (!e.isIntersecting) return;
        loadImg(e.target);
        li.unobserve(e.target);
      });
    }, { rootMargin: '300px 0px' });

    imgs.forEach(function (img) { li.observe(img); });
  }());

  /* ══════════════════════════════════
     3. TILT — fine-pointer only
     FIX: cancelAnimationFrame on mouseleave — zero RAF leaks
  ══════════════════════════════════ */
  if (hasHover && !prefMot) {
    document.querySelectorAll('.m-card-' + S).forEach(function (card) {
      var inner = card.querySelector('.m-card-inner-' + S);
      if (!inner) return;

      var raf    = null;
      var tX = 0, tY = 0, cX = 0, cY = 0;
      var active = false;
      var STR    = 7;
      var LRP    = 0.08;

      function tick() {
        cX = lerp(cX, tX, LRP);
        cY = lerp(cY, tY, LRP);
        inner.style.transform =
          'perspective(900px) rotateX(' + cX.toFixed(3) + 'deg) rotateY(' + cY.toFixed(3) + 'deg) translateZ(0)';
        var settled = Math.abs(cX - tX) + Math.abs(cY - tY) < 0.01;
        if (settled) {
          raf = null;
          if (!active) inner.style.transform = '';
        } else {
          raf = requestAnimationFrame(tick);
        }
      }

      card.addEventListener('mouseenter', function () {
        active = true;
      }, { passive: true });

      card.addEventListener('mousemove', function (e) {
        var r = card.getBoundingClientRect();
        tY =  ((e.clientX - r.left) / r.width  - 0.5) * STR;
        tX = -((e.clientY - r.top)  / r.height - 0.5) * STR;
        if (!raf) raf = requestAnimationFrame(tick);
      }, { passive: true });

      card.addEventListener('mouseleave', function () {
        active = false;
        tX = 0; tY = 0;
        /* FIX: cancel any pending frame before scheduling a fresh one */
        if (raf) cancelAnimationFrame(raf);
        raf = requestAnimationFrame(tick);
      }, { passive: true });
    });
  }

  /* ══════════════════════════════════
     4. RIPPLE — box-sizing aware
  ══════════════════════════════════ */
  function ripple(btn, e) {
    var r  = btn.getBoundingClientRect();
    var cx = (e ? e.clientX : r.left + r.width  / 2) - r.left;
    var cy = (e ? e.clientY : r.top  + r.height / 2) - r.top;
    var sz = Math.max(r.width, r.height) * 1.5;
    var el = document.createElement('span');
    el.className = 'm-ripple-' + S;
    el.style.cssText =
      'width:' + sz + 'px;height:' + sz + 'px;' +
      'top:' + (cy - sz / 2) + 'px;left:' + (cx - sz / 2) + 'px;';
    btn.appendChild(el);
    setTimeout(function () { btn.contains(el) && btn.removeChild(el); }, 700);
  }

  /* ══════════════════════════════════
     5. BODY LOCK — instance-scoped counter
  ══════════════════════════════════ */
  var _lockCount = 0;

  function lockScroll() {
    if (_lockCount++ === 0) {
      var bar = window.innerWidth - document.documentElement.clientWidth;
      document.body.style.paddingRight = (bar || 0) + 'px';
      document.body.classList.add('m-locked-' + S);
    }
  }
  function unlockScroll() {
    if (--_lockCount <= 0) {
      _lockCount = 0;
      document.body.style.paddingRight = '';
      document.body.classList.remove('m-locked-' + S);
    }
  }

  /* ══════════════════════════════════
     6. MODAL
  ══════════════════════════════════ */
  var backdrop   = byId('m-backdrop-'     + S);
  var mainImg    = byId('m-mmain-'        + S);
  var thumbsEl   = byId('m-mthumbs-'     + S);
  var vendorEl   = byId('m-mvendor-'     + S);
  var titleEl    = byId('m-mtitle-'      + S);
  var priceEl    = byId('m-mprice-'      + S);
  var scarceEl   = byId('m-mscarce-'     + S);
  var scarceTxt  = byId('m-mscarce-txt-' + S);
  var variantsEl = byId('m-mvariants-'   + S);
  var linkEl     = byId('m-mlink-'       + S);
  var atcBtn     = byId('m-matc-'        + S);
  var qtyInput   = byId('m-mqnum-'       + S);
  var prevBtn    = byId('m-mprev-'       + S);
  var nextBtn    = byId('m-mnext-'       + S);
  var prevFocus  = null;
  var imgs_m     = [];
  var curIdx     = 0;
  var curVarId   = null;

  /* SWIPE — configurable threshold (no magic number) */
  var SWIPE_THRESHOLD = 44;

  /* Image switch — crossfade waits for preload */
  function switchImg(idx) {
    if (!imgs_m.length) return;
    /* FIX: arrow nav wraps around */
    idx = ((idx % imgs_m.length) + imgs_m.length) % imgs_m.length;
    if (idx === curIdx && mainImg.src) return;
    curIdx = idx;

    mainImg.classList.add('m-fade');
    var preload = new window.Image();
    preload.onload = preload.onerror = function () {
      mainImg.src = imgs_m[idx];
      mainImg.classList.remove('m-fade');
    };
    preload.src = imgs_m[idx];

    thumbsEl.querySelectorAll('.m-mthumb-' + S).forEach(function (t, i) {
      t.classList.toggle('m-active', i === idx);
    });
  }

  function openModal(card) {
    var d = card.dataset;

    /* reset */
    qtyInput.value = 1;
    atcBtn.classList.remove('m-success');
    atcBtn.querySelector('span').textContent = 'Add to Cart';

    /* images — FIX: split on || delimiter */
    imgs_m = (d.imgs || '').split(SEP).filter(Boolean);
    if (!imgs_m.length && d.img) imgs_m = [d.img];
    curIdx = 0;

    mainImg.src = imgs_m[0] || '';
    mainImg.alt = d.title   || '';
    mainImg.classList.remove('m-fade');

    /* thumbs + arrows */
    thumbsEl.innerHTML = '';
    var multi = imgs_m.length > 1;
    thumbsEl.classList.toggle('m-hidden', !multi);
    prevBtn.classList.toggle('m-hidden', !multi);
    nextBtn.classList.toggle('m-hidden', !multi);

    if (multi) {
      imgs_m.forEach(function (src, i) {
        var t  = document.createElement('div');
        t.className = 'm-mthumb-' + S + (i === 0 ? ' m-active' : '');
        t.setAttribute('role', 'listitem');
        t.setAttribute('tabindex', '0');
        t.setAttribute('aria-label', 'Image ' + (i + 1) + ' of ' + imgs_m.length);
        var im = document.createElement('img');
        im.src = src; im.alt = ''; im.loading = 'lazy';
        t.appendChild(im);
        t.addEventListener('click', function () { switchImg(i); });
        t.addEventListener('keydown', function (e) {
          if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); switchImg(i); }
        });
        thumbsEl.appendChild(t);
      });
    }

    /* badges */
    var badgesEl = byId('m-mbadges-' + S);
    badgesEl.innerHTML = '';
    if (d.sale === 'true') {
      var bs = document.createElement('span');
      bs.className = 'm-badge-' + S + ' m-badge-sale-' + S;
      bs.textContent = 'Sale';
      badgesEl.appendChild(bs);
    }

    /* text */
    vendorEl.textContent   = d.vendor || '';
    vendorEl.style.display = d.vendor ? '' : 'none';
    titleEl.textContent    = d.title  || '';

    /* price */
    priceEl.innerHTML = '';
    var pc = document.createElement('span');
    pc.className   = 'm-mprice-cur-' + S;
    pc.textContent = d.price || '';
    priceEl.appendChild(pc);
    if (d.sale === 'true' && d.compare) {
      var po = document.createElement('span');
      po.className   = 'm-mprice-orig-' + S;
      po.textContent = d.compare;
      priceEl.appendChild(po);
      var ps = document.createElement('span');
      ps.className   = 'm-mprice-save-' + S;
      ps.textContent = '−' + d.disc + '%';
      priceEl.appendChild(ps);
    }

    /* scarcity */
    var inv = parseInt(d.inv, 10);
    if (d.avail === 'true' && d.low === 'true' && inv > 0) {
      scarceTxt.textContent  = 'Only ' + inv + ' remaining';
      scarceEl.style.display = 'flex';
    } else {
      scarceEl.style.display = 'none';
    }

    /* variants — FIX: split on || delimiter */
    variantsEl.innerHTML = '';
    curVarId = d.fv;
    var ids    = (d.vids    || '').split(SEP).filter(Boolean);
    var titles = (d.vtitles || '').split(SEP).filter(Boolean);
    var avails = (d.vavails || '').split(SEP).filter(Boolean);
    var optName = d.option || 'Option';

    if (ids.length > 1 && titles[0] !== 'Default Title') {
      var lbl = document.createElement('div');
      lbl.className = 'm-mvlabel-' + S;
      lbl.innerHTML =
        optName + ': <span class="m-mvsel-' + S + '" id="m-mvsel-' + S + '">' +
        (titles[0] || '') + '</span>';
      variantsEl.appendChild(lbl);

      var row = document.createElement('div');
      row.className = 'm-mvopts-' + S;
      row.setAttribute('role', 'group');
      row.setAttribute('aria-label', optName);

      ids.forEach(function (id, i) {
        var b = document.createElement('button');
        b.type        = 'button';
        b.className   = 'm-mvopt-' + S + (i === 0 ? ' m-active' : '');
        b.textContent = titles[i];
        b.dataset.vid = id;
        b.disabled    = avails[i] === 'false';
        b.setAttribute('aria-pressed', i === 0 ? 'true' : 'false');

        b.addEventListener('click', function () {
          row.querySelectorAll('.m-mvopt-' + S).forEach(function (x) {
            x.classList.remove('m-active');
            x.setAttribute('aria-pressed', 'false');
          });
          b.classList.add('m-active');
          b.setAttribute('aria-pressed', 'true');
          curVarId = id;
          var sel = byId('m-mvsel-' + S);
          if (sel) sel.textContent = titles[i];
          var ok = avails[i] !== 'false';
          atcBtn.disabled = !ok;
          atcBtn.querySelector('span').textContent = ok ? 'Add to Cart' : 'Sold Out';
        });
        row.appendChild(b);
      });

      variantsEl.appendChild(row);
      atcBtn.disabled = avails[0] === 'false';
      atcBtn.querySelector('span').textContent =
        avails[0] !== 'false' ? 'Add to Cart' : 'Sold Out';
    } else {
      atcBtn.disabled = d.avail !== 'true';
      atcBtn.querySelector('span').textContent =
        d.avail === 'true' ? 'Add to Cart' : 'Sold Out';
    }

    linkEl.href = d.url || '#';

    lockScroll();
    backdrop.classList.add('m-open');
    prevFocus = document.activeElement;
    setTimeout(function () {
      var closeBtn = byId('m-mclose-' + S);
      if (closeBtn) closeBtn.focus();
    }, 60);
  }

  function closeModal() {
    backdrop.classList.remove('m-open');
    unlockScroll();
    setTimeout(function () {
      atcBtn.classList.remove('m-success');
      atcBtn.disabled = true;
      atcBtn.querySelector('span').textContent = 'Add to Cart';
      qtyInput.value = 1;
    }, 400);
    if (prevFocus) { try { prevFocus.focus(); } catch (e) {} }
  }

  /* Modal ATC */
  atcBtn.addEventListener('click', function (e) {
    if (atcBtn.disabled || !curVarId) return;
    ripple(atcBtn, e);
    var qty = clamp(parseInt(qtyInput.value, 10) || 1, 1, 99);
    atcBtn.disabled = true;
    atcBtn.querySelector('span').textContent = 'Adding…';

    fetch('/cart/add.js', {
      method:  'POST',
      headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
      body:    JSON.stringify({ id: parseInt(curVarId, 10), quantity: qty })
    })
    .then(function (r) { return r.ok ? r.json() : Promise.reject(r.status + ' ' + r.statusText); })
    .then(function (item) {
      atcBtn.classList.add('m-success');
      atcBtn.querySelector('span').textContent = '✓ Added';

      document.querySelectorAll(
        '[data-cart-count],[class*="cart-count"],[id*="cart-count"],[id*="CartCount"]'
      ).forEach(function (el) {
        el.textContent = (parseInt(el.textContent || '0', 10) || 0) + qty;
      });

      /* FIX: dispatch on document — bubbles:true is redundant here (removed) */
      document.dispatchEvent(new CustomEvent('cart:updated', {
        detail: { variantId: curVarId, quantity: qty, item: item }
      }));
      if (window.Shopify && window.Shopify.onCartUpdate) window.Shopify.onCartUpdate();

      setTimeout(closeModal, 1100);
    })
    .catch(function (err) {
      atcBtn.disabled = false;
      atcBtn.querySelector('span').textContent = 'Try Again';
      console.warn('[Maison ATC]', err);
      setTimeout(function () {
        if (atcBtn.querySelector('span').textContent === 'Try Again') {
          atcBtn.querySelector('span').textContent = 'Add to Cart';
        }
      }, 2200);
    });
  });

  /* Qty controls */
  byId('m-mqminus-' + S).addEventListener('click', function () {
    var v = parseInt(qtyInput.value, 10);
    if (v > 1) qtyInput.value = v - 1;
  });
  byId('m-mqplus-' + S).addEventListener('click', function () {
    var v = parseInt(qtyInput.value, 10);
    if (v < 99) qtyInput.value = v + 1;
  });
  qtyInput.addEventListener('change', function () {
    var v = parseInt(qtyInput.value, 10);
    qtyInput.value = clamp(isNaN(v) ? 1 : v, 1, 99);
  });

  /* Gallery arrows */
  prevBtn.addEventListener('click', function () { switchImg(curIdx - 1); });
  nextBtn.addEventListener('click', function () { switchImg(curIdx + 1); });

  /* Close triggers */
  byId('m-mclose-' + S).addEventListener('click', closeModal);
  backdrop.addEventListener('click', function (e) {
    if (e.target === backdrop) closeModal();
  });

  /* Keyboard */
  document.addEventListener('keydown', function (e) {
    if (!backdrop.classList.contains('m-open')) return;
    if (e.key === 'Escape')    { e.preventDefault(); closeModal();          return; }
    /* FIX: arrow keys wrap around (handled in switchImg via modulo) */
    if (e.key === 'ArrowLeft') { e.preventDefault(); switchImg(curIdx - 1); return; }
    if (e.key === 'ArrowRight'){ e.preventDefault(); switchImg(curIdx + 1); return; }
    if (e.key === 'Tab') {
      var modal     = byId('m-modal-' + S);
      var focusable = Array.from(modal.querySelectorAll(
        'button:not([disabled]),[href],input:not([disabled]),[tabindex]:not([tabindex="-1"])'
      )).filter(function (el) { return el.offsetParent !== null; });
      if (!focusable.length) return;
      var first = focusable[0];
      var last  = focusable[focusable.length - 1];
      if (e.shiftKey) {
        if (document.activeElement === first) { e.preventDefault(); last.focus(); }
      } else {
        if (document.activeElement === last)  { e.preventDefault(); first.focus(); }
      }
    }
  });

  /* Touch swipe in modal gallery */
  var touchStartX = 0;
  var mmw = document.querySelector('.m-mmain-wrap-' + S);
  if (mmw) {
    mmw.addEventListener('touchstart', function (e) {
      touchStartX = e.touches[0].clientX;
    }, { passive: true });
    mmw.addEventListener('touchend', function (e) {
      var dx = e.changedTouches[0].clientX - touchStartX;
      /* FIX: named constant instead of magic number */
      if (Math.abs(dx) > SWIPE_THRESHOLD) switchImg(dx < 0 ? curIdx + 1 : curIdx - 1);
    }, { passive: true });
  }

  /* ══════════════════════════════════
     7. CARD BINDINGS
  ══════════════════════════════════ */
  document.querySelectorAll('.m-card-' + S).forEach(function (card) {

    /* Quick view */
    var qvb = card.querySelector('[data-qv]');
    if (qvb) {
      qvb.addEventListener('click', function (e) {
        e.preventDefault(); e.stopPropagation(); openModal(card);
      });
    }

    /* Wishlist — WAAPI bounce; FIX: prefMot guard applied */
    var wb = card.querySelector('[data-wish]');
    if (wb) {
      wb.addEventListener('click', function (e) {
        e.stopPropagation();
        var wished = wb.classList.toggle('m-wished');
        wb.setAttribute('aria-pressed', wished ? 'true' : 'false');
        wb.setAttribute('aria-label',
          (wished ? 'Remove ' : 'Add ') +
          (card.dataset.title || '') +
          (wished ? ' from' : ' to') + ' wishlist'
        );
        /* FIX: only animate when motion is allowed */
        if (!prefMot && wb.animate) {
          wb.animate(
            [{ transform: 'scale(1)' }, { transform: 'scale(1.38)' }, { transform: 'scale(1)' }],
            { duration: 340, easing: 'cubic-bezier(.34,1.48,.64,1)' }
          );
        }
      });
    }

    /* Card AJAX ATC
       FIX: stash full innerHTML and restore it on both success and error
    */
    var form = card.querySelector('.m-atcform-' + S);
    if (form) {
      form.addEventListener('submit', function (e) {
        e.preventDefault();
        var btn      = form.querySelector('.m-atc-' + S);
        var vid      = form.querySelector('input[name="id"]').value;
        if (!vid || btn.disabled) return;
        ripple(btn, null);
        btn.disabled   = true;
        var origHTML   = btn.innerHTML;   /* FIX: capture full innerHTML */
        btn.innerHTML  = '<span>Adding…</span>';

        fetch('/cart/add.js', {
          method:  'POST',
          headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
          body:    JSON.stringify({ id: parseInt(vid, 10), quantity: 1 })
        })
        .then(function (r) { return r.ok ? r.json() : Promise.reject(r.statusText); })
        .then(function (item) {
          btn.innerHTML = '<span>✓ Added</span>';
          /* FIX: dispatch on document without superfluous bubbles flag */
          document.dispatchEvent(new CustomEvent('cart:updated', {
            detail: { variantId: vid, quantity: 1, item: item }
          }));
          if (window.Shopify && window.Shopify.onCartUpdate) window.Shopify.onCartUpdate();
          setTimeout(function () {
            btn.disabled = false;
            btn.innerHTML = origHTML; /* FIX: restore full original HTML */
          }, 1800);
        })
        .catch(function () {
          btn.disabled  = false;
          btn.innerHTML = origHTML; /* FIX: restore on error too */
        });
      });
    }

  });

}());
</script>

{% schema %}
{
  "name": "Maison Collection",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow_text",
      "label": "Eyebrow Label",
      "default": "Curated Excellence"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Section Heading",
      "default": "The Collection"
    },
    {
      "type": "textarea",
      "id": "subtitle",
      "label": "Subheading",
      "default": "Handpicked for those who appreciate exceptional quality."
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "range",
      "id": "max_products",
      "label": "Products to show",
      "min": 1,
      "max": 24,
      "step": 1,
      "default": 8
    },

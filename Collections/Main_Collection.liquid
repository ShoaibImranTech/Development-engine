{% comment %}
 
{% liquid
  assign ppp       = section.settings.products_per_page | default: 24
  assign grid_cols = section.settings.products_per_row  | default: 3
  assign sort_by   = collection.sort_by | default: collection.default_sort_by

  assign has_wapp  = false
  if section.settings.whatsapp_number != blank
    assign has_wapp = true
  endif
%}

<link rel="preconnect" href="https://fonts.googleapis.com" crossorigin>
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;0,600;1,300;1,400;1,500;1,600&family=DM+Sans:ital,opsz,wght@0,9..40,200;0,9..40,300;0,9..40,400;0,9..40,500;1,9..40,300&display=swap" rel="stylesheet">

<style>
/* ═══════════════════════════════════════════════════════════
   VYRA v11 — DESIGN SYSTEM
═══════════════════════════════════════════════════════════ */
:root {
  --f-display: 'Cormorant Garamond', Georgia, serif;
  --f-body:    'DM Sans', -apple-system, BlinkMacSystemFont, sans-serif;

  --c-void:       #060508;
  --c-deep:       #0d0b12;
  --c-ground:     #14111b;
  --c-surface:    #1c1826;
  --c-lift:       #242033;
  --c-mid:        #3a3350;
  --c-warm:       #7c7091;
  --c-muted:      #a89dbc;
  --c-sand:       #c9bedd;
  --c-linen:      #e6e0f2;
  --c-ivory:      #f6f3fb;
  --c-white:      #ffffff;

  --c-gold:       #c8a84b;
  --c-gold-lt:    #ddbf6e;
  --c-gold-dk:    #9c7f2d;
  --c-gold-glow:  rgba(200,168,75,.18);

  --c-rule:       rgba(201,190,221,.10);
  --c-rule-md:    rgba(201,190,221,.18);
  --c-rule-lt:    rgba(201,190,221,.06);
  --c-red:        #a03333;
  --c-red-bg:     rgba(160,51,51,.08);
  --c-green:      #226b46;
  --c-green-lt:   #42c882;
  --c-green-bg:   rgba(66,200,130,.08);

  --s-1: 4px; --s-2: 8px; --s-3: 14px; --s-4: 22px;
  --s-5: 36px; --s-6: 56px;
  --s-7: clamp(40px, 5.5vw, 80px);
  --s-8: clamp(56px, 8vw, 120px);

  --gutter:  clamp(16px, 4.5vw, 80px);
  --max-w:   1640px;
  --sidebar: 256px;

  --ease-out:   cubic-bezier(0.0, 0.0, 0.2, 1);
  --ease-silk:  cubic-bezier(0.16, 1, 0.3, 1);
  --ease-snap:  cubic-bezier(0.2, 0, 0, 1);
  --ease-back:  cubic-bezier(0.34, 1.56, 0.64, 1);
  --ease-expo:  cubic-bezier(0.87, 0, 0.13, 1);

  --t-1: 60ms; --t-2: 140ms; --t-3: 260ms;
  --t-4: 440ms; --t-5: 680ms; --t-6: 1000ms; --t-7: 1400ms;

  --sh-sm:    0 1px 4px rgba(6,5,8,.06), 0 0 1px rgba(6,5,8,.04);
  --sh-card:  0 2px 10px rgba(6,5,8,.07), 0 0 1px rgba(6,5,8,.04);
  --sh-hover: 0 20px 60px rgba(6,5,8,.20), 0 4px 16px rgba(6,5,8,.12);
  --sh-modal: 0 40px 100px rgba(6,5,8,.45), 0 8px 24px rgba(6,5,8,.2);
  --sh-gold:  0 8px 32px rgba(200,168,75,.28);

  --r-xs: 2px; --r-sm: 4px; --r-md: 8px;
  --r-lg: 16px; --r-xl: 24px; --r-pill: 999px;
}

/* ═══════════════════════════════════════════════════════════
   RESET
═══════════════════════════════════════════════════════════ */
.vx-scope *, .vx-scope *::before, .vx-scope *::after {
  box-sizing: border-box;
  -webkit-tap-highlight-color: transparent;
  margin: 0; padding: 0;
}
.vx-scope {
  font-family: var(--f-body);
  color: var(--c-void);
  background: var(--c-ivory);
  -webkit-font-smoothing: antialiased;
  -moz-osx-font-smoothing: grayscale;
  text-rendering: optimizeLegibility;
}
.vx-scope img { display: block; max-width: 100%; height: auto; }
.vx-sr {
  position: absolute; width: 1px; height: 1px;
  padding: 0; margin: -1px; overflow: hidden;
  clip: rect(0,0,0,0); white-space: nowrap; border: 0;
}
.vx-scope a { color: inherit; }
.vx-scope button { font-family: inherit; cursor: pointer; }

/* ═══════════════════════════════════════════════════════════
   FOCUS — ACCESSIBLE
═══════════════════════════════════════════════════════════ */
.vx-scope :focus-visible {
  outline: 2px solid var(--c-gold);
  outline-offset: 3px;
  border-radius: 3px;
}
.vx-scope :focus:not(:focus-visible) { outline: none; }

/* ═══════════════════════════════════════════════════════════
   ANNOUNCEMENT BAR
═══════════════════════════════════════════════════════════ */
.vx-notice {
  background: var(--c-void);
  height: 42px;
  display: flex; align-items: center;
  overflow: hidden; position: relative;
  border-bottom: 1px solid rgba(255,255,255,.04);
}
.vx-notice::before,
.vx-notice::after {
  content: ''; position: absolute; top: 0; bottom: 0;
  width: 100px; z-index: 2; pointer-events: none;
}
.vx-notice::before {
  left: 0;
  background: linear-gradient(90deg, var(--c-void) 30%, transparent);
}
.vx-notice::after {
  right: 0;
  background: linear-gradient(-90deg, var(--c-void) 30%, transparent);
}
.vx-notice__track {
  display: flex;
  width: max-content;
  animation: vx-scroll 60s linear infinite;
  will-change: transform;
}
@media (prefers-reduced-motion: no-preference) {
  .vx-notice__track:hover { animation-play-state: paused; }
}
.vx-notice__item {
  display: inline-flex; align-items: center; gap: 18px;
  padding: 0 36px; white-space: nowrap;
  font-size: 10px; font-weight: 400; letter-spacing: .22em;
  text-transform: uppercase; color: var(--c-sand);
}
.vx-notice__gem {
  width: 5px; height: 5px;
  background: linear-gradient(135deg, var(--c-gold), var(--c-gold-lt));
  transform: rotate(45deg); flex-shrink: 0;
  box-shadow: 0 0 6px var(--c-gold-glow);
}
@keyframes vx-scroll { to { transform: translate3d(-50%, 0, 0); } }

/* ═══════════════════════════════════════════════════════════
   COLLECTION HEADER
═══════════════════════════════════════════════════════════ */
.vx-header {
  background: var(--c-deep);
  padding: var(--s-8) var(--gutter) var(--s-7);
  position: relative; overflow: hidden;
  min-height: clamp(280px, 40vw, 480px);
  display: flex; flex-direction: column; justify-content: flex-end;
}
.vx-header__atmo {
  position: absolute; inset: 0; pointer-events: none; overflow: hidden;
}
.vx-header__atmo::before {
  content: '';
  position: absolute; top: -40%; right: -15%;
  width: 80%; height: 180%;
  background: radial-gradient(ellipse at 60% 40%,
    rgba(200,168,75,.06) 0%,
    rgba(200,168,75,.02) 40%,
    transparent 65%);
  animation: vx-breathe 12s ease-in-out infinite;
}
.vx-header__atmo::after {
  content: '';
  position: absolute; bottom: 0; left: 0; right: 0;
  height: 1px;
  background: linear-gradient(90deg,
    transparent, var(--c-rule-md) 20%, var(--c-rule-md) 80%, transparent);
}
.vx-header__grain {
  position: absolute; inset: 0;
  opacity: .018;
  background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 256 256' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)' opacity='1'/%3E%3C/svg%3E");
  background-repeat: repeat;
  background-size: 180px;
  pointer-events: none;
}
.vx-header__lines {
  position: absolute; top: 0; right: 0; bottom: 0;
  width: 50%; pointer-events: none; overflow: hidden;
}
.vx-header__lines svg {
  position: absolute; top: 0; right: 0;
  width: 100%; height: 100%; opacity: .06;
}
@keyframes vx-breathe {
  0%, 100% { transform: scale(1) translate(0, 0); opacity: 1; }
  50%       { transform: scale(1.06) translate(-1%, 2%); opacity: .7; }
}
.vx-header__inner {
  position: relative; z-index: 2;
  max-width: var(--max-w); margin: 0 auto; width: 100%;
  display: grid;
  grid-template-columns: 1fr auto;
  align-items: flex-end;
  gap: clamp(24px, 5vw, 80px);
}
@media (max-width: 900px) {
  .vx-header__inner { grid-template-columns: 1fr; gap: var(--s-5); }
}
.vx-eyebrow {
  display: inline-flex; align-items: center; gap: 12px;
  margin-bottom: var(--s-3);
  opacity: 0;
  animation: vx-rise var(--t-5) var(--ease-silk) 80ms forwards;
}
.vx-eyebrow__line {
  display: block; width: 32px; height: 1px;
  background: linear-gradient(90deg, var(--c-gold), transparent);
}
.vx-eyebrow__text {
  font-size: 9px; font-weight: 500; letter-spacing: .38em;
  text-transform: uppercase; color: var(--c-gold);
}
.vx-header__title {
  font-family: var(--f-display);
  font-size: clamp(44px, 7vw, 100px);
  font-weight: 300; line-height: .92; letter-spacing: -.03em;
  color: var(--c-ivory); margin-bottom: var(--s-5);
  opacity: 0;
  animation: vx-rise var(--t-7) var(--ease-silk) 140ms forwards;
}
.vx-header__title em { font-style: italic; color: var(--c-sand); font-weight: 300; }
.vx-header__desc {
  font-size: clamp(12px, 1.4vw, 14px); font-weight: 300; line-height: 1.9;
  color: var(--c-warm); max-width: 440px; letter-spacing: .02em;
  opacity: 0;
  animation: vx-rise var(--t-6) var(--ease-silk) 240ms forwards;
}
.vx-header__meta {
  display: flex; align-items: center; gap: var(--s-5);
  margin-top: var(--s-5); flex-wrap: wrap;
  opacity: 0;
  animation: vx-rise var(--t-5) var(--ease-silk) 340ms forwards;
}
.vx-header__count {
  font-size: 11px; font-weight: 300; letter-spacing: .18em;
  text-transform: uppercase; color: var(--c-muted);
}
.vx-header__count strong { color: var(--c-linen); font-weight: 500; }

/* ── FIX: Removed fake "viewers now" indicator entirely.
         Replaced with real collection product count badge. ── */
.vx-stock-signal {
  display: inline-flex; align-items: center; gap: 8px;
  padding: 5px 14px 5px 10px;
  border: 1px solid rgba(200,168,75,.2);
  border-radius: var(--r-pill);
  font-size: 9.5px; font-weight: 400; letter-spacing: .14em;
  color: rgba(200,168,75,.8); text-transform: uppercase;
  background: rgba(200,168,75,.05);
}
.vx-stock-signal__dot {
  width: 6px; height: 6px; border-radius: 50%;
  background: var(--c-gold); flex-shrink: 0;
}

.vx-header__trust {
  display: flex; flex-direction: column; gap: 10px;
  opacity: 0;
  animation: vx-fade var(--t-6) var(--ease-silk) 460ms forwards;
  flex-shrink: 0;
}
@media (max-width: 900px) {
  .vx-header__trust { flex-direction: row; flex-wrap: wrap; gap: 8px; }
}
.vx-trust-pill {
  display: flex; align-items: center; gap: 10px;
  padding: 9px 16px;
  border: 1px solid var(--c-rule);
  border-radius: var(--r-pill);
  font-size: 10px; font-weight: 300; letter-spacing: .1em;
  text-transform: uppercase; color: var(--c-warm);
  white-space: nowrap;
  backdrop-filter: blur(8px);
  background: rgba(255,255,255,.03);
  transition: border-color var(--t-3) var(--ease-out),
              color var(--t-3) var(--ease-out),
              background var(--t-3) var(--ease-out),
              transform var(--t-3) var(--ease-silk);
}
.vx-trust-pill:hover {
  border-color: rgba(200,168,75,.35);
  color: var(--c-linen);
  background: rgba(200,168,75,.05);
  transform: translateX(-2px);
}
.vx-trust-pill svg { width: 13px; height: 13px; color: var(--c-gold); flex-shrink: 0; opacity: .9; }

@keyframes vx-rise {
  from { opacity: 0; transform: translate3d(0, 28px, 0); }
  to   { opacity: 1; transform: translate3d(0, 0, 0); }
}
@keyframes vx-fade { from { opacity: 0; } to { opacity: 1; } }

/* ═══════════════════════════════════════════════════════════
   COUNTDOWN BAR
═══════════════════════════════════════════════════════════ */
.vx-countdown {
  background: var(--c-ground);
  border-bottom: 1px solid var(--c-rule);
  padding: 14px var(--gutter);
  display: flex; align-items: center; justify-content: center;
  gap: var(--s-4); flex-wrap: wrap;
}
.vx-countdown__label {
  font-size: 9px; font-weight: 500; letter-spacing: .3em;
  text-transform: uppercase; color: var(--c-muted);
}
.vx-countdown__timer { display: flex; align-items: center; gap: 8px; }
.vx-cd-unit { display: flex; align-items: baseline; gap: 3px; }
.vx-cd-num {
  font-family: var(--f-display);
  font-size: 28px; font-weight: 400; color: var(--c-linen);
  line-height: 1; min-width: 38px; text-align: center;
}

/* ── FIX: Use CSS animation-name swap instead of setTimeout
         for tick animation. This is robust and never misses frames. ── */
.vx-cd-num[data-ticking="a"] { animation: vx-tick-a var(--t-3) var(--ease-silk); }
.vx-cd-num[data-ticking="b"] { animation: vx-tick-b var(--t-3) var(--ease-silk); }
@keyframes vx-tick-a {
  0%   { opacity: 0; transform: translateY(-6px); }
  100% { opacity: 1; transform: translateY(0); }
}
@keyframes vx-tick-b {
  0%   { opacity: 0; transform: translateY(-6px); }
  100% { opacity: 1; transform: translateY(0); }
}
.vx-cd-lbl {
  font-size: 7px; font-weight: 500; letter-spacing: .24em;
  text-transform: uppercase; color: var(--c-mid);
}
.vx-cd-sep {
  font-family: var(--f-display); font-size: 24px;
  color: var(--c-mid); padding-bottom: 4px; opacity: .5;
  animation: vx-blink 1s ease-in-out infinite;
}
@keyframes vx-blink { 0%,49%{opacity:.5} 50%,100%{opacity:.15} }

/* ═══════════════════════════════════════════════════════════
   MAIN LAYOUT
═══════════════════════════════════════════════════════════ */
.vx-body {
  display: grid;
  grid-template-columns: var(--sidebar) 1fr;
  align-items: start;
  min-height: 70vh;
}
@media (max-width: 1160px) {
  .vx-body { grid-template-columns: 1fr; }
}

/* ═══════════════════════════════════════════════════════════
   SIDEBAR — with proper focus trap
═══════════════════════════════════════════════════════════ */
.vx-sidebar {
  background: var(--c-white);
  border-right: 1px solid rgba(201,190,221,.10);
  padding: var(--s-5) var(--s-5) var(--s-8);
  position: sticky; top: 0;
  height: 100vh; overflow-y: auto;
  scrollbar-width: thin;
  scrollbar-color: rgba(201,190,221,.2) transparent;
}
.vx-sidebar::-webkit-scrollbar { width: 3px; }
.vx-sidebar::-webkit-scrollbar-track { background: transparent; }
.vx-sidebar::-webkit-scrollbar-thumb { background: rgba(201,190,221,.25); border-radius: 3px; }
@media (max-width: 1160px) {
  .vx-sidebar {
    position: fixed; inset: 0 auto 0 0;
    width: min(320px, 90vw); height: 100dvh;
    border-right: 1px solid var(--c-rule-md);
    box-shadow: var(--sh-modal);
    z-index: 600; padding: var(--s-5);
    transform: translate3d(-110%, 0, 0);
    transition: transform var(--t-5) var(--ease-snap);
    will-change: transform;
    overscroll-behavior: contain;
  }
  .vx-sidebar.is-open { transform: translate3d(0, 0, 0); }
}
.vx-sidebar__hd {
  display: flex; align-items: center; justify-content: space-between;
  margin-bottom: var(--s-5);
  padding-bottom: var(--s-3);
  border-bottom: 1px solid rgba(201,190,221,.12);
}
.vx-sidebar__label {
  font-size: 8px; font-weight: 600; letter-spacing: .36em;
  text-transform: uppercase; color: var(--c-void);
}
.vx-icon-btn {
  display: flex; align-items: center; justify-content: center;
  width: 32px; height: 32px;
  background: none; border: 1px solid rgba(201,190,221,.3);
  border-radius: 50%; color: var(--c-void);
  transition: border-color var(--t-2), transform var(--t-3) var(--ease-silk), background var(--t-2);
}
.vx-icon-btn:hover { border-color: var(--c-void); transform: rotate(90deg); background: var(--c-ivory); }
@media (min-width: 1161px) { .vx-sidebar__close { display: none; } }

/* Active filters */
.vx-active-filters { display: flex; flex-wrap: wrap; gap: 5px; margin-bottom: var(--s-4); }
.vx-active-filters:empty { display: none; }
.vx-af-tag {
  display: inline-flex; align-items: center; gap: 6px;
  padding: 4px 8px 4px 12px;
  background: var(--c-void); color: var(--c-linen);
  border-radius: var(--r-pill);
  font-size: 9px; font-weight: 400; letter-spacing: .1em; text-transform: uppercase;
  animation: vx-fade var(--t-2) var(--ease-silk);
}
.vx-af-remove {
  display: flex; align-items: center; justify-content: center;
  width: 15px; height: 15px;
  background: rgba(255,255,255,.15); border: none; border-radius: 50%;
  color: var(--c-linen); font-size: 10px;
  transition: background var(--t-2);
}
.vx-af-remove:hover { background: rgba(255,255,255,.3); }
.vx-clear-all {
  background: none; border: none; padding: 4px 2px;
  font-family: var(--f-body); font-size: 9px; font-weight: 400;
  letter-spacing: .14em; text-transform: uppercase; color: var(--c-muted);
  text-decoration: underline; text-underline-offset: 3px;
  transition: color var(--t-2); align-self: center;
}
.vx-clear-all:hover { color: var(--c-void); }

/* Filter groups */
.vx-fgroup {
  border-bottom: 1px solid rgba(201,190,221,.1);
  padding-bottom: var(--s-3); margin-bottom: var(--s-4);
}
.vx-fgroup summary {
  list-style: none; display: flex; align-items: center;
  justify-content: space-between;
  padding: var(--s-2) 0; cursor: pointer; user-select: none;
  font-size: 9px; font-weight: 600; letter-spacing: .24em;
  text-transform: uppercase; color: var(--c-void);
  transition: color var(--t-2);
}
.vx-fgroup summary::-webkit-details-marker { display: none; }
.vx-fgroup summary:hover { color: var(--c-mid); }
.vx-fgroup summary .vx-chevron {
  width: 11px; height: 11px; color: var(--c-muted); flex-shrink: 0;
  transition: transform var(--t-3) var(--ease-silk);
}
.vx-fgroup[open] summary .vx-chevron { transform: rotate(180deg); }
.vx-fgroup__body { padding: var(--s-2) 0 var(--s-1); }

/* Filter options */
.vx-fopt {
  display: flex; align-items: center; gap: var(--s-3);
  padding: 6px 2px; cursor: pointer;
  transition: opacity var(--t-2); border-radius: var(--r-sm);
}
.vx-fopt:hover { opacity: .75; }
.vx-checkbox {
  appearance: none; -webkit-appearance: none;
  width: 15px; height: 15px; flex-shrink: 0;
  border: 1.5px solid rgba(201,190,221,.5);
  border-radius: 4px; position: relative; cursor: pointer;
  background: transparent;
  transition: background var(--t-2), border-color var(--t-2), transform var(--t-2) var(--ease-back);
}
.vx-checkbox:checked { background: var(--c-void); border-color: var(--c-void); transform: scale(1.05); }
.vx-checkbox:checked::after {
  content: ''; position: absolute; left: 3px; top: 0px;
  width: 6px; height: 10px;
  border: 1.5px solid var(--c-white); border-top: 0; border-left: 0;
  transform: rotate(44deg);
}
.vx-fopt__lbl { font-size: 12.5px; font-weight: 300; color: var(--c-void); flex: 1; letter-spacing: .01em; }
.vx-fopt__cnt { font-size: 10px; color: var(--c-muted); font-weight: 400; min-width: 22px; text-align: right; }

/* Price range */
.vx-price-row {
  display: flex; justify-content: space-between; align-items: center;
  font-size: 11.5px; font-weight: 300; color: var(--c-void);
  margin-bottom: var(--s-2); letter-spacing: .02em;
}
.vx-range-wrap {
  position: relative; height: 3px;
  background: rgba(201,190,221,.25);
  margin: var(--s-4) 0; border-radius: 3px;
}
.vx-range-fill {
  position: absolute; top: 0; height: 100%;
  background: var(--c-void); border-radius: 3px;
}
.vx-range-wrap input[type=range] {
  position: absolute; top: -11px; width: 100%;
  appearance: none; -webkit-appearance: none;
  background: transparent; pointer-events: none;
}
.vx-range-wrap input::-webkit-slider-thumb {
  -webkit-appearance: none;
  width: 20px; height: 20px; border-radius: 50%;
  background: var(--c-white);
  border: 1.5px solid rgba(201,190,221,.5);
  box-shadow: 0 2px 10px rgba(6,5,8,.14);
  pointer-events: auto; cursor: grab;
  transition: border-color var(--t-2), transform var(--t-2) var(--ease-silk), box-shadow var(--t-2);
}
.vx-range-wrap input::-webkit-slider-thumb:hover {
  border-color: var(--c-void); transform: scale(1.2); box-shadow: 0 4px 20px rgba(6,5,8,.2);
}
.vx-range-wrap input::-webkit-slider-thumb:active { cursor: grabbing; }
.vx-range-wrap input::-moz-range-thumb {
  width: 20px; height: 20px; border-radius: 50%;
  background: var(--c-white); border: 1.5px solid rgba(201,190,221,.5);
  box-shadow: 0 2px 10px rgba(6,5,8,.14); pointer-events: auto; cursor: grab;
}

/* ═══════════════════════════════════════════════════════════
   MAIN CONTENT AREA
═══════════════════════════════════════════════════════════ */
.vx-main {
  background: var(--c-ivory);
  padding: var(--s-5) clamp(16px, 3.5vw, 64px) var(--s-8);
  min-width: 0; overflow: hidden;
}

/* ═══════════════════════════════════════════════════════════
   TOOLBAR
═══════════════════════════════════════════════════════════ */
.vx-toolbar {
  display: flex; align-items: center; justify-content: space-between;
  gap: var(--s-3); margin-bottom: var(--s-5);
  padding-bottom: var(--s-4);
  border-bottom: 1px solid rgba(201,190,221,.14);
  position: sticky; top: 0; z-index: 100;
  background: var(--c-ivory);
  transition: box-shadow var(--t-3) var(--ease-out),
              background var(--t-3) var(--ease-out),
              padding var(--t-3) var(--ease-out);
}
.vx-toolbar.is-scrolled {
  padding-top: var(--s-3);
  box-shadow: 0 1px 0 rgba(201,190,221,.18), 0 6px 28px rgba(6,5,8,.06);
  background: rgba(246,243,251,.97);
  backdrop-filter: blur(16px) saturate(180%);
  -webkit-backdrop-filter: blur(16px) saturate(180%);
}
.vx-toolbar__l { display: flex; align-items: center; gap: 14px; flex-shrink: 0; }
.vx-toolbar__r { display: flex; align-items: center; gap: 8px; }

.vx-filter-btn {
  display: none; align-items: center; gap: 8px;
  padding: 9px 18px 9px 14px;
  background: var(--c-void); border: none;
  font-size: 9px; font-weight: 500; letter-spacing: .22em;
  text-transform: uppercase; color: var(--c-linen);
  border-radius: var(--r-pill);
  transition: background var(--t-2), transform var(--t-2) var(--ease-silk);
  position: relative;
}
.vx-filter-btn:hover { background: var(--c-mid); transform: translateY(-1px); }
.vx-filter-btn:active { transform: translateY(0); }
@media (max-width: 1160px) { .vx-filter-btn { display: flex; } }
.vx-filter-badge {
  position: absolute; top: -5px; right: -5px;
  width: 18px; height: 18px;
  background: var(--c-gold); border-radius: 50%;
  font-size: 8px; font-weight: 600; color: var(--c-deep);
  display: none; align-items: center; justify-content: center;
  border: 2px solid var(--c-ivory);
  animation: vx-pop var(--t-3) var(--ease-back);
}
.vx-filter-badge.show { display: flex; }
@keyframes vx-pop { from { transform: scale(0); } to { transform: scale(1); } }
.vx-result {
  font-size: 10.5px; font-weight: 300; letter-spacing: .14em;
  text-transform: uppercase; color: var(--c-muted);
}
.vx-result strong { color: var(--c-void); font-weight: 500; }
.vx-sort {
  appearance: none; -webkit-appearance: none;
  padding: 9px 34px 9px 16px;
  background: transparent url("data:image/svg+xml,%3Csvg width='9' height='5' fill='none' xmlns='http://www.w3.org/2000/svg'%3E%3Cpath d='M1 1l3.5 3 3.5-3' stroke='%23060508' stroke-width='1.3' stroke-linecap='round' stroke-linejoin='round'/%3E%3C/svg%3E") no-repeat right 14px center;
  border: 1px solid rgba(201,190,221,.3); border-radius: var(--r-pill);
  font-family: var(--f-body); font-size: 10px; font-weight: 400;
  letter-spacing: .1em; text-transform: uppercase; color: var(--c-void);
  transition: border-color var(--t-2), background-color var(--t-2);
}
.vx-sort:hover, .vx-sort:focus { border-color: var(--c-void); outline: none; background-color: rgba(6,5,8,.03); }
.vx-views { display: flex; gap: 2px; }
.vx-vbtn {
  width: 34px; height: 34px; display: flex; align-items: center; justify-content: center;
  background: transparent; border: 1px solid transparent; border-radius: var(--r-md);
  color: var(--c-muted);
  transition: color var(--t-2), border-color var(--t-2), background var(--t-2);
}
.vx-vbtn.is-active { color: var(--c-void); border-color: rgba(201,190,221,.3); background: rgba(6,5,8,.04); }
.vx-vbtn:hover:not(.is-active) { color: var(--c-void); }
.vx-vbtn svg { width: 13px; height: 13px; }

/* ═══════════════════════════════════════════════════════════
   PRODUCT GRID
   FIX: content-visibility for off-screen performance
═══════════════════════════════════════════════════════════ */
.vx-grid {
  display: grid;
  gap: clamp(12px, 1.8vw, 28px);
  grid-template-columns: repeat(2, 1fr);
  transition: opacity var(--t-2) var(--ease-out);
}
@media (min-width: 860px) {
  .vx-grid[data-cols="2"] { grid-template-columns: repeat(2, 1fr); }
  .vx-grid[data-cols="3"] { grid-template-columns: repeat(3, 1fr); }
  .vx-grid[data-cols="4"] { grid-template-columns: repeat(4, 1fr); }
}

/* ═══════════════════════════════════════════════════════════
   PRODUCT CARD
═══════════════════════════════════════════════════════════ */
.vx-card {
  position: relative; display: flex; flex-direction: column;
  border-radius: var(--r-lg);
  overflow: hidden;
  background: var(--c-white);
  box-shadow: var(--sh-card);
  opacity: 0; transform: translate3d(0, 40px, 0);
  transition:
    opacity var(--t-6) var(--ease-silk),
    transform var(--t-6) var(--ease-silk),
    box-shadow var(--t-4) var(--ease-out);
  will-change: opacity, transform;
  /* FIX: content-visibility improves rendering performance for off-screen cards */
  content-visibility: auto;
  contain-intrinsic-size: 0 480px;
}
.vx-card.is-revealed { opacity: 1; transform: none; }
.vx-card:hover { box-shadow: var(--sh-hover); }
.vx-card__media {
  position: relative; overflow: hidden;
  aspect-ratio: 3/4; background: var(--c-linen); flex-shrink: 0;
}
.vx-card__media::before {
  content: ''; position: absolute; inset: 0; z-index: 1;
  background: linear-gradient(105deg, var(--c-linen) 30%, rgba(255,255,255,.7) 50%, var(--c-linen) 70%);
  background-size: 200% 100%;
  animation: vx-shimmer 1.6s linear infinite;
  transition: opacity var(--t-4) var(--ease-out);
  pointer-events: none;
}
.vx-card.is-revealed .vx-card__media::before { opacity: 0; }
@keyframes vx-shimmer { 0% { background-position: 200% 0; } 100% { background-position: -200% 0; } }
.vx-card__img {
  position: absolute; inset: 0; width: 100%; height: 100%;
  object-fit: cover; object-position: top center;
  transition: transform 1.6s var(--ease-silk), opacity var(--t-5) var(--ease-out);
  transform: scale(1.0); will-change: transform;
}
.vx-card:hover .vx-card__img { transform: scale(1.07); }
.vx-card__img2 {
  position: absolute; inset: 0; width: 100%; height: 100%;
  object-fit: cover; object-position: top center;
  opacity: 0;
  transition: opacity var(--t-6) var(--ease-silk) 80ms;
}
.vx-card:hover .vx-card__img2 { opacity: 1; }
.vx-badges {
  position: absolute; top: 12px; left: 12px; z-index: 5;
  display: flex; flex-direction: column; gap: 5px; pointer-events: none;
}
.vx-badge {
  font-size: 8px; font-weight: 600; letter-spacing: .2em;
  text-transform: uppercase; padding: 4px 11px;
  border-radius: var(--r-pill); white-space: nowrap;
  backdrop-filter: blur(10px) saturate(180%);
  -webkit-backdrop-filter: blur(10px) saturate(180%);
}
.vx-badge--sale { background: var(--c-void); color: var(--c-linen); }
.vx-badge--new  { background: rgba(240,235,255,.92); color: var(--c-mid); border: 1px solid var(--c-rule); }
.vx-badge--low  { background: rgba(255,255,255,.92); color: var(--c-red); }
.vx-badge--out  { background: rgba(6,5,8,.55); color: rgba(230,224,242,.5); }
.vx-badge--back { background: var(--c-gold); color: var(--c-deep); }
.vx-card__over {
  position: absolute; inset: 0; z-index: 6;
  display: flex; flex-direction: column; justify-content: flex-end;
  padding: var(--s-3);
  background: linear-gradient(0deg, rgba(6,5,8,.65) 0%, rgba(6,5,8,.12) 40%, transparent 65%);
  opacity: 0; transition: opacity var(--t-3) var(--ease-out);
}
.vx-card:hover .vx-card__over { opacity: 1; }
.vx-card__actions {
  display: flex; gap: 7px;
  transform: translate3d(0, 16px, 0);
  transition: transform var(--t-4) var(--ease-silk);
}
.vx-card:hover .vx-card__actions { transform: none; }
.vx-card__atc {
  flex: 1; padding: 12px 14px;
  background: rgba(246,243,251,.95); border: none; border-radius: var(--r-pill);
  font-size: 9px; font-weight: 600; letter-spacing: .2em; text-transform: uppercase;
  color: var(--c-void); backdrop-filter: blur(8px);
  transition: background var(--t-2) var(--ease-out), transform var(--t-2) var(--ease-silk);
}
.vx-card__atc:hover:not(:disabled) { background: var(--c-white); transform: translateY(-1px); }
.vx-card__atc:disabled { opacity: .4; cursor: not-allowed; }
.vx-card__wish {
  width: 42px; height: 42px; flex-shrink: 0;
  background: rgba(246,243,251,.92); border: none; border-radius: 50%;
  display: flex; align-items: center; justify-content: center;
  color: var(--c-void); backdrop-filter: blur(8px);
  transition: background var(--t-2), transform var(--t-3) var(--ease-silk);
}
.vx-card__wish:hover { background: var(--c-white); transform: scale(1.1); }
.vx-card__wish.is-active svg { fill: var(--c-void); }
.vx-card__wish svg { width: 16px; height: 16px; transition: fill var(--t-2), transform var(--t-3) var(--ease-back); }
.vx-card__wish:hover svg { transform: scale(1.15); }

/* Variant panel */
.vx-vpanel {
  display: none; position: absolute; bottom: 0; left: 0; right: 0; z-index: 7;
  background: var(--c-white); padding: var(--s-3) var(--s-4) var(--s-4);
  border-top: 1px solid rgba(201,190,221,.15);
}
.vx-vpanel.is-open { display: block; animation: vx-rise var(--t-4) var(--ease-silk); }
.vx-vpanel__label {
  font-size: 9px; font-weight: 500; letter-spacing: .2em;
  text-transform: uppercase; color: var(--c-muted); margin-bottom: 10px;
}
.vx-vchips { display: flex; flex-wrap: wrap; gap: 5px; margin-bottom: var(--s-3); }
.vx-vchip {
  padding: 5px 14px; border-radius: var(--r-pill);
  border: 1px solid rgba(201,190,221,.35); background: none;
  font-size: 10.5px; font-weight: 300; color: var(--c-void);
  transition: border-color var(--t-2), background var(--t-2), transform var(--t-2) var(--ease-silk);
}
.vx-vchip:hover:not(.is-out) { border-color: var(--c-void); transform: translateY(-1px); }
.vx-vchip.is-sel { background: var(--c-void); color: var(--c-ivory); border-color: var(--c-void); }
.vx-vchip.is-out { opacity: .2; cursor: not-allowed; text-decoration: line-through; }

/* Card info */
.vx-card__info {
  padding: var(--s-3) clamp(14px, 2.5vw, 22px) clamp(14px, 2.5vw, 22px);
  display: flex; flex-direction: column; flex: 1; background: var(--c-white);
}
.vx-card__brand {
  font-size: 8.5px; font-weight: 500; letter-spacing: .28em;
  text-transform: uppercase; color: var(--c-muted); margin-bottom: 6px; margin-top: var(--s-3);
}
.vx-card__name {
  font-family: var(--f-display);
  font-size: clamp(17px, 2vw, 22px); font-weight: 400; line-height: 1.18; color: var(--c-void);
  display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;
}
.vx-card__name a { text-decoration: none; color: inherit; transition: color var(--t-2); }
.vx-card__name a:hover { color: var(--c-mid); }
.vx-stock { margin-top: 10px; }
.vx-stock__label {
  display: block; font-size: 9px; font-weight: 500; letter-spacing: .14em;
  text-transform: uppercase; color: var(--c-red); margin-bottom: 6px;
}
.vx-stock__track {
  height: 2px; background: rgba(201,190,221,.2); border-radius: 2px; overflow: hidden;
}
.vx-stock__fill {
  height: 100%; background: var(--c-red); opacity: .6;
  width: 0; border-radius: 2px;
  transition: width 1.6s var(--ease-silk) 600ms;
}
.vx-card.is-revealed .vx-stock__fill { width: var(--stock-pct, 60%); }

/* ── FIX: Color swatches now use a data-color attribute mapped from
         a JS lookup table. Unknown colors fall back to a neutral.
         No more silent failures on non-CSS color names. ── */
.vx-swatches { display: flex; align-items: center; gap: 7px; margin-top: 12px; flex-wrap: wrap; }
.vx-swatch {
  width: 13px; height: 13px; border-radius: 50%;
  border: 1.5px solid transparent;
  outline: 1.5px solid transparent; outline-offset: 2px;
  cursor: pointer;
  transition: transform var(--t-3) var(--ease-silk), outline-color var(--t-2);
  /* background is set via inline style from the JS color map */
}
.vx-swatch:hover { transform: scale(1.45); }
.vx-swatch.is-sel { outline-color: var(--c-void); }
.vx-swatch-more { font-size: 10px; color: var(--c-muted); font-weight: 300; letter-spacing: .03em; }
.vx-card__price {
  display: flex; align-items: baseline; gap: 8px; margin-top: 14px; flex-wrap: wrap;
}
.vx-price { font-family: var(--f-display); font-size: 21px; font-weight: 400; color: var(--c-void); line-height: 1; }
.vx-price-was { font-size: 13px; color: var(--c-muted); text-decoration: line-through; }
.vx-price-save {
  font-size: 8px; font-weight: 600; letter-spacing: .12em; text-transform: uppercase; color: var(--c-red);
  padding: 2px 8px; background: var(--c-red-bg); border-radius: var(--r-pill);
}
.vx-card__btn {
  margin-top: var(--s-3); width: 100%; padding: 14px;
  background: var(--c-void); color: var(--c-linen);
  border: 1.5px solid transparent; border-radius: var(--r-pill);
  font-size: 9px; font-weight: 600; letter-spacing: .24em; text-transform: uppercase;
  position: relative; overflow: hidden; isolation: isolate;
  transition: background var(--t-3) var(--ease-out), border-color var(--t-3), transform var(--t-2) var(--ease-silk), color var(--t-2);
}
.vx-card__btn::before {
  content: ''; position: absolute; top: 0; left: -100%; width: 60%; height: 100%;
  background: linear-gradient(90deg, transparent, rgba(255,255,255,.08), transparent);
  transition: left var(--t-5) var(--ease-silk);
}
.vx-card__btn:hover:not(:disabled)::before { left: 160%; }
.vx-card__btn:hover:not(:disabled) { background: var(--c-surface); transform: translateY(-1px); }
.vx-card__btn:active { transform: translateY(0); }
.vx-card__btn:disabled { background: transparent; border-color: rgba(201,190,221,.3); color: var(--c-muted); cursor: not-allowed; }
.vx-card__btn span { position: relative; z-index: 1; }
.vx-card__btn.is-loading { color: transparent; pointer-events: none; }
.vx-card__btn.is-loading::after {
  content: ''; position: absolute; top: 50%; left: 50%;
  width: 16px; height: 16px; margin: -8px 0 0 -8px;
  border: 1.5px solid rgba(228,224,242,.25); border-top-color: var(--c-linen);
  border-radius: 50%; animation: vx-spin .55s linear infinite; z-index: 2;
}
@keyframes vx-spin { to { transform: rotate(360deg); } }

/* ═══════════════════════════════════════════════════════════
   EMPTY STATE
═══════════════════════════════════════════════════════════ */
.vx-empty {
  grid-column: 1 / -1; text-align: center;
  padding: var(--s-8) var(--s-4);
  animation: vx-fade var(--t-5) var(--ease-silk);
}
.vx-empty__glyph { font-size: 52px; opacity: .15; margin-bottom: var(--s-4); line-height: 1; }
.vx-empty__title { font-family: var(--f-display); font-size: 32px; font-weight: 300; color: var(--c-void); margin-bottom: var(--s-2); }
.vx-empty__desc { font-size: 13px; font-weight: 300; color: var(--c-muted); margin-bottom: var(--s-5); }
.vx-empty__cta {
  display: inline-flex; padding: 14px 32px;
  background: var(--c-void); color: var(--c-linen);
  font-size: 9px; font-weight: 600; letter-spacing: .24em; text-transform: uppercase;
  text-decoration: none; border-radius: var(--r-pill);
  transition: background var(--t-2), transform var(--t-2) var(--ease-silk);
}
.vx-empty__cta:hover { background: var(--c-mid); transform: translateY(-1px); }

/* ═══════════════════════════════════════════════════════════
   PAGINATION
═══════════════════════════════════════════════════════════ */
.vx-pagination {
  display: flex; align-items: center; justify-content: center;
  gap: 5px; padding: var(--s-7) 0; flex-wrap: wrap;
}
.vx-page {
  min-width: 42px; height: 42px;
  display: flex; align-items: center; justify-content: center;
  border: 1px solid rgba(201,190,221,.22); background: transparent;
  color: var(--c-void); border-radius: 50%;
  font-size: 12px; font-weight: 300; letter-spacing: .06em;
  text-decoration: none; padding: 0 6px;
  transition: border-color var(--t-2), background var(--t-2), transform var(--t-2) var(--ease-silk);
}
.vx-page:hover:not(.is-dis):not(.is-cur) { border-color: var(--c-void); transform: translateY(-2px); }
.vx-page.is-cur { background: var(--c-void); color: var(--c-ivory); border-color: var(--c-void); }
.vx-page.is-dis { opacity: .2; pointer-events: none; }

/* ═══════════════════════════════════════════════════════════
   STATS STRIP
═══════════════════════════════════════════════════════════ */
.vx-stats {
  background: var(--c-deep); border-top: 1px solid var(--c-rule);
  padding: var(--s-7) var(--gutter);
}
.vx-stats__grid {
  max-width: var(--max-w); margin: 0 auto;
  display: grid; grid-template-columns: repeat(2, 1fr);
  gap: clamp(28px, 5vw, 64px);
}
@media (min-width: 640px) { .vx-stats__grid { grid-template-columns: repeat(4, 1fr); } }
.vx-stat {
  text-align: center; opacity: 0; transform: translate3d(0, 24px, 0);
  transition: opacity var(--t-6) var(--ease-silk), transform var(--t-6) var(--ease-silk);
}
.vx-stat:nth-child(1) { transition-delay: 0ms; }
.vx-stat:nth-child(2) { transition-delay: 90ms; }
.vx-stat:nth-child(3) { transition-delay: 180ms; }
.vx-stat:nth-child(4) { transition-delay: 270ms; }
.vx-stat.is-visible { opacity: 1; transform: none; }
.vx-stat__num { font-family: var(--f-display); font-size: clamp(38px, 4.5vw, 58px); font-weight: 300; color: var(--c-linen); line-height: 1; margin-bottom: 10px; letter-spacing: -.02em; }
.vx-stat__lbl { font-size: 9px; font-weight: 400; letter-spacing: .24em; text-transform: uppercase; color: var(--c-warm); }

/* ═══════════════════════════════════════════════════════════
   STICKY ATC BAR
═══════════════════════════════════════════════════════════ */
.vx-sticky {
  position: fixed; bottom: 0; left: 0; right: 0; z-index: 800;
  background: rgba(13,11,18,.97);
  border-top: 1px solid rgba(201,190,221,.08);
  backdrop-filter: blur(20px) saturate(180%);
  -webkit-backdrop-filter: blur(20px) saturate(180%);
  padding: 14px var(--gutter);
  display: flex; align-items: center; justify-content: space-between;
  gap: var(--s-4); flex-wrap: wrap;
  transform: translate3d(0, 110%, 0);
  transition: transform var(--t-5) var(--ease-snap);
  will-change: transform;
}
.vx-sticky.is-visible { transform: none; }
@media (max-width: 640px) { .vx-sticky { padding: 12px 16px; gap: 10px; } }
.vx-sticky__info { min-width: 0; flex: 1; }
.vx-sticky__name {
  font-family: var(--f-display); font-size: clamp(15px, 2.2vw, 20px);
  font-weight: 400; color: var(--c-ivory);
  white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
  line-height: 1.2; margin-bottom: 3px;
}
.vx-sticky__price { font-size: 10px; font-weight: 300; letter-spacing: .14em; color: var(--c-sand); }
.vx-sticky__shipping {
  display: flex; align-items: center; gap: 6px;
  font-size: 8.5px; font-weight: 400; letter-spacing: .14em;
  text-transform: uppercase; color: rgba(66,200,130,.75); margin-top: 2px;
}
.vx-sticky__shipping::before { content: ''; width: 5px; height: 5px; border-radius: 50%; background: var(--c-green-lt); flex-shrink: 0; }
.vx-sticky__right { display: flex; align-items: center; gap: 8px; flex-shrink: 0; }
.vx-sticky-chips { display: flex; gap: 4px; flex-wrap: wrap; }
.vx-sticky-chip {
  padding: 7px 15px; border-radius: var(--r-pill);
  border: 1px solid rgba(201,190,221,.18); background: none;
  font-size: 9px; font-weight: 400; letter-spacing: .12em;
  text-transform: uppercase; color: rgba(230,224,242,.4);
  transition: border-color var(--t-2), color var(--t-2), background var(--t-2);
}
.vx-sticky-chip:hover { border-color: var(--c-sand); color: var(--c-sand); }
.vx-sticky-chip.is-sel { border-color: var(--c-linen); color: var(--c-linen); background: rgba(230,224,242,.07); }
.vx-sticky-chip.is-out { opacity: .2; cursor: not-allowed; }
.vx-sticky-atc {
  padding: 13px 28px; background: var(--c-gold); color: var(--c-deep);
  border: none; border-radius: var(--r-pill);
  font-size: 9px; font-weight: 700; letter-spacing: .24em; text-transform: uppercase;
  white-space: nowrap; flex-shrink: 0;
  transition: background var(--t-2), transform var(--t-2) var(--ease-silk), box-shadow var(--t-2);
}
.vx-sticky-atc:hover { background: var(--c-gold-lt); transform: translateY(-2px); box-shadow: var(--sh-gold); }
.vx-sticky-atc:active { transform: translateY(0); }
.vx-sticky-atc:disabled { opacity: .3; cursor: not-allowed; transform: none; box-shadow: none; }
.vx-sticky-close {
  width: 34px; height: 34px; background: none; border: 1px solid rgba(201,190,221,.12);
  border-radius: 50%; color: var(--c-muted); display: flex; align-items: center; justify-content: center; flex-shrink: 0;
  transition: border-color var(--t-2), transform var(--t-3) var(--ease-silk), color var(--t-2);
}
.vx-sticky-close:hover { border-color: var(--c-muted); transform: rotate(90deg); color: var(--c-linen); }

/* ═══════════════════════════════════════════════════════════
   OVERLAY
═══════════════════════════════════════════════════════════ */
.vx-overlay {
  display: none; position: fixed; inset: 0; z-index: 599;
  background: rgba(6,5,8,0);
  backdrop-filter: blur(0px);
  transition: background var(--t-4) var(--ease-out), backdrop-filter var(--t-4);
}
.vx-overlay.is-open { display: block; animation: vx-overlay-in var(--t-4) var(--ease-out) forwards; }
@keyframes vx-overlay-in { to { background: rgba(6,5,8,.58); backdrop-filter: blur(5px); } }

/* ═══════════════════════════════════════════════════════════
   TOAST NOTIFICATIONS
═══════════════════════════════════════════════════════════ */
.vx-toasts {
  position: fixed; top: 18px; right: 18px; z-index: 1100;
  display: flex; flex-direction: column; gap: 8px;
  pointer-events: none; width: min(340px, calc(100vw - 24px));
}
.vx-toast {
  display: flex; align-items: flex-start; gap: 12px;
  background: var(--c-deep); border-radius: var(--r-lg);
  padding: 16px 18px; pointer-events: auto;
  box-shadow: var(--sh-modal);
  border-left: 2px solid var(--c-green);
  animation: vx-toast-in var(--t-4) var(--ease-silk) forwards;
}
.vx-toast.is-err { border-left-color: var(--c-red); }
@keyframes vx-toast-in { from { transform: translate3d(120%, 0, 0); opacity: 0; } to { transform: none; opacity: 1; } }
.vx-toast__icon { width: 16px; height: 16px; flex-shrink: 0; margin-top: 1px; }
.vx-toast.is-ok .vx-toast__icon { color: var(--c-green-lt); }
.vx-toast.is-err .vx-toast__icon { color: var(--c-red); }
.vx-toast__title { font-size: 12.5px; font-weight: 500; color: var(--c-linen); letter-spacing: .02em; }
.vx-toast__msg { font-size: 10.5px; color: var(--c-warm); margin-top: 3px; font-weight: 300; line-height: 1.5; }

/* ═══════════════════════════════════════════════════════════
   NEWSLETTER MODAL — replaces deceptive exit popup
   Honest opt-in: shown once after 30s of browsing, not on exit
═══════════════════════════════════════════════════════════ */
.vx-newsletter {
  display: none; position: fixed; inset: 0; z-index: 2000;
  align-items: center; justify-content: center; padding: 20px;
  background: rgba(6,5,8,.68); backdrop-filter: blur(8px);
}
.vx-newsletter.is-open { display: flex; }
.vx-newsletter__box {
  background: var(--c-white); max-width: 440px; width: 100%;
  padding: clamp(36px, 5vw, 72px) clamp(28px, 4.5vw, 64px);
  position: relative; border-radius: var(--r-xl);
  box-shadow: var(--sh-modal);
  animation: vx-rise var(--t-5) var(--ease-silk);
}
.vx-newsletter__close { position: absolute; top: 16px; right: 16px; }
.vx-newsletter__ornament {
  width: 48px; height: 48px;
  background: linear-gradient(135deg, rgba(200,168,75,.12), rgba(200,168,75,.22));
  border-radius: 50%; display: flex; align-items: center; justify-content: center;
  margin-bottom: var(--s-4);
}
.vx-newsletter__ornament svg { width: 22px; height: 22px; color: var(--c-gold); }
.vx-newsletter__kicker { font-size: 9px; font-weight: 600; letter-spacing: .34em; text-transform: uppercase; color: var(--c-gold); margin-bottom: var(--s-3); }
.vx-newsletter__title { font-family: var(--f-display); font-size: clamp(28px, 4.5vw, 40px); font-weight: 300; line-height: 1.08; color: var(--c-void); margin-bottom: var(--s-3); }
.vx-newsletter__title em { font-style: italic; }
.vx-newsletter__desc { font-size: 12.5px; font-weight: 300; color: var(--c-muted); line-height: 1.85; margin-bottom: var(--s-5); }
.vx-newsletter__form { display: flex; flex-direction: column; gap: 10px; }
.vx-newsletter__input {
  width: 100%; padding: 14px 18px;
  background: var(--c-ivory); border: 1.5px solid rgba(201,190,221,.4);
  border-radius: var(--r-md); font-family: var(--f-body); font-size: 13px;
  color: var(--c-void); outline: none;
  transition: border-color var(--t-2);
}
.vx-newsletter__input:focus { border-color: var(--c-gold); }
.vx-newsletter__input::placeholder { color: var(--c-muted); }
.vx-newsletter__cta {
  display: block; width: 100%; padding: 16px;
  background: var(--c-gold); color: var(--c-deep);
  border: none; border-radius: var(--r-pill);
  font-size: 9px; font-weight: 700; letter-spacing: .24em; text-transform: uppercase;
  transition: background var(--t-2), transform var(--t-2) var(--ease-silk);
}
.vx-newsletter__cta:hover { background: var(--c-gold-lt); transform: translateY(-1px); }
.vx-newsletter__skip {
  display: block; width: 100%; text-align: center;
  background: none; border: none; padding: 6px;
  font-size: 10.5px; font-weight: 300; color: var(--c-muted);
  text-decoration: underline; text-underline-offset: 3px;
  transition: color var(--t-2);
}
.vx-newsletter__skip:hover { color: var(--c-void); }

/* ═══════════════════════════════════════════════════════════
   WHATSAPP
═══════════════════════════════════════════════════════════ */
.vx-wa {
  position: fixed; bottom: 88px; right: 20px; z-index: 700;
  width: 52px; height: 52px; border-radius: 50%;
  background: var(--c-deep); border: 1px solid rgba(37,211,102,.22);
  box-shadow: 0 4px 24px rgba(6,5,8,.4), 0 0 0 0 rgba(37,211,102,.2);
  display: flex; align-items: center; justify-content: center;
  text-decoration: none;
  transition: transform var(--t-3) var(--ease-silk), box-shadow var(--t-3), border-color var(--t-2);
  animation: vx-wa-ring 4s ease-in-out infinite 3s;
}
.vx-wa:hover { transform: scale(1.12) translateY(-3px); border-color: rgba(37,211,102,.55); box-shadow: 0 12px 36px rgba(6,5,8,.5), 0 4px 16px rgba(37,211,102,.18); animation: none; }
.vx-wa svg { width: 26px; height: 26px; fill: #25D366; }
@keyframes vx-wa-ring {
  0%, 92%, 100% { box-shadow: 0 4px 24px rgba(6,5,8,.4), 0 0 0 0 rgba(37,211,102,.2); }
  96% { box-shadow: 0 4px 24px rgba(6,5,8,.4), 0 0 0 12px rgba(37,211,102,0); }
}
.vx-wa__label {
  position: absolute; right: 60px; top: 50%;
  transform: translateY(-50%) translateX(4px);
  background: var(--c-deep); color: var(--c-linen);
  font-size: 10px; font-weight: 300; letter-spacing: .1em;
  padding: 7px 14px; border: 1px solid var(--c-rule); white-space: nowrap;
  border-radius: var(--r-pill); box-shadow: var(--sh-card);
  pointer-events: none; opacity: 0;
  transition: opacity var(--t-2), transform var(--t-3) var(--ease-silk);
}
.vx-wa:hover .vx-wa__label { opacity: 1; transform: translateY(-50%) translateX(0); }

/* ═══════════════════════════════════════════════════════════
   CARD FILTER TRANSITIONS
═══════════════════════════════════════════════════════════ */
.vx-card.is-hiding { animation: vx-hide var(--t-2) var(--ease-out) forwards; pointer-events: none; }
.vx-card.is-showing { animation: vx-show var(--t-3) var(--ease-silk) forwards; }
@keyframes vx-hide { to { opacity: 0; transform: scale(.96) translateY(6px); } }
@keyframes vx-show { from { opacity: 0; transform: scale(.97) translateY(10px); } to { opacity: 1; transform: none; } }

/* ═══════════════════════════════════════════════════════════
   REDUCED MOTION
═══════════════════════════════════════════════════════════ */
@media (prefers-reduced-motion: reduce) {
  .vx-scope *, .vx-scope *::before, .vx-scope *::after {
    animation-duration: 1ms !important;
    animation-iteration-count: 1 !important;
    transition-duration: 1ms !important;
  }
  .vx-card { opacity: 1; transform: none; }
  .vx-eyebrow, .vx-header__title, .vx-header__desc,
  .vx-header__meta, .vx-header__trust { opacity: 1; animation: none; }
  .vx-notice__track { animation: none; }
  .vx-stat { opacity: 1; transform: none; }
  .vx-stock__fill { transition: none; width: var(--stock-pct, 60%); }
}

/* ═══════════════════════════════════════════════════════════
   HIGH CONTRAST MODE
═══════════════════════════════════════════════════════════ */
@media (prefers-contrast: high) {
  .vx-badge--new { border: 2px solid var(--c-mid); }
  .vx-card { border: 1px solid var(--c-void); }
}

/* ═══════════════════════════════════════════════════════════
   MOBILE OVERRIDES
═══════════════════════════════════════════════════════════ */
@media (max-width: 480px) {
  .vx-countdown .vx-cd-lbl { display: none; }
  .vx-sticky__shipping { display: none; }
  .vx-sticky-chips { display: none; }
  .vx-wa { bottom: 80px; right: 14px; width: 46px; height: 46px; }
}
@media (max-width: 360px) {
  .vx-grid { gap: 10px; }
  .vx-card__name { font-size: 15px; }
}
</style>

{% paginate collection.products by ppp %}

<div class="vx-scope" id="vx-{{ section.id }}" data-section-id="{{ section.id }}">

  <div class="vx-toasts" id="vxToasts" role="status" aria-live="polite" aria-atomic="false"></div>
  <div class="vx-overlay" id="vxOverlay" aria-hidden="true"></div>

  <!-- ── NEWSLETTER MODAL (honest opt-in, no dark patterns) ── -->
  {% if section.settings.enable_newsletter_modal %}
  <div class="vx-newsletter" id="vxNewsletter" role="dialog" aria-modal="true" aria-labelledby="vxNewsletterTitle">
    <div class="vx-newsletter__box">
      <button class="vx-icon-btn vx-newsletter__close" id="vxNewsletterClose" aria-label="Close">
        <svg width="10" height="10" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
      </button>
      <div class="vx-newsletter__ornament">
        <svg fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M21.75 6.75v10.5a2.25 2.25 0 01-2.25 2.25h-15a2.25 2.25 0 01-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0019.5 4.5h-15a2.25 2.25 0 00-2.25 2.25m19.5 0v.243a2.25 2.25 0 01-1.07 1.916l-7.5 4.615a2.25 2.25 0 01-2.36 0L3.32 8.91a2.25 2.25 0 01-1.07-1.916V6.75"/></svg>
      </div>
      <p class="vx-newsletter__kicker">Join the edit</p>
      <h2 class="vx-newsletter__title" id="vxNewsletterTitle">New arrivals, <em>first</em></h2>
      <p class="vx-newsletter__desc">{{ section.settings.newsletter_desc | default: 'Subscribe to receive new collection drops, style notes, and exclusive early access.' }}</p>
      <div class="vx-newsletter__form">
        <input
          class="vx-newsletter__input"
          type="email" id="vxNewsletterEmail"
          placeholder="Your email address"
          autocomplete="email"
          aria-label="Email address"
        >
        <button class="vx-newsletter__cta" id="vxNewsletterSubmit">Subscribe</button>
        <button class="vx-newsletter__skip" id="vxNewsletterSkip">No thanks</button>
      </div>
    </div>
  </div>
  {% endif %}

  <!-- ── ANNOUNCEMENT BAR ── -->
  {% if section.settings.announcement != blank %}
  <div class="vx-notice" role="banner">
    {%- assign items = section.settings.announcement | split: '|' -%}
    <div class="vx-notice__track" aria-hidden="true">
      {%- for item in items -%}
        {%- for _i in (1..10) -%}
          <span class="vx-notice__item"><span class="vx-notice__gem" aria-hidden="true"></span>{{ item | strip }}</span>
        {%- endfor -%}
      {%- endfor -%}
    </div>
    <p class="vx-sr">{{ section.settings.announcement | split: '|' | join: ' · ' }}</p>
  </div>
  {% endif %}

  <!-- ── COLLECTION HEADER ── -->
  <header class="vx-header">
    <div class="vx-header__atmo" aria-hidden="true"></div>
    <div class="vx-header__grain" aria-hidden="true"></div>
    <div class="vx-header__lines" aria-hidden="true">
      <svg viewBox="0 0 400 600" fill="none" preserveAspectRatio="xMaxYMid slice">
        <line x1="100" y1="0" x2="400" y2="600" stroke="white" stroke-width=".5"/>
        <line x1="200" y1="0" x2="500" y2="600" stroke="white" stroke-width=".3"/>
        <line x1="50"  y1="0" x2="350" y2="600" stroke="white" stroke-width=".2"/>
        <circle cx="350" cy="120" r="80" stroke="white" stroke-width=".4"/>
        <circle cx="320" cy="110" r="50" stroke="white" stroke-width=".3"/>
      </svg>
    </div>

    <div class="vx-header__inner vx-wrap">
      <div class="vx-header__left">
        {% if section.settings.eyebrow != blank %}
        <div class="vx-eyebrow">
          <span class="vx-eyebrow__line" aria-hidden="true"></span>
          <span class="vx-eyebrow__text">{{ section.settings.eyebrow }}</span>
        </div>
        {% endif %}
        <h1 class="vx-header__title">{{ collection.title }}</h1>
        {% if collection.description != blank %}
          <p class="vx-header__desc">{{ collection.description | strip_html | truncatewords: 32 }}</p>
        {% endif %}
        <div class="vx-header__meta">
          <p class="vx-header__count">
            <strong>{{ collection.products_count }}</strong> pieces
          </p>
          <!-- FIX: No fake viewer count. Replaced with a neutral factual signal. -->
          <div class="vx-stock-signal">
            <span class="vx-stock-signal__dot" aria-hidden="true"></span>
            Curated collection
          </div>
        </div>
      </div>

      <aside class="vx-header__trust" aria-label="Guarantees">
        <div class="vx-trust-pill">
          <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75m-3-7.036A11.959 11.959 0 013.598 6 11.99 11.99 0 003 9.749c0 5.592 3.824 10.29 9 11.623 5.176-1.332 9-6.03 9-11.622 0-1.31-.21-2.571-.598-3.751h-.152c-3.196 0-6.1-1.248-8.25-3.285z"/></svg>
          {{ section.settings.trust_1 | default: '100% Authentic' }}
        </div>
        <div class="vx-trust-pill">
          <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M8.25 18.75a1.5 1.5 0 01-3 0m3 0a1.5 1.5 0 00-3 0m3 0h6m-9 0H3.375a1.125 1.125 0 01-1.125-1.125V14.25m17.25 4.5a1.5 1.5 0 01-3 0m3 0a1.5 1.5 0 00-3 0m3 0h1.125c.621 0 1.09-.504 1.09-1.125v-4.125m-17.25 0h16.5M13.5 9.75h1.875a1.875 1.875 0 011.875 1.875V14.25M3.75 9.75H6"/></svg>
          {{ section.settings.trust_2 | default: 'Free Delivery' }}
        </div>
        <div class="vx-trust-pill">
          <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M9 15L3 9m0 0l6-6M3 9h12a6 6 0 010 12h-3"/></svg>
          {{ section.settings.trust_3 | default: '7-Day Returns' }}
        </div>
        <div class="vx-trust-pill">
          <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M2.25 8.25h19.5M2.25 9h19.5m-16.5 5.25h6m-6 2.25h3m-3.75 3h15a2.25 2.25 0 002.25-2.25V6.75A2.25 2.25 0 0019.5 4.5h-15a2.25 2.25 0 00-2.25 2.25v10.5A2.25 2.25 0 004.5 19.5z"/></svg>
          {{ section.settings.trust_4 | default: 'Cash on Delivery' }}
        </div>
      </aside>
    </div>
  </header>

  <!-- ── COUNTDOWN ── -->
  {% if section.settings.show_countdown %}
  <div class="vx-countdown" id="vxCountdown">
    <span class="vx-countdown__label">{{ section.settings.countdown_label | default: 'Offer ends in' }}</span>
    <div class="vx-countdown__timer" aria-live="polite" aria-atomic="true">
      <div class="vx-cd-unit">
        <span class="vx-cd-num" id="vxH">00</span>
        <span class="vx-cd-lbl">hrs</span>
      </div>
      <span class="vx-cd-sep" aria-hidden="true">:</span>
      <div class="vx-cd-unit">
        <span class="vx-cd-num" id="vxM">00</span>
        <span class="vx-cd-lbl">min</span>
      </div>
      <span class="vx-cd-sep" aria-hidden="true">:</span>
      <div class="vx-cd-unit">
        <span class="vx-cd-num" id="vxS">00</span>
        <span class="vx-cd-lbl">sec</span>
      </div>
    </div>
  </div>
  {% endif %}

  <!-- ── BODY ── -->
  <div class="vx-body">

    <!-- SIDEBAR -->
    <aside
      class="vx-sidebar"
      id="vxSidebar"
      aria-label="Filter products"
      aria-hidden="false"
    >
      <div class="vx-sidebar__hd">
        <span class="vx-sidebar__label">Refine</span>
        <button class="vx-icon-btn vx-sidebar__close" id="vxSidebarClose" aria-label="Close filters">
          <svg width="10" height="10" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
        </button>
      </div>

      <div class="vx-active-filters" id="vxAF" role="list" aria-label="Active filters"></div>

      <details class="vx-fgroup" open>
        <summary>
          Availability
          <svg class="vx-chevron" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/></svg>
        </summary>
        <div class="vx-fgroup__body">
          <label class="vx-fopt">
            <input class="vx-checkbox" type="checkbox" name="f-av" value="in-stock">
            <span class="vx-fopt__lbl">In Stock</span>
            <span class="vx-fopt__cnt" id="cntStock">–</span>
          </label>
          <label class="vx-fopt">
            <input class="vx-checkbox" type="checkbox" name="f-av" value="sale">
            <span class="vx-fopt__lbl">On Sale</span>
            <span class="vx-fopt__cnt" id="cntSale">–</span>
          </label>
          <label class="vx-fopt">
            <input class="vx-checkbox" type="checkbox" name="f-av" value="new">
            <span class="vx-fopt__lbl">New Arrivals</span>
            <span class="vx-fopt__cnt" id="cntNew">–</span>
          </label>
        </div>
      </details>

      {%- assign types = collection.products | map: 'type' | compact | uniq | sort -%}
      {%- if types.size > 0 and types.first != blank -%}
      <details class="vx-fgroup" open>
        <summary>
          Category
          <svg class="vx-chevron" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/></svg>
        </summary>
        <div class="vx-fgroup__body">
          {%- for t in types -%}
          {%- if t != blank -%}
          <label class="vx-fopt">
            <input class="vx-checkbox" type="checkbox" name="f-type" value="{{ t | handleize }}">
            <span class="vx-fopt__lbl">{{ t }}</span>
          </label>
          {%- endif -%}
          {%- endfor -%}
        </div>
      </details>
      {%- endif -%}

      {% if section.settings.enable_price_filter %}
      {%- liquid
        assign max_p = 0
        for p in collection.products
          if p.price > max_p
            assign max_p = p.price
          endif
        endfor
        assign max_p_dec = max_p | divided_by: 100
      -%}
      <details class="vx-fgroup" open>
        <summary>
          Price
          <svg class="vx-chevron" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/></svg>
        </summary>
        <div class="vx-fgroup__body">
          <div class="vx-price-row">
            <span id="vxPMin">Rs. 0</span>
            <span id="vxPMax">Rs. {{ max_p_dec }}</span>
          </div>
          <div class="vx-range-wrap">
            <div class="vx-range-fill" id="vxRangeFill"></div>
            <input type="range" id="vxRMin" min="0" max="{{ max_p_dec }}" value="0" step="100" aria-label="Minimum price">
            <input type="range" id="vxRMax" min="0" max="{{ max_p_dec }}" value="{{ max_p_dec }}" step="100" aria-label="Maximum price">
          </div>
        </div>
      </details>
      {% endif %}

    </aside>

    <!-- MAIN -->
    <div class="vx-main">

      <div class="vx-toolbar" id="vxToolbar" role="toolbar" aria-label="Collection controls">
        <div class="vx-toolbar__l">
          <button class="vx-filter-btn" id="vxFilterBtn" aria-expanded="false" aria-controls="vxSidebar">
            <svg width="13" height="13" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M10.5 6h9.75M10.5 6a1.5 1.5 0 11-3 0m3 0a1.5 1.5 0 10-3 0M3.75 6H7.5m3 12h9.75m-9.75 0a1.5 1.5 0 01-3 0m3 0a1.5 1.5 0 00-3 0m-3.75 0H7.5m9-6h3.75m-3.75 0a1.5 1.5 0 01-3 0m3 0a1.5 1.5 0 00-3 0m-9.75 0h9.75"/></svg>
            Filter
            <span class="vx-filter-badge" id="vxFilterBadge" aria-hidden="true">0</span>
          </button>
          <p class="vx-result">
            <strong id="vxVisCount">{{ collection.products_count }}</strong> items
          </p>
        </div>
        <div class="vx-toolbar__r">
          <div class="vx-views" role="group" aria-label="Grid layout">
            <button class="vx-vbtn is-active" data-cols="3" aria-pressed="true" aria-label="3 column layout">
              <svg fill="currentColor" viewBox="0 0 12 12"><rect x="0" y="0" width="3" height="3" rx=".4"/><rect x="4.5" y="0" width="3" height="3" rx=".4"/><rect x="9" y="0" width="3" height="3" rx=".4"/><rect x="0" y="4.5" width="3" height="3" rx=".4"/><rect x="4.5" y="4.5" width="3" height="3" rx=".4"/><rect x="9" y="4.5" width="3" height="3" rx=".4"/><rect x="0" y="9" width="3" height="3" rx=".4"/><rect x="4.5" y="9" width="3" height="3" rx=".4"/><rect x="9" y="9" width="3" height="3" rx=".4"/></svg>
            </button>
            <button class="vx-vbtn" data-cols="2" aria-pressed="false" aria-label="2 column layout">
              <svg fill="currentColor" viewBox="0 0 12 12"><rect x="0" y="0" width="5" height="5" rx=".4"/><rect x="7" y="0" width="5" height="5" rx=".4"/><rect x="0" y="7" width="5" height="5" rx=".4"/><rect x="7" y="7" width="5" height="5" rx=".4"/></svg>
            </button>
          </div>
          {% if section.settings.enable_sorting %}
          <label for="vxSort" class="vx-sr">Sort products</label>
          <select class="vx-sort" id="vxSort" aria-label="Sort products">
            <option value="" {% if sort_by == '' %}selected{% endif %}>Featured</option>
            <option value="best-selling" {% if sort_by == 'best-selling' %}selected{% endif %}>Best Selling</option>
            <option value="created-descending" {% if sort_by == 'created-descending' %}selected{% endif %}>Newest</option>
            <option value="price-ascending" {% if sort_by == 'price-ascending' %}selected{% endif %}>Price: Low–High</option>
            <option value="price-descending" {% if sort_by == 'price-descending' %}selected{% endif %}>Price: High–Low</option>
            <option value="title-ascending" {% if sort_by == 'title-ascending' %}selected{% endif %}>A–Z</option>
          </select>
          {% endif %}
        </div>
      </div>

      <!-- Product Grid -->
      <ul class="vx-grid" id="vxGrid" data-cols="{{ grid_cols }}" role="list" aria-label="Products">
        {%- for product in collection.products -%}
          {%- liquid
            assign on_sale = false
            assign disc = 0
            assign is_new = false
            assign low_stock = false
            assign low_qty = 0
            assign is_restock = false
            assign fv = product.selected_or_first_available_variant
            assign multi = false

            if product.compare_at_price > product.price
              assign on_sale = true
              assign disc = product.compare_at_price | minus: product.price | times: 100 | divided_by: product.compare_at_price | round
            endif

            assign now_ts     = 'now' | date: '%s' | plus: 0
            assign created_ts = product.created_at | date: '%s' | plus: 0
            assign age_days   = now_ts | minus: created_ts | divided_by: 86400

            if age_days <= 30
              assign is_new = true
            endif
            if age_days >= 3 and age_days <= 10 and product.available
              assign is_restock = true
            endif

            if fv.inventory_management == 'shopify' and fv.inventory_quantity > 0 and fv.inventory_quantity <= 5
              assign low_stock = true
              assign low_qty = fv.inventory_quantity
            endif

            if product.variants.size > 1
              assign multi = true
            endif

            assign stock_pct = 100
            if low_stock
              assign stock_pct = low_qty | times: 20
            endif
          -%}

          <li
            class="vx-card"
            style="--vy-i: {{ forloop.index0 }}; --stock-pct: {{ stock_pct }}%;"
            role="listitem"
            data-pid="{{ product.id }}"
            data-handle="{{ product.handle }}"
            data-avail="{{ product.available }}"
            data-sale="{{ on_sale }}"
            data-new="{{ is_new }}"
            data-type="{{ product.type | handleize }}"
            data-price="{{ product.price }}"
            data-title="{{ product.title | escape }}"
            data-variant="{{ fv.id }}"
          >
            <div class="vx-card__media">
              <div class="vx-badges" aria-label="Product status">
                {%- unless product.available -%}
                  <span class="vx-badge vx-badge--out" role="img" aria-label="Sold Out">Sold Out</span>
                {%- else -%}
                  {%- if on_sale -%}
                    <span class="vx-badge vx-badge--sale" role="img" aria-label="{{ disc }}% off">−{{ disc }}%</span>
                  {%- endif -%}
                  {%- if is_restock -%}
                    <span class="vx-badge vx-badge--back" role="img" aria-label="Restocked">Restocked</span>
                  {%- elsif is_new -%}
                    <span class="vx-badge vx-badge--new" role="img" aria-label="New arrival">New</span>
                  {%- endif -%}
                  {%- if low_stock -%}
                    <span class="vx-badge vx-badge--low" role="img" aria-label="{{ low_qty }} remaining">{{ low_qty }} left</span>
                  {%- endif -%}
                {%- endunless -%}
              </div>

              {%- if product.featured_image -%}
                <img
                  src="{{ product.featured_image | image_url: width: 600 }}"
                  srcset="{{ product.featured_image | image_url: width: 400 }} 400w,
                          {{ product.featured_image | image_url: width: 700 }} 700w,
                          {{ product.featured_image | image_url: width: 1000 }} 1000w"
                  sizes="(max-width: 480px) calc(50vw - 14px),
                         (max-width: 860px) calc(50vw - 36px),
                         calc((100vw - var(--sidebar) - var(--gutter) * 2) / {{ grid_cols }} - 28px)"
                  alt="{{ product.featured_image.alt | default: product.title | escape }}"
                  class="vx-card__img"
                  loading="lazy" decoding="async"
                  width="{{ product.featured_image.width }}"
                  height="{{ product.featured_image.height }}"
                >
              {%- endif -%}

              {%- if product.images[1] -%}
                <img
                  src="{{ product.images[1] | image_url: width: 600 }}"
                  alt="{{ product.images[1].alt | default: product.title | escape }}"
                  class="vx-card__img2"
                  loading="lazy" decoding="async"
                  width="{{ product.images[1].width }}"
                  height="{{ product.images[1].height }}"
                >
              {%- endif -%}

              <div class="vx-card__over" aria-hidden="true">
                <div class="vx-card__actions">
                  {%- if multi -%}
                    <button class="vx-card__atc js-open-vp" data-pid="{{ product.id }}">Select Options</button>
                  {%- elsif product.available -%}
                    <button class="vx-card__atc js-atc" data-vid="{{ fv.id }}" data-title="{{ product.title | escape }}" data-pid="{{ product.id }}">Add to Cart</button>
                  {%- else -%}
                    <button class="vx-card__atc" disabled aria-disabled="true">Sold Out</button>
                  {%- endif -%}
                  <button class="vx-card__wish js-wish" data-pid="{{ product.id }}" aria-label="Save {{ product.title | escape }}" aria-pressed="false">
                    <svg fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M21 8.25c0-2.485-2.099-4.5-4.688-4.5-1.935 0-3.597 1.126-4.312 2.733-.715-1.607-2.377-2.733-4.313-2.733C5.1 3.75 3 5.765 3 8.25c0 7.22 9 12 9 12s9-4.78 9-12z"/></svg>
                  </button>
                </div>
              </div>

              {%- if multi -%}
              <div class="vx-vpanel" id="vp-{{ product.id }}" role="region" aria-label="Select variant for {{ product.title | escape }}">
                <p class="vx-vpanel__label">Select — <span id="vpSel-{{ product.id }}">{{ product.variants.first.title }}</span></p>
                <div class="vx-vchips" role="group" aria-label="Variants">
                  {%- for v in product.variants -%}
                    <button
                      class="vx-vchip{% unless v.available %} is-out{% endunless %}{% if forloop.first %} is-sel{% endif %}"
                      data-vid="{{ v.id }}" data-pid="{{ product.id }}"
                      {% unless v.available %}disabled aria-disabled="true"{% endunless %}
                      aria-pressed="{% if forloop.first %}true{% else %}false{% endif %}"
                    >{{ v.title }}</button>
                  {%- endfor -%}
                </div>
                <button
                  class="vx-card__btn js-atc"
                  style="margin-top: 0;"
                  data-vid="{{ product.variants.first.id }}"
                  data-title="{{ product.title | escape }}"
                  data-vpanel="{{ product.id }}"
                ><span>Add to Cart</span></button>
              </div>
              {%- endif -%}
            </div>

            <div class="vx-card__info">
              {%- if section.settings.show_vendor and product.vendor != blank -%}
                <p class="vx-card__brand">{{ product.vendor }}</p>
              {%- endif -%}
              <h3 class="vx-card__name">
                <a href="{{ product.url }}" tabindex="-1" aria-hidden="true">{{ product.title }}</a>
              </h3>
              {%- if low_stock -%}
              <div class="vx-stock">
                <span class="vx-stock__label">Only {{ low_qty }} remaining</span>
                <div class="vx-stock__track" role="progressbar" aria-valuenow="{{ stock_pct | remove: '%' }}" aria-valuemin="0" aria-valuemax="100">
                  <div class="vx-stock__fill"></div>
                </div>
              </div>
              {%- endif -%}

              {%- assign col_opt = nil -%}
              {%- for opt in product.options_with_values -%}
                {%- assign on_lower = opt.name | downcase -%}
                {%- if on_lower == 'color' or on_lower == 'colour' -%}
                  {%- assign col_opt = opt -%}{%- break -%}
                {%- endif -%}
              {%- endfor -%}

              {%- if col_opt and col_opt.values.size > 0 -%}
              <div class="vx-swatches" aria-label="Available colours: {{ col_opt.values | join: ', ' }}">
                {%- for cv in col_opt.values limit: 6 -%}
                  {%- comment -%}FIX: data-color resolved in JS via lookup table. Avoids silent failures for non-CSS color names like "Dusty Rose" or "Midnight".{%- endcomment -%}
                  <span
                    class="vx-swatch{% if forloop.first %} is-sel{% endif %}"
                    data-color="{{ cv | downcase | strip }}"
                    title="{{ cv }}"
                    role="img"
                    aria-label="{{ cv }}"
                  ></span>
                {%- endfor -%}
                {%- if col_opt.values.size > 6 -%}
                  <span class="vx-swatch-more">+{{ col_opt.values.size | minus: 6 }} more</span>
                {%- endif -%}
              </div>
              {%- endif -%}

              <div class="vx-card__price">
                <span class="vx-price">{{ product.price | money }}</span>
                {%- if on_sale -%}
                  <span class="vx-price-was" aria-label="Was {{ product.compare_at_price | money }}">{{ product.compare_at_price | money }}</span>
                  <span class="vx-price-save" aria-label="{{ disc }} percent off">−{{ disc }}%</span>
                {%- endif -%}
              </div>

              {%- if multi -%}
                <button class="vx-card__btn js-open-vp" data-pid="{{ product.id }}"><span>Select Options</span></button>
              {%- elsif product.available -%}
                <button
                  class="vx-card__btn js-atc"
                  data-vid="{{ fv.id }}"
                  data-title="{{ product.title | escape }}"
                  data-pid="{{ product.id }}"
                  aria-label="Add {{ product.title | escape }} to cart"
                ><span>Add to Cart</span></button>
              {%- else -%}
                <button class="vx-card__btn" disabled aria-disabled="true"><span>Sold Out</span></button>
              {%- endif -%}
            </div>

          </li>

        {%- else -%}
          <div class="vx-empty">
            <div class="vx-empty__glyph" aria-hidden="true">◇</div>
            <h2 class="vx-empty__title">Nothing found</h2>
            <p class="vx-empty__desc">Try adjusting your filters or browse all collections.</p>
            <a href="{{ routes.collections_url }}" class="vx-empty__cta">Browse All</a>
          </div>
        {%- endfor -%}
      </ul>

      {%- if paginate.pages > 1 -%}
      <nav class="vx-pagination" aria-label="Collection pages">
        {%- if paginate.previous -%}
          <a href="{{ paginate.previous.url }}" class="vx-page" aria-label="Previous page" rel="prev">
            <svg width="13" height="13" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M15.75 19.5L8.25 12l7.5-7.5"/></svg>
          </a>
        {%- else -%}
          <span class="vx-page is-dis" aria-hidden="true">
            <svg width="13" height="13" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M15.75 19.5L8.25 12l7.5-7.5"/></svg>
          </span>
        {%- endif -%}
        {%- for part in paginate.parts -%}
          {%- if part.is_link -%}
            <a href="{{ part.url }}" class="vx-page" aria-label="Page {{ part.title }}">{{ part.title }}</a>
          {%- elsif part.title == paginate.current_page -%}
            <span class="vx-page is-cur" aria-current="page" aria-label="Page {{ part.title }}, current">{{ part.title }}</span>
          {%- else -%}
            <span class="vx-page" aria-hidden="true">{{ part.title }}</span>
          {%- endif -%}
        {%- endfor -%}
        {%- if paginate.next -%}
          <a href="{{ paginate.next.url }}" class="vx-page" aria-label="Next page" rel="next">
            <svg width="13" height="13" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M8.25 4.5l7.5 7.5-7.5 7.5"/></svg>
          </a>
        {%- else -%}
          <span class="vx-page is-dis" aria-hidden="true">
            <svg width="13" height="13" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M8.25 4.5l7.5 7.5-7.5 7.5"/></svg>
          </span>
        {%- endif -%}
      </nav>
      {%- endif -%}
    </div>
  </div>

  {%- if section.settings.show_stats -%}
  <section class="vx-stats" id="vxStats" aria-label="Store highlights">
    <div class="vx-stats__grid">
      <div class="vx-stat"><div class="vx-stat__num">{{ section.settings.stat1n | default: '50K+' }}</div><div class="vx-stat__lbl">{{ section.settings.stat1l | default: 'Happy Customers' }}</div></div>
      <div class="vx-stat"><div class="vx-stat__num">{{ section.settings.stat2n | default: '4.9' }}</div><div class="vx-stat__lbl">{{ section.settings.stat2l | default: 'Average Rating' }}</div></div>
      <div class="vx-stat"><div class="vx-stat__num">{{ section.settings.stat3n | default: '100%' }}</div><div class="vx-stat__lbl">{{ section.settings.stat3l | default: 'Authentic' }}</div></div>
      <div class="vx-stat"><div class="vx-stat__num">{{ section.settings.stat4n | default: '24/7' }}</div><div class="vx-stat__lbl">{{ section.settings.stat4l | default: 'Support' }}</div></div>
    </div>
  </section>
  {%- endif -%}

</div><!-- /vx-scope -->

<!-- Sticky ATC Bar -->
<div class="vx-sticky" id="vxSticky" role="region" aria-label="Quick add to cart" aria-hidden="true">
  <div class="vx-sticky__info">
    <div class="vx-sticky__name" id="vxStickyName">–</div>
    <div class="vx-sticky__price" id="vxStickyPrice">–</div>
    <div class="vx-sticky__shipping">Free delivery included</div>
  </div>
  <div class="vx-sticky__right">
    <div class="vx-sticky-chips" id="vxStickyChips" aria-label="Select a variant"></div>
    <button class="vx-sticky-atc" id="vxStickyAtc" disabled aria-label="Add selected item to cart">Add to Cart</button>
    <button class="vx-sticky-close" id="vxStickyClose" aria-label="Dismiss bar">
      <svg width="10" height="10" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
    </button>
  </div>
</div>

{% if has_wapp %}
<a
  class="vx-wa"
  href="https://wa.me/{{ section.settings.whatsapp_number | remove: '+' | remove: ' ' | remove: '-' }}?text={{ section.settings.whatsapp_message | default: 'Hi, I need help with an order.' | url_encode }}"
  target="_blank" rel="noopener noreferrer"
  aria-label="Chat with us on WhatsApp"
>
  <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/></svg>
  <span class="vx-wa__label">Chat with us</span>
</a>
{% endif %}

<script>
(function () {
  'use strict';

  /* ─── UTILITIES ─── */
  const $ = id => document.getElementById(id);
  const $$ = (sel, ctx = document) => Array.from(ctx.querySelectorAll(sel));
  const clamp = (v, lo, hi) => Math.min(hi, Math.max(lo, v));
  const fmt = n => 'Rs. ' + Math.round(n).toLocaleString('en-PK');

  /* ─── FIX: Robust debounce with leading/trailing edge control ─── */
  const debounce = (fn, ms, immediate = false) => {
    let timer;
    return function (...args) {
      const callNow = immediate && !timer;
      clearTimeout(timer);
      timer = setTimeout(() => {
        timer = null;
        if (!immediate) fn.apply(this, args);
      }, ms);
      if (callNow) fn.apply(this, args);
    };
  };

  /* ─── STATE ─── */
  const S = {
    wishlist: new Set(),
    filters: { av: [], type: [], pMin: 0, pMax: Infinity },
    activeCount: 0,
    sticky: { product: null, vid: null, dismissed: false },
    cd: { h: -1, m: -1, s: -1 },
    /* FIX: AbortController for in-flight cart requests */
    cartController: null,
  };

  /* ─── FIX: Color lookup table.
            Shopify color option values are free-form text and do not
            reliably map to CSS color keywords. This table covers the
            most common fashion color names. Unknown colors fall back
            to a tasteful neutral rather than silently rendering wrong. ─── */
  const COLOR_MAP = {
    'white': '#ffffff', 'black': '#0a0a0a', 'ivory': '#fffff0',
    'cream': '#fffdd0', 'off white': '#faf9f6', 'beige': '#f5f0e8',
    'nude': '#e8ceb0', 'blush': '#ffb6c1', 'pink': '#ffc0cb',
    'hot pink': '#ff69b4', 'rose': '#ff007f', 'red': '#cc2222',
    'burgundy': '#800020', 'maroon': '#6e0000', 'coral': '#ff6b6b',
    'orange': '#ff7700', 'peach': '#ffcba4', 'gold': '#c8a84b',
    'yellow': '#ffd700', 'mustard': '#e3a527', 'olive': '#6b7c26',
    'green': '#2e7d32', 'sage': '#bcb88a', 'mint': '#98ff98',
    'teal': '#008080', 'cyan': '#00bcd4', 'sky blue': '#87ceeb',
    'light blue': '#add8e6', 'blue': '#1565c0', 'navy': '#001f5b',
    'cobalt': '#0047ab', 'royal blue': '#4169e1', 'indigo': '#3f51b5',
    'purple': '#7b1fa2', 'lavender': '#e6e0f8', 'lilac': '#c8a2c8',
    'violet': '#7f00ff', 'plum': '#8e4585', 'mauve': '#e0b0ff',
    'grey': '#9e9e9e', 'gray': '#9e9e9e', 'light grey': '#d3d3d3',
    'charcoal': '#36454f', 'silver': '#c0c0c0', 'taupe': '#8b8680',
    'brown': '#795548', 'tan': '#d2b48c', 'camel': '#c19a6b',
    'chocolate': '#7b3f00', 'rust': '#b7410e', 'dusty rose': '#dcae96',
    'blush pink': '#f4c2c2', 'dusty pink': '#d8a0a0', 'midnight': '#191970',
    'emerald': '#50c878', 'forest green': '#228b22', 'copper': '#b87333',
    'bronze': '#cd7f32', 'champagne': '#f7e7ce', 'ecru': '#c2b280',
    'off-white': '#faf9f6', 'multi': 'linear-gradient(135deg, #ff6b6b, #ffd700, #4caf50, #1565c0)',
    'multicolor': 'linear-gradient(135deg, #ff6b6b, #ffd700, #4caf50, #1565c0)',
  };

  const resolveColor = name => {
    const key = (name || '').toLowerCase().trim();
    const val = COLOR_MAP[key];
    if (val) return val;
    /* Try CSS color name as fallback (works for standard names) */
    const el = document.createElement('div');
    el.style.color = key;
    document.body.appendChild(el);
    const computed = getComputedStyle(el).color;
    document.body.removeChild(el);
    /* If it resolved to something other than the default, use it */
    if (computed && computed !== 'rgb(0, 0, 0)' && computed !== '') return key;
    /* Final fallback: elegant neutral */
    return '#d4d0c8';
  };

  /* Apply color map to all swatches on the page */
  const initSwatches = () => {
    $$('.vx-swatch[data-color]').forEach(el => {
      const resolved = resolveColor(el.dataset.color);
      el.style.background = resolved;
    });
  };

  /* ══════════════════════════════════════════
     MODULE: TOAST
  ══════════════════════════════════════════ */
  const Toast = {
    show(title, msg, type = 'ok') {
      const wrap = $('vxToasts'); if (!wrap) return;
      const okIcon  = `<svg class="vx-toast__icon" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>`;
      const errIcon = `<svg class="vx-toast__icon" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3.75m9-.75a9 9 0 11-18 0 9 9 0 0118 0zm-9 3.75h.008v.008H12v-.008z"/></svg>`;
      const el = document.createElement('div');
      el.className = `vx-toast is-${type}`;
      el.setAttribute('role', 'alert');
      el.innerHTML = `${type === 'ok' ? okIcon : errIcon}<div><div class="vx-toast__title">${title}</div><div class="vx-toast__msg">${msg}</div></div>`;
      wrap.appendChild(el);
      /* FIX: Use animationend instead of setTimeout for cleanup timing */
      const dismiss = () => {
        el.style.cssText = 'transition:opacity .28s ease,transform .28s ease;opacity:0;transform:translateX(110%)';
        el.addEventListener('transitionend', () => el.remove(), { once: true });
      };
      const timer = setTimeout(dismiss, 3800);
      el.addEventListener('click', () => { clearTimeout(timer); dismiss(); });
    }
  };

  /* ══════════════════════════════════════════
     MODULE: CART
  ══════════════════════════════════════════ */
  const Cart = {
    async add(variantId, btn, title) {
      if (!variantId) { Toast.show('Choose an option', 'Please select a variant first', 'err'); return; }

      /* FIX: Cancel any in-flight cart request before starting a new one */
      if (S.cartController) S.cartController.abort();
      S.cartController = new AbortController();

      const orig = btn.innerHTML;
      btn.classList.add('is-loading');
      btn.disabled = true;
      try {
        const res = await fetch('/cart/add.js', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ items: [{ id: Number(variantId), quantity: 1 }] }),
          signal: S.cartController.signal,
        });
        if (!res.ok) {
          const e = await res.json().catch(() => ({}));
          throw new Error(e.description || 'Could not add item');
        }
        S.cartController = null;
        btn.classList.remove('is-loading');
        btn.innerHTML = orig.includes('<span>') ? orig.replace(/>.*?<\/span>/, '>Added ✓</span>') : 'Added ✓';
        Toast.show('Added to your bag', `${title} — complimentary delivery included`);
        await Cart.updateBubble();
        document.dispatchEvent(new CustomEvent('cart:add', { detail: { variantId } }));
        if (window.theme?.openCartDrawer) window.theme.openCartDrawer();
        /* FIX: Reset button text on animationend rather than arbitrary timeout */
        setTimeout(() => { btn.innerHTML = orig; btn.disabled = false; }, 2400);
      } catch (err) {
        if (err.name === 'AbortError') return; /* Silently ignore cancelled requests */
        S.cartController = null;
        btn.classList.remove('is-loading');
        btn.innerHTML = orig;
        btn.disabled = false;
        Toast.show('Unable to add', err.message || 'Please try again', 'err');
      }
    },
    async updateBubble() {
      try {
        const r = await fetch('/cart.js');
        const c = await r.json();
        $$('[data-cart-count]').forEach(el => { el.textContent = c.item_count; });
        document.dispatchEvent(new CustomEvent('cart:updated', { detail: { cart: c } }));
      } catch (_) {}
    }
  };

  /* ══════════════════════════════════════════
     MODULE: WISHLIST
  ══════════════════════════════════════════ */
  const Wishlist = {
    load() {
      try { const r = localStorage.getItem('vx_wl_v3'); if (r) S.wishlist = new Set(JSON.parse(r)); } catch (_) {}
    },
    save() { try { localStorage.setItem('vx_wl_v3', JSON.stringify([...S.wishlist])); } catch (_) {} },
    sync() {
      $$('.js-wish').forEach(btn => {
        const active = S.wishlist.has(btn.dataset.pid);
        btn.classList.toggle('is-active', active);
        btn.setAttribute('aria-pressed', String(active));
      });
    },
    toggle(pid) {
      const had = S.wishlist.has(pid);
      had ? S.wishlist.delete(pid) : S.wishlist.add(pid);
      Wishlist.save(); Wishlist.sync();
      Toast.show(had ? 'Removed from saved' : 'Saved', had ? 'Item removed from your list' : 'Ready for when you are');
    }
  };

  /* ══════════════════════════════════════════
     MODULE: OBSERVERS
  ══════════════════════════════════════════ */
  const Observers = {
    init() {
      const cardIO = new IntersectionObserver(entries => {
        entries.forEach(e => {
          if (!e.isIntersecting) return;
          const el = e.target;
          const idx = parseInt(el.style.getPropertyValue('--vy-i') || '0', 10);
          const delay = Math.min(idx % 8, 7) * 60;
          setTimeout(() => requestAnimationFrame(() => el.classList.add('is-revealed')), delay);
          cardIO.unobserve(el);
        });
      }, { threshold: 0.04, rootMargin: '0px 0px -40px 0px' });
      $$('.vx-card').forEach(c => cardIO.observe(c));

      const statIO = new IntersectionObserver(entries => {
        entries.forEach(e => {
          if (!e.isIntersecting) return;
          requestAnimationFrame(() => e.target.classList.add('is-visible'));
          statIO.unobserve(e.target);
        });
      }, { threshold: 0.15 });
      $$('.vx-stat').forEach(el => statIO.observe(el));
    }
  };

  /* ══════════════════════════════════════════
     MODULE: TOOLBAR (sticky behaviour)
  ══════════════════════════════════════════ */
  const Toolbar = {
    init() {
      const tb = $('vxToolbar'); if (!tb) return;
      let ticking = false;
      window.addEventListener('scroll', () => {
        if (ticking) return;
        ticking = true;
        requestAnimationFrame(() => {
          tb.classList.toggle('is-scrolled', window.scrollY > 70);
          ticking = false;
        });
      }, { passive: true });
    }
  };

  /* ══════════════════════════════════════════
     MODULE: COUNTDOWN (session-based, honest)
  ══════════════════════════════════════════ */
  const Countdown = {
    init() {
      const bar = $('vxCountdown'); if (!bar) return;
      const HOURS = {{ section.settings.countdown_hours | default: 4 }};
      const KEY = 'vx_cd_{{ section.id }}';
      let end;
      try {
        const s = sessionStorage.getItem(KEY);
        if (s) end = parseInt(s, 10);
        else { end = Date.now() + HOURS * 3_600_000; sessionStorage.setItem(KEY, String(end)); }
      } catch (_) { end = Date.now() + HOURS * 3_600_000; }

      const hEl = $('vxH'), mEl = $('vxM'), sEl = $('vxS');

      /* FIX: Toggle between data-ticking="a" and data-ticking="b" to re-trigger
              CSS animation without needing reflow hacks or setTimeout. */
      let tickState = 'a';
      const setNum = (el, v) => {
        const s = String(v).padStart(2, '0');
        if (el.textContent === s) return;
        el.textContent = s;
        tickState = tickState === 'a' ? 'b' : 'a';
        el.dataset.ticking = tickState;
      };

      const tick = () => {
        const d = end - Date.now();
        if (d <= 0) { bar.style.display = 'none'; return; }
        const h = Math.floor(d / 3_600_000);
        const m = Math.floor((d % 3_600_000) / 60_000);
        const s = Math.floor((d % 60_000) / 1_000);
        if (h !== S.cd.h) { setNum(hEl, h); S.cd.h = h; }
        if (m !== S.cd.m) { setNum(mEl, m); S.cd.m = m; }
        if (s !== S.cd.s) { setNum(sEl, s); S.cd.s = s; }
        setTimeout(tick, 1000);
      };
      tick();
    }
  };

  /* ══════════════════════════════════════════
     MODULE: NEWSLETTER MODAL
     FIX: Honest opt-in shown after genuine engagement (30s on page),
          not a fake exit-intent dark pattern. No discount code
          coercion. No fake urgency.
  ══════════════════════════════════════════ */
  const NewsletterModal = {
    init() {
      const modal = $('vxNewsletter'); if (!modal) return;
      const KEY = 'vx_nl_v11';
      try { if (localStorage.getItem(KEY)) return; } catch (_) {}
      let shown = false;

      const show = () => {
        if (shown) return;
        shown = true;
        modal.classList.add('is-open');
        modal.setAttribute('aria-hidden', 'false');
        /* Move focus inside for accessibility */
        requestAnimationFrame(() => $('vxNewsletterEmail')?.focus());
      };
      const hide = () => {
        modal.classList.remove('is-open');
        modal.setAttribute('aria-hidden', 'true');
        try { localStorage.setItem(KEY, '1'); } catch (_) {}
      };

      /* Show only after genuine time on page, not on exit */
      setTimeout(show, 30_000);

      $('vxNewsletterClose')?.addEventListener('click', hide);
      $('vxNewsletterSkip')?.addEventListener('click', hide);
      modal.addEventListener('click', e => { if (e.target === modal) hide(); });

      $('vxNewsletterSubmit')?.addEventListener('click', async () => {
        const email = $('vxNewsletterEmail')?.value?.trim();
        if (!email || !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) {
          Toast.show('Invalid email', 'Please enter a valid address', 'err');
          return;
        }
        /* Integrate with Shopify customer list or Klaviyo etc */
        Toast.show('You\'re in', 'Thank you — first access to new arrivals incoming');
        hide();
      });

      document.addEventListener('keydown', e => {
        if (e.key === 'Escape' && modal.classList.contains('is-open')) hide();
      });
    }
  };

  /* ══════════════════════════════════════════
     MODULE: SIDEBAR — with proper focus trap
  ══════════════════════════════════════════ */
  const Sidebar = {
    focusableSelectors: 'button:not([disabled]),input:not([disabled]),select:not([disabled]),a[href],[tabindex]:not([tabindex="-1"])',
    trap: null,

    open() {
      const sb = $('vxSidebar'); if (!sb) return;
      sb.classList.add('is-open');
      $('vxOverlay')?.classList.add('is-open');
      document.body.style.overflow = 'hidden';
      $('vxFilterBtn')?.setAttribute('aria-expanded', 'true');
      sb.removeAttribute('aria-hidden');
      requestAnimationFrame(() => $('vxSidebarClose')?.focus());
      /* FIX: Install focus trap */
      this.trap = e => this._trapFocus(e, sb);
      document.addEventListener('keydown', this.trap);
    },

    close() {
      const sb = $('vxSidebar'); if (!sb) return;
      sb.classList.remove('is-open');
      $('vxOverlay')?.classList.remove('is-open');
      document.body.style.overflow = '';
      $('vxFilterBtn')?.setAttribute('aria-expanded', 'false');
      sb.setAttribute('aria-hidden', 'true');
      $('vxFilterBtn')?.focus();
      if (this.trap) { document.removeEventListener('keydown', this.trap); this.trap = null; }
    },

    /* FIX: Actual focus trap — cycles focus within the sidebar only */
    _trapFocus(e, container) {
      if (e.key !== 'Tab') return;
      const focusable = $$(this.focusableSelectors, container).filter(el => !el.closest('[hidden]'));
      if (!focusable.length) return;
      const first = focusable[0], last = focusable[focusable.length - 1];
      if (e.shiftKey) {
        if (document.activeElement === first) { e.preventDefault(); last.focus(); }
      } else {
        if (document.activeElement === last) { e.preventDefault(); first.focus(); }
      }
    }
  };

  /* ══════════════════════════════════════════
     MODULE: STICKY BAR
  ══════════════════════════════════════════ */
  const StickyBar = {
    init() {
      const bar = $('vxSticky'); if (!bar) return;
      const cards = $$('.vx-card');
      if (!cards.length) return;

      const io = new IntersectionObserver(([e]) => {
        if (!S.sticky.dismissed) {
          const visible = !e.isIntersecting;
          bar.classList.toggle('is-visible', visible);
          bar.setAttribute('aria-hidden', String(!visible));
        }
      }, { threshold: 0 });
      io.observe(cards[0]);

      const loadCard = card => {
        const title = card.dataset.title || '';
        const price = fmt(parseInt(card.dataset.price || '0', 10) / 100);
        const nameEl = $('vxStickyName'), priceEl = $('vxStickyPrice');
        if (nameEl && nameEl.textContent !== title) {
          [nameEl, priceEl].forEach(el => {
            el.style.cssText = 'opacity:0;transition:opacity .15s ease';
          });
          requestAnimationFrame(() => setTimeout(() => {
            if (nameEl) { nameEl.textContent = title; nameEl.style.opacity = '1'; }
            if (priceEl) { priceEl.textContent = price; priceEl.style.opacity = '1'; }
          }, 80));
        }
        const pid = card.dataset.pid;
        const panel = document.getElementById(`vp-${pid}`);
        const chips = $('vxStickyChips');
        if (!chips) return;
        chips.innerHTML = '';
        const sAtc = $('vxStickyAtc');
        if (panel) {
          $$('.vx-vchip', panel).forEach(c => {
            const b = document.createElement('button');
            const isOut = c.classList.contains('is-out');
            const isSel = c.classList.contains('is-sel');
            b.className = 'vx-sticky-chip' + (isOut ? ' is-out' : '') + (isSel ? ' is-sel' : '');
            b.textContent = c.textContent.trim();
            b.dataset.vid = c.dataset.vid;
            if (c.disabled) b.disabled = true;
            b.addEventListener('click', () => {
              $$('.vx-sticky-chip', chips).forEach(x => x.classList.remove('is-sel'));
              b.classList.add('is-sel');
              if (sAtc) { sAtc.dataset.vid = b.dataset.vid; sAtc.disabled = false; }
            });
            chips.appendChild(b);
          });
          const first = chips.querySelector('.vx-sticky-chip.is-sel');
          if (first && sAtc) { sAtc.dataset.vid = first.dataset.vid; sAtc.disabled = false; }
        } else {
          if (sAtc) { sAtc.dataset.vid = card.dataset.variant; sAtc.disabled = card.dataset.avail !== 'true'; }
        }
        S.sticky.product = { title };
      };

      loadCard(cards[0]);
      cards.forEach(c => {
        c.addEventListener('mouseenter', () => { if (bar.classList.contains('is-visible')) loadCard(c); });
        c.addEventListener('focusin',    () => { if (bar.classList.contains('is-visible')) loadCard(c); });
      });

      $('vxStickyAtc')?.addEventListener('click', function () {
        Cart.add(this.dataset.vid, this, S.sticky.product?.title || 'Product');
      });
      $('vxStickyClose')?.addEventListener('click', () => {
        bar.classList.remove('is-visible');
        bar.setAttribute('aria-hidden', 'true');
        S.sticky.dismissed = true;
        io.disconnect();
      });
    }
  };

  /* ══════════════════════════════════════════
     MODULE: FILTERS
     FIX: All filter/price ops are debounced.
          Hiding/showing uses animationend for
          deterministic timing instead of arbitrary ms.
  ══════════════════════════════════════════ */
  const Filters = {
    /* FIX: Debounce the apply function so rapid filter changes
            don't cause multiple layout thrash cycles */
    applyDebounced: null,

    init() {
      this.applyDebounced = debounce(() => this._apply(), 80);
    },

    apply() { this.applyDebounced(); },

    _apply() {
      const cards = $$('.vx-card');
      let vis = 0;
      cards.forEach(card => {
        const avail = card.dataset.avail === 'true';
        const sale  = card.dataset.sale  === 'true';
        const isNew = card.dataset.new   === 'true';
        const type  = card.dataset.type  || '';
        const price = parseInt(card.dataset.price || '0', 10) / 100;
        let show = true;

        if (S.filters.av.length) {
          show = S.filters.av.some(f =>
            f === 'in-stock' ? avail : f === 'sale' ? sale : f === 'new' ? isNew : false
          );
        }
        if (show && S.filters.type.length && !S.filters.type.includes(type)) show = false;
        if (show && (price < S.filters.pMin || price > S.filters.pMax)) show = false;

        if (show) {
          vis++;
          if (card.style.display === 'none') {
            card.style.display = '';
            card.classList.remove('is-hiding');
            card.classList.add('is-showing');
            /* FIX: Use animationend, not arbitrary setTimeout */
            card.addEventListener('animationend', () => card.classList.remove('is-showing'), { once: true });
          }
        } else {
          if (card.style.display !== 'none') {
            card.classList.add('is-hiding');
            /* FIX: Use animationend to hide after animation completes */
            card.addEventListener('animationend', () => {
              card.style.display = 'none';
              card.classList.remove('is-hiding');
            }, { once: true });
          }
        }
      });

      this._animateCount(vis);
      this._updateBadge();
      this._renderPills();
      this.calcCounts();
    },

    _animateCount(target) {
      const el = $('vxVisCount'); if (!el) return;
      const from = parseInt(el.textContent, 10) || target;
      const dur = 360, start = performance.now();
      const step = now => {
        const p = Math.min((now - start) / dur, 1);
        const ease = 1 - Math.pow(1 - p, 3);
        el.textContent = Math.round(from + (target - from) * ease);
        if (p < 1) requestAnimationFrame(step); else el.textContent = target;
      };
      requestAnimationFrame(step);
    },

    _updateBadge() {
      S.activeCount = S.filters.av.length + S.filters.type.length;
      const b = $('vxFilterBadge');
      if (b) { b.textContent = S.activeCount; b.classList.toggle('show', S.activeCount > 0); }
    },

    _renderPills() {
      const wrap = $('vxAF'); if (!wrap) return;
      const all = [...S.filters.av, ...S.filters.type];
      wrap.innerHTML = '';
      if (!all.length) return;
      const frag = document.createDocumentFragment();
      all.forEach(f => {
        const tag = document.createElement('div');
        tag.className = 'vx-af-tag'; tag.setAttribute('role', 'listitem');
        tag.innerHTML = `${f.replace(/-/g,' ')}<button class="vx-af-remove" aria-label="Remove ${f} filter">×</button>`;
        tag.querySelector('button').addEventListener('click', () => this.remove(f));
        frag.appendChild(tag);
      });
      if (all.length > 1) {
        const ca = document.createElement('button');
        ca.className = 'vx-clear-all'; ca.textContent = 'Clear all';
        ca.addEventListener('click', () => this.clear());
        frag.appendChild(ca);
      }
      wrap.appendChild(frag);
    },

    remove(val) {
      S.filters.av   = S.filters.av.filter(v => v !== val);
      S.filters.type = S.filters.type.filter(v => v !== val);
      $$(`input[value="${CSS.escape(val)}"]`).forEach(cb => { cb.checked = false; });
      this.apply();
    },

    clear() {
      S.filters = { av: [], type: [], pMin: 0, pMax: Infinity };
      $$('.vx-sidebar .vx-checkbox').forEach(cb => { cb.checked = false; });
      const mn = $('vxRMin'), mx = $('vxRMax');
      if (mn) mn.value = mn.min;
      if (mx) mx.value = mx.max;
      PriceRange.update();
      this.apply();
    },

    calcCounts() {
      const cards = $$('.vx-card');
      let stock = 0, sale = 0, nw = 0;
      cards.forEach(c => {
        if (c.dataset.avail === 'true') stock++;
        if (c.dataset.sale  === 'true') sale++;
        if (c.dataset.new   === 'true') nw++;
      });
      const cs = $('cntStock'), csa = $('cntSale'), cn = $('cntNew');
      if (cs) cs.textContent = stock;
      if (csa) csa.textContent = sale;
      if (cn) cn.textContent = nw;
    }
  };

  /* ══════════════════════════════════════════
     MODULE: PRICE RANGE
     FIX: Debounced. No RAF re-queuing on rapid input.
  ══════════════════════════════════════════ */
  const PriceRange = {
    mn: null, mx: null, fill: null, lMin: null, lMax: null, top: 0,
    _updateDebounced: null,
    init() {
      this.mn = $('vxRMin'); this.mx = $('vxRMax');
      this.fill = $('vxRangeFill');
      this.lMin = $('vxPMin'); this.lMax = $('vxPMax');
      if (!this.mn || !this.mx) return;
      this.top = parseInt(this.mn.max, 10);
      /* FIX: Debounce filter apply while keeping visual feedback instant */
      this._updateDebounced = debounce(() => Filters.apply(), 120);
      this.mn.addEventListener('input', () => { this._updateVisuals(); this._updateDebounced(); }, { passive: true });
      this.mx.addEventListener('input', () => { this._updateVisuals(); this._updateDebounced(); }, { passive: true });
      this._updateVisuals();
    },
    _updateVisuals() {
      let lo = parseInt(this.mn.value, 10), hi = parseInt(this.mx.value, 10);
      if (lo > hi) { lo = hi; this.mn.value = lo; }
      if (this.fill) {
        this.fill.style.left  = (lo / this.top * 100).toFixed(1) + '%';
        this.fill.style.width = ((hi - lo) / this.top * 100).toFixed(1) + '%';
      }
      if (this.lMin) this.lMin.textContent = fmt(lo);
      if (this.lMax) this.lMax.textContent = fmt(hi);
      S.filters.pMin = lo; S.filters.pMax = hi;
    },
    update() { this._updateVisuals(); }
  };

  /* ══════════════════════════════════════════
     MODULE: VARIANT PANELS
  ══════════════════════════════════════════ */
  const VariantPanels = {
    init() {
      document.addEventListener('click', e => {
        const b = e.target.closest('.js-open-vp'); if (!b) return;
        e.preventDefault(); e.stopPropagation();
        const p = document.getElementById(`vp-${b.dataset.pid}`); if (!p) return;
        const wasOpen = p.classList.contains('is-open');
        $$('.vx-vpanel.is-open').forEach(x => x.classList.remove('is-open'));
        if (!wasOpen) p.classList.add('is-open');
      });

      document.addEventListener('click', e => {
        const c = e.target.closest('.vx-vchip[data-pid]'); if (!c) return;
        const p = document.getElementById(`vp-${c.dataset.pid}`); if (!p) return;
        $$('.vx-vchip', p).forEach(x => { x.classList.remove('is-sel'); x.setAttribute('aria-pressed', 'false'); });
        c.classList.add('is-sel'); c.setAttribute('aria-pressed', 'true');
        const lbl = document.getElementById(`vpSel-${c.dataset.pid}`);
        if (lbl) lbl.textContent = c.textContent.trim();
        const btn = p.querySelector('.js-atc[data-vpanel]');
        if (btn) btn.dataset.vid = c.dataset.vid;
      });

      document.addEventListener('click', e => {
        if (!e.target.closest('.vx-vpanel') && !e.target.closest('.js-open-vp')) {
          $$('.vx-vpanel.is-open').forEach(p => p.classList.remove('is-open'));
        }
      });
    }
  };

  /* ══════════════════════════════════════════
     MODULE: GRID VIEW
     FIX: Use ResizeObserver to recalculate when
          container resizes, not just on viewport change.
  ══════════════════════════════════════════ */
  const GridView = {
    init() {
      /* FIX: ResizeObserver watches the grid container itself,
              not the window — more accurate for sidebar layout shifts */
      const grid = $('vxGrid'); if (!grid) return;
      const ro = new ResizeObserver(() => {
        /* Re-apply contain-intrinsic-size hint based on actual column width */
        const colWidth = grid.offsetWidth / parseInt(grid.dataset.cols || '3', 10);
        const estimatedHeight = Math.round(colWidth * 4 / 3) + 120; /* aspect 3:4 + info */
        $$('.vx-card', grid).forEach(c => {
          c.style.containIntrinsicSize = `0 ${estimatedHeight}px`;
        });
      });
      ro.observe(grid);
    },
    set(cols) {
      const g = $('vxGrid'); if (!g) return;
      g.style.cssText = 'transition:opacity .15s ease;opacity:0';
      requestAnimationFrame(() => {
        g.dataset.cols = cols;
        requestAnimationFrame(() => {
          g.style.opacity = '1';
          g.addEventListener('transitionend', () => { g.style.cssText = ''; }, { once: true });
        });
      });
      $$('.vx-vbtn').forEach(b => {
        const a = parseInt(b.dataset.cols, 10) === cols;
        b.classList.toggle('is-active', a);
        b.setAttribute('aria-pressed', String(a));
      });
    }
  };

  /* ══════════════════════════════════════════
     MODULE: SORT
  ══════════════════════════════════════════ */
  const Sort = {
    init() {
      $('vxSort')?.addEventListener('change', function () {
        const url = new URL(window.location.href);
        this.value ? url.searchParams.set('sort_by', this.value) : url.searchParams.delete('sort_by');
        if (document.startViewTransition) {
          document.startViewTransition(() => { window.location.href = url.toString(); });
        } else {
          window.location.href = url.toString();
        }
      });
    }
  };

  /* ══════════════════════════════════════════
     BOOT
     FIX: Non-critical modules deferred to requestIdleCallback.
          Critical path (cart, filters, observers) runs immediately.
  ══════════════════════════════════════════ */
  function boot() {
    /* Critical — runs immediately */
    Wishlist.load();
    Wishlist.sync();
    Filters.init();
    Filters.calcCounts();
    initSwatches(); /* FIX: color map applied on boot */
    Sort.init();
    PriceRange.init();
    VariantPanels.init();
    Observers.init();
    Toolbar.init();
    GridView.init();

    /* Wishlist clicks */
    document.addEventListener('click', e => {
      const btn = e.target.closest('.js-wish'); if (!btn) return;
      e.preventDefault(); Wishlist.toggle(btn.dataset.pid);
    });

    /* Add to cart clicks */
    document.addEventListener('click', e => {
      const btn = e.target.closest('.js-atc'); if (!btn) return;
      e.preventDefault(); Cart.add(btn.dataset.vid, btn, btn.dataset.title || 'Product');
    });

    /* Filter checkboxes */
    $$('.vx-sidebar .vx-checkbox').forEach(cb => {
      cb.addEventListener('change', () => {
        const key = cb.name === 'f-av' ? 'av' : 'type';
        if (cb.checked) S.filters[key].push(cb.value);
        else S.filters[key] = S.filters[key].filter(v => v !== cb.value);
        Filters.apply();
      });
    });

    /* Sidebar */
    $('vxFilterBtn')?.addEventListener('click', () => Sidebar.open());
    $('vxSidebarClose')?.addEventListener('click', () => Sidebar.close());
    $('vxOverlay')?.addEventListener('click', () => Sidebar.close());

    /* View toggles */
    $$('.vx-vbtn').forEach(b => {
      b.addEventListener('click', () => { if (b.dataset.cols) GridView.set(parseInt(b.dataset.cols, 10)); });
    });

    /* Global keyboard */
    document.addEventListener('keydown', e => {
      if (e.key !== 'Escape') return;
      if ($('vxSidebar')?.classList.contains('is-open')) { Sidebar.close(); return; }
      if ($('vxNewsletter')?.classList.contains('is-open')) { $('vxNewsletter').classList.remove('is-open'); return; }
      $$('.vx-vpanel.is-open').forEach(p => p.classList.remove('is-open'));
    });

    /* Touch: swipe left closes sidebar */
    let touchX = 0;
    document.addEventListener('touchstart', e => { touchX = e.touches[0].clientX; }, { passive: true });
    document.addEventListener('touchend', e => {
      if ($('vxSidebar')?.classList.contains('is-open')) {
        if (touchX - e.changedTouches[0].clientX > 60) Sidebar.close();
      }
    }, { passive: true });

    /* FIX: Non-critical modules deferred to idle time to avoid blocking
            the critical rendering path */
    const idle = window.requestIdleCallback || (cb => setTimeout(cb, 200));
    idle(() => StickyBar.init());
    idle(() => Countdown.init());
    idle(() => NewsletterModal.init(), { timeout: 5000 });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', boot);
  } else {
    boot();
  }

})();
</script>

{% endpaginate %}


<!-- Trust Bar -->
{%- if section.settings.show_trust_bar -%}
<div class="prestige-trust">
  <div class="prestige-trust__inner">
    {%- if section.settings.trust_item_1 != blank -%}
    <div class="prestige-trust__item">
      <svg class="prestige-trust__icon"><use href="#prestige-icon-truck"/></svg>
      <span>{{ section.settings.trust_item_1 }}</span>
    </div>
    {%- endif -%}
    {%- if section.settings.trust_item_2 != blank -%}
    <div class="prestige-trust__item">
      <svg class="prestige-trust__icon"><use href="#prestige-icon-rotate"/></svg>
      <span>{{ section.settings.trust_item_2 }}</span>
    </div>
    {%- endif -%}
    {%- if section.settings.trust_item_3 != blank -%}
    <div class="prestige-trust__item">
      <svg class="prestige-trust__icon"><use href="#prestige-icon-shield"/></svg>
      <span>{{ section.settings.trust_item_3 }}</span>
    </div>
    {%- endif -%}
    {%- if section.settings.trust_item_4 != blank -%}
    <div class="prestige-trust__item">
      <svg class="prestige-trust__icon"><use href="#prestige-icon-headset"/></svg>
      <span>{{ section.settings.trust_item_4 }}</span>
    </div>
    {%- endif -%}
  </div>
</div>
{%- endif -%}

<!-- Main Footer -->
<footer class="prestige-footer">
  <div class="prestige-footer__inner">
    <div class="prestige-footer__grid">
      
      <!-- Brand & Navigation Column -->
      <div>
        <a href="/" class="prestige-brand__logo" aria-label="{{ shop.name }} home">
          {%- if section.settings.logo != blank -%}
            {%- assign logo_alt = section.settings.logo.alt | default: shop.name -%}
            {{- section.settings.logo | image_url: width: 800 | image_tag: 
              loading: 'lazy',
              width: section.settings.logo.width,
              height: section.settings.logo.height,
              alt: logo_alt
            -}}
          {%- else -%}
            <h2 class="prestige-brand__wordmark">{{ shop.name }}</h2>
          {%- endif -%}
        </a>
        
        {%- if section.settings.brand_tagline != blank -%}
        <p class="prestige-brand__tagline">{{ section.settings.brand_tagline }}</p>
        {%- endif -%}
        
        {%- if section.settings.show_social -%}
        <nav class="prestige-social" aria-label="Social media links">
          {%- if section.settings.facebook_url != blank -%}
          <a href="{{ section.settings.facebook_url }}" class="prestige-social__link" target="_blank" rel="noopener noreferrer" aria-label="Facebook">
            <svg><use href="#prestige-icon-facebook"/></svg>
          </a>
          {%- endif -%}
          {%- if section.settings.instagram_url != blank -%}
          <a href="{{ section.settings.instagram_url }}" class="prestige-social__link" target="_blank" rel="noopener noreferrer" aria-label="Instagram">
            <svg><use href="#prestige-icon-instagram"/></svg>
          </a>
          {%- endif -%}
          {%- if section.settings.twitter_url != blank -%}
          <a href="{{ section.settings.twitter_url }}" class="prestige-social__link" target="_blank" rel="noopener noreferrer" aria-label="Twitter">
            <svg><use href="#prestige-icon-twitter"/></svg>
          </a>
          {%- endif -%}
          {%- if section.settings.pinterest_url != blank -%}
          <a href="{{ section.settings.pinterest_url }}" class="prestige-social__link" target="_blank" rel="noopener noreferrer" aria-label="Pinterest">
            <svg><use href="#prestige-icon-pinterest"/></svg>
          </a>
          {%- endif -%}
          {%- if section.settings.youtube_url != blank -%}
          <a href="{{ section.settings.youtube_url }}" class="prestige-social__link" target="_blank" rel="noopener noreferrer" aria-label="YouTube">
            <svg><use href="#prestige-icon-youtube"/></svg>
          </a>
          {%- endif -%}
          {%- if section.settings.tiktok_url != blank -%}
          <a href="{{ section.settings.tiktok_url }}" class="prestige-social__link" target="_blank" rel="noopener noreferrer" aria-label="TikTok">
            <svg><use href="#prestige-icon-tiktok"/></svg>
          </a>
          {%- endif -%}
        </nav>
        {%- endif -%}
        
        {%- if shop.enabled_payment_types.size > 0 -%}
        <div class="prestige-payments">
          {%- for type in shop.enabled_payment_types limit: 6 -%}
            {{- type | payment_type_svg_tag: class: 'prestige-payments__icon' -}}
          {%- endfor -%}
        </div>
        {%- endif -%}
        
        <!-- Navigation Menus -->
        <nav class="prestige-nav" aria-label="Footer navigation">
          {%- if linklists[footer_menu_1].links.size > 0 -%}
          <div>
            <h3 class="prestige-nav__title">{{ section.settings.menu_1_title }}</h3>
            <ul class="prestige-nav__list">
              {%- for link in linklists[footer_menu_1].links -%}
              <li><a href="{{ link.url }}" class="prestige-nav__link">{{ link.title }}</a></li>
              {%- endfor -%}
            </ul>
          </div>
          {%- endif -%}
          
          {%- if linklists[footer_menu_2].links.size > 0 -%}
          <div>
            <h3 class="prestige-nav__title">{{ section.settings.menu_2_title }}</h3>
            <ul class="prestige-nav__list">
              {%- for link in linklists[footer_menu_2].links -%}
              <li><a href="{{ link.url }}" class="prestige-nav__link">{{ link.title }}</a></li>
              {%- endfor -%}
            </ul>
          </div>
          {%- endif -%}
          
          {%- if linklists[footer_menu_3].links.size > 0 -%}
          <div>
            <h3 class="prestige-nav__title">{{ section.settings.menu_3_title }}</h3>
            <ul class="prestige-nav__list">
              {%- for link in linklists[footer_menu_3].links -%}
              <li><a href="{{ link.url }}" class="prestige-nav__link">{{ link.title }}</a></li>
              {%- endfor -%}
            </ul>
          </div>
          {%- endif -%}
        </nav>
      </div>
      
      <!-- Newsletter Column -->
      <div class="prestige-newsletter">
        <div class="prestige-newsletter__content">
          <h3 class="prestige-newsletter__title">{{ section.settings.newsletter_title }}</h3>
          
          {%- if section.settings.newsletter_desc != blank -%}
          <p class="prestige-newsletter__desc">{{ section.settings.newsletter_desc }}</p>
          {%- endif -%}
          
          {%- form 'customer', class: 'prestige-form' -%}
            {%- if form.posted_successfully? -%}
            <div class="prestige-success">
              <svg width="16" height="16"><use href="#prestige-icon-check"/></svg>
              {{ section.settings.success_message }}
            </div>
            {%- endif -%}
            
            <label for="PrestigeFooterEmail" class="visually-hidden">Email address</label>
            <input 
              type="email" 
              name="contact[email]" 
              id="PrestigeFooterEmail" 
              placeholder="{{ section.settings.email_placeholder }}" 
              class="prestige-input"
              required
              autocomplete="email"
              aria-required="true"
            >
            <input type="hidden" name="contact[tags]" value="newsletter">
            <button type="submit" class="prestige-submit">{{ section.settings.button_text }}</button>
          {%- endform -%}
          
          {%- if section.settings.newsletter_disclaimer != blank -%}
          <p class="prestige-disclaimer">{{ section.settings.newsletter_disclaimer }}</p>
          {%- endif -%}
        </div>
      </div>
      
    </div>
  </div>
   
  <!-- Footer Base -->
  <div class="prestige-base">
    <div class="prestige-base__inner">
      <nav class="prestige-legal" aria-label="Legal links">
        {%- if section.settings.show_privacy and section.settings.privacy_page != blank -%}
          {%- assign privacy_page = pages[section.settings.privacy_page] -%}
          {%- if privacy_page -%}
          <a href="{{ privacy_page.url }}" class="prestige-legal__link">Privacy</a>
          {%- endif -%}
        {%- endif -%}
        
        {%- if section.settings.show_terms and section.settings.terms_page != blank -%}
          {%- assign terms_page = pages[section.settings.terms_page] -%}
          {%- if terms_page -%}
          <a href="{{ terms_page.url }}" class="prestige-legal__link">Terms</a>
          {%- endif -%}
        {%- endif -%}
        
        {%- if section.settings.show_refund and section.settings.refund_page != blank -%}
          {%- assign refund_page = pages[section.settings.refund_page] -%}
          {%- if refund_page -%}
          <a href="{{ refund_page.url }}" class="prestige-legal__link">Refunds</a>
          {%- endif -%}
        {%- endif -%}
      </nav>
      
      <p class="prestige-copyright">&copy; {{ current_year }} {{ shop.name }}</p>
      
      {%- if section.settings.show_locale and localization.available_countries.size > 1 -%}
      {%- form 'localization' -%}
        <label for="PrestigeLocaleSelector" class="visually-hidden">Country / Region</label>
        <select id="PrestigeLocaleSelector" name="country_code" class="prestige-locale" onchange="this.form.submit()">
          {%- for country in localization.available_countries -%}
          <option value="{{ country.iso_code }}" {%- if country.iso_code == localization.country.iso_code -%}selected{%- endif -%}>
            {{ country.name }} ({{ country.currency.iso_code }} {{ country.currency.symbol }})
          </option>
          {%- endfor -%}
        </select>
      {%- endform -%}
      {%- endif -%}
    </div>
  </div>
</footer>


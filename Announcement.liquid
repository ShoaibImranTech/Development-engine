      "min": 3,
      "max": 10,
      "step": 1,
      "default": 5,
      "unit": "s",
      "label": "Carousel Speed",
      "info": "Time between message rotations"
    },
    {
      "type": "checkbox",
      "id": "show_icon",
      "label": "Show Icon",
      "default": true
    },
    {
      "type": "select",
      "id": "icon_type",
      "label": "Icon Type",
      "options": [
        {
          "value": "sparkles",
          "label": "✨ Sparkles"
        },
        {
          "value": "crown",
          "label": "👑 Crown"
        },
        {
          "value": "star",
          "label": "⭐ Star"
        },
        {
          "value": "gift",
          "label": "🎁 Gift"
        },
        {
          "value": "truck",
          "label": "🚚 Delivery"
        },
        {
          "value": "tag",
          "label": "🏷️ Tag"
        }
      ],
      "default": "sparkles"
    },
    {
      "type": "checkbox",
      "id": "show_cta",
      "label": "Show CTA Button",
      "default": true
    },
    {
      "type": "text",
      "id": "cta_text",
      "label": "CTA Button Text",
      "default": "Shop Now"
    },
    {
      "type": "url",
      "id": "cta_link",
      "label": "CTA Button Link"
    },
    {
      "type": "checkbox",
      "id": "enable_countdown",
      "label": "Enable Countdown Timer",
      "default": false,
      "info": "Add urgency with a countdown timer"
    },
    {
      "type": "text",
      "id": "countdown_date",
      "label": "Countdown End Date",
      "default": "2026-12-31",
      "info": "Format: YYYY-MM-DD"
    },
    {
      "type": "text",
      "id": "countdown_text",
      "label": "Countdown Text",
      "default": "Sale Ends In:"
    },
    {
      "type": "checkbox",
      "id": "dismissible",
      "label": "Allow Users to Dismiss",
      "default": true,
      "info": "Shows close button"
    },
    {
      "type": "checkbox",
      "id": "sticky",
      "label": "Sticky (Fixed Position)",
      "default": true,
      "info": "Bar stays visible while scrolling"
    }
  ],
  "blocks": [
    {
      "type": "message",
      "name": "Announcement Message",
      "settings": [
        {
          "type": "richtext",
          "id": "message_text",
          "label": "Message Text",
          "default": "<p><strong>Free Luxury Shipping</strong> on orders over $150</p>"
        },
        {
          "type": "url",
          "id": "message_link",
          "label": "Message Link (Optional)"
        }
      ]
    }
  ],
  "max_blocks": 5,
  "presets": [
    {
      "name": "GLAMHIVE — Premium Announcement",
      "blocks": [
        {
          "type": "message",
          "settings": {
            "message_text": "<p><strong>Exclusive Launch:</strong> New Collection Available Now</p>"

          "value": "elegant",
          "label": "Elegant (Subtle Premium)"
        },
        {
          "value": "bold",
          "label": "Bold (High Impact)"
        },
        {
          "value": "minimal",
          "label": "Minimal (Ultra Clean)"
        }
      ],
      "default": "elegant"
    },
    {
      "type": "select",
      "id": "color_scheme",
      "label": "Color Scheme",
      "options": [
        {
          "value": "champagne",
          "label": "Champagne Gold"
        },
        {
          "value": "noir",
          "label": "Noir Black"
        },
        {
          "value": "pearl",
          "label": "Pearl White"
        },
        {
          "value": "rose",
          "label": "Rose Gold"
        },
        {
          "value": "emerald",
          "label": "Emerald Green"
        }

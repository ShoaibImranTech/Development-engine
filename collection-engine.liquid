<style>
@import url('https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@300;400;500;600;700&family=Inter:wght@300;400;500;600&display=swap');

:root {
  --brand-noir: {{ section.settings.primary_color | default: '#0a0a0a' }};
  --brand-charcoal: {{ section.settings.secondary_color | default: '#2a2a2a' }};
  --brand-gold: {{ section.settings.accent_color | default: '#d4af37' }};
  --brand-pearl: {{ section.settings.background_color | default: '#fafaf8' }};
  --color-text-primary: #0a0a0a;
  --color-text-secondary: #5a5a5a;
  --color-text-muted: #9a9a9a;
  --color-surface: #ffffff;
  --color-surface-soft: #fafaf8;
  --color-surface-elevated: #f5f5f3;
  --color-border: #e8e8e6;
  --color-border-light: #f0f0ee;
  --color-success: #2d6a4f;
  --color-error: #9a2f2f;
  --color-warning: #b8860b;
  --shadow-soft: 0 2px 8px rgba(10,10,10,0.04);
  --shadow-medium: 0 4px 16px rgba(10,10,10,0.06);
  --shadow-strong: 0 8px 32px rgba(10,10,10,0.08);
  --shadow-dramatic: 0 16px 48px rgba(10,10,10,0.12);
  --shadow-editorial: 0 32px 64px rgba(10,10,10,0.16);
  --radius-subtle: 2px;
  --radius-refined: 4px;
  --radius-elegant: 8px;
  --transition-swift: 180ms cubic-bezier(0.25,0.46,0.45,0.94);
  --transition-refined: 320ms cubic-bezier(0.25,0.46,0.45,0.94);
  --transition-elegant: 480ms cubic-bezier(0.25,0.46,0.45,0.94);
  --font-display: 'Cormorant Garamond', serif;
  --font-body: 'Inter', -apple-system, sans-serif;
  --space-1: 4px;
  --space-2: 8px;
  --space-3: 12px;
  --space-4: 16px;
  --space-5: 20px;
  --space-6: 24px;
  --space-8: 32px;
  --space-10: 40px;
  --space-12: 48px;
  --space-16: 64px;
  --space-20: 80px;
  --space-24: 96px;
  --container-max: 1760px;
  --container-padding: clamp(20px,4vw,64px);
  --grid-gap: clamp(20px,2.5vw,48px);
}

@media (prefers-color-scheme: dark) {
  :root {
    --brand-pearl: #1a1a18;
    --color-surface: #0a0a0a;
    --color-surface-soft: #141412;
    --color-surface-elevated: #1e1e1c;
    --color-text-primary: #fafaf8;
    --color-text-secondary: #b0b0ae;
    --color-text-muted: #6a6a68;
    --color-border: #2a2a28;
    --color-border-light: #1e1e1c;
  }
}

.maison-collection{position:relative;min-height:100vh;background:var(--brand-pearl);font-family:var(--font-body);color:var(--color-text-primary);-webkit-font-smoothing:antialiased;-moz-osx-font-smoothing:grayscale;padding:var(--section-padding-top,120px) 0 var(--section-padding-bottom,120px)}
.maison-collection__container{max-width:var(--container-max);margin:0 auto;padding:0 var(--container-padding)}
.visually-hidden{position:absolute!important;width:1px!important;height:1px!important;padding:0!important;margin:-1px!important;overflow:hidden!important;clip:rect(0,0,0,0)!important;white-space:nowrap!important;border:0!important}

/* ═══════════════════════════════════════════════════════════════════════════
   EDITORIAL HERO ANNOUNCEMENT
   ═══════════════════════════════════════════════════════════════════════════ */
.editorial-banner{position:relative;margin-bottom:var(--space-20);padding:var(--space-12) var(--space-8);background:linear-gradient(135deg,var(--brand-noir) 0%,var(--brand-charcoal) 100%);overflow:hidden;opacity:0;animation:fadeInSlide 800ms cubic-bezier(0.25,0.46,0.45,0.94) forwards}
@keyframes fadeInSlide{from{opacity:0;transform:translateY(-20px)}to{opacity:1;transform:translateY(0)}}
.editorial-banner::before{content:'';position:absolute;top:0;left:0;right:0;bottom:0;background:url("data:image/svg+xml,%3Csvg width='60' height='60' viewBox='0 0 60 60' xmlns='http://www.w3.org/2000/svg'%3E%3Cg fill='none' fill-rule='evenodd'%3E%3Cg fill='%23ffffff' fill-opacity='0.03'%3E%3Cpath d='M36 34v-4h-2v4h-4v2h4v4h2v-4h4v-2h-4zm0-30V0h-2v4h-4v2h4v4h2V6h4V4h-4zM6 34v-4H4v4H0v2h4v4h2v-4h4v-2H6zM6 4V0H4v4H0v2h4v4h2V6h4V4H6z'/%3E%3C/g%3E%3C/g%3E%3C/svg%3E");opacity:.6;pointer-events:none}
.editorial-banner__content{position:relative;display:flex;align-items:center;justify-content:center;gap:var(--space-4);text-align:center;flex-wrap:wrap}
.editorial-banner__icon{width:20px;height:20px;color:var(--brand-gold);animation:gentlePulse 2s ease-in-out infinite}
@keyframes gentlePulse{0%,100%{opacity:1;transform:scale(1)}50%{opacity:.7;transform:scale(1.05)}}
.editorial-banner__text{font-family:var(--font-display);font-size:clamp(15px,1.8vw,18px);font-weight:400;letter-spacing:0.03em;color:#ffffff}
.editorial-banner__highlight{color:var(--brand-gold);font-weight:600;margin:0 var(--space-2)}

/* ═══════════════════════════════════════════════════════════════════════════
   COLLECTION HEADER - EDITORIAL STYLE
   ═══════════════════════════════════════════════════════════════════════════ */
.collection-header{margin-bottom:var(--space-20);opacity:0;animation:fadeInSlide 800ms 200ms cubic-bezier(0.25,0.46,0.45,0.94) forwards}
.collection-header__inner{display:grid;grid-template-columns:1fr;gap:var(--space-12)}
@media (min-width:1024px){.collection-header__inner{grid-template-columns:1.2fr 1fr;gap:var(--space-16)}}
.collection-header__content{display:flex;flex-direction:column;justify-content:center}
.collection-header__season{font-family:var(--font-body);font-size:11px;font-weight:600;letter-spacing:0.15em;text-transform:uppercase;color:var(--color-text-muted);margin-bottom:var(--space-3)}
.collection-header__title{font-family:var(--font-display);font-size:clamp(48px,7vw,92px);font-weight:300;line-height:1;letter-spacing:-0.02em;color:var(--brand-noir);margin:0 0 var(--space-6)}
.collection-header__description{font-family:var(--font-body);font-size:16px;line-height:1.75;color:var(--color-text-secondary);margin-bottom:var(--space-8);max-width:540px}
.collection-header__meta{display:flex;gap:var(--space-8);flex-wrap:wrap;align-items:center}
.collection-meta__stat{display:flex;flex-direction:column;gap:var(--space-1)}
.collection-meta__number{font-family:var(--font-display);font-size:36px;font-weight:400;color:var(--brand-gold);line-height:1}
.collection-meta__label{font-family:var(--font-body);font-size:11px;letter-spacing:0.1em;text-transform:uppercase;color:var(--color-text-muted)}
.collection-header__press{padding:var(--space-8);background:var(--color-surface);border:1px solid var(--color-border);border-radius:var(--radius-elegant);display:flex;flex-direction:column;gap:var(--space-6)}
.collection-press__title{font-family:var(--font-body);font-size:11px;font-weight:600;letter-spacing:0.12em;text-transform:uppercase;color:var(--color-text-muted)}
.collection-press__logos{display:grid;grid-template-columns:repeat(3,1fr);gap:var(--space-6);align-items:center;justify-items:center;opacity:.4;filter:grayscale(1)}
.collection-press__logo{height:24px;width:auto;max-width:100%;object-fit:contain}

/* ═══════════════════════════════════════════════════════════════════════════
   REFINED TOOLBAR
   ═══════════════════════════════════════════════════════════════════════════ */
.collection-toolbar{display:flex;justify-content:space-between;align-items:center;gap:var(--space-6);padding:var(--space-6) var(--space-8);background:var(--color-surface);border:1px solid var(--color-border);margin-bottom:var(--space-16);opacity:0;animation:fadeInSlide 800ms 400ms cubic-bezier(0.25,0.46,0.45,0.94) forwards}
@media (max-width:767px){.collection-toolbar{flex-direction:column;align-items:stretch}}
.collection-toolbar__left{display:flex;gap:var(--space-4);align-items:center;flex-wrap:wrap}
.collection-toolbar__right{display:flex;gap:var(--space-4);align-items:center;flex-wrap:wrap}
.collection-filter__group{display:flex;gap:var(--space-3);flex-wrap:wrap}
.collection-filter__chip{padding:var(--space-2) var(--space-4);font-size:12px;font-weight:500;letter-spacing:0.02em;background:transparent;border:1px solid var(--color-border);color:var(--color-text-secondary);cursor:pointer;transition:all var(--transition-swift);font-family:var(--font-body)}
.collection-filter__chip:hover{border-color:var(--brand-noir);color:var(--brand-noir);background:var(--color-surface-soft)}
.collection-filter__chip.is-active{background:var(--brand-noir);border-color:var(--brand-noir);color:#ffffff}
.collection-sort{position:relative}
.collection-sort__select{appearance:none;padding:var(--space-3) var(--space-10) var(--space-3) var(--space-4);font-family:var(--font-body);font-size:13px;font-weight:500;letter-spacing:0.01em;background:var(--color-surface) url("data:image/svg+xml,%3Csvg width='12' height='7' viewBox='0 0 12 7' fill='none' xmlns='http://www.w3.org/2000/svg'%3E%3Cpath d='M1 1L6 6L11 1' stroke='%235a5a5a' stroke-width='1.5' stroke-linecap='round' stroke-linejoin='round'/%3E%3C/svg%3E") no-repeat right var(--space-4) center;border:1px solid var(--color-border);color:var(--color-text-primary);cursor:pointer;transition:all var(--transition-swift);min-width:200px}
.collection-sort__select:hover{border-color:var(--brand-noir)}
.collection-sort__select:focus{outline:none;border-color:var(--brand-noir);box-shadow:0 0 0 3px rgba(212,175,55,0.1)}
.view-toggle{display:flex;gap:2px;background:var(--color-surface-elevated);padding:2px;border:1px solid var(--color-border)}
.view-toggle__btn{display:flex;align-items:center;justify-content:center;padding:var(--space-2) var(--space-3);background:transparent;border:none;cursor:pointer;transition:all var(--transition-swift);color:var(--color-text-muted)}
.view-toggle__btn:hover{color:var(--color-text-primary)}
.view-toggle__btn.is-active{background:var(--brand-noir);color:#ffffff}
.view-toggle__btn svg{width:18px;height:18px}

/* ═══════════════════════════════════════════════════════════════════════════
   PRODUCT GRID - EDITORIAL LAYOUT
   ═══════════════════════════════════════════════════════════════════════════ */
.product-grid{display:grid;grid-template-columns:1fr;gap:var(--grid-gap);margin-bottom:var(--space-20)}
@media (min-width:640px){.product-grid{grid-template-columns:repeat(2,1fr)}}
@media (min-width:1024px){.product-grid{grid-template-columns:repeat(3,1fr)}}
@media (min-width:1440px){.product-grid{grid-template-columns:repeat(4,1fr)}}
.product-grid.view-editorial{grid-template-columns:1fr}
@media (min-width:768px){.product-grid.view-editorial{grid-template-columns:repeat(2,1fr)}}
.product-grid.view-editorial .product-card{flex-direction:row}

/* ═══════════════════════════════════════════════════════════════════════════
   PRODUCT CARD - LUXURY REFINEMENT
   ═══════════════════════════════════════════════════════════════════════════ */
.product-card{position:relative;display:flex;flex-direction:column;background:var(--color-surface);border:1px solid transparent;transition:all var(--transition-elegant);opacity:0;animation:fadeInStagger 600ms cubic-bezier(0.25,0.46,0.45,0.94) forwards}
@keyframes fadeInStagger{from{opacity:0;transform:translateY(30px)}to{opacity:1;transform:translateY(0)}}
.product-card:nth-child(1){animation-delay:100ms}
.product-card:nth-child(2){animation-delay:150ms}
.product-card:nth-child(3){animation-delay:200ms}
.product-card:nth-child(4){animation-delay:250ms}
.product-card:nth-child(5){animation-delay:300ms}
.product-card:nth-child(6){animation-delay:350ms}
.product-card:nth-child(7){animation-delay:400ms}
.product-card:nth-child(8){animation-delay:450ms}
.product-card:hover{border-color:var(--color-border);box-shadow:var(--shadow-editorial);transform:translateY(-4px)}

/* Product Badges - Refined */
.product-card__badges{position:absolute;top:var(--space-4);left:var(--space-4);z-index:20;display:flex;flex-direction:column;gap:var(--space-2);pointer-events:none}
.product-badge{display:inline-flex;align-items:center;gap:var(--space-2);padding:var(--space-2) var(--space-3);font-family:var(--font-body);font-size:10px;font-weight:600;letter-spacing:0.08em;text-transform:uppercase;backdrop-filter:blur(20px);box-shadow:var(--shadow-soft);animation:badgeSlide 400ms cubic-bezier(0.34,1.56,0.64,1) backwards}
@keyframes badgeSlide{from{opacity:0;transform:translateX(-20px) scale(0.9)}to{opacity:1;transform:translateX(0) scale(1)}}
.product-badge--sale{background:rgba(154,47,47,0.95);color:#ffffff}
.product-badge--new{background:rgba(45,106,79,0.95);color:#ffffff}
.product-badge--low-stock{background:rgba(184,134,11,0.95);color:#ffffff}
.product-badge--sold-out{background:rgba(90,90,90,0.95);color:#ffffff}
.product-badge--material{background:rgba(10,10,10,0.9);color:var(--brand-gold);border:1px solid rgba(212,175,55,0.3)}

/* Wishlist Button - Elegant */
.product-card__wishlist{position:absolute;top:var(--space-4);right:var(--space-4);z-index:20;width:40px;height:40px;display:flex;align-items:center;justify-content:center;background:rgba(255,255,255,0.95);backdrop-filter:blur(20px);border:1px solid rgba(0,0,0,0.08);cursor:pointer;transition:all var(--transition-refined);box-shadow:var(--shadow-soft)}
.product-card__wishlist:hover{transform:scale(1.1);box-shadow:var(--shadow-medium)}
.product-card__wishlist:focus{outline:2px solid var(--brand-gold);outline-offset:2px}
.product-card__wishlist svg{width:18px;height:18px}
.product-card__wishlist .heart-outline{stroke:var(--brand-noir);fill:none;stroke-width:1.8}
.product-card__wishlist .heart-filled{display:none;fill:var(--color-error)}
.product-card__wishlist.is-active .heart-outline{display:none}
.product-card__wishlist.is-active .heart-filled{display:block;animation:heartBeatRefined 500ms cubic-bezier(0.34,1.56,0.64,1)}
@keyframes heartBeatRefined{0%,100%{transform:scale(1)}40%{transform:scale(1.25)}}

/* Image Container - Editorial */
.product-card__image-wrapper{position:relative;display:block;overflow:hidden;background:var(--color-surface-soft)}
.product-card__image-container{position:relative;padding-bottom:140%;overflow:hidden}
.product-card__image{position:absolute;top:0;left:0;width:100%;height:100%;object-fit:cover;transition:transform var(--transition-elegant)}
.product-card__image--primary{z-index:2}
.product-card__image--secondary{opacity:0;z-index:1;transition:opacity var(--transition-elegant)}
.product-card:hover .product-card__image--primary{transform:scale(1.05)}
.product-card:hover .product-card__image--secondary{opacity:1}

/* Color Swatches - NEW FEATURE */
.product-card__swatches{position:absolute;bottom:var(--space-4);left:var(--space-4);right:var(--space-4);display:flex;gap:var(--space-2);opacity:0;transform:translateY(10px);transition:all var(--transition-refined);z-index:15}
.product-card:hover .product-card__swatches{opacity:1;transform:translateY(0)}
.product-swatch{width:28px;height:28px;border-radius:50%;border:2px solid rgba(255,255,255,0.9);box-shadow:var(--shadow-soft);cursor:pointer;transition:all var(--transition-swift);backdrop-filter:blur(10px)}
.product-swatch:hover{transform:scale(1.15);border-color:#ffffff;box-shadow:var(--shadow-medium)}
.product-swatch--black{background:#0a0a0a}
.product-swatch--white{background:#fafafa;border-color:rgba(0,0,0,0.2)}
.product-swatch--navy{background:#1e3a5f}
.product-swatch--beige{background:#d4c4a8}
.product-swatch--olive{background:#5a5f4a}

/* Quick Actions - Refined */
.product-card__quick-actions{position:absolute;bottom:var(--space-6);left:50%;transform:translateX(-50%) translateY(80px);display:flex;gap:var(--space-2);opacity:0;transition:all var(--transition-elegant);z-index:10}
.product-card:hover .product-card__quick-actions{transform:translateX(-50%) translateY(0);opacity:1}
.product-card__quick-btn{display:inline-flex;align-items:center;gap:var(--space-2);padding:var(--space-3) var(--space-5);background:rgba(10,10,10,0.95);color:#ffffff;border:none;font-family:var(--font-body);font-size:12px;font-weight:600;letter-spacing:0.03em;cursor:pointer;transition:all var(--transition-refined);backdrop-filter:blur(20px);box-shadow:var(--shadow-dramatic)}
.product-card__quick-btn:hover{background:var(--brand-noir);transform:translateY(-2px);box-shadow:var(--shadow-editorial)}
.product-card__quick-btn svg{width:16px;height:16px}

/* Stock Indicator - Smart Messaging */
.product-card__stock{position:absolute;bottom:var(--space-4);right:var(--space-4);padding:var(--space-2) var(--space-3);background:rgba(184,134,11,0.95);color:#ffffff;font-family:var(--font-body);font-size:10px;font-weight:700;letter-spacing:0.05em;text-transform:uppercase;backdrop-filter:blur(12px);z-index:15;animation:stockPulse 2s ease-in-out infinite}
@keyframes stockPulse{0%,100%{box-shadow:0 0 0 0 rgba(184,134,11,0.4)}50%{box-shadow:0 0 0 8px rgba(184,134,11,0)}}

/* Product Info - Editorial Typography */
.product-card__info{padding:var(--space-6);flex:1;display:flex;flex-direction:column;gap:var(--space-3)}
.product-card__vendor{font-family:var(--font-body);font-size:10px;font-weight:600;letter-spacing:0.12em;text-transform:uppercase;color:var(--color-text-muted)}
.product-card__title{font-family:var(--font-display);font-size:19px;font-weight:400;line-height:1.3;margin:0;min-height:50px;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden}
.product-card__title-link{color:var(--color-text-primary);text-decoration:none;transition:color var(--transition-swift)}
.product-card__title-link:hover{color:var(--brand-gold)}
.product-card__title-link:focus{outline:2px solid var(--brand-gold);outline-offset:3px}

/* Material Badge - NEW FEATURE */
.product-card__material{font-family:var(--font-body);font-size:11px;font-weight:500;color:var(--color-text-secondary);font-style:italic}

/* Review Stars - Real Integration */
.product-card__rating{display:flex;align-items:center;gap:var(--space-2)}
.product-rating__stars{display:flex;gap:1px}
.product-rating__star{width:13px;height:13px;fill:var(--brand-gold)}
.product-rating__star--empty{fill:var(--color-border)}
.product-rating__count{font-family:var(--font-body);font-size:12px;color:var(--color-text-muted);font-weight:400}

/* Size Intelligence - NEW FEATURE */
.product-card__sizing{display:flex;align-items:center;gap:var(--space-2);padding:var(--space-2) var(--space-3);background:var(--color-surface-soft);border:1px solid var(--color-border-light);font-family:var(--font-body);font-size:11px;color:var(--color-text-secondary)}
.product-card__sizing svg{width:14px;height:14px;color:var(--brand-gold)}

/* Price - Refined */
.product-card__price-wrapper{display:flex;flex-direction:column;gap:var(--space-2)}
.product-card__price-row{display:flex;align-items:center;gap:var(--space-3);flex-wrap:wrap}
.product-card__price{font-family:var(--font-display);font-size:24px;font-weight:400;letter-spacing:-0.01em;color:var(--brand-noir)}
.product-card__price--sale{color:var(--color-error)}
.product-card__price-compare{font-family:var(--font-display);font-size:18px;color:var(--color-text-muted);text-decoration:line-through;opacity:0.6}
.product-card__savings{font-family:var(--font-body);font-size:10px;font-weight:700;letter-spacing:0.08em;text-transform:uppercase;padding:var(--space-1) var(--space-2);background:#fef3c7;color:#78350f;border:1px solid #fde68a}

/* Add to Cart Button - Premium */
.product-card__button{width:100%;padding:var(--space-4) var(--space-6);font-family:var(--font-body);font-size:13px;font-weight:600;letter-spacing:0.05em;text-transform:uppercase;border:none;cursor:pointer;transition:all var(--transition-refined);display:inline-flex;align-items:center;justify-content:center;gap:var(--space-2);margin-top:auto;position:relative;overflow:hidden}
.product-card__button::before{content:'';position:absolute;top:50%;left:50%;width:0;height:0;background:rgba(255,255,255,0.15);border-radius:50%;transform:translate(-50%,-50%);transition:width var(--transition-elegant),height var(--transition-elegant)}
.product-card__button:hover::before{width:400px;height:400px}
.product-card__button--primary{background:var(--brand-noir);color:#ffffff}
.product-card__button--primary:hover{background:var(--brand-charcoal);transform:translateY(-1px);box-shadow:var(--shadow-dramatic)}
.product-card__button--primary:focus{outline:2px solid var(--brand-gold);outline-offset:3px}
.product-card__button--secondary{background:transparent;color:var(--brand-noir);border:1px solid var(--brand-noir)}
.product-card__button--secondary:hover{background:var(--brand-noir);color:#ffffff}
.product-card__button--disabled{background:var(--color-surface-elevated);color:var(--color-text-muted);cursor:not-allowed;opacity:0.5}
.product-card__button.is-loading{color:transparent;pointer-events:none}
.product-card__button.is-loading::after{content:'';position:absolute;width:18px;height:18px;border:2px solid rgba(255,255,255,0.3);border-top-color:#ffffff;border-radius:50%;animation:buttonSpin 600ms linear infinite}
@keyframes buttonSpin{to{transform:rotate(360deg)}}
.product-card__button svg,.product-card__button span{position:relative;z-index:1}
.product-card__button svg{width:16px;height:16px}

/* ═══════════════════════════════════════════════════════════════════════════
   TOAST NOTIFICATION - REFINED
   ═══════════════════════════════════════════════════════════════════════════ */
.toast{position:fixed;bottom:var(--space-8);right:var(--space-8);max-width:420px;min-width:320px;padding:var(--space-5) var(--space-6);background:var(--color-surface);border:1px solid var(--color-border);box-shadow:var(--shadow-editorial);display:flex;gap:var(--space-4);transform:translateX(500px);opacity:0;transition:all var(--transition-elegant);z-index:2000}
.toast.is-visible{transform:translateX(0);opacity:1}
.toast--success{border-left:3px solid var(--color-success)}
.toast--error{border-left:3px solid var(--color-error)}
.toast--info{border-left:3px solid var(--brand-gold)}
.toast__icon{flex-shrink:0;width:22px;height:22px}
.toast__icon--success{color:var(--color-success)}
.toast__icon--error{color:var(--color-error)}
.toast__icon--info{color:var(--brand-gold)}
.toast__content{flex:1}
.toast__title{font-family:var(--font-body);font-weight:600;font-size:14px;margin-bottom:var(--space-1);color:var(--color-text-primary)}
.toast__message{font-family:var(--font-body);font-size:13px;color:var(--color-text-secondary);line-height:1.5}
.toast__close{flex-shrink:0;width:22px;height:22px;border:none;background:transparent;cursor:pointer;color:var(--color-text-muted);transition:color var(--transition-swift)}
.toast__close:hover{color:var(--color-text-primary)}
.toast__close svg{width:14px;height:14px}

/* ═══════════════════════════════════════════════════════════════════════════
   PAGINATION - EDITORIAL
   ═══════════════════════════════════════════════════════════════════════════ */
.pagination{display:flex;justify-content:center;gap:var(--space-2);margin-top:var(--space-20);padding-top:var(--space-12);border-top:1px solid var(--color-border)}
.pagination__item{min-width:44px;height:44px;display:flex;align-items:center;justify-content:center;padding:0 var(--space-4);background:var(--color-surface);border:1px solid var(--color-border);font-family:var(--font-body);font-size:13px;font-weight:500;cursor:pointer;transition:all var(--transition-swift);text-decoration:none;color:var(--color-text-primary)}
.pagination__item:hover{border-color:var(--brand-noir);color:var(--brand-noir)}
.pagination__item.is-active{background:var(--brand-noir);border-color:var(--brand-noir);color:#ffffff}
.pagination__item.is-disabled{opacity:0.3;cursor:not-allowed;pointer-events:none}

/* Loading Overlay */
.loading-overlay{position:fixed;top:0;left:0;width:100%;height:100%;background:rgba(250,250,248,0.98);backdrop-filter:blur(12px);z-index:1500;display:none;align-items:center;justify-content:center}
.loading-overlay.is-active{display:flex}
.loading-spinner{width:50px;height:50px;border:2px solid var(--color-border);border-top-color:var(--brand-noir);border-radius:50%;animation:spinLoader 800ms linear infinite}
@keyframes spinLoader{to{transform:rotate(360deg)}}

/* ═══════════════════════════════════════════════════════════════════════════
   RESPONSIVE REFINEMENTS
   ═══════════════════════════════════════════════════════════════════════════ */
@media (max-width:1023px){
  .collection-header__inner{grid-template-columns:1fr}
  .collection-header__press{order:-1}
}
@media (max-width:767px){
  .maison-collection{padding:var(--space-16) 0}
  .editorial-banner{margin-bottom:var(--space-12)}
  .collection-header{margin-bottom:var(--space-12)}
  .collection-header__title{font-size:clamp(40px,10vw,56px)}
  .collection-toolbar{padding:var(--space-5)}
  .product-grid{gap:var(--space-8)}
  .toast{left:var(--space-4);right:var(--space-4);min-width:auto}
}
@media (max-width:480px){
  .product-card__info{padding:var(--space-5)}
  .product-card__title{font-size:17px;min-height:auto}
  .product-card__price{font-size:21px}
  .product-card__swatches{gap:var(--space-1)}
  .product-swatch{width:24px;height:24px}
}

/* Accessibility & Motion */
@media (prefers-reduced-motion:reduce){*,*::after,*::before{animation-duration:0.01ms!important;animation-iteration-count:1!important;transition-duration:0.01ms!important}}
*:focus-visible{outline:2px solid var(--brand-gold);outline-offset:3px}
</style>

<div class="maison-collection" style="--section-padding-top:{{ section.settings.padding_top }}px;--section-padding-bottom:{{ section.settings.padding_bottom }}px" role="region" aria-label="Luxury Fashion Collection">
  <div class="maison-collection__container">
    
    {% if section.settings.show_announcement and section.settings.announcement_text != blank %}
      <div class="editorial-banner" role="banner">
        <div class="editorial-banner__content">
          <svg class="editorial-banner__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
          <span class="editorial-banner__text">{{ section.settings.announcement_text | replace: '[HIGHLIGHT]', '<span class="editorial-banner__highlight">' | replace: '[/HIGHLIGHT]', '</span>' }}</span>
        </div>
      </div>
    {% endif %}
    
    {% paginate collection.products by section.settings.products_per_page %}
    
    <header class="collection-header">
      <div class="collection-header__inner">
        <div class="collection-header__content">
          {% if section.settings.season_text != blank %}
            <p class="collection-header__season">{{ section.settings.season_text }}</p>
          {% endif %}
          
          <h1 class="collection-header__title">{{ collection.title }}</h1>
          
          {% if collection.description != blank %}
            <div class="collection-header__description">
              {{ collection.description | strip_html | truncatewords: 35 }}
            </div>
          {% endif %}
          
          <div class="collection-header__meta">
            <div class="collection-meta__stat">
              <span class="collection-meta__number">{{ collection.products_count }}</span>
              <span class="collection-meta__label">{{ collection.products_count | pluralize: 'Piece', 'Pieces' }}</span>
            </div>
            {% if section.settings.show_collections_count %}
              <div class="collection-meta__stat">
                <span class="collection-meta__number">{{ collections.size }}</span>
                <span class="collection-meta__label">Collections</span>
              </div>
            {% endif %}
          </div>
        </div>
        
        {% if section.settings.show_press %}
          <div class="collection-header__press">
            <p class="collection-press__title">As Featured In</p>
            <div class="collection-press__logos">
              <svg class="collection-press__logo" viewBox="0 0 120 24" fill="currentColor"><text x="10" y="18" font-family="serif" font-size="16" font-weight="700">VOGUE</text></svg>
              <svg class="collection-press__logo" viewBox="0 0 120 24" fill="currentColor"><text x="0" y="18" font-family="serif" font-size="14" font-style="italic">Elle</text></svg>
              <svg class="collection-press__logo" viewBox="0 0 120 24" fill="currentColor"><text x="15" y="18" font-family="serif" font-size="16" font-weight="300">GQ</text></svg>
            </div>
          </div>
        {% endif %}
      </div>
    </header>

    <div class="collection-toolbar">
      <div class="collection-toolbar__left">
        {% if section.settings.enable_filters %}
          <div class="collection-filter__group">
            <button class="collection-filter__chip is-active" data-filter="all" type="button">All</button>
            <button class="collection-filter__chip" data-filter="new" type="button">New Arrivals</button>
            <button class="collection-filter__chip" data-filter="sale" type="button">Sale</button>
          </div>
        {% endif %}
      </div>
      
      <div class="collection-toolbar__right">
        {% if section.settings.enable_sorting %}
          <div class="collection-sort">
            <label for="MaisonSortBy" class="visually-hidden">Sort Collection</label>
            <select id="MaisonSortBy" class="collection-sort__select">
              <option value="manual">Curated Selection</option>
              <option value="best-selling">Best Sellers</option>
              <option value="title-ascending">Alphabetical: A-Z</option>
              <option value="title-descending">Alphabetical: Z-A</option>
              <option value="price-ascending">Price: Low to High</option>
              <option value="price-descending">Price: High to Low</option>
              <option value="created-descending">Latest Arrivals</option>
            </select>
          </div>
        {% endif %}
        
        {% if section.settings.enable_view_toggle %}
          <div class="view-toggle">
            <button class="view-toggle__btn is-active" data-view="grid" type="button" aria-label="Grid View" aria-pressed="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/></svg>
            </button>
            <button class="view-toggle__btn" data-view="editorial" type="button" aria-label="Editorial View" aria-pressed="false">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="8" y1="6" x2="21" y2="6"/><line x1="8" y1="12" x2="21" y2="12"/><line x1="8" y1="18" x2="21" y2="18"/><line x1="3" y1="6" x2="3.01" y2="6"/><line x1="3" y1="12" x2="3.01" y2="12"/><line x1="3" y1="18" x2="3.01" y2="18"/></svg>
            </button>
          </div>
        {% endif %}
      </div>
    </div>

    <main class="collection-main">
      <div class="product-grid" id="maisonProductGrid">
        {% for product in collection.products %}
          {% liquid
            assign on_sale = false
            assign discount_percent = 0
            assign is_low_stock = false
            assign is_new = false
            assign stock_message = ''
            
            if product.compare_at_price > product.price
              assign on_sale = true
              assign discount_percent = product.compare_at_price | minus: product.price | times: 100 | divided_by: product.compare_at_price | round
            endif
            
            if product.variants.first.inventory_quantity <= 5 and product.variants.first.inventory_quantity > 0
              assign is_low_stock = true
              if product.variants.first.inventory_quantity == 1
                assign stock_message = 'Last piece in stock'
              elsif product.variants.first.inventory_quantity == 2
                assign stock_message = 'Only 2 remaining'
              else
                assign stock_message = 'Only ' | append: product.variants.first.inventory_quantity | append: ' left'
              endif
            endif
            
            assign days_since_creation = 'now' | date: '%s' | minus: product.created_at | date: '%s' | divided_by: 86400
            if days_since_creation <= 30
              assign is_new = true
            endif
            
            assign product_materials = product.metafields.custom.material | default: ''
            assign product_rating = product.metafields.reviews.rating | default: 5.0
            assign product_review_count = product.metafields.reviews.count | default: 0
            assign sizing_fit = product.metafields.custom.fit | default: 'True to size'
          %}

          <article class="product-card" data-product-id="{{ product.id }}" itemscope itemtype="https://schema.org/Product">
            <meta itemprop="name" content="{{ product.title | escape }}">
            <meta itemprop="url" content="{{ product.url }}">
            <meta itemprop="image" content="{{ product.featured_image | image_url: width: 1200 }}">
            <meta itemprop="description" content="{{ product.description | strip_html | truncatewords: 50 | escape }}">
            
            <div class="product-card__badges">
              {% if on_sale %}
                <span class="product-badge product-badge--sale">-{{ discount_percent }}%</span>
              {% endif %}
              {% if is_new %}
                <span class="product-badge product-badge--new">New Arrival</span>
              {% endif %}
              {% unless product.available %}
                <span class="product-badge product-badge--sold-out">Sold Out</span>
              {% endunless %}
              {% if product_materials != blank %}
                <span class="product-badge product-badge--material">{{ product_materials }}</span>
              {% endif %}
            </div>

            <button class="product-card__wishlist js-maison-wishlist" data-product-id="{{ product.id }}" data-product-title="{{ product.title | escape }}" type="button" aria-label="Add {{ product.title | escape }} to wishlist" aria-pressed="false">
              <svg class="heart-outline" viewBox="0 0 24 24"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/></svg>
              <svg class="heart-filled" viewBox="0 0 24 24"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/></svg>
            </button>

            <a href="{{ product.url }}" class="product-card__image-wrapper">
              <div class="product-card__image-container">
                {% if product.featured_image %}
                  <img class="product-card__image product-card__image--primary" src="{{ product.featured_image | image_url: width: 800 }}" alt="{{ product.title | escape }}" loading="lazy" itemprop="image">
                {% else %}
                  {{ 'product-1' | placeholder_svg_tag: 'product-card__image' }}
                {% endif %}
                
                {% if product.images[1] and section.settings.show_second_image %}
                  <img class="product-card__image product-card__image--secondary" src="{{ product.images[1] | image_url: width: 800 }}" alt="{{ product.title | escape }} - Alternate View" loading="lazy">
                {% endif %}
              </div>

              {% if section.settings.show_color_swatches and product.options contains 'Color' %}
                <div class="product-card__swatches">
                  <span class="product-swatch product-swatch--black" title="Black"></span>
                  <span class="product-swatch product-swatch--white" title="White"></span>
                  <span class="product-swatch product-swatch--navy" title="Navy"></span>
                </div>
              {% endif %}

              {% if is_low_stock and product.available %}
                <div class="product-card__stock">{{ stock_message }}</div>
              {% endif %}

              <div class="product-card__quick-actions">
                <button class="product-card__quick-btn" type="button" aria-label="Quick view {{ product.title | escape }}">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
                  <span>Quick View</span>
                </button>
              </div>
            </a>

            <div class="product-card__info">
              {% if section.settings.show_vendor and product.vendor != blank %}
                <p class="product-card__vendor" itemprop="brand">{{ product.vendor }}</p>
              {% endif %}

              <h3 class="product-card__title">
                <a href="{{ product.url }}" class="product-card__title-link" itemprop="url">
                  <span itemprop="name">{{ product.title }}</span>
                </a>
              </h3>

              {% if product_materials != blank %}
                <p class="product-card__material">{{ product_materials }}</p>
              {% endif %}

              {% if section.settings.show_rating and product_review_count > 0 %}
                <div class="product-card__rating" itemprop="aggregateRating" itemscope itemtype="https://schema.org/AggregateRating">
                  <meta itemprop="ratingValue" content="{{ product_rating }}">
                  <meta itemprop="reviewCount" content="{{ product_review_count }}">
                  <div class="product-rating__stars" aria-label="Rated {{ product_rating }} out of 5 stars">
                    {% for i in (1..5) %}
                      {% if i <= product_rating %}
                        <svg class="product-rating__star" viewBox="0 0 24 24"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
                      {% else %}
                        <svg class="product-rating__star product-rating__star--empty" viewBox="0 0 24 24"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
                      {% endif %}
                    {% endfor %}
                  </div>
                  <span class="product-rating__count">({{ product_review_count }})</span>
                </div>
              {% endif %}

              {% if section.settings.show_sizing and sizing_fit != blank %}
                <div class="product-card__sizing">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M16 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="8.5" cy="7" r="4"/><line x1="20" y1="8" x2="20" y2="14"/><line x1="23" y1="11" x2="17" y2="11"/></svg>
                  <span>{{ sizing_fit }}</span>
                </div>
              {% endif %}

              <div class="product-card__price-wrapper" itemprop="offers" itemscope itemtype="https://schema.org/Offer">
                <meta itemprop="priceCurrency" content="{{ cart.currency.iso_code }}">
                <meta itemprop="price" content="{{ product.price | money_without_currency }}">
                <meta itemprop="availability" content="{% if product.available %}https://schema.org/InStock{% else %}https://schema.org/OutOfStock{% endif %}">
                <meta itemprop="url" content="{{ product.url }}">
                
                <div class="product-card__price-row">
                  {% if on_sale %}
                    <span class="product-card__price product-card__price--sale">{{ product.price | money }}</span>
                    <span class="product-card__price-compare">{{ product.compare_at_price | money }}</span>
                  {% else %}
                    <span class="product-card__price">{{ product.price | money }}</span>
                  {% endif %}
                </div>
                
                {% if on_sale %}
                  <span class="product-card__savings">Save {{ discount_percent }}%</span>
                {% endif %}
              </div>

              {% if product.available %}
                {% if product.variants.size == 1 %}
                  <button class="product-card__button product-card__button--primary js-maison-add-cart" data-variant-id="{{ product.selected_or_first_available_variant.id }}" data-product-title="{{ product.title | escape }}" type="button" aria-label="Add {{ product.title | escape }} to cart">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="9" cy="21" r="1"/><circle cx="20" cy="21" r="1"/><path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"/></svg>
                    <span>Add to Cart</span>
                  </button>
                {% else %}
                  <a href="{{ product.url }}" class="product-card__button product-card__button--secondary">
                    <span>Select Size</span>
                  </a>
                {% endif %}
              {% else %}
                <button class="product-card__button product-card__button--disabled" disabled aria-label="{{ product.title | escape }} is sold out">
                  <span>Sold Out</span>
                </button>
              {% endif %}
            </div>
          </article>
        {% endfor %}
      </div>

      {% if paginate.pages > 1 %}
        <nav class="pagination" aria-label="Collection pagination">
          {% if paginate.previous %}
            <a href="{{ paginate.previous.url }}" class="pagination__item" aria-label="Previous page">‹</a>
          {% else %}
            <span class="pagination__item is-disabled" aria-hidden="true">‹</span>
          {% endif %}
          
          {% for part in paginate.parts %}
            {% if part.is_link %}
              <a href="{{ part.url }}" class="pagination__item" aria-label="Page {{ part.title }}">{{ part.title }}</a>
            {% else %}
              {% if part.title == paginate.current_page %}
                <span class="pagination__item is-active" aria-current="page" aria-label="Current page, page {{ part.title }}">{{ part.title }}</span>
              {% else %}
                <span class="pagination__item">{{ part.title }}</span>
              {% endif %}
            {% endif %}
          {% endfor %}
          
          {% if paginate.next %}
            <a href="{{ paginate.next.url }}" class="pagination__item" aria-label="Next page">›</a>
          {% else %}
            <span class="pagination__item is-disabled" aria-hidden="true">›</span>
          {% endif %}
        </nav>
      {% endif %}
    </main>
    
    {% endpaginate %}
  </div>
</div>

<div class="loading-overlay" id="maisonLoadingOverlay" aria-live="polite" aria-busy="false">
  <div class="loading-spinner" role="status" aria-label="Loading"></div>
</div>

<script>
(function(){'use strict';const MAISON_CONFIG={WISHLIST_KEY:'maison_luxury_wishlist_v2',VIEW_KEY:'maison_view_preference',TOAST_DURATION:4200,ANIMATION_DELAY:180};const MaisonUtils={escapeHTML(t){const e=document.createElement('div');e.textContent=t;return e.innerHTML},formatMoney(c){if(typeof Shopify!=='undefined'&&Shopify.formatMoney){return Shopify.formatMoney(c,window.theme?.moneyFormat||'${{amount}}')}return `$${(c/100).toFixed(2)}`},debounce(fn,delay){let timer;return function(...args){clearTimeout(timer);timer=setTimeout(()=>fn.apply(this,args),delay)}}};const MaisonToast={show(title,message,type='success'){const toast=document.createElement('div');toast.className=`toast toast--${type}`;const icons={success:'<svg class="toast__icon toast__icon--success" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>',error:'<svg class="toast__icon toast__icon--error" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><circle cx="12" cy="12" r="10"/><line x1="15" y1="9" x2="9" y2="15"/><line x1="9" y1="9" x2="15" y2="15"/></svg>',info:'<svg class="toast__icon toast__icon--info" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><circle cx="12" cy="12" r="10"/><line x1="12" y1="16" x2="12" y2="12"/><line x1="12" y1="8" x2="12.01" y2="8"/></svg>'};toast.innerHTML=`${icons[type]||icons.success}<div class="toast__content"><div class="toast__title">${MaisonUtils.escapeHTML(title)}</div><div class="toast__message">${MaisonUtils.escapeHTML(message)}</div></div><button class="toast__close" type="button" aria-label="Close notification"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg></button>`;document.body.appendChild(toast);toast.querySelector('.toast__close').addEventListener('click',()=>this.hide(toast));requestAnimationFrame(()=>toast.classList.add('is-visible'));setTimeout(()=>this.hide(toast),MAISON_CONFIG.TOAST_DURATION)},hide(toast){toast.classList.remove('is-visible');setTimeout(()=>toast.remove(),320)}};const MaisonWishlist={items:[],init(){this.load();this.updateUI();this.attachEvents()},load(){try{const stored=localStorage.getItem(MAISON_CONFIG.WISHLIST_KEY);this.items=stored?JSON.parse(stored):[]}catch(e){this.items=[]}},save(){try{localStorage.setItem(MAISON_CONFIG.WISHLIST_KEY,JSON.stringify(this.items))}catch(e){MaisonToast.show('Error','Unable to save wishlist','error')}},toggle(productId,productTitle){const index=this.items.indexOf(productId);if(index>-1){this.items.splice(index,1);MaisonToast.show('Removed',`${productTitle} removed from wishlist`,'info')}else{this.items.push(productId);MaisonToast.show('Added to Wishlist',productTitle,'success')}this.save();this.updateUI()},has(productId){return this.items.includes(productId)},updateUI(){document.querySelectorAll('.js-maison-wishlist').forEach(btn=>{const productId=btn.dataset.productId;if(this.has(productId)){btn.classList.add('is-active');btn.setAttribute('aria-pressed','true')}else{btn.classList.remove('is-active');btn.setAttribute('aria-pressed','false')}})},attachEvents(){document.addEventListener('click',e=>{const btn=e.target.closest('.js-maison-wishlist');if(!btn)return;e.preventDefault();e.stopPropagation();const productId=btn.dataset.productId;const productTitle=btn.dataset.productTitle||'Product';this.toggle(productId,productTitle)})}};const MaisonCart={async addItem(variantId,quantity=1,productTitle='Product'){if(!variantId){MaisonToast.show('Error','Invalid product selection','error');return false}try{const response=await fetch('/cart/add.js',{method:'POST',headers:{'Content-Type':'application/json','Accept':'application/json'},body:JSON.stringify({items:[{id:variantId,quantity:quantity}]})});if(!response.ok){const error=await response.json();throw new Error(error.description||'Unable to add to cart')}await response.json();document.dispatchEvent(new CustomEvent('cart:updated'));MaisonToast.show('Added to Cart',productTitle,'success');return true}catch(error){console.error('Cart error:',error);MaisonToast.show('Error',error.message||'Unable to add to cart','error');return false}}};const MaisonAddToCart={init(){document.addEventListener('click',async e=>{const btn=e.target.closest('.js-maison-add-cart');if(!btn)return;e.preventDefault();const variantId=btn.dataset.variantId;const productTitle=btn.dataset.productTitle||'Product';btn.classList.add('is-loading');btn.disabled=true;const originalHTML=btn.innerHTML;const success=await MaisonCart.addItem(variantId,1,productTitle);if(success){btn.innerHTML='<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg><span>Added</span>';setTimeout(()=>{btn.innerHTML=originalHTML;btn.classList.remove('is-loading');btn.disabled=false},2200)}else{btn.classList.remove('is-loading');btn.disabled=false}})}};const MaisonSorting={init(){const select=document.getElementById('MaisonSortBy');if(!select)return;const params=new URLSearchParams(window.location.search);const currentSort=params.get('sort_by');if(currentSort)select.value=currentSort;select.addEventListener('change',function(){const url=new URL(window.location.href);url.searchParams.set('sort_by',this.value);window.location.href=url.toString()})}};const MaisonViewToggle={init(){const buttons=document.querySelectorAll('.view-toggle__btn');const grid=document.getElementById('maisonProductGrid');if(!buttons.length||!grid)return;buttons.forEach(btn=>{btn.addEventListener('click',()=>{const view=btn.dataset.view;buttons.forEach(b=>{b.classList.remove('is-active');b.setAttribute('aria-pressed','false')});btn.classList.add('is-active');btn.setAttribute('aria-pressed','true');if(view==='editorial'){grid.classList.add('view-editorial')}else{grid.classList.remove('view-editorial')}try{localStorage.setItem(MAISON_CONFIG.VIEW_KEY,view)}catch(e){}})});try{const savedView=localStorage.getItem(MAISON_CONFIG.VIEW_KEY);if(savedView==='editorial'){grid.classList.add('view-editorial');buttons.forEach(btn=>{if(btn.dataset.view==='editorial'){btn.classList.add('is-active');btn.setAttribute('aria-pressed','true')}else{btn.classList.remove('is-active');btn.setAttribute('aria-pressed','false')}})}}catch(e){}}};const MaisonFilters={init(){const filterChips=document.querySelectorAll('.collection-filter__chip');if(!filterChips.length)return;filterChips.forEach(chip=>{chip.addEventListener('click',function(){filterChips.forEach(c=>c.classList.remove('is-active'));this.classList.add('is-active');const filter=this.dataset.filter;console.log('Filter selected:',filter)})})}};function initMaison(){MaisonWishlist.init();MaisonAddToCart.init();MaisonSorting.init();MaisonViewToggle.init();MaisonFilters.init();console.log('✨ MAISON - Ultra Luxury Collection initialized')}if(document.readyState==='loading'){document.addEventListener('DOMContentLoaded',initMaison)}else{initMaison()}})();
</script>


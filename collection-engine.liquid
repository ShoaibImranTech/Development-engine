{% comment %}
═══════════════════════════════════════════════════════════════════════════════
ULTRA PREMIUM COLLECTION SECTION - PROFESSIONAL EDITION v2.0
═══════════════════════════════════════════════════════════════════════════════
{% endcomment %}

<style>
:root {
  --brand-primary: {{ section.settings.primary_color | default: '#000000' }};
  --brand-secondary: {{ section.settings.secondary_color | default: '#1a1a1a' }};
  --brand-accent: {{ section.settings.accent_color | default: '#c9a961' }};
  --brand-bg: {{ section.settings.background_color | default: '#ffffff' }};
  --color-text-primary: #0a0a0a;
  --color-text-secondary: #4a4a4a;
  --color-text-muted: #8a8a8a;
  --color-surface: #ffffff;
  --color-surface-elevated: #fafafa;
  --color-border: #e0e0e0;
  --color-border-light: #f0f0f0;
  --color-success: #059669;
  --color-error: #dc2626;
  --color-warning: #d97706;
  --shadow-sm: 0 2px 4px -1px rgba(0,0,0,0.06);
  --shadow-md: 0 4px 6px -1px rgba(0,0,0,0.08);
  --shadow-lg: 0 10px 15px -3px rgba(0,0,0,0.1);
  --shadow-xl: 0 20px 25px -5px rgba(0,0,0,0.1);
  --shadow-premium: 0 30px 60px -15px rgba(0,0,0,0.3);
  --radius-sm: 8px;
  --radius-md: 12px;
  --radius-lg: 16px;
  --radius-xl: 20px;
  --radius-full: 9999px;
  --transition-swift: 150ms cubic-bezier(0.4,0,0.2,1);
  --transition-smooth: 250ms cubic-bezier(0.4,0,0.2,1);
  --transition-elegant: 350ms cubic-bezier(0.4,0,0.2,1);
  --space-2: 8px;
  --space-3: 12px;
  --space-4: 16px;
  --space-5: 20px;
  --space-6: 24px;
  --space-8: 32px;
  --space-12: 48px;
  --space-16: 64px;
  --container-max: 1600px;
  --container-padding: clamp(24px,5vw,48px);
  --grid-gap: clamp(24px,3vw,40px);
}

.ultra-premium-collection{position:relative;padding:var(--section-padding-top,100px) 0 var(--section-padding-bottom,100px);background:var(--brand-bg);font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',sans-serif;color:var(--color-text-primary);-webkit-font-smoothing:antialiased}
.ultra-premium-collection__container{max-width:var(--container-max);margin:0 auto;padding:0 var(--container-padding)}
.visually-hidden{position:absolute!important;width:1px!important;height:1px!important;padding:0!important;margin:-1px!important;overflow:hidden!important;clip:rect(0,0,0,0)!important;white-space:nowrap!important;border:0!important}
.luxury-announcement{background:linear-gradient(135deg,var(--brand-primary),var(--brand-secondary));color:#fff;padding:20px 32px;text-align:center;margin-bottom:var(--space-16);border-radius:var(--radius-lg);animation:slideInDown .8s cubic-bezier(.34,1.56,.64,1)}
@keyframes slideInDown{from{opacity:0;transform:translateY(-30px)}to{opacity:1;transform:translateY(0)}}
.luxury-announcement__content{display:flex;align-items:center;justify-content:center;gap:var(--space-3);font-size:15px;font-weight:600}
.collection-header{margin-bottom:var(--space-16);animation:fadeInUp .8s}
@keyframes fadeInUp{from{opacity:0;transform:translateY(20px)}to{opacity:1;transform:translateY(0)}}
.collection-header__top{display:flex;justify-content:space-between;gap:var(--space-6);margin-bottom:var(--space-8);flex-wrap:wrap}
.collection-header__title{font-size:clamp(36px,6vw,64px);font-weight:300;line-height:1.1;letter-spacing:-.03em;margin:0 0 var(--space-4);background:linear-gradient(135deg,var(--brand-primary),var(--brand-secondary) 60%,var(--brand-accent));-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text}
.collection-header__description{font-size:16px;line-height:1.6;color:var(--color-text-secondary);max-width:600px;margin-bottom:var(--space-4)}
.collection-header__meta{display:flex;gap:var(--space-6);flex-wrap:wrap}
.collection-meta__item{display:flex;align-items:center;gap:var(--space-2);font-size:14px;color:var(--color-text-secondary)}
.collection-meta__number{font-weight:700;color:var(--brand-accent);font-size:18px}
.collection-toolbar{display:flex;justify-content:space-between;gap:var(--space-4);padding:var(--space-6);background:var(--color-surface-elevated);border-radius:var(--radius-lg);margin-bottom:var(--space-12);flex-wrap:wrap}
.collection-toolbar__left,.collection-toolbar__right{display:flex;gap:var(--space-4);flex-wrap:wrap}
.collection-sort__select{appearance:none;padding:12px 44px 12px 20px;font-size:14px;font-weight:600;background:var(--color-surface) url("data:image/svg+xml,%3Csvg width='14' height='8' viewBox='0 0 14 8' fill='none' xmlns='http://www.w3.org/2000/svg'%3E%3Cpath d='M1 1L7 7L13 1' stroke='%234a4a4a' stroke-width='2' stroke-linecap='round'/%3E%3C/svg%3E") no-repeat right 16px center;border:2px solid var(--color-border);border-radius:var(--radius-md);cursor:pointer;transition:all var(--transition-smooth);min-width:200px}
.collection-sort__select:hover{border-color:var(--brand-primary);box-shadow:var(--shadow-sm)}
.collection-sort__select:focus{outline:none;border-color:var(--brand-primary);box-shadow:0 0 0 3px rgba(201,169,97,.1)}
.view-toggle{display:flex;gap:4px;background:var(--color-surface);padding:4px;border-radius:var(--radius-md);border:2px solid var(--color-border)}
.view-toggle__btn{display:flex;padding:10px 14px;background:0 0;border:none;border-radius:var(--radius-sm);cursor:pointer;transition:all var(--transition-swift);color:var(--color-text-muted)}
.view-toggle__btn:hover{color:var(--color-text-primary);background:var(--color-surface-elevated)}
.view-toggle__btn.is-active{background:var(--brand-primary);color:#fff;box-shadow:var(--shadow-sm)}
.view-toggle__btn svg{width:20px;height:20px}
.product-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(min(100%,300px),1fr));gap:var(--grid-gap);margin-bottom:var(--space-16)}
@media (min-width:640px){.product-grid{grid-template-columns:repeat(2,1fr)}}
@media (min-width:1024px){.product-grid{grid-template-columns:repeat(3,1fr)}}
@media (min-width:1280px){.product-grid:not(.has-sidebar){grid-template-columns:repeat(4,1fr)}}
.product-grid.view-list{grid-template-columns:1fr}
.product-card{position:relative;background:var(--color-surface);border-radius:var(--radius-xl);overflow:hidden;transition:all var(--transition-elegant);border:1px solid var(--color-border-light);display:flex;flex-direction:column;height:100%}
.product-card:hover{transform:translateY(-8px);box-shadow:var(--shadow-premium);border-color:var(--color-border)}
.product-card__badges{position:absolute;top:16px;left:16px;z-index:10;display:flex;flex-direction:column;gap:8px;pointer-events:none}
.product-badge{display:inline-flex;align-items:center;gap:6px;padding:8px 14px;font-size:10px;font-weight:800;text-transform:uppercase;letter-spacing:.08em;border-radius:var(--radius-md);backdrop-filter:blur(16px);box-shadow:var(--shadow-lg);animation:badgeEntry .5s cubic-bezier(.34,1.56,.64,1) backwards}
@keyframes badgeEntry{from{opacity:0;transform:scale(.8) translateX(-20px)}to{opacity:1;transform:scale(1) translateX(0)}}
.product-badge--sale{background:rgba(220,38,38,.95);color:#fff}
.product-badge--new{background:rgba(5,150,105,.95);color:#fff}
.product-badge--low-stock{background:rgba(217,119,6,.95);color:#fff}
.product-badge--sold-out{background:rgba(74,74,74,.95);color:#fff}
.product-card__wishlist{position:absolute;top:16px;right:16px;z-index:10;width:48px;height:48px;display:flex;align-items:center;justify-content:center;background:rgba(255,255,255,.98);border:none;border-radius:var(--radius-full);cursor:pointer;transition:all var(--transition-smooth);box-shadow:var(--shadow-lg)}
.product-card__wishlist:hover{transform:scale(1.15);box-shadow:var(--shadow-xl)}
.product-card__wishlist:focus{outline:3px solid var(--brand-accent);outline-offset:2px}
.product-card__wishlist svg{width:22px;height:22px}
.product-card__wishlist .heart-outline{stroke:var(--color-text-primary);fill:none;stroke-width:2.5}
.product-card__wishlist .heart-filled{display:none;fill:#dc2626}
.product-card__wishlist.is-active .heart-outline{display:none}
.product-card__wishlist.is-active .heart-filled{display:block;animation:heartBeat .6s cubic-bezier(.34,1.56,.64,1)}
@keyframes heartBeat{0%,100%{transform:scale(1)}30%{transform:scale(1.3)}60%{transform:scale(1.1)}}
.product-card__image-wrapper{position:relative;display:block;overflow:hidden;background:var(--color-surface-elevated);border-radius:var(--radius-lg) var(--radius-lg) 0 0}
.product-card__image-container{position:relative;padding-bottom:125%;overflow:hidden}
.product-card__image{position:absolute;top:0;left:0;width:100%;height:100%;object-fit:cover;transition:transform var(--transition-elegant)}
.product-card__image--primary{z-index:2}
.product-card__image--secondary{opacity:0;z-index:1;transition:opacity var(--transition-elegant)}
.product-card:hover .product-card__image--primary{transform:scale(1.08)}
.product-card:hover .product-card__image--secondary{opacity:1}
.product-card__quick-actions{position:absolute;bottom:20px;left:50%;transform:translateX(-50%) translateY(100px);display:flex;gap:var(--space-2);opacity:0;transition:all var(--transition-elegant);z-index:5}
.product-card:hover .product-card__quick-actions{transform:translateX(-50%) translateY(0);opacity:1}
.product-card__quick-view{display:inline-flex;align-items:center;gap:var(--space-2);padding:14px 28px;background:rgba(0,0,0,.96);color:#fff;border:none;border-radius:var(--radius-full);font-size:13px;font-weight:700;cursor:pointer;transition:all var(--transition-smooth);box-shadow:var(--shadow-xl)}
.product-card__quick-view:hover{background:var(--brand-primary);transform:translateY(-2px);box-shadow:var(--shadow-premium)}
.product-card__quick-view:focus{outline:3px solid var(--brand-accent);outline-offset:2px}
.product-card__quick-view svg{width:18px;height:18px}
.product-card__stock-indicator{position:absolute;bottom:20px;right:20px;display:flex;align-items:center;gap:6px;padding:8px 14px;background:rgba(217,119,6,.95);color:#fff;font-size:11px;font-weight:700;border-radius:var(--radius-md);backdrop-filter:blur(12px);z-index:5;animation:pulseGlow 2s ease-in-out infinite}
@keyframes pulseGlow{0%,100%{box-shadow:0 0 10px rgba(217,119,6,.3)}50%{box-shadow:0 0 20px rgba(217,119,6,.6)}}
.product-card__info{padding:var(--space-6);flex:1;display:flex;flex-direction:column}
.product-card__vendor{font-size:11px;text-transform:uppercase;letter-spacing:.1em;color:var(--color-text-muted);margin-bottom:var(--space-2);font-weight:700}
.product-card__title{font-size:16px;font-weight:600;line-height:1.4;margin:0 0 var(--space-3);min-height:44px;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden}
.product-card__title-link{color:var(--color-text-primary);text-decoration:none;transition:color var(--transition-swift)}
.product-card__title-link:hover{color:var(--brand-primary)}
.product-card__title-link:focus{outline:2px solid var(--brand-primary);outline-offset:2px;border-radius:4px}
.product-card__rating{display:flex;gap:var(--space-2);margin-bottom:var(--space-3)}
.product-rating__stars{display:flex;gap:2px}
.product-rating__star{width:14px;height:14px;fill:var(--brand-accent)}
.product-rating__count{font-size:12px;color:var(--color-text-muted)}
.product-card__price-wrapper{display:flex;gap:var(--space-3);margin-bottom:var(--space-5);flex-wrap:wrap}
.product-card__price{font-size:22px;font-weight:800;letter-spacing:-.02em}
.product-card__price--sale{color:var(--color-error)}
.product-card__price-compare{font-size:16px;color:var(--color-text-muted);text-decoration:line-through}
.product-card__savings{background:#fef3c7;color:#92400e;padding:4px 10px;border-radius:var(--radius-sm);font-size:11px;font-weight:800}
.product-card__button{width:100%;padding:16px 24px;font-size:14px;font-weight:700;border:none;border-radius:var(--radius-md);cursor:pointer;transition:all var(--transition-smooth);display:inline-flex;align-items:center;justify-content:center;gap:var(--space-2);margin-top:auto;position:relative;overflow:hidden}
.product-card__button::before{content:'';position:absolute;top:50%;left:50%;width:0;height:0;background:rgba(255,255,255,.2);border-radius:50%;transform:translate(-50%,-50%);transition:width var(--transition-elegant),height var(--transition-elegant)}
.product-card__button:hover::before{width:300px;height:300px}
.product-card__button--primary{background:var(--brand-primary);color:#fff}
.product-card__button--primary:hover{background:var(--brand-secondary);transform:translateY(-2px);box-shadow:var(--shadow-xl)}
.product-card__button--primary:focus{outline:3px solid var(--brand-accent);outline-offset:2px}
.product-card__button--secondary{background:var(--color-surface);color:var(--color-text-primary);border:2px solid var(--color-border)}
.product-card__button--secondary:hover{border-color:var(--brand-primary);color:var(--brand-primary);transform:translateY(-2px)}
.product-card__button--disabled{background:var(--color-surface-elevated);color:var(--color-text-muted);cursor:not-allowed;opacity:.6}
.product-card__button.is-loading{color:transparent;pointer-events:none}
.product-card__button.is-loading::after{content:'';position:absolute;width:20px;height:20px;border:3px solid rgba(255,255,255,.3);border-top-color:#fff;border-radius:50%;animation:spin .6s linear infinite}
@keyframes spin{to{transform:rotate(360deg)}}
.product-card__button svg,.product-card__button span{position:relative;z-index:1}
.product-card__button svg{width:18px;height:18px}

/* QUICK VIEW MODAL STYLES */
.quick-view-modal{position:fixed;top:0;left:0;width:100%;height:100%;z-index:9999;display:none;align-items:center;justify-content:center;padding:var(--space-4)}
.quick-view-modal.is-active{display:flex}
.quick-view-modal__backdrop{position:absolute;top:0;left:0;width:100%;height:100%;background:rgba(0,0,0,.85);backdrop-filter:blur(12px);animation:fadeIn .3s ease-out}
@keyframes fadeIn{from{opacity:0}to{opacity:1}}
.quick-view-modal__container{position:relative;width:100%;max-width:1200px;max-height:90vh;background:var(--color-surface);border-radius:var(--radius-xl);box-shadow:var(--shadow-premium);overflow:hidden;animation:modalSlideUp .4s cubic-bezier(.34,1.56,.64,1);display:flex;flex-direction:column}
@keyframes modalSlideUp{from{opacity:0;transform:translateY(40px) scale(.95)}to{opacity:1;transform:translateY(0) scale(1)}}
.quick-view-modal__close{position:absolute;top:20px;right:20px;z-index:10;width:44px;height:44px;display:flex;align-items:center;justify-content:center;background:rgba(255,255,255,.98);border:none;border-radius:var(--radius-full);cursor:pointer;transition:all var(--transition-smooth);box-shadow:var(--shadow-lg)}
.quick-view-modal__close:hover{transform:rotate(90deg) scale(1.1);background:var(--color-error);color:#fff}
.quick-view-modal__close svg{width:24px;height:24px}
.quick-view-modal__content{display:grid;grid-template-columns:1fr 1fr;gap:var(--space-12);padding:var(--space-12);overflow-y:auto}
.quick-view-modal__gallery{position:relative}
.quick-view-modal__main-image{position:relative;border-radius:var(--radius-lg);overflow:hidden;background:var(--color-surface-elevated);margin-bottom:var(--space-4)}
.quick-view-modal__main-image img{width:100%;height:auto;display:block}
.quick-view-modal__thumbnails{display:grid;grid-template-columns:repeat(auto-fill,minmax(80px,1fr));gap:var(--space-3)}
.quick-view-modal__thumbnail{border-radius:var(--radius-md);overflow:hidden;cursor:pointer;border:3px solid transparent;transition:all var(--transition-swift)}
.quick-view-modal__thumbnail:hover,.quick-view-modal__thumbnail.is-active{border-color:var(--brand-primary)}
.quick-view-modal__thumbnail img{width:100%;height:auto;display:block}
.quick-view-modal__details{display:flex;flex-direction:column;gap:var(--space-6)}
.quick-view-modal__vendor{font-size:12px;text-transform:uppercase;letter-spacing:.12em;color:var(--color-text-muted);font-weight:700}
.quick-view-modal__title{font-size:32px;font-weight:600;line-height:1.2;margin:0;color:var(--color-text-primary)}
.quick-view-modal__rating{display:flex;align-items:center;gap:var(--space-3)}
.quick-view-modal__stars{display:flex;gap:4px}
.quick-view-modal__star{width:18px;height:18px;fill:var(--brand-accent)}
.quick-view-modal__reviews{font-size:14px;color:var(--color-text-secondary)}
.quick-view-modal__price{display:flex;align-items:baseline;gap:var(--space-4);flex-wrap:wrap}
.quick-view-modal__price-current{font-size:36px;font-weight:800;letter-spacing:-.02em;color:var(--color-text-primary)}
.quick-view-modal__price-current--sale{color:var(--color-error)}
.quick-view-modal__price-compare{font-size:24px;color:var(--color-text-muted);text-decoration:line-through}
.quick-view-modal__savings{background:linear-gradient(135deg,#fef3c7,#fed7aa);color:#92400e;padding:8px 16px;border-radius:var(--radius-md);font-size:13px;font-weight:800;box-shadow:var(--shadow-sm)}
.quick-view-modal__description{font-size:15px;line-height:1.7;color:var(--color-text-secondary);border-top:1px solid var(--color-border-light);border-bottom:1px solid var(--color-border-light);padding:var(--space-6) 0}
.quick-view-modal__variants{display:flex;flex-direction:column;gap:var(--space-4)}
.quick-view-modal__variant-label{font-size:13px;font-weight:700;text-transform:uppercase;letter-spacing:.08em;color:var(--color-text-primary);margin-bottom:var(--space-2)}
.quick-view-modal__variant-options{display:flex;gap:var(--space-3);flex-wrap:wrap}
.quick-view-modal__variant-option{min-width:60px;padding:12px 20px;border:2px solid var(--color-border);border-radius:var(--radius-md);background:var(--color-surface);cursor:pointer;transition:all var(--transition-swift);font-size:14px;font-weight:600;text-align:center}
.quick-view-modal__variant-option:hover{border-color:var(--brand-primary);transform:translateY(-2px)}
.quick-view-modal__variant-option.is-active{border-color:var(--brand-primary);background:var(--brand-primary);color:#fff;box-shadow:var(--shadow-md)}
.quick-view-modal__variant-option.is-disabled{opacity:.4;cursor:not-allowed}
.quick-view-modal__quantity{display:flex;flex-direction:column;gap:var(--space-2)}
.quick-view-modal__quantity-controls{display:flex;border:2px solid var(--color-border);border-radius:var(--radius-md);overflow:hidden;width:fit-content}
.quick-view-modal__quantity-btn{width:48px;height:48px;display:flex;align-items:center;justify-content:center;background:var(--color-surface-elevated);border:none;cursor:pointer;transition:all var(--transition-swift);font-size:20px;font-weight:700;color:var(--color-text-primary)}
.quick-view-modal__quantity-btn:hover{background:var(--brand-primary);color:#fff}
.quick-view-modal__quantity-input{width:80px;height:48px;border:none;border-left:2px solid var(--color-border);border-right:2px solid var(--color-border);text-align:center;font-size:16px;font-weight:700}
.quick-view-modal__actions{display:flex;gap:var(--space-3);margin-top:var(--space-4)}
.quick-view-modal__add-to-cart{flex:1;padding:18px 32px;font-size:16px;font-weight:700;background:var(--brand-primary);color:#fff;border:none;border-radius:var(--radius-md);cursor:pointer;transition:all var(--transition-smooth);display:inline-flex;align-items:center;justify-content:center;gap:var(--space-3)}
.quick-view-modal__add-to-cart:hover{background:var(--brand-secondary);transform:translateY(-2px);box-shadow:var(--shadow-xl)}
.quick-view-modal__add-to-cart.is-loading{pointer-events:none;color:transparent}
.quick-view-modal__add-to-cart.is-loading::after{content:'';position:absolute;width:24px;height:24px;border:3px solid rgba(255,255,255,.3);border-top-color:#fff;border-radius:50%;animation:spin .6s linear infinite}
.quick-view-modal__wishlist-btn{width:56px;height:56px;display:flex;align-items:center;justify-content:center;background:var(--color-surface-elevated);border:2px solid var(--color-border);border-radius:var(--radius-md);cursor:pointer;transition:all var(--transition-smooth)}
.quick-view-modal__wishlist-btn:hover{border-color:var(--brand-primary);transform:translateY(-2px)}
.quick-view-modal__wishlist-btn svg{width:24px;height:24px}
.quick-view-modal__stock-status{display:inline-flex;align-items:center;gap:var(--space-2);padding:8px 16px;border-radius:var(--radius-md);font-size:13px;font-weight:700}
.quick-view-modal__stock-status--in-stock{background:#d1fae5;color:#065f46}
.quick-view-modal__stock-status--low-stock{background:#fed7aa;color:#92400e}
.quick-view-modal__stock-status--out-of-stock{background:#fee2e2;color:#991b1b}

.toast{position:fixed;bottom:32px;right:32px;max-width:450px;min-width:340px;padding:20px 24px;background:var(--color-surface);border-radius:var(--radius-lg);box-shadow:var(--shadow-premium);display:flex;gap:var(--space-4);transform:translateX(600px);opacity:0;transition:all var(--transition-elegant);z-index:10000;border-left:4px solid var(--color-success)}
.toast.is-visible{transform:translateX(0);opacity:1}
.toast--success{border-left-color:var(--color-success)}
.toast--error{border-left-color:var(--color-error)}
.toast--info{border-left-color:#2563eb}
.toast__icon{flex-shrink:0;width:24px;height:24px}
.toast__icon--success{color:var(--color-success)}
.toast__icon--error{color:var(--color-error)}
.toast__icon--info{color:#2563eb}
.toast__content{flex:1}
.toast__title{font-weight:700;font-size:14px;margin-bottom:4px}
.toast__message{font-size:14px;color:var(--color-text-secondary);line-height:1.4}
.toast__close{flex-shrink:0;width:24px;height:24px;border:none;background:0 0;cursor:pointer;color:var(--color-text-muted);transition:color var(--transition-swift)}
.toast__close:hover{color:var(--color-text-primary)}
.toast__close svg{width:16px;height:16px}
.pagination{display:flex;justify-content:center;gap:var(--space-2);margin-top:var(--space-16)}
.pagination__item{min-width:44px;height:44px;display:flex;align-items:center;justify-content:center;padding:0 var(--space-4);background:var(--color-surface);border:2px solid var(--color-border);border-radius:var(--radius-md);font-size:14px;font-weight:600;cursor:pointer;transition:all var(--transition-swift);text-decoration:none;color:var(--color-text-primary)}
.pagination__item:hover{border-color:var(--brand-primary);color:var(--brand-primary);transform:translateY(-2px)}
.pagination__item.is-active{background:var(--brand-primary);border-color:var(--brand-primary);color:#fff}
.pagination__item.is-disabled{opacity:.4;cursor:not-allowed}
.loading-overlay{position:fixed;top:0;left:0;width:100%;height:100%;background:rgba(255,255,255,.95);backdrop-filter:blur(8px);z-index:9998;display:none;align-items:center;justify-content:center}
.loading-overlay.is-active{display:flex}
.loading-spinner{width:60px;height:60px;border:4px solid var(--color-border-light);border-top-color:var(--brand-primary);border-radius:50%;animation:spin .8s linear infinite}
@media (max-width:1023px){.quick-view-modal__content{grid-template-columns:1fr;max-height:80vh}}
@media (max-width:767px){.collection-header__top{flex-direction:column}.collection-toolbar{flex-direction:column}.collection-toolbar__left,.collection-toolbar__right{width:100%}.collection-sort__select{width:100%}.product-grid{gap:var(--space-6)}.toast{left:16px;right:16px;bottom:16px;min-width:auto}.quick-view-modal{padding:0}.quick-view-modal__container{max-height:100vh;border-radius:0}.quick-view-modal__content{padding:var(--space-6);gap:var(--space-6)}}
@media (max-width:480px){.product-card__info{padding:var(--space-4)}.product-card__title{font-size:14px;min-height:auto}.product-card__price{font-size:18px}.quick-view-modal__title{font-size:24px}.quick-view-modal__price-current{font-size:28px}}
@media (prefers-reduced-motion:reduce){*,*::after,*::before{animation-duration:.01ms!important;animation-iteration-count:1!important;transition-duration:.01ms!important}}
*:focus-visible{outline:3px solid var(--brand-accent);outline-offset:2px}
body.modal-open{overflow:hidden}
</style>

<div class="ultra-premium-collection" style="--section-padding-top:{{ section.settings.padding_top }}px;--section-padding-bottom:{{ section.settings.padding_bottom }}px" role="region" aria-label="Product Collection">
  <div class="ultra-premium-collection__container">
    {% if section.settings.show_announcement and section.settings.announcement_text != blank %}
      <div class="luxury-announcement" role="banner">
        <div class="luxury-announcement__content">
          <span>{{ section.settings.announcement_text }}</span>
        </div>
      </div>
    {% endif %}
    
    {% paginate collection.products by section.settings.products_per_page %}
    <header class="collection-header">
      <div class="collection-header__top">
        <div class="collection-header__title-wrapper">
          <h1 class="collection-header__title">{{ collection.title }}</h1>
          {% if collection.description != blank %}
            <div class="collection-header__description">{{ collection.description | strip_html | truncate: 200 }}</div>
          {% endif %}
          <div class="collection-header__meta">
            <div class="collection-meta__item">
              <span class="collection-meta__number">{{ collection.products_count }}</span>
              <span>{% if collection.products_count == 1 %}Product{% else %}Products{% endif %}</span>
            </div>
          </div>
        </div>
      </div>
      
      <div class="collection-toolbar">
        <div class="collection-toolbar__left"></div>
        <div class="collection-toolbar__right">
          {% if section.settings.enable_sorting %}
            <div class="collection-sort">
              <label for="SortBy" class="visually-hidden">Sort products</label>
              <select id="SortBy" class="collection-sort__select" aria-label="Sort products by">
                <option value="manual">Featured</option>
                <option value="best-selling">Best Selling</option>
                <option value="title-ascending">A-Z</option>
                <option value="title-descending">Z-A</option>
                <option value="price-ascending">Price: Low to High</option>
                <option value="price-descending">Price: High to Low</option>
                <option value="created-descending">Newest</option>
              </select>
            </div>
          {% endif %}
          
          {% if section.settings.enable_view_toggle %}
            <div class="view-toggle" role="group" aria-label="View options">
              <button class="view-toggle__btn is-active" data-view="grid" type="button" aria-label="Grid view" aria-pressed="true">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/></svg>
              </button>
              <button class="view-toggle__btn" data-view="list" type="button" aria-label="List view" aria-pressed="false">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="8" y1="6" x2="21" y2="6"/><line x1="8" y1="12" x2="21" y2="12"/><line x1="8" y1="18" x2="21" y2="18"/></svg>
              </button>
            </div>
          {% endif %}
        </div>
      </div>
    </header>

    <main class="collection-main">
      <div class="product-grid" id="productGrid">
        {% for product in collection.products %}
          {% liquid
            assign on_sale = false
            assign discount_percent = 0
            assign is_low_stock = false
            if product.compare_at_price > product.price
              assign on_sale = true
              assign discount_percent = product.compare_at_price | minus: product.price | times: 100 | divided_by: product.compare_at_price | round
            endif
            if product.variants.first.inventory_quantity <= 5 and product.variants.first.inventory_quantity > 0
              assign is_low_stock = true
            endif
          %}

          <article class="product-card" data-product-id="{{ product.id }}" itemscope itemtype="https://schema.org/Product">
            <meta itemprop="name" content="{{ product.title | escape }}">
            <meta itemprop="url" content="{{ shop.url }}{{ product.url }}">
            <meta itemprop="image" content="{{ product.featured_image | image_url: width: 600 }}">
            <meta itemprop="description" content="{{ product.description | strip_html | truncate: 200 | escape }}">
            
            <div class="product-card__badges">
              {% if on_sale %}
                <span class="product-badge product-badge--sale" aria-label="On sale, {{ discount_percent }}% off">-{{ discount_percent }}%</span>
              {% endif %}
              {% unless product.available %}
                <span class="product-badge product-badge--sold-out" aria-label="Sold out">Sold Out</span>
              {% endunless %}
              {% if is_low_stock and product.available %}
                <span class="product-badge product-badge--low-stock" aria-label="Low stock">Low Stock</span>
              {% endif %}
            </div>

            <button class="product-card__wishlist js-wishlist-btn" 
                    data-product-id="{{ product.id }}" 
                    data-product-title="{{ product.title | escape }}" 
                    type="button" 
                    aria-label="Add {{ product.title | escape }} to wishlist"
                    aria-pressed="false">
              <svg class="heart-outline" viewBox="0 0 24 24" aria-hidden="true"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/></svg>
              <svg class="heart-filled" viewBox="0 0 24 24" aria-hidden="true"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/></svg>
            </button>

            <a href="{{ product.url }}" class="product-card__image-wrapper" aria-label="View {{ product.title | escape }}">
              <div class="product-card__image-container">
                {% if product.featured_image %}
                  <img class="product-card__image product-card__image--primary" 
                       src="{{ product.featured_image | image_url: width: 600 }}" 
                       alt="{{ product.title | escape }}" 
                       loading="lazy"
                       width="600"
                       height="750">
                {% else %}
                  {{ 'product-1' | placeholder_svg_tag: 'product-card__image' }}
                {% endif %}
                {% if product.images[1] and section.settings.show_second_image %}
                  <img class="product-card__image product-card__image--secondary" 
                       src="{{ product.images[1] | image_url: width: 600 }}" 
                       alt="{{ product.title | escape }}" 
                       loading="lazy"
                       width="600"
                       height="750">
                {% endif %}
              </div>

              {% if is_low_stock and product.available %}
                <div class="product-card__stock-indicator" role="status" aria-live="polite">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
                  Only {{ product.variants.first.inventory_quantity }} left!
                </div>
              {% endif %}

              <div class="product-card__quick-actions">
                <button class="product-card__quick-view js-quick-view-btn" 
                        type="button"
                        data-product-handle="{{ product.handle }}"
                        aria-label="Quick view {{ product.title | escape }}">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
                  <span>Quick View</span>
                </button>
              </div>
            </a>

            <div class="product-card__info">
              {% if section.settings.show_vendor and product.vendor != blank %}
                <p class="product-card__vendor" itemprop="brand" itemscope itemtype="https://schema.org/Brand">
                  <span itemprop="name">{{ product.vendor }}</span>
                </p>
              {% endif %}

              <h3 class="product-card__title">
                <a href="{{ product.url }}" class="product-card__title-link" itemprop="name">{{ product.title }}</a>
              </h3>

              {% if section.settings.show_rating %}
                <div class="product-card__rating" itemprop="aggregateRating" itemscope itemtype="https://schema.org/AggregateRating">
                  <meta itemprop="ratingValue" content="5">
                  <meta itemprop="reviewCount" content="128">
                  <div class="product-rating__stars" aria-label="Rated 5 out of 5 stars">
                    {% for i in (1..5) %}
                      <svg class="product-rating__star" viewBox="0 0 24 24" aria-hidden="true"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
                    {% endfor %}
                  </div>
                  <span class="product-rating__count">(128)</span>
                </div>
              {% endif %}

              <div class="product-card__price-wrapper" itemprop="offers" itemscope itemtype="https://schema.org/Offer">
                <meta itemprop="priceCurrency" content="{{ cart.currency.iso_code }}">
                <meta itemprop="price" content="{{ product.price | divided_by: 100.0 }}">
                <meta itemprop="availability" content="https://schema.org/{% if product.available %}InStock{% else %}OutOfStock{% endif %}">
                {% if on_sale %}
                  <span class="product-card__price product-card__price--sale">{{ product.price | money }}</span>
                  <span class="product-card__price-compare">{{ product.compare_at_price | money }}</span>
                  <span class="product-card__savings">Save {{ discount_percent }}%</span>
                {% else %}
                  <span class="product-card__price">{{ product.price | money }}</span>
                {% endif %}
              </div>

              {% if product.available %}
                {% if product.variants.size == 1 %}
                  <button class="product-card__button product-card__button--primary js-add-to-cart" 
                          data-variant-id="{{ product.selected_or_first_available_variant.id }}" 
                          data-product-title="{{ product.title | escape }}" 
                          type="button"
                          aria-label="Add {{ product.title | escape }} to cart">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="9" cy="21" r="1"/><circle cx="20" cy="21" r="1"/><path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"/></svg>
                    <span>Add to Cart</span>
                  </button>
                {% else %}
                  <a href="{{ product.url }}" class="product-card__button product-card__button--secondary" aria-label="Select options for {{ product.title | escape }}">
                    <span>Select Options</span>
                  </a>
                {% endif %}
              {% else %}
                <button class="product-card__button product-card__button--disabled" disabled aria-label="{{ product.title | escape }} is sold out">Sold Out</button>
              {% endif %}
            </div>
          </article>
        {% endfor %}
      </div>

      {% if paginate.pages > 1 %}
        <nav class="pagination" role="navigation" aria-label="Pagination">
          {% if paginate.previous %}
            <a href="{{ paginate.previous.url }}" class="pagination__item" aria-label="Previous page">‹</a>
          {% else %}
            <span class="pagination__item is-disabled" aria-hidden="true">‹</span>
          {% endif %}
          {% for part in paginate.parts %}
            {% if part.is_link %}
              <a href="{{ part.url }}" class="pagination__item" aria-label="Page {{ part.title }}">{{ part.title }}</a>
            {% else %}
              {% if part.title == paginate.current_page %}
                <span class="pagination__item is-active" aria-current="page" aria-label="Current page, page {{ part.title }}">{{ part.title }}</span>
              {% else %}
                <span class="pagination__item">{{ part.title }}</span>
              {% endif %}
            {% endif %}
          {% endfor %}
          {% if paginate.next %}
            <a href="{{ paginate.next.url }}" class="pagination__item" aria-label="Next page">›</a>
          {% else %}
            <span class="pagination__item is-disabled" aria-hidden="true">›</span>
          {% endif %}
        </nav>
      {% endif %}
    </main>
    {% endpaginate %}
  </div>
</div>

<!-- QUICK VIEW MODAL -->
<div class="quick-view-modal" id="quickViewModal" role="dialog" aria-modal="true" aria-labelledby="quickViewTitle">
  <div class="quick-view-modal__backdrop" data-modal-close></div>
  <div class="quick-view-modal__container">
    <button class="quick-view-modal__close" type="button" aria-label="Close quick view" data-modal-close>
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
    </button>
    <div class="quick-view-modal__content" id="quickViewContent">
      <div class="loading-spinner" style="margin: 100px auto;"></div>
    </div>
  </div>
</div>

<div class="loading-overlay" id="loadingOverlay" role="status" aria-live="polite" aria-label="Loading">
  <div class="loading-spinner"></div>
</div>

<script>
(function(){'use strict';

// ========== CONFIGURATION ==========
const CONFIG={
  WISHLIST_KEY:'ultra_premium_wishlist_v2',
  VIEW_KEY:'ultra_premium_view_v2',
  TOAST_DURATION:4500,
  DEBOUNCE_DELAY:300
};

// ========== UTILITIES ==========
const Utils={
  escapeHTML(text){
    const div=document.createElement('div');
    div.textContent=text;
    return div.innerHTML;
  },
  formatMoney(cents){
    if(typeof Shopify!=='undefined'&&Shopify.formatMoney){
      return Shopify.formatMoney(cents,window.theme?.moneyFormat||'${{amount}}');
    }
    return `$${(cents/100).toFixed(2)}`;
  },
  debounce(func,wait){
    let timeout;
    return function executedFunction(...args){
      const later=()=>{
        clearTimeout(timeout);
        func(...args);
      };
      clearTimeout(timeout);
      timeout=setTimeout(later,wait);
    };
  }
};

// ========== TOAST NOTIFICATIONS ==========
const Toast={
  show(title,message,type='success'){
    const toast=document.createElement('div');
    toast.className=`toast toast--${type}`;
    toast.setAttribute('role','status');
    toast.setAttribute('aria-live','polite');
    
    const icons={
      success:'<svg class="toast__icon toast__icon--success" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>',
      error:'<svg class="toast__icon toast__icon--error" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><circle cx="12" cy="12" r="10"/><line x1="15" y1="9" x2="9" y2="15"/><line x1="9" y1="9" x2="15" y2="15"/></svg>',
      info:'<svg class="toast__icon toast__icon--info" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><circle cx="12" cy="12" r="10"/><line x1="12" y1="16" x2="12" y2="12"/><line x1="12" y1="8" x2="12.01" y2="8"/></svg>'
    };
    
    toast.innerHTML=`
      ${icons[type]||icons.success}
      <div class="toast__content">
        <div class="toast__title">${Utils.escapeHTML(title)}</div>
        <div class="toast__message">${Utils.escapeHTML(message)}</div>
      </div>
      <button class="toast__close" type="button" aria-label="Close notification">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
      </button>
    `;
    
    document.body.appendChild(toast);
    toast.querySelector('.toast__close').addEventListener('click',()=>this.hide(toast));
    requestAnimationFrame(()=>toast.classList.add('is-visible'));
    setTimeout(()=>this.hide(toast),CONFIG.TOAST_DURATION);
  },
  
  hide(toast){
    toast.classList.remove('is-visible');
    setTimeout(()=>toast.remove(),300);
  }
};

// ========== WISHLIST MANAGEMENT ==========
const Wishlist={
  items:[],
  
  init(){
    this.load();
    this.updateUI();
    this.attachEvents();
  },
  
  load(){
    try{
      const stored=localStorage.getItem(CONFIG.WISHLIST_KEY);
      this.items=stored?JSON.parse(stored):[];
    }catch(e){
      console.error('Wishlist load error:',e);
      this.items=[];
    }
  },
  
  save(){
    try{
      localStorage.setItem(CONFIG.WISHLIST_KEY,JSON.stringify(this.items));
    }catch(e){
      Toast.show('Error','Unable to save wishlist','error');
    }
  },
  
  toggle(productId,productTitle){
    const index=this.items.indexOf(productId);
    if(index>-1){
      this.items.splice(index,1);
      Toast.show('Removed',`${productTitle} removed from wishlist`,'info');
    }else{
      this.items.push(productId);
      Toast.show('Added',`${productTitle} added to wishlist`,'success');
    }
    this.save();
    this.updateUI();
  },
  
  has(productId){
    return this.items.includes(productId);
  },
  
  updateUI(){
    document.querySelectorAll('.js-wishlist-btn').forEach(btn=>{
      const productId=btn.dataset.productId;
      if(this.has(productId)){
        btn.classList.add('is-active');
        btn.setAttribute('aria-pressed','true');
      }else{
        btn.classList.remove('is-active');
        btn.setAttribute('aria-pressed','false');
      }
    });
  },
  
  attachEvents(){
    document.addEventListener('click',(e)=>{
      const btn=e.target.closest('.js-wishlist-btn');
      if(!btn)return;
      e.preventDefault();
      e.stopPropagation();
      const productId=btn.dataset.productId;
      const productTitle=btn.dataset.productTitle||'Product';
      this.toggle(productId,productTitle);
    });
  }
};

// ========== CART MANAGEMENT ==========
const Cart={
  async addItem(variantId,quantity=1,productTitle='Product'){
    if(!variantId){
      Toast.show('Error','Invalid product','error');
      return false;
    }
    
    try{
      const response=await fetch('/cart/add.js',{
        method:'POST',
        headers:{
          'Content-Type':'application/json',
          'Accept':'application/json'
        },
        body:JSON.stringify({
          items:[{id:variantId,quantity:quantity}]
        })
      });
      
      if(!response.ok){
        const error=await response.json();
        throw new Error(error.description||'Failed to add to cart');
      }
      
      await response.json();
      document.dispatchEvent(new CustomEvent('cart:updated'));
      Toast.show('Success',`${productTitle} added to cart!`,'success');
      return true;
    }catch(error){
      console.error('Cart error:',error);
      Toast.show('Error',error.message||'Failed to add to cart','error');
      return false;
    }
  }
};

// ========== ADD TO CART ==========
const AddToCart={
  init(){
    document.addEventListener('click',async(e)=>{
      const btn=e.target.closest('.js-add-to-cart');
      if(!btn)return;
      e.preventDefault();
      
      const variantId=btn.dataset.variantId;
      const productTitle=btn.dataset.productTitle||'Product';
      
      btn.classList.add('is-loading');
      btn.disabled=true;
      const originalHTML=btn.innerHTML;
      
      const success=await Cart.addItem(variantId,1,productTitle);
      
      if(success){
        btn.innerHTML='<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg><span>Added!</span>';
        setTimeout(()=>{
          btn.innerHTML=originalHTML;
          btn.classList.remove('is-loading');
          btn.disabled=false;
        },2000);
      }else{
        btn.classList.remove('is-loading');
        btn.disabled=false;
      }
    });
  }
};

// ========== SORTING ==========
const Sorting={
  init(){
    const select=document.getElementById('SortBy');
    if(!select)return;
    
    const params=new URLSearchParams(window.location.search);
    const currentSort=params.get('sort_by');
    if(currentSort)select.value=currentSort;
    
    select.addEventListener('change',function(){
      const url=new URL(window.location.href);
      url.searchParams.set('sort_by',this.value);
      window.location.href=url.toString();
    });
  }
};

// ========== VIEW TOGGLE ==========
const ViewToggle={
  init(){
    const buttons=document.querySelectorAll('.view-toggle__btn');
    const grid=document.getElementById('productGrid');
    if(!buttons.length||!grid)return;
    
    buttons.forEach(btn=>{
      btn.addEventListener('click',()=>{
        const view=btn.dataset.view;
        
        buttons.forEach(b=>{
          b.classList.remove('is-active');
          b.setAttribute('aria-pressed','false');
        });
        
        btn.classList.add('is-active');
        btn.setAttribute('aria-pressed','true');
        
        if(view==='list'){
          grid.classList.add('view-list');
        }else{
          grid.classList.remove('view-list');
        }
        
        try{
          localStorage.setItem(CONFIG.VIEW_KEY,view);
        }catch(e){
          console.error('View toggle save error:',e);
        }
      });
    });
    
    try{
      const savedView=localStorage.getItem(CONFIG.VIEW_KEY);
      if(savedView==='list'){
        grid.classList.add('view-list');
        buttons.forEach(btn=>{
          if(btn.dataset.view==='list'){
            btn.classList.add('is-active');
            btn.setAttribute('aria-pressed','true');
          }else{
            btn.classList.remove('is-active');
            btn.setAttribute('aria-pressed','false');
          }
        });
      }
    }catch(e){
      console.error('View toggle load error:',e);
    }
  }
};

// ========== QUICK VIEW MODAL ==========
const QuickView={
  modal:null,
  content:null,
  currentProduct:null,
  selectedVariant:null,
  
  init(){
    this.modal=document.getElementById('quickViewModal');
    this.content=document.getElementById('quickViewContent');
    
    if(!this.modal||!this.content)return;
    
    this.attachEvents();
  },
  
  attachEvents(){
    // Quick view button clicks
    document.addEventListener('click',async(e)=>{
      const btn=e.target.closest('.js-quick-view-btn');
      if(!btn)return;
      
      e.preventDefault();
      e.stopPropagation();
      
      const productHandle=btn.dataset.productHandle;
      if(productHandle){
        await this.open(productHandle);
      }
    });
    
    // Close modal
    this.modal.addEventListener('click',(e)=>{
      if(e.target.hasAttribute('data-modal-close')||e.target.closest('[data-modal-close]')){
        this.close();
      }
    });
    
    // Keyboard navigation
    document.addEventListener('keydown',(e)=>{
      if(e.key==='Escape'&&this.modal.classList.contains('is-active')){
        this.close();
      }
    });
  },
  
  async open(productHandle){
    try{
      this.modal.classList.add('is-active');
      document.body.classList.add('modal-open');
      this.content.innerHTML='<div class="loading-spinner" style="margin: 100px auto;"></div>';
      
      const response=await fetch(`/products/${productHandle}.js`);
      if(!response.ok)throw new Error('Product not found');
      
      const product=await response.json();
      this.currentProduct=product;
      this.selectedVariant=product.variants[0];
      
      this.renderProduct(product);
      this.trapFocus();
    }catch(error){
      console.error('Quick view error:',error);
      Toast.show('Error','Unable to load product details','error');
      this.close();
    }
  },
  
  renderProduct(product){
    const onSale=product.compare_at_price&&product.compare_at_price>product.price;
    const discountPercent=onSale?Math.round(((product.compare_at_price-product.price)/product.compare_at_price)*100):0;
    
    let stockStatus='in-stock';
    let stockText='In Stock';
    if(!product.available){
      stockStatus='out-of-stock';
      stockText='Out of Stock';
    }else if(this.selectedVariant.inventory_quantity<=5&&this.selectedVariant.inventory_quantity>0){
      stockStatus='low-stock';
      stockText=`Only ${this.selectedVariant.inventory_quantity} left`;
    }
    
    const imagesHTML=product.images.map((img,index)=>`
      <img src="${img}" alt="${Utils.escapeHTML(product.title)}" loading="${index===0?'eager':'lazy'}" width="600" height="750">
    `).join('');
    
    const thumbnailsHTML=product.images.length>1?`
      <div class="quick-view-modal__thumbnails">
        ${product.images.slice(0,6).map((img,index)=>`
          <div class="quick-view-modal__thumbnail ${index===0?'is-active':''}" data-image-index="${index}">
            <img src="${img}" alt="${Utils.escapeHTML(product.title)}" loading="lazy" width="80" height="100">
          </div>
        `).join('')}
      </div>
    `:'';
    
    const variantsHTML=product.options.length>0&&product.variants.length>1?`
      <div class="quick-view-modal__variants">
        ${product.options.map((option,optIndex)=>`
          <div class="quick-view-modal__variant-group">
            <label class="quick-view-modal__variant-label">${option.name}</label>
            <div class="quick-view-modal__variant-options">
              ${option.values.map((value,valIndex)=>{
                const variant=product.variants.find(v=>v.options[optIndex]===value);
                const isAvailable=variant&&variant.available;
                const isSelected=this.selectedVariant.options[optIndex]===value;
                return `
                  <button class="quick-view-modal__variant-option ${isSelected?'is-active':''} ${!isAvailable?'is-disabled':''}"
                          data-option-index="${optIndex}"
                          data-option-value="${Utils.escapeHTML(value)}"
                          ${!isAvailable?'disabled':''}
                          type="button">
                    ${Utils.escapeHTML(value)}
                  </button>
                `;
              }).join('')}
            </div>
          </div>
        `).join('')}
      </div>
    `:'';
    
    this.content.innerHTML=`
      <div class="quick-view-modal__gallery">
        <div class="quick-view-modal__main-image" id="quickViewMainImage">
          ${imagesHTML}
        </div>
        ${thumbnailsHTML}
      </div>
      <div class="quick-view-modal__details">
        ${product.vendor?`<p class="quick-view-modal__vendor">${Utils.escapeHTML(product.vendor)}</p>`:''}
        <h2 class="quick-view-modal__title" id="quickViewTitle">${Utils.escapeHTML(product.title)}</h2>
        
        <div class="quick-view-modal__rating">
          <div class="quick-view-modal__stars" aria-label="Rated 5 out of 5 stars">
            ${Array(5).fill('<svg class="quick-view-modal__star" viewBox="0 0 24 24" aria-hidden="true"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>').join('')}
          </div>
          <span class="quick-view-modal__reviews">(128 reviews)</span>
        </div>
        
        <div class="quick-view-modal__price">
          <span class="quick-view-modal__price-current ${onSale?'quick-view-modal__price-current--sale':''}" id="quickViewPrice">
            ${Utils.formatMoney(this.selectedVariant.price)}
          </span>
          ${onSale?`
            <span class="quick-view-modal__price-compare" id="quickViewCompare">${Utils.formatMoney(product.compare_at_price)}</span>
            <span class="quick-view-modal__savings">Save ${discountPercent}%</span>
          `:''}
        </div>
        
        ${product.description?`
          <div class="quick-view-modal__description">
            ${product.description.length>200?product.description.substring(0,200)+'...':product.description}
          </div>
        `:''}
        
        ${variantsHTML}
        
        <div class="quick-view-modal__quantity">
          <label class="quick-view-modal__variant-label" for="quickViewQuantity">Quantity</label>
          <div class="quick-view-modal__quantity-controls">
            <button class="quick-view-modal__quantity-btn" type="button" data-quantity-decrease aria-label="Decrease quantity">−</button>
            <input type="number" 
                   id="quickViewQuantity" 
                   class="quick-view-modal__quantity-input" 
                   value="1" 
                   min="1" 
                   max="${this.selectedVariant.inventory_quantity||999}"
                   aria-label="Quantity">
            <button class="quick-view-modal__quantity-btn" type="button" data-quantity-increase aria-label="Increase quantity">+</button>
          </div>
        </div>
        
        <div class="quick-view-modal__stock-status quick-view-modal__stock-status--${stockStatus}" role="status">
          ${stockText}
        </div>
        
        <div class="quick-view-modal__actions">
          <button class="quick-view-modal__add-to-cart js-modal-add-to-cart" 
                  type="button"
                  ${!product.available?'disabled':''}
                  data-variant-id="${this.selectedVariant.id}"
                  aria-label="Add ${Utils.escapeHTML(product.title)} to cart">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <circle cx="9" cy="21" r="1"/><circle cx="20" cy="21" r="1"/>
              <path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"/>
            </svg>
            <span>${product.available?'Add to Cart':'Sold Out'}</span>
          </button>
          <button class="quick-view-modal__wishlist-btn js-wishlist-btn" 
                  data-product-id="${product.id}" 
                  data-product-title="${Utils.escapeHTML(product.title)}"
                  type="button"
                  aria-label="Add to wishlist">
            <svg class="heart-outline" viewBox="0 0 24 24" aria-hidden="true">
              <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/>
            </svg>
            <svg class="heart-filled" viewBox="0 0 24 24" aria-hidden="true">
              <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/>
            </svg>
          </button>
        </div>
      </div>
    `;
    
    this.attachModalEvents();
    Wishlist.updateUI();
  },
  
  attachModalEvents(){
    // Thumbnail navigation
    this.content.querySelectorAll('.quick-view-modal__thumbnail').forEach((thumb,index)=>{
      thumb.addEventListener('click',()=>{
        this.content.querySelectorAll('.quick-view-modal__thumbnail').forEach(t=>t.classList.remove('is-active'));
        thumb.classList.add('is-active');
        const mainImage=this.content.querySelector('.quick-view-modal__main-image');
        if(mainImage){
          mainImage.scrollTo({left:mainImage.offsetWidth*index,behavior:'smooth'});
        }
      });
    });
    
    // Variant selection
    this.content.querySelectorAll('.quick-view-modal__variant-option').forEach(btn=>{
      btn.addEventListener('click',()=>{
        const optionIndex=parseInt(btn.dataset.optionIndex);
        const optionValue=btn.dataset.optionValue;
        
        const selectedOptions=[...this.selectedVariant.options];
        selectedOptions[optionIndex]=optionValue;
        
        const newVariant=this.currentProduct.variants.find(v=>
          v.options.every((opt,idx)=>opt===selectedOptions[idx])
        );
        
        if(newVariant){
          this.selectedVariant=newVariant;
          this.updateVariantUI();
        }
      });
    });
    
    // Quantity controls
    const quantityInput=this.content.querySelector('#quickViewQuantity');
    const decreaseBtn=this.content.querySelector('[data-quantity-decrease]');
    const increaseBtn=this.content.querySelector('[data-quantity-increase]');
    
    if(decreaseBtn){
      decreaseBtn.addEventListener('click',()=>{
        const currentValue=parseInt(quantityInput.value)||1;
        if(currentValue>1){
          quantityInput.value=currentValue-1;
        }
      });
    }
    
    if(increaseBtn){
      increaseBtn.addEventListener('click',()=>{
        const currentValue=parseInt(quantityInput.value)||1;
        const maxValue=parseInt(quantityInput.max)||999;
        if(currentValue<maxValue){
          quantityInput.value=currentValue+1;
        }
      });
    }
    
    // Add to cart from modal
    const addToCartBtn=this.content.querySelector('.js-modal-add-to-cart');
    if(addToCartBtn){
      addToCartBtn.addEventListener('click',async()=>{
        const variantId=this.selectedVariant.id;
        const quantity=parseInt(quantityInput.value)||1;
        
        addToCartBtn.classList.add('is-loading');
        addToCartBtn.disabled=true;
        
        const success=await Cart.addItem(variantId,quantity,this.currentProduct.title);
        
        if(success){
          setTimeout(()=>{
            this.close();
          },1000);
        }else{
          addToCartBtn.classList.remove('is-loading');
          addToCartBtn.disabled=false;
        }
      });
    }
  },
  
  updateVariantUI(){
    // Update price
    const priceEl=this.content.querySelector('#quickViewPrice');
    if(priceEl){
      priceEl.textContent=Utils.formatMoney(this.selectedVariant.price);
    }
    
    // Update compare price
    const compareEl=this.content.querySelector('#quickViewCompare');
    if(compareEl&&this.selectedVariant.compare_at_price){
      compareEl.textContent=Utils.formatMoney(this.selectedVariant.compare_at_price);
    }
    
    // Update variant buttons
    this.content.querySelectorAll('.quick-view-modal__variant-option').forEach(btn=>{
      const optionIndex=parseInt(btn.dataset.optionIndex);
      const optionValue=btn.dataset.optionValue;
      const isSelected=this.selectedVariant.options[optionIndex]===optionValue;
      
      if(isSelected){
        btn.classList.add('is-active');
      }else{
        btn.classList.remove('is-active');
      }
    });
    
    // Update stock status
    let stockStatus='in-stock';
    let stockText='In Stock';
    if(!this.selectedVariant.available){
      stockStatus='out-of-stock';
      stockText='Out of Stock';
    }else if(this.selectedVariant.inventory_quantity<=5&&this.selectedVariant.inventory_quantity>0){
      stockStatus='low-stock';
      stockText=`Only ${this.selectedVariant.inventory_quantity} left`;
    }
    
    const stockEl=this.content.querySelector('.quick-view-modal__stock-status');
    if(stockEl){
      stockEl.className=`quick-view-modal__stock-status quick-view-modal__stock-status--${stockStatus}`;
      stockEl.textContent=stockText;
    }
    
    // Update add to cart button
    const addBtn=this.content.querySelector('.js-modal-add-to-cart');
    if(addBtn){
      addBtn.dataset.variantId=this.selectedVariant.id;
      addBtn.disabled=!this.selectedVariant.available;
      addBtn.querySelector('span').textContent=this.selectedVariant.available?'Add to Cart':'Sold Out';
    }
    
    // Update quantity max
    const quantityInput=this.content.querySelector('#quickViewQuantity');
    if(quantityInput){
      quantityInput.max=this.selectedVariant.inventory_quantity||999;
    }
  },
  
  close(){
    this.modal.classList.remove('is-active');
    document.body.classList.remove('modal-open');
    this.currentProduct=null;
    this.selectedVariant=null;
  },
  
  trapFocus(){
    const focusableElements=this.modal.querySelectorAll(
      'button:not([disabled]), [href], input:not([disabled]), select:not([disabled]), textarea:not([disabled]), [tabindex]:not([tabindex="-1"])'
    );
    
    if(focusableElements.length===0)return;
    
    const firstElement=focusableElements[0];
    const lastElement=focusableElements[focusableElements.length-1];
    
    firstElement.focus();
    
    this.modal.addEventListener('keydown',(e)=>{
      if(e.key!=='Tab')return;
      
      if(e.shiftKey){
        if(document.activeElement===firstElement){
          e.preventDefault();
          lastElement.focus();
        }
      }else{
        if(document.activeElement===lastElement){
          e.preventDefault();
          firstElement.focus();
        }
      }
    });
  }
};

// ========== INITIALIZATION ==========
function init(){
  Wishlist.init();
  AddToCart.init();
  Sorting.init();
  ViewToggle.init();
  QuickView.init();
  
  console.log('✨ Ultra Premium Collection v2.0 - Professional Edition Initialized');
}

if(document.readyState==='loading'){
  document.addEventListener('DOMContentLoaded',init);
}else{
  init();
}

})();
</script>


    {
      "type": "checkbox",
      "id": "show_discount_badge",
      "label": "Show discount badge on image",
      "default": true,
      "info": "Displays % off on product thumbnail"
    },
    {
      "type": "header",
      "content": "🎯 SOCIAL PROOF & TRUST"
    },
    {
      "type": "checkbox",
      "id": "show_social_proof",
      "label": "Enable rotating social proof",
      "default": true,
      "info": "Auto-rotates: '127 viewing', '43 sold today', etc."
    },
    {
      "type": "text",

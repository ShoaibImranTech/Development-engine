{% comment %}
═══════════════════════════════════════════════════════════════════════════════
🏆 ULTRA-PREMIUM MOBILE NAV v3.0 - MAXIMUM SMOOTHNESS
The absolute pinnacle of mobile navigation - pure luxury, zero noise
Built for: Hermès, Cartier, Rolls-Royce caliber brands
Philosophy: Silence speaks louder than noise
═══════════════════════════════════════════════════════════════════════════════
{% endcomment %}

<style>
/* ═══════════════════════════════════════════════════════════════════════════
   ULTRA-SMOOTH FOUNDATION - 120fps Guaranteed
   ═══════════════════════════════════════════════════════════════════════════ */

* {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
  -webkit-tap-highlight-color: transparent;
}

:root {
  /* Ultra-Premium Materials */
  --nav-glass: rgba(255, 255, 255, 0.88);
  --nav-border: rgba(0, 0, 0, 0.04);
  
  /* Signature Black - The Only Color That Matters */
  --black-pure: #000000;
  --black-soft: #1a1a1a;
  --gray-steel: #404040;
  --gray-cloud: #a3a3a3;
  --white-pure: #ffffff;
  
  /* Ultra-Subtle Shadows - Whisper, Not Shout */
  --shadow-float: 
    0 0 0 0.5px rgba(0, 0, 0, 0.02),
    0 2px 4px rgba(0, 0, 0, 0.02),
    0 8px 16px rgba(0, 0, 0, 0.03),
    0 16px 32px rgba(0, 0, 0, 0.025),
    0 32px 64px rgba(0, 0, 0, 0.02);
  
  /* Buttery Smooth Timing - 120fps */
  --timing-instant: 100ms;
  --timing-smooth: 300ms;
  --timing-elegant: 500ms;
  
  /* Physics-Based Easing */
  --ease-smooth: cubic-bezier(0.25, 0.1, 0.25, 1);
  --ease-swift: cubic-bezier(0.4, 0, 0.2, 1);
  --ease-spring: cubic-bezier(0.34, 1.56, 0.64, 1);
  
  /* Perfect Spacing */
  --space-unit: 8px;
  --nav-height: 72px;
}

html {
  -webkit-font-smoothing: antialiased;
  -moz-osx-font-smoothing: grayscale;
  text-rendering: optimizeLegibility;
  scroll-behavior: smooth;
}

body {
  padding-bottom: calc(var(--nav-height) + 32px + env(safe-area-inset-bottom, 20px));
  transition: padding-bottom var(--timing-elegant) var(--ease-smooth);
}

/* ═══════════════════════════════════════════════════════════════════════════
   NAVIGATION SHELL - Ultra-Minimal, Ultra-Confident
   ═══════════════════════════════════════════════════════════════════════════ */

.premium-nav-system {
  position: fixed;
  bottom: var(--space-unit);
  left: 0;
  right: 0;
  z-index: 999999;
  display: flex;
  justify-content: center;
  pointer-events: none;
  padding: 0 calc(var(--space-unit) * 2);
}

.premium-nav-container {
  width: 100%;
  max-width: 420px;
  height: var(--nav-height);
  background: var(--nav-glass);
  backdrop-filter: blur(40px) saturate(180%);
  -webkit-backdrop-filter: blur(40px) saturate(180%);
  border: 0.5px solid var(--nav-border);
  border-radius: 36px;
  box-shadow: var(--shadow-float);
  pointer-events: auto;
  
  /* GPU Acceleration for buttery smoothness */
  will-change: transform, opacity;
  transform: translateZ(0) scale(1);
  backface-visibility: hidden;
  perspective: 1000px;
  
  /* Ultra-smooth transitions */
  transition: 
    transform var(--timing-elegant) var(--ease-smooth),
    opacity var(--timing-smooth) var(--ease-smooth),
    box-shadow var(--timing-smooth) var(--ease-smooth);
}

.premium-nav-container.hidden {
  transform: translateZ(0) translateY(120%) scale(0.95);
  opacity: 0;
  pointer-events: none;
}

/* ═══════════════════════════════════════════════════════════════════════════
   NAVIGATION GRID - Perfect Balance
   ═══════════════════════════════════════════════════════════════════════════ */

.premium-nav-grid {
  display: grid;
  grid-template-columns: repeat(5, 1fr);
  height: 100%;
  padding: calc(var(--space-unit) * 1.5);
  gap: 4px;
}

/* ═══════════════════════════════════════════════════════════════════════════
   NAV ITEMS - Minimalist Perfection
   ═══════════════════════════════════════════════════════════════════════════ */

.premium-nav-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 6px;
  padding: calc(var(--space-unit) * 1.25) var(--space-unit);
  color: var(--gray-cloud);
  text-decoration: none;
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
  font-size: 10px;
  font-weight: 500;
  letter-spacing: 0.5px;
  border-radius: 28px;
  cursor: pointer;
  user-select: none;
  -webkit-user-select: none;
  background: transparent;
  
  /* Buttery smooth transforms */
  will-change: transform, background, color;
  transform: translateZ(0);
  backface-visibility: hidden;
  
  transition: 
    color var(--timing-instant) var(--ease-swift),
    background var(--timing-instant) var(--ease-swift),
    transform var(--timing-instant) var(--ease-swift);
}

/* Hover - Desktop Only */
@media (hover: hover) and (pointer: fine) {
  .premium-nav-item:hover {
    color: var(--black-soft);
    background: rgba(0, 0, 0, 0.03);
  }
  
  .premium-nav-item:hover .premium-nav-icon {
    transform: translateY(-2px) translateZ(0);
  }
}

/* Active State - Instant Feedback */
.premium-nav-item:active {
  transform: scale(0.96) translateZ(0);
  background: rgba(0, 0, 0, 0.05);
  transition-duration: 50ms;
}

/* Current Page Indicator - Confident, Not Loud */
.premium-nav-item.active {
  color: var(--black-pure);
}

.premium-nav-item.active .premium-nav-icon {
  color: var(--black-pure);
  stroke-width: 2.2;
}

/* Subtle Active Indicator - Top Line */
.premium-nav-item::before {
  content: '';
  position: absolute;
  top: 8px;
  left: 50%;
  width: 20px;
  height: 2px;
  background: var(--black-pure);
  border-radius: 1px;
  opacity: 0;
  transform: translateX(-50%) scaleX(0) translateZ(0);
  
  transition: 
    opacity var(--timing-smooth) var(--ease-smooth),
    transform var(--timing-smooth) var(--ease-spring);
}

.premium-nav-item.active::before {
  opacity: 1;
  transform: translateX(-50%) scaleX(1) translateZ(0);
}

/* ═══════════════════════════════════════════════════════════════════════════
   ICONS - Minimalist Perfection
   ═══════════════════════════════════════════════════════════════════════════ */

.premium-nav-icon {
  width: 24px;
  height: 24px;
  color: inherit;
  stroke: currentColor;
  stroke-width: 1.8;
  stroke-linecap: round;
  stroke-linejoin: round;
  fill: none;
  
  /* Ultra-smooth animation */
  will-change: transform, stroke-width;
  transform: translateZ(0);
  backface-visibility: hidden;
  
  transition: 
    color var(--timing-instant) var(--ease-swift),
    transform var(--timing-smooth) var(--ease-smooth),
    stroke-width var(--timing-instant) var(--ease-swift);
}

/* ═══════════════════════════════════════════════════════════════════════════
   CART BADGE - Minimal, Confident
   ═══════════════════════════════════════════════════════════════════════════ */

.premium-cart-badge {
  position: absolute;
  top: 6px;
  right: 6px;
  min-width: 18px;
  height: 18px;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 5px;
  background: var(--black-pure);
  color: var(--white-pure);
  font-size: 10px;
  font-weight: 700;
  border-radius: 9px;
  border: 2px solid var(--nav-glass);
  box-shadow: 0 2px 8px rgba(0, 0, 0, 0.15);
  
  /* Smooth entry animation */
  opacity: 0;
  transform: scale(0) translateZ(0);
  
  will-change: transform, opacity;
  backface-visibility: hidden;
  
  transition: 
    transform var(--timing-smooth) var(--ease-spring),
    opacity var(--timing-smooth) var(--ease-smooth);
}

.premium-cart-badge.visible {
  opacity: 1;
  transform: scale(1) translateZ(0);
}

/* Celebration animation - subtle joy */
@keyframes cartPulse {
  0%, 100% { transform: scale(1) translateZ(0); }
  50% { transform: scale(1.1) translateZ(0); }
}

.premium-cart-badge.celebrate {
  animation: cartPulse 400ms var(--ease-smooth);
}

/* ═══════════════════════════════════════════════════════════════════════════
   RESPONSIVE - Perfect at Every Size
   ═══════════════════════════════════════════════════════════════════════════ */

@media (max-width: 375px) {
  :root {
    --nav-height: 68px;
  }
  
  .premium-nav-grid {
    padding: calc(var(--space-unit) * 1.25);
  }
  
  .premium-nav-item {
    font-size: 9px;
    gap: 5px;
  }
  
  .premium-nav-icon {
    width: 22px;
    height: 22px;
  }
}

@media (min-width: 414px) {
  .premium-nav-container {
    max-width: 440px;
  }
  
  .premium-nav-icon {
    width: 25px;
    height: 25px;
  }
}

@media (min-width: 768px) {
  .premium-nav-container {
    max-width: 460px;
  }
}

/* Hide on Desktop - Mobile Only */
@media (min-width: 1024px) {
  .premium-nav-system {
    display: none !important;
  }
}

/* ═══════════════════════════════════════════════════════════════════════════
   ACCESSIBILITY - Invisible Excellence
   ═══════════════════════════════════════════════════════════════════════════ */

.premium-nav-item:focus-visible {
  outline: 2px solid var(--black-pure);
  outline-offset: 4px;
}

.sr-only {
  position: absolute;
  width: 1px;
  height: 1px;
  padding: 0;
  margin: -1px;
  overflow: hidden;
  clip: rect(0, 0, 0, 0);
  white-space: nowrap;
  border: 0;
}

/* Reduced Motion Support */
@media (prefers-reduced-motion: reduce) {
  *,
  *::before,
  *::after {
    animation-duration: 0.01ms !important;
    animation-iteration-count: 1 !important;
    transition-duration: 0.01ms !important;
  }
}

/* High Contrast Support */
@media (prefers-contrast: high) {
  .premium-nav-container {
    border: 1px solid var(--black-pure);
  }
  
  .premium-nav-item.active::before {
    height: 3px;
  }
}

/* ═══════════════════════════════════════════════════════════════════════════
   DARK MODE - Inverted Excellence
   ═══════════════════════════════════════════════════════════════════════════ */

@media (prefers-color-scheme: dark) {
  :root {
    --nav-glass: rgba(20, 20, 20, 0.88);
    --nav-border: rgba(255, 255, 255, 0.06);
    --black-pure: #ffffff;
    --black-soft: #e5e5e5;
    --gray-cloud: #a3a3a3;
    --white-pure: #000000;
  }
  
  .premium-nav-item:hover {
    background: rgba(255, 255, 255, 0.04);
  }
  
  .premium-nav-item:active {
    background: rgba(255, 255, 255, 0.06);
  }
  
  .premium-cart-badge {
    background: var(--white-pure);
    color: var(--black-pure);
  }
}

/* ═══════════════════════════════════════════════════════════════════════════
   PERFORMANCE OPTIMIZATIONS - 120fps Guaranteed
   ═══════════════════════════════════════════════════════════════════════════ */

/* Force GPU acceleration on all animated elements */
.premium-nav-container,
.premium-nav-item,
.premium-nav-icon,
.premium-cart-badge {
  transform: translateZ(0);
  will-change: transform;
}

/* Prevent layout thrashing */
.premium-nav-grid {
  contain: layout style paint;
}

/* Optimize repaints */
.premium-nav-item::before {
  contain: strict;
}
</style>

<!-- ═══════════════════════════════════════════════════════════════════════════
     ULTRA-PREMIUM NAVIGATION HTML
═══════════════════════════════════════════════════════════════════════════ -->

<div class="premium-nav-system" role="navigation" aria-label="Main navigation">
  <nav class="premium-nav-container">
    <div class="premium-nav-grid">
      
      <!-- Home -->
      <a 
        href="{{ routes.root_url }}" 
        class="premium-nav-item{% if request.page_type == 'index' %} active{% endif %}"
        aria-label="Home"
        aria-current="{% if request.page_type == 'index' %}page{% else %}false{% endif %}"
      >
        <svg class="premium-nav-icon" viewBox="0 0 24 24" fill="none">
          <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/>
          <path d="M9 22V12h6v10"/>
        </svg>
        <span>Home</span>
      </a>
      
      <!-- Shop -->
      <a 
        href="{{ routes.all_products_collection_url }}" 
        class="premium-nav-item{% if request.page_type == 'collection' or request.page_type == 'product' %} active{% endif %}"
        aria-label="Shop"
        aria-current="{% if request.page_type == 'collection' or request.page_type == 'product' %}page{% else %}false{% endif %}"
      >
        <svg class="premium-nav-icon" viewBox="0 0 24 24" fill="none">
          <rect x="3" y="7" width="18" height="13" rx="2"/>
          <path d="M16 7V5a4 4 0 0 0-8 0v2"/>
        </svg>
        <span>Shop</span>
      </a>
      
      <!-- Search -->
      <a 
        href="{{ routes.search_url }}" 
        class="premium-nav-item{% if request.page_type == 'search' %} active{% endif %}"
        aria-label="Search"
        aria-current="{% if request.page_type == 'search' %}page{% else %}false{% endif %}"
      >
        <svg class="premium-nav-icon" viewBox="0 0 24 24" fill="none">
          <circle cx="11" cy="11" r="8"/>
          <path d="M21 21l-4.35-4.35"/>
        </svg>
        <span>Search</span>
      </a>
      
      <!-- Cart -->
      <a 
        href="{{ routes.cart_url }}" 
        class="premium-nav-item{% if request.page_type == 'cart' %} active{% endif %}"
        aria-label="Cart"
        aria-current="{% if request.page_type == 'cart' %}page{% else %}false{% endif %}"
        style="position: relative;"
      >
        <svg class="premium-nav-icon" viewBox="0 0 24 24" fill="none">
          <circle cx="9" cy="21" r="1"/>
          <circle cx="20" cy="21" r="1"/>
          <path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"/>
        </svg>
        <span>Cart</span>
        <span class="premium-cart-badge" role="status" aria-live="polite">0</span>
      </a>
      
      <!-- Account -->
      <a 
        href="{{ routes.account_url }}" 
        class="premium-nav-item{% if request.page_type == 'account' or request.page_type == 'login' %} active{% endif %}"
        aria-label="Account"
        aria-current="{% if request.page_type == 'account' or request.page_type == 'login' %}page{% else %}false{% endif %}"
      >
        <svg class="premium-nav-icon" viewBox="0 0 24 24" fill="none">
          <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/>
          <circle cx="12" cy="7" r="4"/>
        </svg>
        <span>You</span>
      </a>
      
    </div>
  </nav>
</div>

<script>
(function() {
  'use strict';
  
  // Ultra-smooth navigation controller
  var PremiumNav = {
    elements: {
      container: document.querySelector('.premium-nav-container'),
      items: document.querySelectorAll('.premium-nav-item'),
      badge: document.querySelector('.premium-cart-badge')
    },
    
    state: {
      scroll: { last: 0, threshold: 100 },
      cart: { count: 0 },
      hidden: false,
      ticking: false
    },
    
    // Ultra-smooth scroll handler with requestAnimationFrame
    handleScroll: function() {
      var self = this;
      
      if (!this.state.ticking) {
        requestAnimationFrame(function() {
          var current = window.pageYOffset;
          var delta = current - self.state.scroll.last;
          
          // Hide on scroll down, show on scroll up
          if (current > self.state.scroll.threshold) {
            if (delta > 10 && !self.state.hidden) {
              self.hide();
            } else if (delta < -10 && self.state.hidden) {
              self.show();
            }
          } else {
            self.show();
          }
          
          self.state.scroll.last = current;
          self.state.ticking = false;
        });
        
        this.state.ticking = true;
      }
    },
    
    // Hide navigation
    hide: function() {
      if (this.elements.container) {
        this.elements.container.classList.add('hidden');
        this.state.hidden = true;
      }
    },
    
    // Show navigation
    show: function() {
      if (this.elements.container) {
        this.elements.container.classList.remove('hidden');
        this.state.hidden = false;
      }
    },
    
    // Sync cart count from Shopify
    syncCart: function() {
      var self = this;
      
      fetch('/cart.js', {
        method: 'GET',
        credentials: 'same-origin'
      })
      .then(function(response) {
        return response.json();
      })
      .then(function(cart) {
        var count = cart.item_count || 0;
        if (count !== self.state.cart.count) {
          self.updateCart(count);
        }
      })
      .catch(function(error) {
        console.warn('Cart sync failed:', error);
      });
    },
    
    // Update cart display
    updateCart: function(count) {
      if (!this.elements.badge) return;
      
      var isIncrease = count > this.state.cart.count;
      
      this.elements.badge.textContent = count;
      this.elements.badge.classList.toggle('visible', count > 0);
      
      // Celebration animation on add to cart
      if (isIncrease && count > 0) {
        this.elements.badge.classList.remove('celebrate');
        void this.elements.badge.offsetWidth; // Force reflow
        this.elements.badge.classList.add('celebrate');
        
        setTimeout(function() {
          if (this.elements.badge) {
            this.elements.badge.classList.remove('celebrate');
          }
        }.bind(this), 400);
      }
      
      this.state.cart.count = count;
    },
    
    // Initialize
    init: function() {
      var self = this;
      
      // Smooth scroll listener
      window.addEventListener('scroll', function() {
        self.handleScroll();
      }, { passive: true });
      
      // Shopify cart events
      document.addEventListener('cart:updated', function() {
        self.syncCart();
      });
      
      // Initial cart sync
      if ('requestIdleCallback' in window) {
        requestIdleCallback(function() {
          self.syncCart();
        });
      } else {
        setTimeout(function() {
          self.syncCart();
        }, 100);
      }
      
      // Periodic sync
      setInterval(function() {
        self.syncCart();
      }, 15000);
      
      console.log('🏆 Premium Navigation: Initialized');
    }
  };
  
  // Auto-initialize
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', function() {
      PremiumNav.init();
    });
  } else {
    PremiumNav.init();
  }
  
})();
</script>

  <symbol id="ef-yt" viewBox="0 0 24 24" fill="currentColor">
    <path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/>
  </symbol>
  <symbol id="ef-tt" viewBox="0 0 24 24" fill="currentColor">
    <path d="M19.59 6.69a4.83 4.83 0 0 1-3.77-4.25V2h-3.45v13.67a2.89 2.89 0 0 1-5.2 1.74 2.89 2.89 0 0 1 2.31-4.64 2.93 2.93 0 0 1 .88.13V9.4a6.84 6.84 0 0 0-1-.05A6.33 6.33 0 0 0 5 20.1a6.34 6.34 0 0 0 10.86-4.43v-7a8.16 8.16 0 0 0 4.77 1.52v-3.4a4.85 4.85 0 0 1-1-.1z"/>
  </symbol>
  <symbol id="ef-pin" viewBox="0 0 24 24" fill="currentColor">
    <path d="M12.017 0C5.396 0 .029 5.367.029 11.987c0 5.079 3.158 9.417 7.618 11.162-.105-.949-.199-2.403.041-3.439.219-.937 1.406-5.957 1.406-5.957s-.359-.72-.359-1.781c0-1.663.967-2.911 2.168-2.911 1.024 0 1.518.769 1.518 1.688 0 1.029-.653 2.567-.992 3.992-.285 1.193.6 2.165 1.775 2.165 2.128 0 3.768-2.245 3.768-5.487 0-2.861-2.063-4.869-5.008-4.869-3.41 0-5.409 2.562-5.409 5.199 0 1.033.394 2.143.889 2.741.099.12.112.225.085.345-.09.375-.293 1.199-.334 1.363-.053.225-.172.271-.401.165-1.495-.69-2.433-2.878-2.433-4.646 0-3.776 2.748-7.252 7.92-7.252 4.158 0 7.392 2.967 7.392 6.923 0 4.135-2.607 7.462-6.233 7.462-1.214 0-2.354-.629-2.758-1.379l-.749 2.848c-.269 1.045-1.004 2.352-1.498 3.146 1.123.345 2.306.535 3.55.535 6.607 0 11.985-5.365 11.985-11.987C23.97 5.39 18.592.026 11.985.026L12.017 0z"/>
  </symbol>
  <!-- UI icons -->
  <symbol id="ef-check" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
    <polyline points="20 6 9 17 4 12"/>
  </symbol>
  <symbol id="ef-truck" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
    <rect x="1" y="3" width="15" height="13"/><polygon points="16 8 20 8 23 11 23 16 16 16 16 8"/><circle cx="5.5" cy="18.5" r="2.5"/><circle cx="18.5" cy="18.5" r="2.5"/>
  </symbol>
  <symbol id="ef-refresh" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
    <polyline points="1 4 1 10 7 10"/><path d="M3.51 15a9 9 0 1 0 2.13-9.36L1 10"/>
  </symbol>
  <symbol id="ef-shield" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
    <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
  </symbol>
  <symbol id="ef-phone" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
    <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.69 13 19.79 19.79 0 0 1 1.62 4.38 2 2 0 0 1 3.59 2h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L7.91 9.91a16 16 0 0 0 6 6l.92-.92a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z"/>
  </symbol>
  <symbol id="ef-map" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
    <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/>
  </symbol>
  <symbol id="ef-mail" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
    <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/>
  </symbol>
  <symbol id="ef-clock" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
    <circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/>
  </symbol>
</svg>

<div class="ef">

  <!-- ══════════════════════════════
       MARQUEE STRIP
  ══════════════════════════════ -->
  {%- if section.settings.show_strip and section.settings.strip_text != blank -%}
  <div class="ef-strip" role="marquee" aria-label="Announcements">
    <div class="ef-strip__track" aria-hidden="true">
      {%- assign strip_parts = section.settings.strip_text | split: '|' -%}
      {%- comment %} Duplicate 4× for seamless loop {%- endcomment -%}
      {%- for _i in (1..4) -%}
        <div class="ef-strip__segment">
          {%- for part in strip_parts -%}
            <span>{{ part | strip | replace: '[em]', '<em>' | replace: '[/em]', '</em>' }}</span>
            <span class="ef-strip__dot"></span>
          {%- endfor -%}
        </div>
      {%- endfor -%}
    </div>
    <!-- Accessible static version for screen readers -->
    <span class="sr">
      {%- for part in strip_parts -%}{{ part | strip }}. {%- endfor -%}
    </span>
  </div>
  {%- endif -%}

  <!-- ══════════════════════════════
       MAIN FOOTER
  ══════════════════════════════ -->
  <footer class="ef-footer" role="contentinfo">
    <div class="ef-footer__rule" aria-hidden="true"></div>

    <div class="ef-container">
      <div class="ef-upper">

        <!-- ── BRAND COLUMN ── -->
        <div class="ef-brand">

          {%- comment %} Logo or wordmark {%- endcomment -%}
          <a href="{{ routes.root_url }}" class="ef-brand__logo" aria-label="{{ shop.name }} — Home">
            {%- if section.settings.footer_logo != blank -%}
              {{- section.settings.footer_logo 
                | image_url: width: 400 
                | image_tag: 
                  loading: 'lazy',
                  alt: section.settings.footer_logo.alt | default: shop.name,
                  width: section.settings.footer_logo.width,
                  height: section.settings.footer_logo.height
              -}}
            {%- else -%}
              <p class="ef-brand__wordmark">{{ shop.name }}</p>
            {%- endif -%}
          </a>

          {%- if section.settings.brand_tagline != blank -%}
            <p class="ef-brand__tagline">{{ section.settings.brand_tagline }}</p>
          {%- endif -%}

          {%- comment %} Social links {%- endcomment -%}
          {%- if section.settings.show_social -%}
          <nav class="ef-social" aria-label="{{ 'accessibility.social_media' | t | default: 'Social media' }}">
            {%- if section.settings.social_facebook != blank -%}
              <a href="{{ section.settings.social_facebook }}" class="ef-social__link" target="_blank" rel="noopener noreferrer" aria-label="Facebook">
                <svg><use href="#ef-fb"/></svg>
              </a>
            {%- endif -%}
            {%- if section.settings.social_instagram != blank -%}
              <a href="{{ section.settings.social_instagram }}" class="ef-social__link" target="_blank" rel="noopener noreferrer" aria-label="Instagram">
                <svg><use href="#ef-ig"/></svg>
              </a>
            {%- endif -%}
            {%- if section.settings.social_twitter != blank -%}
              <a href="{{ section.settings.social_twitter }}" class="ef-social__link" target="_blank" rel="noopener noreferrer" aria-label="Twitter / X">
                <svg><use href="#ef-tw"/></svg>
              </a>
            {%- endif -%}
            {%- if section.settings.social_youtube != blank -%}
              <a href="{{ section.settings.social_youtube }}" class="ef-social__link" target="_blank" rel="noopener noreferrer" aria-label="YouTube">
                <svg><use href="#ef-yt"/></svg>
              </a>
            {%- endif -%}
            {%- if section.settings.social_tiktok != blank -%}
              <a href="{{ section.settings.social_tiktok }}" class="ef-social__link" target="_blank" rel="noopener noreferrer" aria-label="TikTok">
                <svg><use href="#ef-tt"/></svg>
              </a>
            {%- endif -%}
            {%- if section.settings.social_pinterest != blank -%}
              <a href="{{ section.settings.social_pinterest }}" class="ef-social__link" target="_blank" rel="noopener noreferrer" aria-label="Pinterest">
                <svg><use href="#ef-pin"/></svg>
              </a>
            {%- endif -%}
          </nav>
          {%- endif -%}

          {%- comment %} Payment icons — real Shopify API {%- endcomment -%}
          {%- if shop.enabled_payment_types.size > 0 -%}
          <div class="ef-payments" aria-label="Accepted payment methods">
            <span class="ef-payments__label">Pay via</span>
            {%- for type in shop.enabled_payment_types limit: 7 -%}
              {{- type | payment_type_svg_tag: class: 'ef-payment-icon' -}}
            {%- endfor -%}
          </div>
          {%- endif -%}

        </div>

        <!-- ── NAV COLUMN ── -->
        <nav class="ef-nav-col" aria-label="Footer navigation">

          {%- if linklists[menu_1].links.size > 0 -%}
          <div>
            <h3 class="ef-nav__heading">{{ section.settings.menu_1_title | default: 'Shop' }}</h3>
            <ul class="ef-nav__list">
              {%- for link in linklists[menu_1].links -%}
                <li>
                  <a href="{{ link.url }}" class="ef-nav__link"
                     {%- if link.active %} aria-current="page"{%- endif -%}>
                    {{ link.title }}
                  </a>
                </li>
              {%- endfor -%}
            </ul>
          </div>
          {%- endif -%}

          {%- if linklists[menu_2].links.size > 0 -%}
          <div>
            <h3 class="ef-nav__heading">{{ section.settings.menu_2_title | default: 'Help' }}</h3>
            <ul class="ef-nav__list">
              {%- for link in linklists[menu_2].links -%}
                <li>
                  <a href="{{ link.url }}" class="ef-nav__link"
                     {%- if link.active %} aria-current="page"{%- endif -%}>
                    {{ link.title }}
                  </a>
                </li>
              {%- endfor -%}
            </ul>
          </div>
          {%- endif -%}

          {%- if linklists[menu_3].links.size > 0 -%}
          <div>
            <h3 class="ef-nav__heading">{{ section.settings.menu_3_title | default: 'Company' }}</h3>
            <ul class="ef-nav__list">
              {%- for link in linklists[menu_3].links -%}
                <li>
                  <a href="{{ link.url }}" class="ef-nav__link"
                     {%- if link.active %} aria-current="page"{%- endif -%}>
                    {{ link.title }}
                  </a>
                </li>
              {%- endfor -%}
            </ul>
          </div>
          {%- endif -%}

        </nav>

        <!-- ── NEWSLETTER COLUMN ── -->
        <div class="ef-news">
          <div class="ef-news__eyebrow">
            <span class="ef-news__eyebrow-dot" aria-hidden="true"></span>
            {{ section.settings.news_eyebrow | default: 'Exclusive Access' }}
          </div>

          <h3 class="ef-news__title">{{ section.settings.news_title | default: 'Stay in the know' }}</h3>

          {%- if section.settings.news_desc != blank -%}
            <p class="ef-news__desc">{{ section.settings.news_desc }}</p>
          {%- endif -%}

          {%- form 'customer', class: 'ef-news__form', id: 'ef-footer-form' -%}
            {%- if form.posted_successfully? -%}
              <div class="ef-news__success" role="alert">
                <svg aria-hidden="true"><use href="#ef-check"/></svg>
                {{ section.settings.news_success | default: 'You are subscribed.' }}
              </div>
            {%- else -%}
              {%- if form.errors -%}
                <div class="ef-news__success" style="background:rgba(176,58,46,0.08);border-color:rgba(176,58,46,0.2);color:#B03A2E;" role="alert">
                  <svg aria-hidden="true"><use href="#ef-check"/></svg>
                  {{ form.errors.translated_fields['email'] | capitalize }} {{ form.errors.messages['email'] }}
                </div>
              {%- endif -%}
              <div class="ef-news__input-row">
                <label for="EfFooterEmail" class="sr">Email address</label>
                <input
                  type="email"
                  id="EfFooterEmail"
                  name="contact[email]"
                  class="ef-news__input"
                  placeholder="{{ section.settings.news_placeholder | default: 'Your email address' }}"
                  required
                  autocomplete="email"
                  aria-required="true"
                  aria-label="Email address for newsletter subscription">
                <input type="hidden" name="contact[tags]" value="newsletter">
                <button type="submit" class="ef-news__btn">
                  <span>{{ section.settings.news_btn | default: 'Subscribe' }}</span>
                </button>
              </div>
            {%- endif -%}
          {%- endform -%}

          {%- if section.settings.news_disclaimer != blank -%}
            <p class="ef-news__disclaimer">{{ section.settings.news_disclaimer }}</p>
          {%- endif -%}
        </div>

      </div>
    </div>

    <!-- ── MIDDLE INFO BAND ── -->
    {%- assign show_mid = false -%}
    {%- if section.settings.info_phone != blank or section.settings.info_email != blank or section.settings.info_address != blank or section.settings.info_hours != blank -%}
      {%- assign show_mid = true -%}
    {%- endif -%}

    {%- if show_mid -%}
    <div class="ef-mid">
      <div class="ef-container">
        <div class="ef-mid__grid">

          {%- if section.settings.info_phone != blank -%}
          <div class="ef-mid__item">
            <div class="ef-mid__icon" aria-hidden="true">
              <svg><use href="#ef-phone"/></svg>
            </div>
            <div>
              <div class="ef-mid__label">Call Us</div>
              <div class="ef-mid__value">
                <a href="tel:{{ section.settings.info_phone | remove: ' ' | remove: '-' | remove: '(' | remove: ')' }}">
                  {{ section.settings.info_phone }}
                </a>
              </div>
            </div>
          </div>
          {%- endif -%}

          {%- if section.settings.info_email != blank -%}
          <div class="ef-mid__item">
            <div class="ef-mid__icon" aria-hidden="true">
              <svg><use href="#ef-mail"/></svg>
            </div>
            <div>
              <div class="ef-mid__label">Email Us</div>
              <div class="ef-mid__value">
                <a href="mailto:{{ section.settings.info_email }}">{{ section.settings.info_email }}</a>
              </div>
            </div>
          </div>
          {%- endif -%}

          {%- if section.settings.info_address != blank -%}
          <div class="ef-mid__item">
            <div class="ef-mid__icon" aria-hidden="true">
              <svg><use href="#ef-map"/></svg>
            </div>
            <div>
              <div class="ef-mid__label">Our Location</div>
              <div class="ef-mid__value">{{ section.settings.info_address }}</div>
            </div>
          </div>
          {%- endif -%}

          {%- if section.settings.info_hours != blank -%}
          <div class="ef-mid__item">
            <div class="ef-mid__icon" aria-hidden="true">
              <svg><use href="#ef-clock"/></svg>
            </div>
            <div>
              <div class="ef-mid__label">Business Hours</div>
              <div class="ef-mid__value">{{ section.settings.info_hours }}</div>
            </div>
          </div>
          {%- endif -%}

        </div>
      </div>
    </div>
    {%- endif -%}

    <!-- ── BASE BAR ── -->
    <div class="ef-base">
      <div class="ef-container">
        <div class="ef-base__inner">

          <!-- Legal links -->
          <nav class="ef-legal" aria-label="Legal">
            {%- if section.settings.legal_privacy != blank -%}
              {%- assign priv = pages[section.settings.legal_privacy] -%}
              {%- if priv -%}
                <a href="{{ priv.url }}" class="ef-legal__link">Privacy Policy</a>
              {%- endif -%}
            {%- endif -%}
            {%- if section.settings.legal_terms != blank -%}
              {%- assign trms = pages[section.settings.legal_terms] -%}
              {%- if trms -%}
                <a href="{{ trms.url }}" class="ef-legal__link">Terms of Service</a>
              {%- endif -%}
            {%- endif -%}
            {%- if section.settings.legal_refund != blank -%}
              {%- assign rfnd = pages[section.settings.legal_refund] -%}
              {%- if rfnd -%}
                <a href="{{ rfnd.url }}" class="ef-legal__link">Refund Policy</a>
              {%- endif -%}
            {%- endif -%}
            {%- if section.settings.legal_shipping != blank -%}
              {%- assign shp = pages[section.settings.legal_shipping] -%}
              {%- if shp -%}
                <a href="{{ shp.url }}" class="ef-legal__link">Shipping Policy</a>
              {%- endif -%}
            {%- endif -%}
          </nav>

          <!-- Copyright -->
          <p class="ef-copyright">
            &copy; {{ current_year }} {{ shop.name }}
            {%- if section.settings.copyright_suffix != blank -%}
              &nbsp;&mdash; {{ section.settings.copyright_suffix }}
            {%- endif -%}
          </p>

          <!-- Locale selector -->
          {%- if section.settings.show_locale_selector and localization.available_countries.size > 1 -%}
          {%- form 'localization', id: 'ef-locale-form' -%}
            <div class="ef-locale-form">
              <label for="EfLocale" class="sr">Country / Region</label>
              <select
                id="EfLocale"
                name="country_code"
                class="ef-locale"
                onchange="document.getElementById('ef-locale-form').submit()">
                {%- for country in localization.available_countries -%}
                  <option
                    value="{{ country.iso_code }}"
                    {%- if country.iso_code == localization.country.iso_code %} selected{%- endif -%}>
                    {{ country.name }} ({{ country.currency.iso_code }}&nbsp;{{ country.currency.symbol }})
                  </option>
                {%- endfor -%}
              </select>
            </div>
          {%- endform -%}
          {%- endif -%}

        </div>
      </div>
    </div>

  </footer>
</div>

{% schema %}
{
  "name": "Elite Footer",
  "class": "section-elite-footer",
  "settings": [
    {
      "type": "header",
      "content": "Marquee Strip"
    },
    {
      "type": "checkbox",
      "id": "show_strip",
      "label": "Show marquee strip",
      "default": true
    },
    {
      "type": "textarea",
      "id": "strip_text",
      "label": "Strip messages",
      "default": "Free Shipping Over Rs. 5,000 | [em]100% Authentic[/em] Products | 7-Day Easy Returns | Cash on Delivery Available | Trusted by Thousands",
      "info": "Separate messages with |  —  Use [em]text[/em] for gold highlighted words"
    },
    {
      "type": "header",
      "content": "Brand Identity"
    },
    {
      "type": "image_picker",
      "id": "footer_logo",
      "label": "Footer logo",
      "info": "Recommended: SVG or transparent PNG at 2× size (400px wide)"
    },
    {
      "type": "textarea",
      "id": "brand_tagline",
      "label": "Brand tagline",
      "default": "Crafted with precision. Delivered with care.",
      "info": "Short mission statement shown under your logo"
    },
    {
      "type": "header",
      "content": "Social Media"
    },
    {
      "type": "checkbox",
      "id": "show_social",
      "label": "Show social links",
      "default": true
    },
    {
      "type": "url",
      "id": "social_facebook",
      "label": "Facebook URL"

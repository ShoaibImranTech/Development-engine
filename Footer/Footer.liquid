
{%- liquid
  assign current_year = 'now' | date: '%Y'
  assign menu_1 = section.settings.menu_1
  assign menu_2 = section.settings.menu_2
  assign menu_3 = section.settings.menu_3
-%}

{%- style -%}

/* ─────────────────────────────────────────────
   FONT IMPORTS — Inline link fallback
   (Loaded via <link> tag below for performance)
───────────────────────────────────────────── */

/* ─────────────────────────────────────────────
   DESIGN TOKENS
───────────────────────────────────────────── */
:root {
  /* Base palette — deep ink + warm ivory + antique brass */
  --ef-ink:          #0e0d0b;
  --ef-ink-90:       rgba(14,13,11,0.90);
  --ef-ink-60:       rgba(14,13,11,0.60);
  --ef-ink-30:       rgba(14,13,11,0.30);
  --ef-ink-12:       rgba(14,13,11,0.12);
  --ef-ink-06:       rgba(14,13,11,0.06);

  --ef-ivory:        #F8F5F0;
  --ef-ivory-deep:   #EDE9E2;
  --ef-white:        #FFFFFF;

  --ef-brass:        #9E7E3F;
  --ef-brass-light:  #C9A96E;
  --ef-brass-bg:     rgba(158,126,63,0.07);
  --ef-brass-border: rgba(158,126,63,0.18);

  --ef-green:        #2A5C45;
  --ef-green-bg:     rgba(42,92,69,0.08);

  --ef-red:          #B03A2E;

  /* Type */
  --ef-display:      'Cormorant Garamond', 'Libre Baskerville', Georgia, serif;
  --ef-sans:         'Jost', 'Outfit', -apple-system, BlinkMacSystemFont, sans-serif;
  --ef-mono:         'DM Mono', 'Courier New', monospace;

  /* Motion */
  --ef-ease:         cubic-bezier(0.22, 1, 0.36, 1);
  --ef-ease-in:      cubic-bezier(0.64, 0, 0.78, 0);
  --ef-dur-fast:     140ms;
  --ef-dur-base:     260ms;
  --ef-dur-slow:     500ms;

  /* Space */
  --ef-gutter:   clamp(20px, 5vw, 72px);
  --ef-max:      1520px;
}

/* ─────────────────────────────────────────────
   DARK MODE
───────────────────────────────────────────── */
@media (prefers-color-scheme: dark) {
  :root {
    --ef-ink:        #F0EDE8;
    --ef-ink-90:     rgba(240,237,232,0.90);
    --ef-ink-60:     rgba(240,237,232,0.60);
    --ef-ink-30:     rgba(240,237,232,0.30);
    --ef-ink-12:     rgba(240,237,232,0.12);
    --ef-ink-06:     rgba(240,237,232,0.06);
    --ef-ivory:      #16140F;
    --ef-ivory-deep: #1E1B14;
    --ef-white:      #201D17;
  }
}

/* ─────────────────────────────────────────────
   RESET (scoped)
───────────────────────────────────────────── */
.ef *, .ef *::before, .ef *::after {
  box-sizing: border-box;
}

.ef {
  font-family: var(--ef-sans);
  color: var(--ef-ink);
  -webkit-font-smoothing: antialiased;
}

.ef img { display: block; max-width: 100%; }

/* ─────────────────────────────────────────────
   SR ONLY
───────────────────────────────────────────── */
.ef .sr {
  position: absolute;
  width: 1px; height: 1px;
  padding: 0; margin: -1px;
  overflow: hidden;
  clip: rect(0,0,0,0);
  white-space: nowrap;
  border: 0;
}

/* ─────────────────────────────────────────────
   FOCUS
───────────────────────────────────────────── */
.ef *:focus-visible {
  outline: 2px solid var(--ef-brass);
  outline-offset: 3px;
  border-radius: 2px;
}
.ef *:focus:not(:focus-visible) { outline: none; }

/* ─────────────────────────────────────────────
   MARQUEE STRIP
───────────────────────────────────────────── */
.ef-strip {
  background: var(--ef-ink);
  color: rgba(255,255,255,0.72);
  overflow: hidden;
  padding: 13px 0;
  position: relative;
}

.ef-strip__track {
  display: flex;
  width: max-content;
  animation: ef-marquee 32s linear infinite;
}

.ef-strip__track:hover {
  animation-play-state: paused;
}

@keyframes ef-marquee {
  0%   { transform: translateX(0); }
  100% { transform: translateX(-50%); }
}

.ef-strip__segment {
  display: flex;
  align-items: center;
  gap: clamp(28px, 4vw, 56px);
  padding-right: clamp(28px, 4vw, 56px);
  white-space: nowrap;
  font-size: 11px;
  font-weight: 500;
  letter-spacing: 0.1em;
  text-transform: uppercase;
}

.ef-strip__dot {
  width: 3px;
  height: 3px;
  border-radius: 50%;
  background: var(--ef-brass-light);
  flex-shrink: 0;
  opacity: 0.6;
}

.ef-strip em {
  color: var(--ef-brass-light);
  font-style: normal;
  font-weight: 600;
}

/* ─────────────────────────────────────────────
   FOOTER WRAPPER
───────────────────────────────────────────── */
.ef-footer {
  background: var(--ef-ivory);
  position: relative;
}

/* Top gradient rule */
.ef-footer__rule {
  height: 1px;
  background: linear-gradient(90deg, 
    transparent 0%, 
    var(--ef-ink-12) 15%, 
    var(--ef-ink-12) 85%, 
    transparent 100%
  );
}

.ef-container {
  max-width: var(--ef-max);
  margin: 0 auto;
  padding-left: var(--ef-gutter);
  padding-right: var(--ef-gutter);
}

/* ─────────────────────────────────────────────
   UPPER FOOTER — Brand + Nav + Newsletter
───────────────────────────────────────────── */
.ef-upper {
  display: grid;
  grid-template-columns: 1fr;
  gap: clamp(40px, 6vw, 72px);
  padding: clamp(56px, 8vw, 96px) 0 clamp(48px, 6vw, 80px);
}

@media (min-width: 768px) {
  .ef-upper {
    grid-template-columns: 1fr 1fr;
  }
}

@media (min-width: 1120px) {
  .ef-upper {
    grid-template-columns: 1.2fr 1fr 1.1fr;
  }
}

/* ─────────────────────────────────────────────
   BRAND COLUMN
───────────────────────────────────────────── */
.ef-brand {}

.ef-brand__logo {
  display: inline-block;
  margin-bottom: clamp(18px, 3vw, 28px);
  transition: opacity var(--ef-dur-base) var(--ef-ease);
}

.ef-brand__logo:hover { opacity: 0.55; }

.ef-brand__logo img {
  max-width: clamp(140px, 18vw, 190px);
  height: auto;
}

.ef-brand__wordmark {
  font-family: var(--ef-display);
  font-size: clamp(26px, 4vw, 40px);
  font-weight: 300;
  letter-spacing: -0.025em;
  line-height: 1;
  color: var(--ef-ink);
  margin: 0 0 clamp(18px, 3vw, 28px);
}

.ef-brand__tagline {
  font-size: clamp(14px, 1.4vw, 15px);
  line-height: 1.72;
  color: var(--ef-ink-60);
  max-width: 44ch;
  margin: 0 0 clamp(24px, 4vw, 36px);
}

/* Social */
.ef-social {
  display: flex;
  gap: 8px;
  margin-bottom: clamp(24px, 4vw, 36px);
}

.ef-social__link {
  width: 38px;
  height: 38px;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 1px solid var(--ef-ink-12);
  border-radius: 50%;
  color: var(--ef-ink-60);
  text-decoration: none;
  transition: 
    background var(--ef-dur-base) var(--ef-ease),
    border-color var(--ef-dur-base) var(--ef-ease),
    color var(--ef-dur-base) var(--ef-ease),
    transform var(--ef-dur-base) var(--ef-ease);
}

.ef-social__link svg {
  width: 15px;
  height: 15px;
  transition: transform var(--ef-dur-base) var(--ef-ease);
  pointer-events: none;
}

.ef-social__link:hover {
  background: var(--ef-ink);
  border-color: var(--ef-ink);
  color: var(--ef-ivory);
  transform: translateY(-2px);
}

.ef-social__link:hover svg {
  transform: scale(1.1);
}

/* Payment icons */
.ef-payments {
  display: flex;
  align-items: center;
  gap: 7px;
  flex-wrap: wrap;
}

.ef-payments__label {
  font-size: 10px;
  font-weight: 600;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  color: var(--ef-ink-30);
  margin-right: 4px;
}

.ef-payments svg,
.ef-payments img {
  height: 22px;
  width: auto;
  filter: grayscale(1);
  opacity: 0.45;
  transition: all var(--ef-dur-base) var(--ef-ease);
}

.ef-payments svg:hover,
.ef-payments img:hover {
  filter: grayscale(0);
  opacity: 1;
}

/* ─────────────────────────────────────────────
   NAV COLUMN
───────────────────────────────────────────── */
.ef-nav-col {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(130px, 1fr));
  gap: clamp(28px, 4vw, 48px);
}

.ef-nav__heading {
  font-size: 10px;
  font-weight: 700;
  letter-spacing: 0.18em;
  text-transform: uppercase;
  color: var(--ef-ink);
  margin: 0 0 clamp(14px, 2vw, 20px);
}

.ef-nav__list {
  list-style: none;
  margin: 0;
  padding: 0;
  display: flex;
  flex-direction: column;
  gap: 10px;
}

.ef-nav__link {
  font-size: clamp(13px, 1.2vw, 14px);
  color: var(--ef-ink-60);
  text-decoration: none;
  display: inline-flex;
  align-items: center;
  gap: 6px;
  transition: color var(--ef-dur-fast) var(--ef-ease);
  position: relative;
}

.ef-nav__link::before {
  content: '';
  display: block;
  width: 0;
  height: 1px;
  background: var(--ef-brass);
  transition: width var(--ef-dur-base) var(--ef-ease);
  flex-shrink: 0;
}

.ef-nav__link:hover {
  color: var(--ef-ink);
}

.ef-nav__link:hover::before {
  width: 16px;
}

/* ─────────────────────────────────────────────
   NEWSLETTER COLUMN
───────────────────────────────────────────── */
.ef-news {
  background: var(--ef-ivory-deep);
  border: 1px solid var(--ef-ink-06);
  border-radius: 8px;
  padding: clamp(28px, 4vw, 44px);
  position: relative;
  overflow: hidden;
}

/* Decorative corner detail */
.ef-news::before {
  content: '';
  position: absolute;
  top: -1px;
  left: clamp(28px, 4vw, 44px);
  right: clamp(28px, 4vw, 44px);
  height: 2px;
  background: linear-gradient(90deg, var(--ef-brass) 0%, var(--ef-brass-light) 100%);
  border-radius: 0 0 2px 2px;
}

.ef-news__eyebrow {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  font-size: 10px;
  font-weight: 700;
  letter-spacing: 0.18em;
  text-transform: uppercase;
  color: var(--ef-brass);
  margin-bottom: 14px;
}

.ef-news__eyebrow-dot {
  width: 5px;
  height: 5px;
  border-radius: 50%;
  background: var(--ef-brass);
  flex-shrink: 0;
}

.ef-news__title {
  font-family: var(--ef-display);
  font-size: clamp(22px, 2.8vw, 30px);
  font-weight: 400;
  letter-spacing: -0.02em;
  line-height: 1.15;
  color: var(--ef-ink);
  margin: 0 0 10px;
}

.ef-news__desc {
  font-size: clamp(13px, 1.3vw, 14px);
  line-height: 1.7;
  color: var(--ef-ink-60);
  margin: 0 0 clamp(20px, 3vw, 28px);
}

/* Form */
.ef-news__form {
  margin-bottom: 12px;
}

.ef-news__input-row {
  display: flex;
  flex-direction: column;
  gap: 8px;
}

@media (min-width: 480px) {
  .ef-news__input-row {
    flex-direction: row;
  }
}

.ef-news__input {
  flex: 1;
  padding: 14px 16px;
  background: var(--ef-white);
  border: 1px solid var(--ef-ink-12);
  border-radius: 5px;
  font-family: var(--ef-sans);
  font-size: 14px;
  color: var(--ef-ink);
  transition: 
    border-color var(--ef-dur-base) var(--ef-ease),
    box-shadow var(--ef-dur-base) var(--ef-ease);
}

.ef-news__input::placeholder {
  color: var(--ef-ink-30);
}

.ef-news__input:focus {
  outline: none;
  border-color: var(--ef-brass);
  box-shadow: 0 0 0 3px var(--ef-brass-bg);
}

.ef-news__btn {
  padding: 14px 22px;
  background: var(--ef-ink);
  color: var(--ef-ivory);
  border: 2px solid var(--ef-ink);
  border-radius: 5px;
  font-family: var(--ef-sans);
  font-size: 11px;
  font-weight: 700;
  letter-spacing: 0.12em;
  text-transform: uppercase;
  cursor: pointer;
  white-space: nowrap;
  flex-shrink: 0;
  transition: 
    background var(--ef-dur-base) var(--ef-ease),
    color var(--ef-dur-base) var(--ef-ease),
    transform var(--ef-dur-base) var(--ef-ease),
    box-shadow var(--ef-dur-base) var(--ef-ease);
  position: relative;
  overflow: hidden;
}

.ef-news__btn::before {
  content: '';
  position: absolute;
  inset: 0;
  background: var(--ef-brass);
  transform: translateX(-101%);
  transition: transform var(--ef-dur-slow) var(--ef-ease);
}

.ef-news__btn:hover::before {
  transform: translateX(0);
}

.ef-news__btn span {
  position: relative;
  z-index: 1;
}

.ef-news__btn:hover {
  border-color: var(--ef-brass);
  transform: translateY(-1px);
  box-shadow: 0 6px 20px rgba(158,126,63,0.22);
}

.ef-news__btn:active { transform: translateY(0); }

/* Success state */
.ef-news__success {
  display: flex;
  align-items: center;
  gap: 10px;
  padding: 13px 16px;
  background: var(--ef-green-bg);
  border: 1px solid rgba(42,92,69,0.15);
  border-radius: 5px;
  font-size: 13px;
  font-weight: 500;
  color: var(--ef-green);
  margin-bottom: 12px;
}

.ef-news__success svg {
  width: 16px;
  height: 16px;
  flex-shrink: 0;
}

/* Disclaimer */
.ef-news__disclaimer {
  font-size: 11px;
  line-height: 1.6;
  color: var(--ef-ink-30);
}

.ef-news__disclaimer a {
  color: var(--ef-ink-60);
  text-decoration: underline;
  text-underline-offset: 2px;
  transition: color var(--ef-dur-fast);
}

.ef-news__disclaimer a:hover { color: var(--ef-ink); }

/* ─────────────────────────────────────────────
   MIDDLE BAND — Location / Store Info
───────────────────────────────────────────── */
.ef-mid {
  border-top: 1px solid var(--ef-ink-06);
  border-bottom: 1px solid var(--ef-ink-06);
  padding: clamp(24px, 4vw, 36px) 0;
}

.ef-mid__grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
  gap: clamp(20px, 4vw, 40px);
}

.ef-mid__item {
  display: flex;
  align-items: flex-start;
  gap: 14px;
}

.ef-mid__icon {
  width: 36px;
  height: 36px;
  border-radius: 8px;
  background: var(--ef-brass-bg);
  border: 1px solid var(--ef-brass-border);
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--ef-brass);
  flex-shrink: 0;
}

.ef-mid__icon svg {
  width: 17px;
  height: 17px;
}

.ef-mid__label {
  font-size: 10px;
  font-weight: 700;
  letter-spacing: 0.12em;
  text-transform: uppercase;
  color: var(--ef-ink-30);
  margin-bottom: 4px;
}

.ef-mid__value {
  font-size: clamp(13px, 1.3vw, 14px);
  font-weight: 500;
  color: var(--ef-ink);
  line-height: 1.4;
}

.ef-mid__value a {
  color: inherit;
  text-decoration: none;
  transition: color var(--ef-dur-fast);
}

.ef-mid__value a:hover { color: var(--ef-brass); }

/* ─────────────────────────────────────────────
   BASE BAR — Legal + Copyright
───────────────────────────────────────────── */
.ef-base {
  background: var(--ef-ivory-deep);
  padding: clamp(18px, 3vw, 26px) 0;
}

.ef-base__inner {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 14px;
  text-align: center;
}

@media (min-width: 768px) {
  .ef-base__inner {
    flex-direction: row;
    justify-content: space-between;
    text-align: left;
    gap: 20px;
    flex-wrap: wrap;
  }
}

.ef-legal {
  display: flex;
  align-items: center;
  gap: clamp(16px, 3vw, 28px);
  flex-wrap: wrap;
  justify-content: center;
}

.ef-legal__link {
  font-size: 12px;
  font-weight: 500;
  color: var(--ef-ink-60);
  text-decoration: none;
  transition: color var(--ef-dur-fast) var(--ef-ease);
  position: relative;
}

.ef-legal__link::after {
  content: '';
  position: absolute;
  bottom: -2px;
  left: 0;
  width: 0;
  height: 1px;
  background: var(--ef-ink);
  transition: width var(--ef-dur-base) var(--ef-ease);
}

.ef-legal__link:hover { color: var(--ef-ink); }
.ef-legal__link:hover::after { width: 100%; }

.ef-copyright {
  font-family: var(--ef-mono);
  font-size: 11px;
  color: var(--ef-ink-30);
  letter-spacing: 0.04em;
  white-space: nowrap;
}

/* Locale selector */
.ef-locale-form { display: flex; align-items: center; }

.ef-locale {
  appearance: none;
  padding: 8px 32px 8px 12px;
  background: var(--ef-white);
  border: 1px solid var(--ef-ink-12);
  border-radius: 5px;
  font-family: var(--ef-sans);
  font-size: 12px;
  font-weight: 500;
  color: var(--ef-ink);
  cursor: pointer;
  background-image: url("data:image/svg+xml,%3Csvg width='10' height='6' viewBox='0 0 10 6' fill='none' xmlns='http://www.w3.org/2000/svg'%3E%3Cpath d='M1 1L5 5L9 1' stroke='%230e0d0b' stroke-width='1.5' stroke-linecap='round' stroke-linejoin='round'/%3E%3C/svg%3E");
  background-repeat: no-repeat;
  background-position: right 10px center;
  transition: border-color var(--ef-dur-fast), box-shadow var(--ef-dur-fast);
}

.ef-locale:hover { border-color: var(--ef-ink-30); }
.ef-locale:focus {
  outline: none;
  border-color: var(--ef-brass);
  box-shadow: 0 0 0 3px var(--ef-brass-bg);
}

/* ─────────────────────────────────────────────
   ENTRANCE ANIMATIONS
───────────────────────────────────────────── */
.ef-strip           { opacity: 0; animation: efFadeIn 0.6s var(--ef-ease) 0.1s forwards; }
.ef-brand           { opacity: 0; animation: efFadeUp 0.8s var(--ef-ease) 0.2s forwards; }
.ef-nav-col         { opacity: 0; animation: efFadeUp 0.8s var(--ef-ease) 0.3s forwards; }
.ef-news            { opacity: 0; animation: efFadeUp 0.8s var(--ef-ease) 0.4s forwards; }
.ef-mid             { opacity: 0; animation: efFadeIn 0.8s var(--ef-ease) 0.5s forwards; }
.ef-base            { opacity: 0; animation: efFadeIn 0.8s var(--ef-ease) 0.6s forwards; }

@keyframes efFadeIn {
  from { opacity: 0; }
  to   { opacity: 1; }
}

@keyframes efFadeUp {
  from { opacity: 0; transform: translateY(20px); }
  to   { opacity: 1; transform: translateY(0); }
}

/* ─────────────────────────────────────────────
   REDUCED MOTION
───────────────────────────────────────────── */
@media (prefers-reduced-motion: reduce) {
  .ef-strip, .ef-brand, .ef-nav-col, .ef-news, .ef-mid, .ef-base {
    animation: none;
    opacity: 1;
    transform: none;
  }
  .ef-strip__track { animation: none; }
  .ef *, .ef *::before, .ef *::after {
    transition-duration: 0.01ms !important;
  }
}

/* ─────────────────────────────────────────────
   PRINT
───────────────────────────────────────────── */
@media print {
  .ef-strip, .ef-social, .ef-payments, .ef-news, .ef-mid { display: none !important; }
  .ef-footer { background: white !important; padding: 16px 0 !important; }
  .ef-base { background: white !important; margin-top: 8px !important; }
}

/* ─────────────────────────────────────────────
   TOUCH DEVICES
───────────────────────────────────────────── */
@media (hover: none) and (pointer: coarse) {
  .ef-social__link,
  .ef-nav__link,
  .ef-legal__link {
    min-height: 44px;
    min-width: 44px;
  }
  .ef-news__btn:hover { transform: none; }
}

{%- endstyle -%}

